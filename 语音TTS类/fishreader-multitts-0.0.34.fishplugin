  "modules": {
    "manage.html": "<!doctype html>\r\n<html lang=\"zh-CN\">\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\r\n  <meta name=\"theme-color\" content=\"#F2F2F7\">\r\n  <title>MultiTTS在线语音包</title>\r\n  <style>\r\n    :root { color-scheme: light; font-family: system-ui, -apple-system, sans-serif; --page: #F2F2F7; --surface: #fff; --ink: #1C1C1E; --muted: #6D6D72; --hint: #8E8E93; --accent: #0A84FF; --accent-soft: #0A84FF1A; --line: #DCDCDC; --soft: #F5F5F5; --on-accent: #fff; --nav: #fff; --danger: #D32F2F; }\r\n    :root[data-color-mode=\"dark\"] { color-scheme: dark; }\r\n    @media (prefers-color-scheme: dark) { :root:not([data-color-mode]) { color-scheme: dark; --page: #111316; --surface: #1E2126; --soft: #292D33; --line: #3A3F46; --ink: #F2F2F7; --muted: #C1C2C7; --hint: #8E8E93; --accent: #409CFF; --accent-soft: #409CFF33; --nav: #1E2126; --danger: #FF6961; } }\r\n    * { box-sizing: border-box; }\r\n    [hidden] { display: none !important; }\r\n    body { margin: 0; padding: 20px 16px calc(28px + env(safe-area-inset-bottom)); background: var(--page); color: var(--ink); font-size: 14px; line-height: 1.5; }\r\n    main { max-width: 720px; margin: 0 auto; }\r\n    button, input, textarea { font: inherit; }\r\n    button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 42px; border: 1px solid transparent; border-radius: 12px; padding: 10px 16px; background: var(--accent); color: var(--on-accent); font-weight: 600; cursor: pointer; -webkit-tap-highlight-color: transparent; }\r\n    button:disabled { opacity: .48; cursor: default; }\r\n    button:focus-visible, input:focus-visible, textarea:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }\r\n    button.secondary { background: var(--soft); color: var(--ink); }\r\n    button.danger { background: var(--soft); color: var(--danger); }\r\n    button.quiet { background: transparent; color: var(--muted); padding: 8px 10px; }\r\n    button svg, .section-icon { width: 18px; height: 18px; flex: 0 0 auto; }\r\n    h1, h2, h3, p { margin: 0; }\r\n    h1 { font-size: 23px; letter-spacing: -.6px; line-height: 1.2; }\r\n    h2 { font-size: 16px; font-weight: 650; }\r\n    p { color: var(--muted); line-height: 1.65; }\r\n    .brand { display: flex; gap: 11px; align-items: center; margin-bottom: 22px; }\r\n    .brand-mark { width: 42px; height: 42px; display: flex; justify-content: center; align-items: center; gap: 3px; background: var(--accent); border-radius: 14px; }\r\n    .brand-mark i { display: block; width: 3px; height: 12px; border-radius: 2px; background: var(--on-accent); }\r\n    .brand-mark i:nth-child(2), .brand-mark i:nth-child(4) { height: 21px; }\r\n    .brand-mark i:nth-child(3) { height: 28px; }\r\n    .brand p { font-size: 12px; margin-top: 4px; }\r\n    .view-tabs { position: sticky; top: 0; z-index: 30; display: grid; grid-template-columns: 1fr 1fr; padding: 4px; gap: 4px; background: var(--soft); border: 1px solid var(--line); border-radius: 15px; margin-bottom: 18px; }\r\n    .view-tabs button { min-width: 0; background: transparent; color: var(--muted); border-radius: 11px; }\r\n    .view-tabs button.active { background: var(--nav); color: var(--accent); }\r\n    .card { margin-top: 14px; padding: 18px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }\r\n    .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\r\n    .grow { flex: 1; min-width: 0; }\r\n    .title { font-weight: 650; overflow-wrap: anywhere; }\r\n    .section-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }\r\n    .section-head > :first-child { min-width: 0; }\r\n    .eyebrow { color: var(--accent); font-size: 11px; font-weight: 650; letter-spacing: 1px; }\r\n    .current-card { background: var(--accent-soft); border-color: transparent; margin-top: 0; }\r\n    .current-card .section-head { align-items: flex-start; margin-bottom: 0; }\r\n    #currentVoiceName { margin-top: 8px; font-size: 23px; font-weight: 650; letter-spacing: -.5px; line-height: 1.45; overflow-wrap: anywhere; }\r\n    #currentVoiceMeta { margin-top: 5px; color: var(--muted); font-size: 12px; overflow-wrap: anywhere; }\r\n    .current-card button { border-color: var(--line); background: var(--surface); color: var(--accent); }\r\n    .meta, .reason { margin-top: 5px; font-size: 12px; color: var(--muted); overflow-wrap: anywhere; }\r\n    .reason { padding-left: 10px; border-left: 2px solid var(--line); }\r\n    .ready { color: var(--accent); }\r\n    .blocked { color: var(--muted); }\r\n    .tabs { display: flex; gap: 7px; overflow-x: auto; padding: 2px 0 8px; scrollbar-width: none; }\r\n    .tabs::-webkit-scrollbar { display: none; }\r\n    button.tab { flex: 0 0 auto; min-height: 34px; padding: 6px 11px; border-radius: 9px; background: var(--soft); color: var(--muted); font-weight: 500; font-size: 12px; }\r\n    button.tab.active { background: var(--accent-soft); color: var(--accent); font-weight: 650; }\r\n    #voiceModeTabs { border-bottom: 1px solid var(--line); margin: 0 0 14px; padding: 0 0 10px; }\r\n    #voiceModeTabs button { font-size: 13px; }\r\n    .tabs.sub { padding-top: 0; }\r\n    button.tab.sub { background: transparent; min-height: 30px; padding: 4px 9px; }\r\n    button.tab.sub.active { background: var(--soft); color: var(--accent); }\r\n    .voice-filter-row, .online-tools { display: flex; gap: 8px; align-items: center; margin: 0 0 12px; }\r\n    .voice-filter-row input, .online-tools input { width: 100%; flex: 1; min-width: 0; border: 1px solid var(--line); border-radius: 11px; padding: 11px 12px; background: var(--soft); color: var(--ink); }\r\n    .voice-filter-row button { flex: 0 0 auto; padding: 10px 13px; }\r\n    input::placeholder, textarea::placeholder { color: var(--hint); }\r\n    .filter-label { margin: 5px 0 7px; font-size: 11px; color: var(--muted); }\r\n    .voice-picker { position: relative; margin-top: 6px; }\r\n    #voice { display: none; }\r\n    .voice-picker-button { width: 100%; justify-content: space-between; gap: 12px; border: 1px solid var(--line); border-radius: 12px; padding: 13px 12px; background: var(--soft); color: var(--ink); text-align: left; font-weight: 550; overflow-wrap: anywhere; }\r\n    .voice-picker-button::after { content: '⌄'; flex: 0 0 auto; color: var(--accent); font-size: 18px; }\r\n    .voice-picker-menu { position: relative; margin-top: 6px; max-height: 300px; max-height: min(45vh, 300px); overflow-y: auto; padding: 5px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); overscroll-behavior: contain; }\r\n    button.voice-picker-option { width: 100%; display: block; min-height: 44px; border-radius: 8px; padding: 11px 9px; background: transparent; color: var(--ink); font-weight: 400; text-align: left; overflow-wrap: anywhere; }\r\n    button.voice-picker-option + button { border-top: 1px solid var(--line); }\r\n    button.voice-picker-option.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }\r\n    #voiceSearchSummary { margin: 0 0 10px; }\r\n    .voice-actions { display: flex; justify-content: space-between; margin-top: 7px; }\r\n    .voice-actions button { background: transparent; padding: 7px 3px; min-height: 32px; font-size: 12px; }\r\n    .voice-actions button.secondary { color: var(--accent); }\r\n    label { display: block; color: var(--muted); font-size: 12px; }\r\n    textarea { width: 100%; border: 1px solid var(--line); border-radius: 12px; padding: 12px; background: var(--soft); color: var(--ink); min-height: 94px; resize: vertical; line-height: 1.7; }\r\n    .tuning { margin: 14px 0 16px; border-bottom: 1px solid var(--line); padding-bottom: 12px; }\r\n    summary { cursor: pointer; color: var(--muted); font-size: 12px; padding: 4px 0; }\r\n    .setting-row { display: flex; align-items: center; gap: 12px; min-height: 44px; }\r\n    .setting-name { flex: 0 0 30px; font-size: 12px; }\r\n    .setting-row input[type=\"range\"] { flex: 1; min-width: 0; accent-color: var(--accent); }\r\n    .setting-value { flex: 0 0 42px; text-align: right; font-size: 12px; color: var(--accent); font-variant-numeric: tabular-nums; }\r\n    .speed-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 6px 0 9px; }\r\n    .speed-actions button { min-width: 0; padding: 9px 8px; font-size: 13px; }\r\n    .speed-actions button.secondary { color: var(--accent); }\r\n    #voicesView { padding-bottom: 86px; }\r\n    .test-actions { position: fixed; z-index: 35; left: 16px; right: 16px; bottom: calc(12px + env(safe-area-inset-bottom)); max-width: 720px; margin: 0 auto; display: flex; align-items: center; gap: 12px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); box-shadow: 0 4px 24px #0000000a; }\r\n    #previewVoiceName { font-size: 13px; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; overflow: hidden; }\r\n    #previewSettings { font-size: 11px; color: var(--muted); margin-top: 2px; }\r\n    #test { flex: 0 0 auto; }\r\n    #testStatus { margin-top: 10px; font-size: 12px; }\r\n    #status { color: var(--accent); white-space: pre-wrap; overflow-wrap: anywhere; font-size: 12px; }\r\n    #status:not(:empty) { padding: 10px 12px; border-radius: 10px; background: var(--accent-soft); margin-bottom: 14px; }\r\n    .package-toolbar { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 16px; }\r\n    .package-toolbar button { background: transparent; color: var(--muted); border-bottom: 2px solid transparent; border-radius: 0; padding: 8px 6px; }\r\n    .package-toolbar button.active { color: var(--accent); border-bottom-color: var(--accent); }\r\n    .library-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; }\r\n    .library-head p { font-size: 12px; margin-top: 3px; }\r\n    #packages .card { margin-top: 10px; padding: 15px; }\r\n    .package-count { color: var(--accent); background: var(--soft); border-radius: 6px; padding: 2px 6px; margin-right: 6px; white-space: nowrap; }\r\n    .engine-list { margin-top: 10px; }\r\n    .engine-list summary { font-size: 11px; }\r\n    .engine-list .reason { margin-top: 8px; }\r\n    .remove { font-size: 12px; min-height: 36px; padding: 7px 10px; }\r\n    .directory { margin-top: 18px; padding: 14px 16px; background: var(--soft); border-radius: 12px; }\r\n    .directory summary { color: var(--muted); }\r\n    #root { font-family: ui-monospace, monospace; font-size: 11px; margin: 10px 0; line-height: 1.7; }\r\n    .directory p { margin: 9px 0 12px; font-size: 12px; }\r\n    #empty { display: none; text-align: center; padding: 32px 16px; border: 1px dashed var(--line); border-radius: 16px; }\r\n    #onlinePanel { margin-top: 0; }\r\n    #onlinePanel > p { font-size: 12px; margin: -5px 0 16px; }\r\n    #refreshOnline { font-size: 12px; padding: 7px 10px; min-height: 34px; }\r\n    #onlineGroupTabs { margin-bottom: 10px; }\r\n    #onlineStatus { margin-bottom: 8px; }\r\n    .online-item { display: flex; align-items: center; gap: 12px; padding: 15px 0; border-top: 1px solid var(--line); }\r\n    .online-item button { flex: 0 0 auto; min-height: 36px; font-size: 12px; padding: 8px 11px; }\r\n    .online-item .meta { font-size: 11px; }\r\n    .online-item button:disabled { background: var(--soft); color: var(--muted); opacity: 1; }\r\n    .empty-action { margin-top: 14px; }\r\n    code { overflow-wrap: anywhere; }\r\n    @media (max-width: 350px) { body { padding: 16px 12px 24px; } .card { padding: 14px; } .online-item { gap: 8px; } .online-item button { padding: 8px; } #currentVoiceName { font-size: 21px; } }\r\n    @media (prefers-reduced-motion: no-preference) { button { transition: background-color .15s, color .15s; } }\r\n  </style>\r\n</head>\r\n<body>\r\n<main>\r\n  <header class=\"brand\">\r\n    <div class=\"brand-mark\" aria-hidden=\"true\"><i></i><i></i><i></i><i></i><i></i></div>\r\n    <div><h1>MultiTTS</h1><p>找到适合你的朗读声音</p></div>\r\n  </header>\r\n  <nav class=\"view-tabs\" aria-label=\"功能导航\">\r\n    <button class=\"active\" data-view=\"voices\" aria-pressed=\"true\">音色与试听</button>\r\n    <button data-view=\"packages\" aria-pressed=\"false\">语音包</button>\r\n  </nav>\r\n  <div id=\"status\" role=\"status\" aria-live=\"polite\"></div>\r\n  <section id=\"voicesView\">\r\n    <div class=\"card current-card\">\r\n      <div class=\"section-head\">\r\n        <div class=\"grow\"><div class=\"eyebrow\">当前朗读音色</div><div id=\"currentVoiceName\">还没有可用音色</div><div id=\"currentVoiceMeta\">先导入一个语音包，开始试听</div></div>\r\n      </div>\r\n      <button id=\"emptyPackageAction\" class=\"empty-action\" data-open-packages hidden>添加语音包</button>\r\n    </div>\r\n    <div class=\"card\">\r\n      <div class=\"section-head\"><h2>选择音色</h2><span id=\"voiceCount\" class=\"meta\"></span></div>\r\n      <div id=\"voiceModeTabs\" class=\"tabs\" aria-label=\"音色列表\">\r\n        <button class=\"tab active\" data-mode=\"all\">全部音色</button>\r\n        <button class=\"tab\" data-mode=\"favorites\">我的收藏</button>\r\n        <button class=\"tab\" data-mode=\"deleted\">已删除</button>\r\n      </div>\r\n      <div class=\"voice-filter-row\">\r\n        <input id=\"voiceFilter\" type=\"search\" placeholder=\"搜索名称、语言、语音包\" aria-label=\"搜索音色\">\r\n        <button id=\"filterVoice\" class=\"secondary\" type=\"button\">搜索</button>\r\n      </div>\r\n      <div id=\"voiceSearchSummary\" class=\"meta\" role=\"status\" hidden></div>\r\n      <div id=\"packageTabs\" class=\"tabs\" aria-label=\"语音包筛选\"></div>\r\n      <div id=\"categoryTabs\" class=\"tabs sub\" aria-label=\"分类筛选\"></div>\r\n      <div class=\"voice-picker\">\r\n        <button id=\"voicePickerButton\" class=\"voice-picker-button\" type=\"button\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-controls=\"voicePickerMenu\">暂无可用音色</button>\r\n        <div id=\"voicePickerMenu\" class=\"voice-picker-menu\" role=\"listbox\" hidden></div>\r\n        <select id=\"voice\" aria-hidden=\"true\" tabindex=\"-1\"></select>\r\n      </div>\r\n      <div class=\"voice-actions\"><button id=\"favorite\" class=\"secondary\" type=\"button\">收藏音色</button><button id=\"deleteVoice\" class=\"danger\" type=\"button\">删除</button></div>\r\n    </div>\r\n    <div class=\"card\">\r\n      <div class=\"section-head\"><h2>试听设置</h2><label for=\"testText\">可修改试听文字</label></div>\r\n      <textarea id=\"testText\" aria-label=\"试听文字\">你好，放慢脚步，让好声音陪你读一本书。</textarea>\r\n      <details class=\"tuning\" open>\r\n        <summary>语速调节</summary>\r\n        <div class=\"setting-row\"><span class=\"setting-name\">语速</span><input id=\"speed\" aria-label=\"语速\" type=\"range\" min=\"0.1\" max=\"3.0\" step=\"0.1\" value=\"1.0\"><output id=\"speedValue\" class=\"setting-value\" for=\"speed\">1.0</output></div>\r\n        <div class=\"speed-actions\"><button id=\"resetAllVoiceSpeeds\" class=\"secondary\" disabled>重置所有音色</button><button id=\"setAllVoiceSpeeds\" class=\"secondary\" disabled>设置所有音色</button></div>\r\n        <div id=\"speedHint\" class=\"meta\">1.0 保持音色默认速度，设置按音色保存。</div>\r\n      </details>\r\n      <p id=\"testStatus\" role=\"status\">选一个声音，听听是否合你心意。</p>\r\n    </div>\r\n    <div class=\"test-actions\" aria-label=\"试听控制\"><div class=\"grow\"><div id=\"previewVoiceName\">尚未选择音色</div><div id=\"previewSettings\">1.0 倍语速</div></div><button id=\"test\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M8 5v14l11-7z\"/></svg><span id=\"testLabel\">试听</span></button></div>\r\n  </section>\r\n  <section id=\"packagesView\" hidden>\r\n    <nav class=\"package-toolbar\" aria-label=\"语音包管理\">\r\n      <button id=\"installedPackages\" class=\"active\" aria-pressed=\"true\">已导入 <span id=\"installedCount\"></span></button>\r\n      <button id=\"onlinePackages\" aria-pressed=\"false\">在线下载</button>\r\n    </nav>\r\n    <div id=\"localPanel\">\r\n      <div class=\"library-head\"><div><h2>我的语音包</h2><p>支持 ZIP 文件，一次最多 200 个</p></div><button id=\"importFiles\" type=\"button\">导入文件</button></div>\r\n      <p id=\"empty\">还没有语音包<br>选择本地文件导入，或到“在线下载”添加</p>\r\n      <div id=\"packages\"></div>\r\n      <details class=\"directory\">\r\n        <summary>从目录扫描导入</summary>\r\n        <div id=\"root\" class=\"meta\">读取中…</div>\r\n        <p>把 ZIP 或已解压语音包放入此目录后扫描。已有音色池、角色绑定和收藏会保留。</p>\r\n        <button id=\"import\" class=\"secondary\" type=\"button\">扫描并导入</button>\r\n      </details>\r\n    </div>\r\n    <section id=\"onlinePanel\" class=\"card\" hidden>\r\n      <div class=\"section-head\"><h2>发现新声音</h2><button id=\"refreshOnline\" class=\"secondary\">刷新</button></div>\r\n      <p>选择语音包，下载后即可使用。</p>\r\n      <div id=\"onlineGroupTabs\" class=\"tabs\"></div>\r\n      <div class=\"online-tools\"><input id=\"onlineFilter\" type=\"search\" placeholder=\"搜索在线语音包\" aria-label=\"搜索在线语音包\"></div>\r\n      <div id=\"onlineStatus\" class=\"meta\" role=\"status\"></div>\r\n      <div id=\"onlineList\"></div>\r\n    </section>\r\n  </section>\r\n</main>\r\n<script>\r\n  const status = document.getElementById('status');\r\n  const importButton = document.getElementById('import');\r\n  const importFilesButton = document.getElementById('importFiles');\r\n  const onlineButton = document.getElementById('onlinePackages');\r\n  const onlinePanel = document.getElementById('onlinePanel');\r\n  const onlineList = document.getElementById('onlineList');\r\n  const onlineStatus = document.getElementById('onlineStatus');\r\n  const onlineGroups = document.getElementById('onlineGroupTabs');\r\n  const onlineFilter = document.getElementById('onlineFilter');\r\n  const refreshOnlineButton = document.getElementById('refreshOnline');\r\n  const testButton = document.getElementById('test');\r\n  const deleteVoiceButton = document.getElementById('deleteVoice');\r\n  const favoriteButton = document.getElementById('favorite');\r\n  const packagesNode = document.getElementById('packages');\r\n  const voiceNode = document.getElementById('voice');\r\n  const voicePickerButton = document.getElementById('voicePickerButton');\r\n  const voicePickerMenu = document.getElementById('voicePickerMenu');\r\n  const voiceFilterNode = document.getElementById('voiceFilter');\r\n  const filterVoiceButton = document.getElementById('filterVoice');\r\n  const voiceSearchSummary = document.getElementById('voiceSearchSummary');\r\n  const voiceModeTabsNode = document.getElementById('voiceModeTabs');\r\n  const packageTabsNode = document.getElementById('packageTabs');\r\n  const categoryTabsNode = document.getElementById('categoryTabs');\r\n  const testStatus = document.getElementById('testStatus');\r\n  const speedNode = document.getElementById('speed');\r\n  const speedValueNode = document.getElementById('speedValue');\r\n  const speedHintNode = document.getElementById('speedHint');\r\n  const resetAllVoiceSpeedsButton = document.getElementById('resetAllVoiceSpeeds');\r\n  const setAllVoiceSpeedsButton = document.getElementById('setAllVoiceSpeeds');\r\n  let busy = false;\r\n  let availableVoices = [];\r\n  let activePackageId = '';\r\n  let activeCategory = '';\r\n  let selectedVoiceId = '';\r\n  let activeVoiceMode = 'all';\r\n  let favoriteVoiceIds = [];\r\n  let deletedVoiceIds = [];\r\n  let voiceSettings = [];\r\n  let allVoiceIds = [];\r\n  let voiceSettingsSaveQueue = Promise.resolve();\r\n  let voiceSearchQuery = '';\r\n  let testRequestSerial = 0;\r\n  let previewPending = false;\r\n  let onlineCatalog = null;\r\n  let onlineCapabilities = null;\r\n  let onlineGroupId = '';\r\n  let onlineInstalledPackages = [];\r\n  let downloadingPackageId = '';\r\n  const ONLINE_BASE = 'https://gitee.com/duckeaty/fishreader_plugin/raw/master/';\r\n  const ONLINE_INDEX = ONLINE_BASE + 'multitts_package/index.json';\r\n  const FAVORITE_VOICE_IDS_KEY = 'multitts.favoriteVoiceIds.v1';\r\n  const DELETED_VOICE_IDS_KEY = 'multitts.deletedVoiceIds.v1';\r\n  const VOICE_SETTINGS_KEY = 'multitts.voiceSettings.v1';\r\n\r\n  function themeCssColor(value) {\r\n    if (typeof value !== 'string') return null;\r\n    if (/^#[0-9a-f]{6}$/i.test(value)) return value;\r\n    // Harmony palettes use #AARRGGBB; CSS uses #RRGGBBAA.\r\n    if (/^#[0-9a-f]{8}$/i.test(value)) return `#${value.slice(3)}${value.slice(1, 3)}`;\r\n    return null;\r\n  }\r\n\r\n  function applyAppTheme() {\r\n    try {\r\n      if (typeof window === 'undefined' || typeof window.FishReaderClub?.getPalette !== 'function') return;\r\n      const palette = JSON.parse(window.FishReaderClub.getPalette());\r\n      if (!palette || typeof palette.darkMode !== 'boolean') return;\r\n      const fields = { '--page': 'page', '--surface': 'surface', '--soft': 'surfaceMuted',\r\n        '--line': 'divider', '--ink': 'primaryText', '--muted': 'secondaryText', '--hint': 'hintText',\r\n        '--accent': 'accent', '--accent-soft': 'accentSoft', '--on-accent': 'onAccent',\r\n        '--nav': 'navigationFill', '--danger': 'danger' };\r\n      for (const [variable, field] of Object.entries(fields)) {\r\n        const value = themeCssColor(palette[field]);\r\n        if (value) document.documentElement.style.setProperty(variable, value);\r\n      }\r\n      document.documentElement.setAttribute('data-color-mode', palette.darkMode ? 'dark' : 'light');\r\n      const meta = document.querySelector?.('meta[name=\"theme-color\"]');\r\n      if (meta && themeCssColor(palette.page)) meta.content = themeCssColor(palette.page);\r\n    } catch (_) { /* A host without the palette bridge keeps the app default preview colors. */ }\r\n  }\r\n\r\n  applyAppTheme();\r\n  if (typeof window !== 'undefined') {\r\n    window.addEventListener('focus', applyAppTheme);\r\n    window.addEventListener('pageshow', applyAppTheme);\r\n    document.addEventListener('visibilitychange', () => { if (!document.hidden) applyAppTheme(); });\r\n  }\r\n\r\n  function showView(view) {\r\n    document.getElementById('voicesView').hidden = view !== 'voices';\r\n    document.getElementById('packagesView').hidden = view !== 'packages';\r\n    document.querySelectorAll('[data-view]').forEach((button) => {\r\n      const active = button.dataset.view === view;\r\n      button.classList.toggle('active', active);\r\n      button.setAttribute('aria-pressed', String(active));\r\n    });\r\n    closeVoicePicker();\r\n  }\r\n\r\n  function showPackageMode(online) {\r\n    document.getElementById('localPanel').hidden = online;\r\n    onlinePanel.hidden = !online;\r\n    const installedButton = document.getElementById('installedPackages');\r\n    installedButton.classList.toggle('active', !online);\r\n    installedButton.setAttribute('aria-pressed', String(!online));\r\n    onlineButton.classList.toggle('active', online);\r\n    onlineButton.setAttribute('aria-pressed', String(online));\r\n  }\r\n\r\n  function renderCurrentVoice() {\r\n    const selected = availableVoices.find((voice) => voice.id === selectedVoiceId);\r\n    document.getElementById('currentVoiceName').textContent = selected?.name || '还没有选择音色';\r\n    document.getElementById('currentVoiceMeta').textContent = selected ?\r\n      [selected.packageName, selected.group, selected.locale].filter(Boolean).join(' · ') :\r\n      availableVoices.length ? '从下方选择一个声音，立即用于朗读' : '先添加一个语音包，开始试听';\r\n    document.getElementById('emptyPackageAction').hidden = availableVoices.length > 0;\r\n    document.getElementById('voiceCount').textContent = `${visibleModeVoices().length} 个音色`;\r\n    const preview = availableVoices.find((voice) => voice.id === voiceNode.value);\r\n    document.getElementById('previewVoiceName').textContent = preview?.name || '尚未选择音色';\r\n    renderPreviewSettings();\r\n  }\r\n\r\n  function renderPreviewSettings() {\r\n    document.getElementById('previewSettings').textContent =\r\n      `${Number(speedNode.value).toFixed(1)} 倍语速`;\r\n  }\r\n\r\n  function escapeHtml(value) {\r\n    return String(value ?? '').replace(/[&<>\"']/g, (char) => ({\r\n      '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\r\n    })[char]);\r\n  }\r\n\r\n  function setBusy(value, message = '') {\r\n    busy = value;\r\n    importButton.disabled = value;\r\n    importFilesButton.disabled = value;\r\n    onlineButton.disabled = value;\r\n    refreshOnlineButton.disabled = value;\r\n    if (onlineCatalog) renderOnlinePackages();\r\n    testButton.disabled = value || previewPending || !voiceNode.value;\r\n    favoriteButton.disabled = value || !voiceNode.value;\r\n    deleteVoiceButton.disabled = value || !voiceNode.value;\r\n    voicePickerButton.disabled = value || !voiceNode.value;\r\n    updateSpeedActions();\r\n    if (message) status.textContent = message;\r\n  }\r\n\r\n  function bindRange(input, output) {\r\n    const update = () => { output.textContent = Number(input.value).toFixed(1); renderPreviewSettings(); };\r\n    input.addEventListener('input', update);\r\n    input.addEventListener('change', () => { void saveCurrentVoiceSettings(); });\r\n    update();\r\n  }\r\n\r\n  function normalizeSetting(value, minimum, maximum, fallback = 1) {\r\n    const parsed = Number(value);\r\n    return Number.isFinite(parsed) ? Math.max(minimum, Math.min(maximum, parsed)) : fallback;\r\n  }\r\n\r\n  function normalizeVoiceSettings(value) {\r\n    if (!Array.isArray(value)) return [];\r\n    const normalized = [];\r\n    value.forEach((item) => {\r\n      if (!item || typeof item !== 'object' || typeof item.voiceId !== 'string' || !item.voiceId) return;\r\n      const record = {\r\n        voiceId: item.voiceId,\r\n        speed: normalizeSetting(item.speed, 0.1, 3.0),\r\n        pitch: 1\r\n      };\r\n      const existing = normalized.findIndex((entry) => entry.voiceId === record.voiceId);\r\n      if (existing >= 0) normalized[existing] = record;\r\n      else normalized.push(record);\r\n    });\r\n    return normalized;\r\n  }\r\n\r\n  function applyVoiceSettings(voiceId) {\r\n    const selected = availableVoices.find((voice) => voice.id === voiceId);\r\n    const supportsSpeed = selected?.supportsSpeed === true;\r\n    const saved = voiceSettings.find((item) => item.voiceId === voiceId);\r\n    speedNode.disabled = busy || !supportsSpeed;\r\n    speedNode.value = supportsSpeed ? normalizeSetting(saved?.speed, 0.1, 3.0).toFixed(1) : '1.0';\r\n    speedValueNode.textContent = Number(speedNode.value).toFixed(1);\r\n    speedHintNode.textContent = supportsSpeed ?\r\n      '语速是当前音色默认语速的倍率；1.0 保持语音包定义的默认速度。' :\r\n      '当前应用未开放此音色的音频调速，请更新应用。';\r\n    updateSpeedActions();\r\n  }\r\n\r\n  function updateSpeedActions() {\r\n    const supportsSpeed = availableVoices.find((voice) => voice.id === voiceNode.value)?.supportsSpeed === true;\r\n    speedNode.disabled = busy || !supportsSpeed;\r\n    resetAllVoiceSpeedsButton.disabled = busy || !allVoiceIds.length;\r\n    setAllVoiceSpeedsButton.disabled = busy || !allVoiceIds.length || !supportsSpeed;\r\n  }\r\n\r\n  async function setAllVoiceSpeeds(reset) {\r\n    if (busy || !allVoiceIds.length || (!reset && speedNode.disabled)) return;\r\n    const speed = reset ? 1 : normalizeSetting(speedNode.value, 0.1, 3.0);\r\n    const ids = [...allVoiceIds];\r\n    const question = reset ? `将全部 ${ids.length} 个音色的语速重置为默认的 1.0 倍？这会覆盖各音色已保存的语速。` :\r\n      `将全部 ${ids.length} 个音色的语速设置为当前滑杆的 ${speed.toFixed(1)} 倍？这会覆盖各音色已保存的语速。`;\r\n    if (!confirm(question)) return;\r\n    setBusy(true, reset ? '正在重置所有音色的语速…' : '正在设置所有音色的语速…');\r\n    try {\r\n      await voiceSettingsSaveQueue;\r\n      const updated = ids.map((voiceId) => ({ voiceId, speed, pitch: 1 }));\r\n      await FishReader.storage.set(VOICE_SETTINGS_KEY, updated);\r\n      voiceSettings = updated;\r\n      applyVoiceSettings(voiceNode.value);\r\n      renderPreviewSettings();\r\n      status.textContent = `已${reset ? '重置' : '设置'}全部 ${ids.length} 个音色的语速为 ${speed.toFixed(1)} 倍。`;\r\n    } catch (error) {\r\n      status.textContent = `批量语速保存失败：${error.message || error}`;\r\n    } finally { setBusy(false); }\r\n  }\r\n\r\n  async function saveCurrentVoiceSettings() {\r\n    const voiceId = voiceNode.value;\r\n    if (busy || !voiceId) return;\r\n    const selected = availableVoices.find((voice) => voice.id === voiceId);\r\n    const supportsSpeed = selected?.supportsSpeed === true;\r\n    const record = {\r\n      voiceId,\r\n      speed: supportsSpeed ? normalizeSetting(speedNode.value, 0.1, 3.0) : 1,\r\n      pitch: 1\r\n    };\r\n    const saving = voiceSettingsSaveQueue.then(() => FishReader.tts.saveVoiceSettings(voiceId, record.speed, record.pitch));\r\n    voiceSettingsSaveQueue = saving.catch(() => {});\r\n    try {\r\n      await saving;\r\n      voiceSettings = voiceSettings.filter((item) => item.voiceId !== voiceId);\r\n      voiceSettings.push(record);\r\n      status.textContent = selected ?\r\n        `已保存 ${selected.name} 的语速 ${record.speed.toFixed(1)} 倍。` :\r\n        '当前音色的语速已保存。';\r\n    } catch (error) {\r\n      status.textContent = `语音设置保存失败：${error.message || error}`;\r\n    }\r\n  }\r\n\r\n  function voiceCategory(voice, hasCategories) {\r\n    if (!hasCategories) return '';\r\n    return voice.group || '其他';\r\n  }\r\n\r\n  function visibleModeVoices() {\r\n    const deleted = new Set(deletedVoiceIds);\r\n    if (activeVoiceMode === 'deleted') {\r\n      return availableVoices.filter((voice) => deleted.has(voice.id));\r\n    }\r\n    const activeVoices = availableVoices.filter((voice) => !deleted.has(voice.id));\r\n    if (activeVoiceMode !== 'favorites') return activeVoices;\r\n    const favorites = new Set(favoriteVoiceIds);\r\n    return activeVoices.filter((voice) => favorites.has(voice.id));\r\n  }\r\n\r\n  function searchMatchedVoices() {\r\n    const voices = visibleModeVoices();\r\n    if (!voiceSearchQuery) return voices;\r\n    return voices.filter((voice) =>\r\n      [voice.name, voice.group, voice.packageName, voice.description, voice.locale]\r\n        .some((value) => String(value || '').toLocaleLowerCase().includes(voiceSearchQuery)));\r\n  }\r\n\r\n  function updateFavoriteButton() {\r\n    const voiceId = voiceNode.value;\r\n    const isFavorite = favoriteVoiceIds.includes(voiceId);\r\n    favoriteButton.textContent = isFavorite ? '取消收藏' : '收藏音色';\r\n    favoriteButton.disabled = busy || !voiceId;\r\n  }\r\n\r\n  function updateDeleteVoiceButton() {\r\n    const restoring = activeVoiceMode === 'deleted';\r\n    deleteVoiceButton.textContent = restoring ? '恢复' : '删除';\r\n    deleteVoiceButton.classList.toggle('danger', !restoring);\r\n    deleteVoiceButton.classList.toggle('secondary', restoring);\r\n    deleteVoiceButton.disabled = busy || !voiceNode.value;\r\n  }\r\n\r\n  function locateFiltersForVoice(voiceId, voices = searchMatchedVoices()) {\r\n    const selected = voices.find((voice) => voice.id === voiceId);\r\n    if (!selected) return false;\r\n    activePackageId = selected.packageId;\r\n    activeCategory = selected.group || '';\r\n    return true;\r\n  }\r\n\r\n  function renderVoiceOptions(selectFirst = false) {\r\n    const searching = voiceSearchQuery.length > 0;\r\n    const matchedVoices = searchMatchedVoices();\r\n    const packageVoices = searching ? matchedVoices :\r\n      matchedVoices.filter((voice) => voice.packageId === activePackageId);\r\n    const explicitCategories = [...new Set(packageVoices.map((voice) => voice.group).filter(Boolean))];\r\n    const hasCategories = explicitCategories.length > 0;\r\n    const categories = hasCategories ?\r\n      [...new Set(packageVoices.map((voice) => voice.group || '其他'))] : [];\r\n    if (activeCategory && !categories.includes(activeCategory)) activeCategory = '';\r\n    categoryTabsNode.style.display = !searching && categories.length > 0 ? 'flex' : 'none';\r\n    categoryTabsNode.innerHTML = categories.length === 0 ? '' :\r\n      [`<button class=\"tab sub ${activeCategory === '' ? 'active' : ''}\" data-category=\"\">全部</button>`]\r\n        .concat(categories.map((category) =>\r\n          `<button class=\"tab sub ${activeCategory === category ? 'active' : ''}\" ` +\r\n          `data-category=\"${escapeHtml(category)}\">${escapeHtml(category)}</button>`)).join('');\r\n    categoryTabsNode.querySelectorAll('.tab').forEach((button) => {\r\n      button.addEventListener('click', () => {\r\n        activeCategory = button.dataset.category || '';\r\n        renderVoiceOptions(true);\r\n      });\r\n    });\r\n    const filtered = packageVoices.filter((voice) =>\r\n      searching || !activeCategory || voiceCategory(voice, hasCategories) === activeCategory);\r\n    voiceSearchSummary.hidden = !searching;\r\n    voiceSearchSummary.textContent = searching ? `找到 ${filtered.length} 个匹配音色` : '';\r\n    const voiceLabel = (voice) => {\r\n      const origin = searching ? [voice.packageName, voice.group].filter(Boolean).join(' · ') : '';\r\n      return `${voice.name}${origin ? `（${origin}）` : ''}`;\r\n    };\r\n    const selectedVisible = filtered.some((voice) => voice.id === selectedVoiceId);\r\n    const targetVoiceId = selectedVisible ? selectedVoiceId : (filtered[0]?.id || '');\r\n    voiceNode.innerHTML = filtered.length > 0 ? filtered.map((voice, index) =>\r\n      `<option value=\"${escapeHtml(voice.id)}\"${voice.id === targetVoiceId ? ' selected' : ''}>${escapeHtml(voiceLabel(voice, index))}</option>`).join('') :\r\n      `<option value=\"\">${voiceSearchQuery ? '未找到匹配音色' :\r\n        (activeVoiceMode === 'favorites' ? '暂无收藏音色' :\r\n          (activeVoiceMode === 'deleted' ? '暂无已删除音色' : '暂无可用音色'))}</option>`;\r\n    voiceNode.value = targetVoiceId;\r\n    applyVoiceSettings(targetVoiceId);\r\n    voicePickerMenu.innerHTML = filtered.map((voice, index) => {\r\n      const active = voice.id === targetVoiceId;\r\n      return `<button class=\"voice-picker-option${active ? ' active' : ''}\" type=\"button\" role=\"option\" ` +\r\n        `aria-selected=\"${active ? 'true' : 'false'}\" data-value=\"${escapeHtml(voice.id)}\">` +\r\n        `${escapeHtml(voiceLabel(voice, index))}</button>`;\r\n    }).join('');\r\n    const targetIndex = filtered.findIndex((voice) => voice.id === targetVoiceId);\r\n    voicePickerButton.textContent = targetIndex >= 0 ?\r\n      voiceLabel(filtered[targetIndex], targetIndex) :\r\n      (voiceSearchQuery ? '未找到匹配音色' :\r\n        (activeVoiceMode === 'favorites' ? '暂无收藏音色' :\r\n          (activeVoiceMode === 'deleted' ? '暂无已删除音色' : '暂无可用音色')));\r\n    voicePickerMenu.querySelectorAll('.voice-picker-option').forEach((option) => {\r\n      option.addEventListener('click', () => {\r\n        const voiceId = option.dataset.value || '';\r\n        voiceNode.value = voiceId;\r\n        closeVoicePicker();\r\n        if (activeVoiceMode === 'deleted') {\r\n          renderVoiceOptions(false);\r\n          return;\r\n        }\r\n        void selectVoice(voiceId);\r\n      });\r\n    });\r\n    if (!selectedVisible && filtered.length > 0) {\r\n      if (selectFirst && activeVoiceMode !== 'deleted') void selectVoice(filtered[0].id);\r\n    }\r\n    voiceNode.disabled = filtered.length === 0;\r\n    voicePickerButton.disabled = busy || filtered.length === 0;\r\n    testButton.disabled = busy || previewPending || filtered.length === 0;\r\n    updateFavoriteButton();\r\n    updateDeleteVoiceButton();\r\n    renderCurrentVoice();\r\n  }\r\n\r\n  function locateSelectedVoiceOption() {\r\n    const targetVoiceId = voiceNode.value || selectedVoiceId;\r\n    const options = Array.from(voicePickerMenu.querySelectorAll('.voice-picker-option'));\r\n    const target = options.find((option) => option.dataset.value === targetVoiceId);\r\n    if (!target) return;\r\n    voicePickerMenu.scrollTop = Math.max(0,\r\n      target.offsetTop - (voicePickerMenu.clientHeight - target.offsetHeight) / 2);\r\n  }\r\n\r\n  function closeVoicePicker() {\r\n    voicePickerMenu.hidden = true;\r\n    voicePickerButton.setAttribute('aria-expanded', 'false');\r\n  }\r\n\r\n  function openVoicePicker() {\r\n    if (voicePickerButton.disabled) return;\r\n    voicePickerMenu.hidden = false;\r\n    voicePickerButton.setAttribute('aria-expanded', 'true');\r\n    requestAnimationFrame(locateSelectedVoiceOption);\r\n  }\r\n\r\n  function renderVoiceFilters(snapshot) {\r\n    availableVoices = (snapshot.voices || []).filter((voice) => voice.available);\r\n    selectedVoiceId = snapshot.selectedVoiceId || '';\r\n    const modeVoices = searchMatchedVoices();\r\n    const packageMap = new Map();\r\n    modeVoices.forEach((voice) => packageMap.set(voice.packageId, voice.packageName));\r\n    packageTabsNode.style.display = voiceSearchQuery ? 'none' : 'flex';\r\n    if (!voiceSearchQuery) locateFiltersForVoice(selectedVoiceId, modeVoices);\r\n    if (!packageMap.has(activePackageId)) activePackageId = packageMap.keys().next().value || '';\r\n    packageTabsNode.innerHTML = [...packageMap.entries()].map(([id, name]) =>\r\n      `<button class=\"tab ${activePackageId === id ? 'active' : ''}\" data-package=\"${escapeHtml(id)}\">` +\r\n      `${escapeHtml(name)}</button>`).join('');\r\n    packageTabsNode.querySelectorAll('.tab').forEach((button) => {\r\n      button.addEventListener('click', () => {\r\n        activePackageId = button.dataset.package || '';\r\n        activeCategory = '';\r\n        packageTabsNode.querySelectorAll('.tab').forEach((item) =>\r\n          item.classList.toggle('active', item === button));\r\n        renderVoiceOptions(true);\r\n      });\r\n    });\r\n    renderVoiceOptions(false);\r\n    voiceModeTabsNode.querySelectorAll('.tab').forEach((button) =>\r\n      button.classList.toggle('active', button.dataset.mode === activeVoiceMode));\r\n  }\r\n\r\n  async function selectVoice(voiceId) {\r\n    if (!voiceId) return;\r\n    try {\r\n      await FishReader.tts.selectVoice(voiceId);\r\n      selectedVoiceId = voiceId;\r\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\r\n      if (selected) {\r\n        activePackageId = selected.packageId;\r\n        activeCategory = selected.group || '';\r\n        renderVoiceOptions(false);\r\n      }\r\n      status.textContent = selected ? `已选择音色：${selected.packageName} · ${selected.name}` : '已选择音色。';\r\n    } catch (error) {\r\n      status.textContent = `选择音色失败：${error.message || error}`;\r\n    }\r\n  }\r\n\r\n  function render(snapshot) {\r\n    onlineInstalledPackages = snapshot.packages || [];\r\n    if (onlineCatalog) renderOnlinePackages();\r\n    document.getElementById('root').textContent = snapshot.rootDirectory || 'TTS_packages';\r\n    renderVoiceFilters(snapshot);\r\n\r\n    const packages = snapshot.packages || [];\r\n    document.getElementById('installedCount').textContent = String(packages.length);\r\n    document.getElementById('empty').style.display = packages.length === 0 ? 'block' : 'none';\r\n    packagesNode.innerHTML = packages.map((item) => {\r\n      const engines = (item.engines || []).map((engine) => {\r\n        const ready = engine.availability === 'ready';\r\n        return `<div class=\"reason\"><span class=\"${ready ? 'ready' : 'blocked'}\">` +\r\n          `${ready ? '可用' : '需要适配'} · ${escapeHtml(engine.name || engine.code)}</span><br>` +\r\n          `${escapeHtml(engine.reason)}</div>`;\r\n      }).join('');\r\n      const usable = availableVoices.some((voice) => voice.packageId === item.id && !deletedVoiceIds.includes(voice.id));\r\n      return `<section class=\"card\"><div class=\"row\"><div class=\"grow\">` +\r\n        `<div class=\"title\">${escapeHtml(item.name)}</div>` +\r\n        `<div class=\"meta\"><span class=\"package-count\">${item.voiceCount} 个音色</span></div></div></div>` +\r\n        `<div class=\"row\" style=\"margin-top:12px\"><button class=\"secondary\" data-use-package=\"${escapeHtml(item.id)}\"${usable ? '' : ' disabled'}>选择音色</button>` +\r\n        `<button class=\"danger remove\" data-id=\"${escapeHtml(item.id)}\" data-name=\"${escapeHtml(item.name)}\">删除</button>` +\r\n        `</div><details class=\"engine-list\"><summary>查看引擎状态</summary>${engines}</details></section>`;\r\n    }).join('');\r\n    document.querySelectorAll('.remove').forEach((button) => {\r\n      button.addEventListener('click', () => removePackage(button.dataset.id, button.dataset.name));\r\n    });\r\n    document.querySelectorAll('[data-use-package]').forEach((button) => {\r\n      button.addEventListener('click', (event) => {\r\n        event.stopPropagation();\r\n        void usePackageVoices(button.dataset.usePackage || '');\r\n      });\r\n    });\r\n  }\r\n\r\n  async function usePackageVoices(packageId) {\r\n    if (busy) return;\r\n    const voice = availableVoices.find((voice) => voice.packageId === packageId && !deletedVoiceIds.includes(voice.id));\r\n    if (!voice) return;\r\n    voiceSearchQuery = '';\r\n    voiceFilterNode.value = '';\r\n    activeVoiceMode = 'all';\r\n    await selectVoice(voice.id);\r\n    renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\r\n    showView('voices');\r\n    openVoicePicker();\r\n  }\r\n\r\n  async function refresh() {\r\n    const snapshot = await FishReader.tts.snapshot();\r\n    const availableIds = new Set((snapshot.voices || []).map((voice) => voice.id));\r\n    allVoiceIds = [...availableIds];\r\n    const cleanedFavorites = favoriteVoiceIds.filter((id) => availableIds.has(id));\r\n    if (cleanedFavorites.length !== favoriteVoiceIds.length) {\r\n      favoriteVoiceIds = cleanedFavorites;\r\n      await FishReader.storage.set(FAVORITE_VOICE_IDS_KEY, favoriteVoiceIds);\r\n    }\r\n    const cleanedDeleted = deletedVoiceIds.filter((id) => availableIds.has(id));\r\n    if (cleanedDeleted.length !== deletedVoiceIds.length) {\r\n      deletedVoiceIds = cleanedDeleted;\r\n      await FishReader.storage.set(DELETED_VOICE_IDS_KEY, deletedVoiceIds);\r\n    }\r\n    const cleanedSettings = voiceSettings.filter((item) => availableIds.has(item.voiceId));\r\n    if (cleanedSettings.length !== voiceSettings.length) {\r\n      voiceSettings = cleanedSettings;\r\n      await FishReader.storage.set(VOICE_SETTINGS_KEY, voiceSettings);\r\n    }\r\n    render(snapshot);\r\n  }\r\n\r\n  async function toggleFavorite() {\r\n    const voiceId = voiceNode.value;\r\n    if (busy || !voiceId) return;\r\n    try {\r\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\r\n      const favorites = new Set(favoriteVoiceIds);\r\n      const removing = favorites.has(voiceId);\r\n      if (removing) favorites.delete(voiceId);\r\n      else favorites.add(voiceId);\r\n      favoriteVoiceIds = [...favorites];\r\n      await FishReader.storage.set(FAVORITE_VOICE_IDS_KEY, favoriteVoiceIds);\r\n      status.textContent = selected ?\r\n        `${removing ? '已取消收藏' : '已收藏'}音色：${selected.packageName} · ${selected.name}` :\r\n        (removing ? '已取消收藏音色。' : '已收藏音色。');\r\n      if (activeVoiceMode === 'favorites') renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\r\n      else updateFavoriteButton();\r\n    } catch (error) {\r\n      status.textContent = `收藏操作失败：${error.message || error}`;\r\n    }\r\n  }\r\n\r\n  async function toggleDeletedVoice() {\r\n    const voiceId = voiceNode.value;\r\n    if (busy || !voiceId) return;\r\n    try {\r\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\r\n      const deleted = new Set(deletedVoiceIds);\r\n      const restoring = activeVoiceMode === 'deleted' || deleted.has(voiceId);\r\n      if (restoring) deleted.delete(voiceId);\r\n      else deleted.add(voiceId);\r\n      deletedVoiceIds = [...deleted];\r\n      await FishReader.storage.set(DELETED_VOICE_IDS_KEY, deletedVoiceIds);\r\n      let switched = false;\r\n      if (!restoring && voiceId === selectedVoiceId) {\r\n        const replacement = availableVoices.find((voice) => !deleted.has(voice.id));\r\n        if (replacement) {\r\n          await FishReader.tts.selectVoice(replacement.id);\r\n          selectedVoiceId = replacement.id;\r\n          switched = true;\r\n        }\r\n      }\r\n      status.textContent = selected ?\r\n        `${restoring ? '已恢复' : '已删除'}音色：${selected.packageName} · ${selected.name}` +\r\n          (switched ? '，并已切换到下一可用音色。' : '。') :\r\n        (restoring ? '已恢复音色。' : '已删除音色。');\r\n      activePackageId = '';\r\n      activeCategory = '';\r\n      renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\r\n    } catch (error) {\r\n      status.textContent = `${activeVoiceMode === 'deleted' ? '恢复' : '删除'}音色失败：${error.message || error}`;\r\n    }\r\n  }\r\n\r\n  function switchVoiceMode(mode) {\r\n    if (mode !== 'all' && mode !== 'favorites' && mode !== 'deleted') return;\r\n    activeVoiceMode = mode;\r\n    activePackageId = '';\r\n    activeCategory = '';\r\n    renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\r\n  }\r\n\r\n  function filterVoices() {\r\n    closeVoicePicker();\r\n    voiceSearchQuery = voiceFilterNode.value.trim().toLocaleLowerCase();\r\n    activePackageId = '';\r\n    activeCategory = '';\r\n    renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\r\n    if (voiceSearchQuery) openVoicePicker();\r\n  }\r\n\r\n  function validateOnlineCatalog(value) {\r\n    if (!value || value.schemaVersion !== 1 || !Array.isArray(value.groups) || !Array.isArray(value.packages) ||\r\n      value.groups.length > 32 || value.packages.length > 256) throw new Error('在线语音包列表格式无效');\r\n    const groups = new Set();\r\n    value.groups.forEach((group) => {\r\n      if (!group || typeof group.id !== 'string' || !group.id || groups.has(group.id) ||\r\n        typeof group.name !== 'string' || group.name.length > 128) throw new Error('语音包分组无效');\r\n      groups.add(group.id);\r\n    });\r\n    const ids = new Set();\r\n    value.packages.forEach((item) => {\r\n      if (!item || typeof item.id !== 'string' || !item.id || ids.has(item.id) || !groups.has(item.groupId) ||\r\n        typeof item.name !== 'string' || item.name.length > 240 || typeof item.installName !== 'string' ||\r\n        !/\\.zip$/i.test(item.installName) || /[\\\\/\\x00-\\x1f]/.test(item.installName) ||\r\n        typeof item.path !== 'string' || !item.path.startsWith('multitts_package/') ||\r\n        /[\\\\\\x00-\\x1f?#]/.test(item.path) || item.path.split('/').some((part) => !part || part === '.' || part === '..') ||\r\n        !Number.isSafeInteger(item.size) || item.size < 4 || item.size > 64 * 1024 * 1024 ||\r\n        !/^[a-f0-9]{64}$/.test(item.sha256) || !Number.isSafeInteger(item.voiceCount) || item.voiceCount < 0 ||\r\n        !Array.isArray(item.engines) || !item.engines.length || item.engines.some((engine) =>\r\n          !engine || typeof engine.code !== 'string' || !['inner', 'http'].includes(engine.type))) {\r\n        throw new Error('在线语音包条目无效');\r\n      }\r\n      ids.add(item.id);\r\n      if (item.parts !== undefined && (!Array.isArray(item.parts) || item.parts.length < 1 || item.parts.length > 128 ||\r\n        item.parts.some((part) => !part || typeof part.path !== 'string' || !part.path.startsWith('multitts_package/.parts/') ||\r\n          /[\\\\\\x00-\\x1f?#]/.test(part.path) || part.path.split('/').some((p) => !p || p === '.' || p === '..') ||\r\n          !Number.isSafeInteger(part.size) || part.size < 1 || part.size > 10 * 1024 * 1024 ||\r\n          !/^[a-f0-9]{64}$/.test(part.sha256)) || item.parts.reduce((total, part) => total + part.size, 0) !== item.size)) {\r\n        throw new Error('在线语音包分片无效');\r\n      }\r\n    });\r\n    return value;\r\n  }\r\n\r\n  function onlineDownloadSupported() {\r\n    return onlineCapabilities?.downloadImport === true && typeof FishReader.ttsPackages?.download === 'function';\r\n  }\r\n\r\n  function normalizedPackageName(value) {\r\n    return String(value || '').normalize('NFKC').trim().replace(/\\.zip$/i, '')\r\n      .replace(/^(?:【在线】|\\[在线\\])\\s*/, '').replace(/_\\d{13}$/, '')\r\n      .replace(/\\s*\\(\\d+\\)$/, '').replace(/\\s+/g, '').toLocaleLowerCase();\r\n  }\r\n\r\n  function onlinePackageInstalled(item) {\r\n    const names = new Set([item.name, item.fileName, item.installName].map(normalizedPackageName));\r\n    const engines = item.engines.map((engine) => engine.code).sort().join('\\n');\r\n    return onlineInstalledPackages.some((installed) => names.has(normalizedPackageName(installed.name)) &&\r\n      installed.voiceCount === item.voiceCount &&\r\n      (installed.engines || []).map((engine) => engine.code).sort().join('\\n') === engines);\r\n  }\r\n\r\n  function renderOnlinePackages() {\r\n    if (!onlineCatalog) return;\r\n    const groups = [{ id: '', name: '全部' }, ...onlineCatalog.groups];\r\n    onlineGroups.innerHTML = groups.map((group) => `<button class=\"tab ${onlineGroupId === group.id ? 'active' : ''}\" ` +\r\n      `data-online-group=\"${escapeHtml(group.id)}\">${escapeHtml(group.name)}</button>`).join('');\r\n    onlineGroups.querySelectorAll('[data-online-group]').forEach((button) => button.addEventListener('click', () => {\r\n      onlineGroupId = button.dataset.onlineGroup || ''; renderOnlinePackages();\r\n    }));\r\n    const query = onlineFilter.value.trim().toLocaleLowerCase();\r\n    const rows = onlineCatalog.packages.filter((item) => (!onlineGroupId || item.groupId === onlineGroupId) &&\r\n      item.name.toLocaleLowerCase().includes(query));\r\n    onlineStatus.textContent = `${rows.length} 个语音包` +\r\n      (onlineDownloadSupported() ? '' : ' · 请更新鱼书应用后使用下载导入功能');\r\n    const supported = new Set(onlineCapabilities?.onlineEngines || []);\r\n    onlineList.innerHTML = rows.map((item) => {\r\n      const ready = item.engines.every((engine) => engine.type === 'http' || supported.has(engine.code));\r\n      const installed = onlinePackageInstalled(item);\r\n      const group = onlineCatalog.groups.find((group) => group.id === item.groupId)?.name || '';\r\n      const label = item.size < 1024 * 1024 ? `${Math.max(1, Math.round(item.size / 1024))} KB` :\r\n        `${(item.size / 1024 / 1024).toFixed(1)} MB`;\r\n      return `<div class=\"online-item\"><div class=\"grow\"><div class=\"title\">${escapeHtml(item.name)}</div>` +\r\n        `<div class=\"meta\">${escapeHtml(group)} · ${item.voiceCount} 个音色 · ${label}</div>` +\r\n        (!ready && onlineDownloadSupported() ? '<div class=\"reason\">当前应用尚未提供此包需要的语音引擎</div>' : '') +\r\n        `</div><button data-online-package=\"${escapeHtml(item.id)}\"${busy || installed || !ready || !onlineDownloadSupported() ? ' disabled' : ''}>` +\r\n        `${downloadingPackageId === item.id ? '下载中…' : installed ? '已导入' : !ready && onlineDownloadSupported() ? '暂不支持' : '下载并导入'}</button></div>`;\r\n    }).join('') || '<p>未找到匹配语音包</p>';\r\n    onlineList.querySelectorAll('[data-online-package]').forEach((button) => button.addEventListener('click', () => {\r\n      void downloadOnlinePackage(button.dataset.onlinePackage || '');\r\n    }));\r\n  }\r\n\r\n  async function loadOnlinePackages() {\r\n    if (busy) return;\r\n    showView('packages');\r\n    showPackageMode(true);\r\n    setBusy(true, '正在获取在线语音包列表…');\r\n    try {\r\n      onlineCapabilities = typeof FishReader.ttsPackages?.capabilities === 'function' ?\r\n        await FishReader.ttsPackages.capabilities() : null;\r\n      const response = await FishReader.http.fetch({ url: ONLINE_INDEX, method: 'GET', responseType: 'text',\r\n        timeoutMs: 30000, headers: { Accept: 'application/json', 'Cache-Control': 'no-cache' } });\r\n      if (!response || response.status < 200 || response.status >= 300) throw new Error(`HTTP ${response?.status || '请求失败'}`);\r\n      if (typeof response.body !== 'string' || response.body.length > 1024 * 1024) throw new Error('在线列表内容无效');\r\n      onlineCatalog = validateOnlineCatalog(JSON.parse(response.body));\r\n      renderOnlinePackages();\r\n      status.textContent = '在线语音包列表已更新。';\r\n    } catch (error) { onlineStatus.textContent = `列表加载失败：${error.message || error}`; status.textContent = onlineStatus.textContent; }\r\n    finally { setBusy(false); }\r\n  }\r\n\r\n  async function downloadOnlinePackage(id) {\r\n    if (busy || !onlineDownloadSupported()) return;\r\n    const item = onlineCatalog?.packages.find((item) => item.id === id);\r\n    if (!item || onlinePackageInstalled(item)) return;\r\n    const supported = new Set(onlineCapabilities.onlineEngines || []);\r\n    if (!item.engines.every((engine) => engine.type === 'http' || supported.has(engine.code))) return;\r\n    downloadingPackageId = id;\r\n    setBusy(true, `正在下载并导入 ${item.name}，请保持本页打开…`);\r\n    try {\r\n      const url = ONLINE_BASE + item.path.split('/').map(encodeURIComponent).join('/');\r\n      const parts = item.parts?.map((part) => ({\r\n        url: ONLINE_BASE + part.path.split('/').map(encodeURIComponent).join('/'), size: part.size, sha256: part.sha256\r\n      }));\r\n      const result = await FishReader.ttsPackages.download({ url, name: item.installName, size: item.size,\r\n        sha256: item.sha256, parts, categoryId: 'default' });\r\n      await refresh();\r\n      status.textContent = result.message || '语音包已导入，可在语音选择中选择音色。';\r\n    } catch (error) { status.textContent = `下载导入失败：${error.message || error}`; }\r\n    finally { downloadingPackageId = ''; setBusy(false); }\r\n  }\r\n\r\n  async function importPackage() {\r\n    if (busy) return;\r\n    setBusy(true, '正在扫描 TTS_packages 并导入语音包…');\r\n    try {\r\n      const result = await FishReader.tts.importPackage();\r\n      status.textContent = result.message || `已导入 ${result.name}，共 ${result.voiceCount} 个音色。`;\r\n      await refresh();\r\n    } catch (error) {\r\n      status.textContent = `导入失败：${error.message || error}`;\r\n    } finally {\r\n      setBusy(false);\r\n    }\r\n  }\r\n\r\n  async function importFiles() {\r\n    if (busy) return;\r\n    if (!FishReader.tts || typeof FishReader.tts.importFiles !== 'function') {\r\n      status.textContent = '当前应用不支持多文件语音包导入，请升级应用后使用。';\r\n      return;\r\n    }\r\n    setBusy(true, '请选择语音包文件，一次最多 200 个；导入期间请保持本页打开…');\r\n    try {\r\n      const result = await FishReader.tts.importFiles();\r\n      status.textContent = result.message || '文件导入完成';\r\n      if (Array.isArray(result.errors) && result.errors.length) status.textContent += '\\n' + result.errors.join('\\n');\r\n      await refresh();\r\n    } catch (error) {\r\n      status.textContent = `文件导入失败：${error.message || error}`;\r\n    } finally { setBusy(false); }\r\n  }\r\n\r\n  async function removePackage(packageId, name) {\r\n    if (busy || !confirm(`删除“${name}”？语音包文件会从 TTS_packages 中移除。`)) return;\r\n    setBusy(true, '正在删除语音包…');\r\n    try {\r\n      await FishReader.tts.removePackage(packageId);\r\n      status.textContent = `已删除 ${name}。`;\r\n      await refresh();\r\n    } catch (error) {\r\n      status.textContent = `删除失败：${error.message || error}`;\r\n    } finally {\r\n      setBusy(false);\r\n    }\r\n  }\r\n\r\n  async function testVoice() {\r\n    if (busy || previewPending || !voiceNode.value) return;\r\n    const text = document.getElementById('testText').value.trim();\r\n    if (!text) { testStatus.textContent = '请输入测试文字。'; return; }\r\n    const requestSerial = ++testRequestSerial;\r\n    const voiceId = voiceNode.value;\r\n    previewPending = true;\r\n    testButton.disabled = true;\r\n    document.getElementById('testLabel').textContent = '生成中…';\r\n    testStatus.textContent = '正在生成试听…';\r\n    try {\r\n      const result = await FishReader.tts.testVoice(voiceId, text,\r\n        Number(speedNode.value), 1);\r\n      if (requestSerial !== testRequestSerial) return;\r\n      testStatus.textContent = '正在播放试听，可继续切换音色或调整声音。';\r\n    } catch (error) {\r\n      if (requestSerial !== testRequestSerial) return;\r\n      testStatus.textContent = `合成失败：${error.message || error}`;\r\n    } finally {\r\n      if (requestSerial === testRequestSerial) {\r\n        previewPending = false;\r\n        document.getElementById('testLabel').textContent = '试听';\r\n        testButton.disabled = busy || !voiceNode.value;\r\n      }\r\n    }\r\n  }\r\n\r\n  importButton.addEventListener('click', importPackage);\r\n  document.querySelectorAll('[data-view]').forEach((button) => {\r\n    button.addEventListener('click', () => showView(button.dataset.view));\r\n  });\r\n  document.querySelectorAll('[data-open-packages]').forEach((button) => {\r\n    button.addEventListener('click', () => { showView('packages'); showPackageMode(false); });\r\n  });\r\n  document.getElementById('installedPackages').addEventListener('click', () => showPackageMode(false));\r\n  importFilesButton.addEventListener('click', importFiles);\r\n  onlineButton.addEventListener('click', loadOnlinePackages);\r\n  refreshOnlineButton.addEventListener('click', loadOnlinePackages);\r\n  onlineFilter.addEventListener('input', renderOnlinePackages);\r\n  testButton.addEventListener('click', testVoice);\r\n  resetAllVoiceSpeedsButton.addEventListener('click', () => { void setAllVoiceSpeeds(true); });\r\n  setAllVoiceSpeedsButton.addEventListener('click', () => { void setAllVoiceSpeeds(false); });\r\n  deleteVoiceButton.addEventListener('click', () => { void toggleDeletedVoice(); });\r\n  favoriteButton.addEventListener('click', () => { void toggleFavorite(); });\r\n  filterVoiceButton.addEventListener('click', (event) => {\r\n    event.stopPropagation();\r\n    filterVoices();\r\n  });\r\n  voiceFilterNode.addEventListener('keydown', (event) => {\r\n    if (event.key === 'Enter') {\r\n      event.preventDefault();\r\n      filterVoices();\r\n    }\r\n  });\r\n  voiceModeTabsNode.querySelectorAll('.tab').forEach((button) => {\r\n    button.addEventListener('click', () => switchVoiceMode(button.dataset.mode || 'all'));\r\n  });\r\n  voiceNode.addEventListener('change', () => {\r\n    if (activeVoiceMode === 'deleted') {\r\n      updateFavoriteButton();\r\n      updateDeleteVoiceButton();\r\n      return;\r\n    }\r\n    void selectVoice(voiceNode.value);\r\n  });\r\n  voicePickerButton.addEventListener('click', (event) => {\r\n    event.stopPropagation();\r\n    if (voicePickerMenu.hidden) openVoicePicker();\r\n    else closeVoicePicker();\r\n  });\r\n  voicePickerMenu.addEventListener('click', (event) => event.stopPropagation());\r\n  document.addEventListener('click', closeVoicePicker);\r\n  bindRange(speedNode, speedValueNode);\r\n  FishReader.ready.then(async () => {\r\n    applyAppTheme();\r\n    // The plugin selects its rule and initiates the host's generic migration.\r\n    // Older hosts keep using the original storage through the existing bridge.\r\n    if (typeof FishReader.ttsPackages?.migrate === 'function') {\r\n      setBusy(true, '检查语音包目录…');\r\n      try {\r\n        await FishReader.tts.snapshot();\r\n        const migration = await FishReader.ttsPackages.migrate();\r\n        status.textContent = migration.warnings?.length ? migration.warnings.join('\\n') : '';\r\n      } catch (error) {\r\n        status.textContent = `目录迁移未完成，可重新打开此页重试：${error.message || error}`;\r\n      } finally { setBusy(false); }\r\n    }\r\n    const savedFavorites = await FishReader.storage.get(FAVORITE_VOICE_IDS_KEY);\r\n    favoriteVoiceIds = Array.isArray(savedFavorites) ? savedFavorites.filter((id) => typeof id === 'string') : [];\r\n    const savedDeleted = await FishReader.storage.get(DELETED_VOICE_IDS_KEY);\r\n    deletedVoiceIds = Array.isArray(savedDeleted) ? savedDeleted.filter((id) => typeof id === 'string') : [];\r\n    voiceSettings = normalizeVoiceSettings(await FishReader.storage.get(VOICE_SETTINGS_KEY));\r\n    await refresh();\r\n  }).catch((error) => {\r\n    status.textContent = `加载失败：${error.message || error}`;\r\n  });\r\n</script>\r\n</body>\r\n</html>\r\n"
  }
}
