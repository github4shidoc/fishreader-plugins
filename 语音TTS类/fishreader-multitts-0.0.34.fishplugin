(v, 18) ^ (v >>> 3)) >>> 0;\r\nconst sigma1 = (v: number): number => (rotr(v, 17) ^ rotr(v, 19) ^ (v >>> 10)) >>> 0;\r\nconst mul = Math.imul;\r\nfunction expand(words: number[], from = 16): void {\r\n  for (let i = from; i < 64; i++) words[i] =\r\n    (sigma1(words[i - 2]) + words[i - 7] + sigma0(words[i - 15]) + words[i - 16]) >>> 0;\r\n}\r\nfunction rounds(state: number[], words: number[], from = 0): number[] {\r\n  let [a,b,c,d,e,f,g,h] = state;\r\n  for (let i = from; i < 64; i++) {\r\n    const k = from === 14 && i === 14 ? 0xC9DC06A7 : ROUND[i];\r\n    const t1 = (h + ((rotr(e,6) ^ rotr(e,11) ^ rotr(e,25)) >>> 0) +\r\n      ((g ^ (e & (f ^ g))) >>> 0) + k + words[i]) >>> 0;\r\n    const t2 = (((rotr(a,2) ^ rotr(a,13) ^ rotr(a,22)) >>> 0) +\r\n      (((a & b) | (c & (a | b))) >>> 0)) >>> 0;\r\n    [a,b,c,d,e,f,g,h] = [(t1+t2)>>>0,a,b,c,(d+t1)>>>0,e,f,g];\r\n  }\r\n  return [a,b,c,d,e,f,g,h];\r\n}\r\nfunction digest(data: Uint8Array): Uint8Array {\r\n  const view = new DataView(data.buffer, data.byteOffset, data.byteLength);\r\n  const words = new Array(14).fill(0);\r\n  words.push((data[0]<<16)|(data[1]<<8)|data[2], view.getUint32(3));\r\n  for (let i=16;i<30;i++) {\r\n    let v = SCHEDULE[i-16];\r\n    if(i-2>=14) v += i===16 ? (sigma1(words[i-2]) ^ 0x000B92C0)>>>0 : sigma1(words[i-2]);\r\n    if(i-7>=14) v += words[i-7];\r\n    if(i-15>=14) v += i===29 ? (sigma0(words[i-15]) ^ 0x059C0B80)>>>0 : sigma0(words[i-15]);\r\n    words.push(v>>>0);\r\n  }\r\n  words.push((sigma1(words[28])+words[23]+sigma0(words[15])+words[14]+0xC9DC06A7-ROUND[14])>>>0);\r\n  expand(words,31);\r\n  let state = rounds(STATE,words,14).map((v,i)=>(v+INITIAL[i])>>>0);\r\n  const length = 57+data.length;\r\n  const zeros = ((55-length)%64+64)%64;\r\n  const padded = new Uint8Array(data.length-7+1+zeros+8);\r\n  padded.set(data.slice(7)); padded[data.length-7]=128;\r\n  const pv=new DataView(padded.buffer);\r\n  pv.setUint32(padded.length-4,length*8);\r\n  for(let offset=0;offset<padded.length;offset+=64) {\r\n    const w=Array.from({length:16},(_,i)=>pv.getUint32(offset+i*4));\r\n    expand(w); const result=rounds(state,w); state=state.map((v,i)=>(v+result[i])>>>0);\r\n  }\r\n  const out=new Uint8Array(32);const ov=new DataView(out.buffer);\r\n  state.forEach((v,i)=>ov.setUint32(i*4,v));return out;\r\n}\r\nfunction cs64(data: Uint8Array, hash: Uint8Array): Uint8Array {\r\n  const hv=new DataView(hash.buffer); const a=hv.getUint32(0,true)|1, b=hv.getUint32(4,true)|1;\r\n  const factors=[mul(a,0x82893933),mul(b,0x82893933)];\r\n  const terms=COEFFICIENTS.map(([c],i)=>mul(c,factors[i%2]));\r\n  const offsets=COEFFICIENTS.map(([,v])=>v);\r\n  const padded=new Uint8Array(Math.ceil((data.length+1)/8)*8);padded.set(data,1);\r\n  const dv=new DataView(padded.buffer);\r\n  for(let i=0;i<padded.length/4;i++) {\r\n    const word=dv.getUint32(i*4,true);\r\n    let term=mul(word,i%2===0?a:b), offset=mul(rol16(word),i%2===0?0xEF0569FB:0xC31713DB);\r\n    if(i===0) {term=(term+mul(0xF2F90B1A,factors[0]))>>>0;offset=(offset+0x0B1A0000)>>>0;}\r\n    terms.push(term);offsets.push(offset);\r\n  }\r\n  let swapAcc=0,swapLast=0,state=0,acc=0;\r\n  for(let i=0;i<terms.length;i+=2) {\r\n    const x=terms[i],y=terms[i+1];\r\n    let q=mul(rol16((offsets[i]+x)>>>0),0x76F50F34);\r\n    swapAcc=(swapAcc+((mul(rol16(q),0xC3EFEA97)+q)>>>0))>>>0;\r\n    q=mul(rol16((offsets[i+1]+y)>>>0),0x1881CE3C);\r\n    swapLast=(mul(rol16(q),0x35BD1EC9)+q)>>>0;swapAcc=(swapAcc+swapLast)>>>0;\r\n    state=(mul(state,a)+x)>>>0;\r\n    for(const factor of [0xCF98B111,0x87085B9F,0x12CEB96D,0x257E1D83]) state=mul(rol16(state),factor);\r\n    acc=(acc+state)>>>0; let t=(mul(state,b)+y)>>>0;\r\n    t=mul(rol16(t),0xA27416F5);t=mul(rol16(t),0xD38396FF);\r\n    state=mul(rol16(mul(rol16(t),0x7C932B89)),0xBFA49F69);acc=(acc+state)>>>0;\r\n  }\r\n  const out=new Uint8Array(8);const ov=new DataView(out.buffer);\r\n  ov.setUint32(0,swapLast^state,true);ov.setUint32(4,swapAcc^acc,true);return out;\r\n}\r