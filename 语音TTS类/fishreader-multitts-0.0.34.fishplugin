'] = 'application/json';\r\n    headers.Accept = 'application/json, text/plain, */*';\r\n    headers.Origin = 'chrome-extension://klgfhbiooeogdfodpopgppeadghjjemk';\r\n    headers.Cookie = 'vtm%253D%257B%2522vtm_aid%2522%253A%2522www.volcengine.com%2522%252C%2522vtm_bid%2522%253A%2522%252Fdocs%252F6561%252F1257544%2522%252C%2522vtm_render_id%2522%253A%2522d47d4dc3-f680-4a0a-8401-fb023a274da4%2522%257D';\r\n    headers['User-Agent'] = USER_AGENT;\r\n    return {\r\n        url,\r\n        method: 'POST',\r\n        headers: mergeHeaders(headers, credentials),\r\n        body: JSON.stringify({ speaker: voice.code, language: locale, text: request.text }),\r\n        contentTypeHint: '',\r\n        responseMode: 'base64-json',\r\n        responsePath: 'audio.data|audio'\r\n    };\r\n}\r\nfunction bytes(value) {\r\n    return new host_3.util.TextEncoder().encodeInto(value);\r\n}\r\nfunction text(value) {\r\n    return new host_3.util.TextDecoder().decodeWithStream(value, { stream: false });\r\n}\r\nfunction responseText(value) {\r\n    if (typeof value === 'string')\r\n        return value;\r\n    if (value instanceof ArrayBuffer)\r\n        return text(new Uint8Array(value));\r\n    return String(value);\r\n}\r\nfunction base64(value) {\r\n    return new host_3.util.Base64Helper().encodeToStringSync(value, host_3.util.Type.BASIC);\r\n}\r\nfunction fromBase64(value) {\r\n    return new host_3.util.Base64Helper().decodeSync(value);\r\n}\r\nfunction valueAt(value, path) {\r\n    let current = value;\r\n    const parts = path.split('.');\r\n    for (let index = 0; index < parts.length; index++) {\r\n        if (current === null || typeof current !== 'object')\r\n            return null;\r\n        current = current[parts[index]];\r\n    }\r\n    return current ?? null;\r\n}\r\nfunction firstValue(value, paths) {\r\n    for (let index = 0; index < paths.length; index++) {\r\n        const found = valueAt(value, paths[index]);\r\n        if (found !== null && String(found).le