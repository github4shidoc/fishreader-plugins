  "source": "// Generated by scripts/build-multitts-runtime.mjs. Edit engines/*.ts.\n(() => { const modules = {\"./MultiTtsBuiltinOnlineRuleResolver\": function(module, exports, require) {\n\"use strict\";\r\nObject.defineProperty(exports, \"__esModule\", { value: true });\r\nexports.MultiTtsBuiltinOnlineRuleResolver = exports.MULTITTS_HTTP_INNER_ENGINES = void 0;\r\nconst host_1 = require(\"./host\");\r\nconst host_2 = require(\"./host\");\r\nconst host_3 = require(\"./host\");\r\nconst MultiTtsOnlineRuleResolver_1 = require(\"./MultiTtsOnlineRuleResolver\");\r\nconst rsa_executor_1 = require(\"./rsa-executor\");\r\nconst MultiTtsControlScale_1 = require(\"./MultiTtsControlScale\");\r\nconst USER_AGENT = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36';\r\nexports.MULTITTS_HTTP_INNER_ENGINES = [\r\n    'filmora', 'gemini', 'ggtrans', 'huoshan', 'mstrans', 'namiai', 'peiyinya', 'xfpeiyin'\r\n];\r\nconst MICROSOFT_APP_ID = 'MSTranslatorAndroidApp';\r\nconst MICROSOFT_SECRET = 'oik6PdDdMnOXemTbwvMn9de/h9lFnfBaCWbGMMZqqoSaQaqUOqjVGm5NqsmjcBI1x+sS9ugjB55HEJWRiFXYFw==';\r\nconst PEIYIN_REQUEST_MODULUS = 'h4VDNr5RxCDRpasklBI2PlUfSBvJxrRSRy6/P/cPTwmoYttdQg1R+/tMJOp63ndKo+JY7cOiGyUvJAzBee8+7Hwp235PFjYods+otNbAi9APC6FFS75R1gxaUwFCuqgcFDmc6TVae7MohC7elLc2ULI1PnfUFFi7lT4oM8N2LAc=';\r\nconst PEIYIN_RESPONSE_MODULUS = 's8lddUavnpI/2bMv1X15ZbBb76T4bBi+jiQ5lpOjpySFf6alnPHh6ipQZBH7wtnOF3gHbedk0qfG2FiwaEhjpCAyO9DD6gwbwdA0d+M5WuW9BzVEVN4effuQbbAs90atmOY8bF1aNdNVKMa1G/4/gEPF9yYEObJAkGxdGsYvUf8=';\r\nconst PEIYIN_RESPONSE_PRIVATE_EXPONENT = 'MFQT5F+g+95SfaHWXOxCwtwaipvtD5nDN5BzTo/XcSm3HS5d3IeE9B51x8CxzZog9VwVmyyVhK8HG8cTfKTg65wVOhx8jgdgUDBOHeOsA8e+71ZDAcpBD33ppYV+5or7kecs/GU3qc1A52ucY4WAvVlZu6qPACiC3XqQG+43gaE=';\r\nfunction mergeHeaders(base, credentials) {\r\n    const result = {};\r\n    Object.keys(base).forEach((key) => { result[key] = base[key]; });\r\n    if (credentials.headers !== undefined) {\r\n        Object.k