{
  "schemaVersion": 1,
  "manifest": {
    "schemaVersion": 1,
    "pluginId": "org.fishreader.xiaoyi.tts",
    "name": "小艺TTS",
    "version": "0.1.4",
    "sdkVersion": "1.0",
    "sourceFormat": "fishreader-js",
    "pluginKinds": [
      "tts"
    ],
    "entryModule": "main.js",
    "managementModule": "manage.html",
    "entrypoints": [
      "ttsVoices",
      "ttsSynthesize",
      "manage",
      "ui"
    ],
    "permissions": {
      "networkDomains": [
        "product-reader-drcn.himovie.dbankcloud.com",
        "ttsaccess-reader-drcn.media.dbankcloud.cn"
      ],
      "redirectDomains": [],
      "cookieScope": false,
      "pluginStorage": true,
      "pluginDatabase": false,
      "standardCrypto": false,
      "htmlParse": false,
      "webViewAutomation": false,
      "loginBrowser": false
    },
    "description": "华为阅读在线音色，包含书馆先生、男声、女声、童声，支持语速调节和试听。仅提供在线合成，音色权限以服务端为准。"
  },
  "source": "'use strict';\n\n// Protocol recovered from Huawei Reader 9.5.53.300. No account tokens or API keys.\nconst PRODUCT_URL = 'https://product-reader-drcn.himovie.dbankcloud.com/readproductservice/v1/speaker/getSpeakerList';\nconst SPEECH_URL = 'https://ttsaccess-reader-drcn.media.dbankcloud.cn/readttsaccessservice/v1/tts/play';\nconst DEVICE_KEY = 'xiaoyi.device.v1';\nconst CATALOG_KEY = 'xiaoyi.catalog.v2';\nconst MAX_AUDIO_BYTES = 4 * 1024 * 1024;\nconst BASE64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\n// Online voices returned by the service on 2026-11-21. PCM and MP3 are supported;\n// obsolete ML Kit online/offline identifiers are deliberately omitted.\nconst INITIAL_VOICES = [\n  ['b01c6b1a-126b-4879-8cc6-fd4dedc2687d', '成熟男士', 'male', '男声', 0],\n  ['1037610034101485568', '播音男声', 'male', '男声', 1],\n  ['325cc781-4f37-4cc3-b92e-70fbb991e3f2', '磁性大叔', 'male', '男声', 0],\n  ['999929595824177155', '温柔男生', 'male', '男声', 0],\n  ['aa079c23-0d39-4f60-b735-ca376eb11052', '阳光少年', 'male', '男声', 0],\n  ['11ad73b1-6d23-4baa-b695-52512efea9a2', '知性女士', 'female', '女声', 0],\n  ['1118100455335943808', '播音女声', 'female', '女声', 1],\n  ['999929595824177154', '率性御姐', 'female', '女声', 0],\n  ['999929595824177152', '清纯少女', 'female', '女声', 0],\n  ['950b6dff-ac5b-4591-b325-fb71a9151900', '阳光女生', 'female', '女声', 0],\n  ['999929595824177153', '软萌正太', 'male', '童声', 0],\n  ['e8dadab7-e88c-4e64-b1f7-24b9e9fef516', '可爱男童', 'male', '童声', 0],\n  ['49b550be-aa47-4b7e-86f2-3cffcf30b81c', '可爱女童', 'female', '童声', 0],\n  ['hwread-tts4-0000005', '书馆先生', 'male', '精品音色', 0, 1, 24000, 1],\n  ['hwread-tts4-0000001', '深情男声', 'male', '精品音色', null, 1, 24000, 0, true],\n  ['hwread-tts4-0000002', '深情女声', 'female', '精品音色', null, 1, 24000, 0, true]\n].map(([id, name, gender, group, feeType, outputEncoderFormat = 0, sampleRate = 16000, displayScope = 0, supplemental = false]) =>\n  ({ id, name, gender, group, feeType, speed: 116, outputEncoderFormat, sampleRate, displayScope, supplemental,\n    description: supplemental ? '已验证匿名短句合成；权益信息待确认' : '' }));\n\nfunction string(value) { return typeof value === 'string' ? value : ''; }\nfunction cleanName(value) { return string(value).replace(/\\s+/g, '').slice(0, 256); }\nfunction bounded(value, minimum, maximum, fallback) {\n  const number = Number(value);\n  return Number.isFinite(number) ? Math.max(minimum, Math.min(maximum, number)) : fallback;\n}\n\nasync function deviceId() {\n  const saved = await reader.storage.get(DEVICE_KEY);\n  if (typeof saved === 'string' && /^uuid#[0-9a-f-]{36}$/.test(saved)) return saved;\n  // This is the APK's anonymous UUID fallback (deviceIdType 11), not a hardware ID.\n  const id = 'uuid#' + 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, letter => {\n    const random = Math.floor(Math.random() * 16);\n    return (letter === 'x' ? random : (random & 3) | 8).toString(16);\n  });\n  await reader.storage.set(DEVICE_KEY, id);\n  return id;\n}\n\nasync function request(url, data, binary, requestId) {\n  const id = await deviceId();\n  const timestamp = new Date().toISOString().replace(/\\D/g, '').slice(0, 14);\n  const response = await reader.http.fetch({\n    url, method: 'POST', responseType: binary ? 'bytes' : 'text', timeoutMs: 25000,\n    useCookieJar: false, requestId: string(requestId) || undefined,\n    headers: { 'Content-Type': 'application/json; charset=UTF-8', 'x-appId': '101',\n      'x-appVer': '90553300', 'x-country': 'CN', 'x-support-utc': '1', timestamp },\n    body: JSON.stringify({\n      deviceInfo: { terminalType: 'UNKNOWN', deviceId: id, deviceIdType: '11', uuid: id,\n        handsetManufacturer: 'HUAWEI', hansetBrand: 'HUAWEI', emuiVer: '0' },\n      appInfo: { packageName: 'com.huawei.hwread.dz', appId: '101', appVer: '90553300',\n        country: 'CN', beId: '99999999', featureFlags: 'COLUMN_GROUP', i18n: 'zh_CN' },\n      userInfo: { accountType: 0, rcmMode: 0 }, data, reqTimestamp: timestamp\n    })\n  });\n  if (!response || response.status < 200 || response.status >= 300) {\n    throw new Error('小艺TTS网络请求失败：HTTP ' + (response && response.status || '未知'));\n  }\n  return response;\n}\n\nfunction serviceError(value) {\n  const code = value && value.retCode;\n  const message = string(value && value.retMsg).slice(0, 180);\n  return new Error('小艺TTS服务返回 ' + (code === undefined ? '无效数据' : code) +\n    (message ? '：' + message : '。当前音色可能不可用，请刷新音色或换用其他音色。'));\n}\n\nasync function catalog() {\n  const saved = await reader.storage.get(CATALOG_KEY);\n  const voices = saved && Array.isArray(saved.voices) && saved.voices.length ? saved.voices.slice() : INITIAL_VOICES.slice();\n  const ids = new Set(voices.map(voice => voice.id));\n  for (const extra of INITIAL_VOICES.filter(voice => voice.supplemental)) {\n    const index = voices.findIndex(voice => voice.id === extra.id);\n    if (index >= 0 && voices[index].supplemental) voices[index] = Object.assign({}, voices[index], extra);\n    else if (!ids.has(extra.id) && voices.length < 256) voices.push(extra);\n  }\n  return voices;\n}\n\nfunction voiceOption(voice) {\n  const group = string(voice.group) || '在线音色';\n  return { voiceKey: voice.id, name: voice.name, locale: 'zh-CN', gender: voice.gender,\n    description: (voice.feeType ? '需相应音色权益；' : '') + '在线合成' +\n      (voice.description ? ' · ' + voice.description : '') +\n      (voice.displayScope === 1 ? ' · 原应用归类为本书专属' : ''),\n    packageId: 'xiaoyi-' + ({ '男声': 'male', '女声': 'female', '童声': 'child', '精品音色': 'premium' }[group] || 'online'),\n    packageName: group };\n}\n\nasync function refreshVoices() {\n  const response = await request(PRODUCT_URL, { getUserSpeaker: 0 }, false);\n  let result;\n  try { result = JSON.parse(response.body); } catch (_) { throw new Error('小艺TTS音色列表格式无效'); }\n  if (!result || Number(result.retCode) !== 0) throw serviceError(result);\n  const groups = result.data && result.data.ttsSysSpeakerGroupList;\n  if (!Array.isArray(groups)) throw new Error('小艺TTS服务未返回音色分组');\n  const voices = [], seen = new Set();\n  for (const group of groups) {\n    for (const voice of Array.isArray(group.ttsSysSpeakerList) ? group.ttsSysSpeakerList : []) {\n      const id = string(voice.speakerId), name = cleanName(voice.speakName);\n      if (!id || id.length > 512 || !name || seen.has(id) || Number(voice.onOffLine) !== 1 ||\n          Number(voice.status) !== 2 || ![0, 1].includes(Number(voice.displayScope)) || Number(voice.type) !== 2) continue;\n      const formats = Array.isArray(voice.outputEncoderFormats) && voice.outputEncoderFormats.length ?\n        voice.outputEncoderFormats.map(Number) : [0];\n      const outputEncoderFormat = formats.includes(0) ? 0 : formats.includes(1) ? 1 : -1;\n      if (outputEncoderFormat === -1) continue;\n      const sampleRates = (Array.isArray(voice.sampleRates) ? voice.sampleRates : []).map(Number)\n        .filter(value => Number.isInteger(value) && value >= 8000 && value <= 48000).sort((a, b) => b - a);\n      const displayScope = Number(voice.displayScope);\n      seen.add(id);\n      voices.push({ id, name, gender: String(voice.gender) === '1' ? 'male' : 'female',\n        group: displayScope === 1 ? '精品音色' : cleanName(group.name) || '在线音色', feeType: Number(voice.feeType) || 0,\n        description: string(voice.description).slice(0, 300),\n        speed: Math.round(bounded(voice.speed, 50, 200, 116)),\n        displayScope, outputEncoderFormat, sampleRate: sampleRates[0] || 16000 });\n      if (voices.length >= 256) break;\n    }\n    if (voices.length >= 256) break;\n  }\n  if (!voices.length) throw new Error('小艺TTS暂时没有可用的在线音色，已保留原列表');\n  // These public model IDs synthesize successfully but are absent from the\n  // directory endpoint. Their display names follow the matched voice samples.\n  for (const extra of INITIAL_VOICES.filter(voice => voice.supplemental)) {\n    if (!seen.has(extra.id) && voices.length < 256) voices.push(extra);\n  }\n  await reader.storage.set(CATALOG_KEY, { updatedAt: Date.now(), voices });\n  return voices.map(voiceOption);\n}\n\nfunction bytesFrom(response) {\n  if (Array.isArray(response.data) || response.data instanceof Uint8Array) {\n    return Uint8Array.from(response.data);\n  }\n  if (response.data instanceof ArrayBuffer) return new Uint8Array(response.data);\n  // Host versions may keep a JSON error in body even for responseType bytes.\n  if (string(response.body).trim().startsWith('{')) {\n    let result;\n    try { result = JSON.parse(response.body); } catch (_) {}\n    throw serviceError(result);\n  }\n  throw new Error('小艺TTS未返回语音字节，请更新鱼书后重试');\n}\n\nfunction unpackAudio(bytes, format) {\n  if (bytes.length > MAX_AUDIO_BYTES + 256 * 1024) throw new Error('小艺TTS语音过长，请缩短文本');\n  let start = 0;\n  while (start < bytes.length && [9, 10, 13, 32].includes(bytes[start])) start++;\n  if (bytes[start] === 123) {\n    let result;\n    try { result = JSON.parse(String.fromCharCode.apply(null, bytes.subarray(start, Math.min(bytes.length, start + 8192)))); } catch (_) {}\n    throw serviceError(result);\n  }\n  let offset = 0, size = 0, ended = false;\n  const chunks = [];\n  while (offset < bytes.length) {\n    if (offset + 8 > bytes.length) throw new Error('小艺TTS语音帧头不完整');\n    const code = bytes[offset] >>> 4, type = bytes[offset] & 15;\n    const length = (bytes[offset + 1] << 14) + (bytes[offset + 2] << 6) + (bytes[offset + 3] >>> 2);\n    const more = bytes[offset + 3] & 3;\n    offset += 8;\n    if (code) throw new Error('小艺TTS语音流返回错误：' + code);\n    if (more !== 0 && more !== 1) throw new Error('小艺TTS语音帧状态无效');\n    if (offset + length > bytes.length) throw new Error('小艺TTS语音帧内容不完整');\n    if (type === 0 && length) {\n      chunks.push(bytes.subarray(offset, offset + length));\n      size += length;\n      if (size > MAX_AUDIO_BYTES) throw new Error('小艺TTS语音过长，请缩短文本');\n    } else if (type !== 0 && type !== 2 && type !== 15) {\n      throw new Error('小艺TTS出现未知语音帧：' + type);\n    }\n    offset += length;\n    if (!more) {\n      ended = true;\n      // The service appends a global empty terminator after the sentence's end.\n      // Accept only its exact empty control-frame shape, never arbitrary bytes.\n      while (offset + 8 <= bytes.length && bytes[offset] === 15 &&\n          bytes.subarray(offset + 1, offset + 8).every(value => value === 0)) offset += 8;\n      break;\n    }\n  }\n  if (!ended || offset !== bytes.length) throw new Error('小艺TTS语音流未完整结束，请重试');\n  if (!size || (format === 0 && size % 2)) throw new Error('小艺TTS返回的' + (format === 1 ? 'MP3' : 'PCM') + '语音无效');\n  const audio = new Uint8Array(size);\n  let position = 0;\n  for (const chunk of chunks) { audio.set(chunk, position); position += chunk.length; }\n  if (format === 1) {\n    let at = 0;\n    if (audio[0] === 73 && audio[1] === 68 && audio[2] === 51) {\n      if (audio.length < 10 || audio.subarray(6, 10).some(value => value & 128)) throw new Error('小艺TTS返回的MP3头无效');\n      at = 10 + (audio[6] << 21) + (audio[7] << 14) + (audio[8] << 7) + audio[9];\n    }\n    if (at + 4 > audio.length || audio[at] !== 255 || (audio[at + 1] & 224) !== 224 ||\n        ((audio[at + 1] >> 3) & 3) === 1 || ((audio[at + 1] >> 1) & 3) !== 1 ||\n        (audio[at + 2] >> 4) === 15 || ((audio[at + 2] >> 2) & 3) === 3) {\n      throw new Error('小艺TTS返回的MP3语音无效');\n    }\n  }\n  return audio;\n}\n\nfunction wav(pcm, sampleRate) {\n  const bytes = new Uint8Array(44 + pcm.length), view = new DataView(bytes.buffer);\n  function tag(at, value) { for (let i = 0; i < value.length; i++) bytes[at + i] = value.charCodeAt(i); }\n  tag(0, 'RIFF'); view.setUint32(4, pcm.length + 36, true); tag(8, 'WAVE');\n  tag(12, 'fmt '); view.setUint32(16, 16, true); view.setUint16(20, 1, true);\n  view.setUint16(22, 1, true); view.setUint32(24, sampleRate, true);\n  view.setUint32(28, sampleRate * 2, true); view.setUint16(32, 2, true); view.setUint16(34, 16, true);\n  tag(36, 'data'); view.setUint32(40, pcm.length, true); bytes.set(pcm, 44);\n  return bytes;\n}\n\nfunction base64(bytes) {\n  const parts = [];\n  for (let start = 0; start < bytes.length; start += 12288) {\n    let part = '';\n    const end = Math.min(start + 12288, bytes.length);\n    for (let i = start; i < end; i += 3) {\n      const n = (bytes[i] << 16) | ((bytes[i + 1] || 0) << 8) | (bytes[i + 2] || 0);\n      part += BASE64[n >>> 18] + BASE64[(n >>> 12) & 63] +\n        (i + 1 < bytes.length ? BASE64[(n >>> 6) & 63] : '=') +\n        (i + 2 < bytes.length ? BASE64[n & 63] : '=');\n    }\n    parts.push(part);\n  }\n  return parts.join('');\n}\n\nmodule.exports.ttsVoices = async function () { return (await catalog()).map(voiceOption); };\n\nfunction checkedText(value, maximum) {\n  const text = string(value).trim();\n  // Some plugin engines cannot even parse Unicode property escapes. Only strip\n  // common punctuation for this empty-input check; send the original text intact.\n  if (!text || !text.replace(/[\\s.,!?;:'\"()\\[\\]{}<>\\-，。！？；：、（）【】《》“”‘’…—]/g, '')) {\n    throw new Error('请输入需要朗读的文字');\n  }\n  if (text.length > maximum) throw new Error('小艺TTS单段最多支持' + maximum + '字，请分段朗读');\n  return text;\n}\n\nasync function audioFor(voice, text, speed, requestId) {\n  const normalSpeed = bounded(voice.speed, 50, 200, 116);\n  const serviceSpeed = Math.round(bounded(normalSpeed * speed, 50, 200, normalSpeed));\n  const format = voice.outputEncoderFormat === 1 ? 1 : 0;\n  const sampleRate = Math.round(bounded(voice.sampleRate, 8000, 48000, 16000));\n  const response = await request(SPEECH_URL, {\n    speakerId: voice.id, text,\n    config: { type: 2, outputEncoderFormat: format, sampleRate, speed: serviceSpeed, pitch: 100, volume: 200 },\n    coordinate: { dompos: '', bookId: '', spChapterId: '', chapterFilePath: '' }\n  }, true, requestId);\n  const payload = unpackAudio(bytesFrom(response), format);\n  const audio = format === 1 ? payload : wav(payload, sampleRate);\n  return { bytes: audio, contentType: format === 1 ? 'audio/mpeg' : 'audio/wav', sampleRate,\n    tempo: speed / (serviceSpeed / normalSpeed) };\n}\n\nmodule.exports.ttsSynthesize = async function (input) {\n  const text = checkedText(input && input.text, 1000);\n  const voice = (await catalog()).find(item => item.id === string(input && input.voiceKey));\n  if (!voice) throw new Error('找不到小艺TTS音色，请刷新音色后重新选择');\n  const speed = bounded(input.speed, 0.1, 3, 1);\n  if (input.streamId !== undefined) throw new Error('当前HTTP接口不提供实时分片，无法执行实时流式合成');\n  const audio = await audioFor(voice, text, speed, input.requestId);\n  return { kind: 'audio-base64', dataBase64: base64(audio.bytes), contentType: audio.contentType,\n    sampleRate: audio.sampleRate, tempo: audio.tempo };\n};\n\nmodule.exports.manage = async function (input) {\n  if (input && input.action === 'listVoices') return module.exports.ttsVoices();\n  if (input && input.action === 'refreshVoices') return refreshVoices();\n  if (input && input.action === 'preview') {\n    if (string(input.text).trim().length > 200) throw new Error('试听文字最多200字');\n    return module.exports.ttsSynthesize({ voiceKey: string(input.voiceKey), text: string(input.text), speed: input.speed });\n  }\n  throw new Error('不支持的小艺TTS管理操作');\n};\n",
  "modules": {
    "manage.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <title>小艺TTS</title>\n  <style>\n    :root{font-family:system-ui,-apple-system,sans-serif;color-scheme:light dark;--bg:#f3f5f8;--surface:#fff;--ink:#182334;--muted:#667389;--line:#e1e7ee;--accent:#2674d9;--soft:#eaf2ff}\n    @media(prefers-color-scheme:dark){:root{--bg:#121820;--surface:#1d2632;--ink:#edf3fa;--muted:#a9b6c8;--line:#334154;--accent:#8abaff;--soft:#263b57}}\n    *{box-sizing:border-box}body{margin:0;padding:24px 18px calc(28px + env(safe-area-inset-bottom));background:var(--bg);color:var(--ink);line-height:1.6}main{max-width:760px;margin:auto}\n    header{display:flex;align-items:center;gap:13px;margin:5px 0 24px}.mark{width:48px;height:48px;display:grid;place-items:center;border-radius:16px;background:var(--accent);color:var(--bg)}h1{margin:0;font-size:25px;letter-spacing:-.5px}h2{margin:0;font-size:18px}p{margin:4px 0;color:var(--muted);font-size:13px}\n    .card{padding:19px;margin-bottom:16px;background:var(--surface);border:1px solid var(--line);border-radius:18px}.row{display:flex;align-items:center;gap:12px;justify-content:space-between}.filters{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}\n    button,input,textarea{font:inherit}button{border:0;min-height:42px;padding:9px 15px;border-radius:11px;background:var(--accent);color:var(--bg);cursor:pointer}button.secondary{background:var(--soft);color:var(--accent)}button:disabled{opacity:.5;cursor:default}button:focus-visible,textarea:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:3px}\n    .filters button{min-height:34px;padding:5px 13px;background:var(--bg);color:var(--muted)}.filters button[aria-pressed=true]{background:var(--soft);color:var(--accent)}.voices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}\n    .voice{min-height:74px;padding:12px 9px;text-align:left;border:1px solid var(--line);background:var(--surface);color:var(--ink)}.voice[aria-pressed=true]{border-color:var(--accent);background:var(--soft)}.voice strong{display:block;font-size:14px;font-weight:600}.voice span{display:block;color:var(--muted);font-size:11px;margin-top:3px}\n    label{display:block;margin:16px 0 8px;font-size:13px;color:var(--muted)}textarea{width:100%;resize:vertical;min-height:96px;padding:12px;border:1px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink)}input[type=range]{width:100%;accent-color:var(--accent)}.preview{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:16px}.preview button{flex:0 0 auto}#previewName{font-size:13px;color:var(--muted)}[hidden]{display:none!important}.status{min-height:23px;font-size:13px;color:var(--muted);overflow-wrap:anywhere;margin-top:14px}.note{padding:0 3px}#count{font-size:12px;color:var(--muted)}\n    @media(max-width:420px){.voices{grid-template-columns:repeat(2,minmax(0,1fr))}.card{padding:16px}}\n  </style>\n</head>\n<body>\n<main>\n  <header><div class=\"mark\" aria-hidden=\"true\"><svg width=\"29\" height=\"29\" viewBox=\"0 0 32 32\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"><path d=\"M5 13v6M11 8v16M17 4v24M23 9v14M29 13v6\"/></svg></div><div><h1>小艺TTS</h1><p>选一个声音，让文字读给你听。</p></div></header>\n  <section class=\"card\" aria-labelledby=\"voicesTitle\">\n    <div class=\"row\"><div><h2 id=\"voicesTitle\">在线音色</h2><span id=\"count\">正在读取…</span></div><button id=\"refresh\" class=\"secondary\" disabled>刷新音色</button></div>\n    <div id=\"filters\" class=\"filters\" aria-label=\"音色分类\"></div>\n    <div id=\"voices\" class=\"voices\" aria-label=\"试听音色\"></div>\n  </section>\n  <section class=\"card\" aria-labelledby=\"previewTitle\">\n    <h2 id=\"previewTitle\">试听</h2>\n    <label for=\"text\">试听文字</label><textarea id=\"text\" maxlength=\"200\">你好，我是小艺。翻开新的一页，让我们一起听见文字里的故事。</textarea>\n    <label class=\"row\" for=\"speed\"><span>语速</span><output id=\"speedLabel\">1.0 倍</output></label><input id=\"speed\" type=\"range\" min=\"0.5\" max=\"2\" step=\"0.1\" value=\"1\">\n    <div class=\"preview\"><button id=\"test\" disabled>试听声音</button><button id=\"stop\" class=\"secondary\" hidden>停止试听</button><span id=\"previewName\">请选择音色</span></div>\n    <div id=\"status\" class=\"status\" role=\"status\" aria-live=\"polite\"></div>\n  </section>\n  <p class=\"note\">在阅读设置的语音朗读中选择“小艺TTS”音色，即可用于正文朗读。在线合成需要网络；标注“需权益”的音色以服务端授权为准。</p>\n</main>\n<script>\n  const $ = id => document.getElementById(id);\n  const PREVIEW_KEY = 'xiaoyi.preview.v1';\n  let voices = [], selected = '', filter = '全部', busy = false;\n  let audioContext = null, playing = null;\n  function stopAudio() {\n    if (playing) { playing.onended = null; try { playing.stop(); } catch (_) {} playing.disconnect(); playing = null; }\n    $('stop').hidden = true;\n  }\n  $('stop').onclick = () => { stopAudio(); $('status').textContent = '试听已停止。'; };\n  window.addEventListener('pagehide', () => { stopAudio(); if (audioContext) audioContext.close().catch(() => {}); });\n  function setBusy(value) {\n    busy = value; $('refresh').disabled = value; $('test').disabled = value || !selected;\n    document.querySelectorAll('.voice,.filters button').forEach(button => { button.disabled = value; });\n  }\n  function render() {\n    $('count').textContent = voices.length + ' 个音色 · ' + [...new Set(voices.map(voice => voice.packageName))].join('、');\n    $('filters').replaceChildren();\n    for (const group of ['全部', ...new Set(voices.map(voice => voice.packageName))]) {\n      const button = document.createElement('button');\n      button.textContent = group; button.setAttribute('aria-pressed', String(filter === group));\n      button.onclick = () => { filter = group; render(); };\n      $('filters').appendChild(button);\n    }\n    $('voices').replaceChildren();\n    for (const voice of voices.filter(voice => filter === '全部' || voice.packageName === filter)) {\n      const button = document.createElement('button');\n      button.className = 'voice'; button.setAttribute('aria-pressed', String(selected === voice.voiceKey));\n      const title = document.createElement('strong'), detail = document.createElement('span');\n      title.textContent = voice.name;\n      detail.textContent = voice.packageName + (voice.description.includes('需相应') ? ' · 需权益' : ' · 在线');\n      button.append(title, detail);\n      button.onclick = () => { selected = voice.voiceKey; render(); };\n      $('voices').appendChild(button);\n    }\n    const voice = voices.find(voice => voice.voiceKey === selected);\n    $('previewName').textContent = voice ? voice.name : '请选择音色';\n    $('test').disabled = busy || !voice;\n  }\n  $('speed').oninput = () => { $('speedLabel').textContent = Number($('speed').value).toFixed(1) + ' 倍'; };\n  $('refresh').onclick = async () => {\n    if (busy) return;\n    setBusy(true); $('status').textContent = '正在更新在线音色…';\n    try {\n      voices = await FishReader.plugin.execute('manage', { action: 'refreshVoices' });\n      if (!voices.some(voice => voice.voiceKey === selected)) selected = voices[0]?.voiceKey || '';\n      render(); $('status').textContent = '在线音色已更新。';\n    } catch (error) { $('status').textContent = '刷新失败：' + (error.message || error); }\n    finally { setBusy(false); }\n  };\n  $('test').onclick = async () => {\n    const text = $('text').value.trim();\n    if (busy || !selected) return;\n    if (!text) { $('status').textContent = '请输入试听文字。'; return; }\n    setBusy(true); stopAudio();\n    $('status').textContent = '正在生成试听…';\n    try {\n      // The host forbids media URLs with CSP. Decode the returned audio in memory\n      // using Web Audio, resuming inside this user gesture before the network call.\n      const AudioContextType = window.AudioContext || window.webkitAudioContext;\n      if (!AudioContextType) throw new Error('当前设备不支持页面试听，请在正文朗读中使用');\n      if (!audioContext || audioContext.state === 'closed') audioContext = new AudioContextType();\n      await audioContext.resume();\n      const speed = Number($('speed').value);\n      const result = await FishReader.plugin.execute('manage', { action: 'preview', voiceKey: selected, text, speed });\n      if (result.kind !== 'audio-base64' || !['audio/wav', 'audio/mpeg'].includes(result.contentType) || !result.dataBase64) throw new Error('服务未返回可播放的语音');\n      const raw = atob(result.dataBase64), bytes = new Uint8Array(raw.length);\n      for (let i = 0; i < raw.length; i++) bytes[i] = raw.charCodeAt(i);\n      const buffer = await audioContext.decodeAudioData(bytes.buffer);\n      const source = audioContext.createBufferSource(); source.buffer = buffer;\n      source.playbackRate.value = result.tempo || 1; source.connect(audioContext.destination);\n      source.onended = () => {\n        if (playing === source) { source.disconnect(); playing = null; $('stop').hidden = true; $('status').textContent = '试听播放完毕。'; }\n      };\n      playing = source; source.start(); $('stop').hidden = false;\n      $('status').textContent = '正在播放试听。';\n      await FishReader.storage.set(PREVIEW_KEY, { voiceKey: selected, speed });\n    } catch (error) { $('status').textContent = '合成失败：' + (error.message || error); }\n    finally { setBusy(false); }\n  };\n  async function load() {\n    setBusy(true);\n    await FishReader.ready;\n    voices = await FishReader.plugin.execute('manage', { action: 'listVoices' });\n    selected = voices[0]?.voiceKey || '';\n    render(); setBusy(false);\n    // Optional preview preferences must not hold up the voice list.\n    try {\n      const saved = await FishReader.storage.get(PREVIEW_KEY);\n      if (voices.some(voice => voice.voiceKey === saved?.voiceKey)) selected = saved.voiceKey;\n      if (saved && Number.isFinite(saved.speed)) $('speed').value = String(saved.speed);\n      $('speed').oninput(); render();\n    } catch (_) {}\n  }\n  load().catch(error => {\n    $('count').textContent = '读取失败'; setBusy(false);\n    $('status').textContent = '读取失败：' + (error.message || error) + '。可点击刷新音色重试。';\n  });\n</script>\n</body>\n</html>\n"
  }
}
