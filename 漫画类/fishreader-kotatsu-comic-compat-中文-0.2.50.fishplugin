:\"6353436350537369479\",\"title\":\"腾讯动漫\",\"language\":\"zh-Hans\",\"url\":\"https://m.ac.qq.com\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.tencentcomics\",\"version\":\"1.6.0\",\"contentWarning\":2,\"localId\":\"tencentcomics:zh\",\"localTitle\":\"腾讯动漫\"},{\"id\":\"4585134706567717130\",\"title\":\"泰拉记事社\",\"language\":\"zh\",\"url\":\"https://comic.hypergryph.com\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.terrahistoricus\",\"version\":\"1.6.1\",\"contentWarning\":1,\"localId\":\"terrahistoricus:zh\",\"localTitle\":\"泰拉记事社\"},{\"id\":\"5530823947742715441\",\"title\":\"東立\",\"language\":\"zh\",\"url\":\"https://ebook.tongli.com.tw\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.tongli\",\"version\":\"1.6.0\",\"contentWarning\":2,\"localId\":\"tongli:zh\",\"localTitle\":\"東立\"},{\"id\":\"1680248666203661128\",\"title\":\"TOPTOON頂通\",\"language\":\"zh\",\"url\":\"https://www.toptoon.net\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.toptoon\",\"version\":\"1.6.0\",\"contentWarning\":2,\"localId\":\"\",\"localTitle\":\"\"},{\"id\":\"3329849726908639188\",\"title\":\"vomic\",\"language\":\"zh\",\"url\":\"https://www.vomicmh.com\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.vomic\",\"version\":\"1.4.6\",\"contentWarning\":1,\"localId\":\"vomic:zh\",\"localTitle\":\"vomic\"},{\"id\":\"6551136894818591762\",\"title\":\"紳士漫畫\",\"language\":\"zh\",\"url\":\"https://www.wn07.cfd\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.wnacg\",\"version\":\"1.6.2\",\"contentWarning\":3,\"localId\":\"\",\"localTitle\":\"\"},{\"id\":\"2417676426413230210\",\"title\":\"一耽女孩\",\"language\":\"zh\",\"url\":\"https://yidan9.club\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.yidan\",\"version\":\"1.4.5\",\"contentWarning\":3,\"localId\":\"\",\"localTitle\":\"\"},{\"id\":\"524579092615598717\",\"title\":\"再漫画\",\"language\":\"zh\",\"url\":\"https://manhua.zaimanhua.com\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.zaimanhua\",\"version\":\"1.6.0\",\"contentWarning\":1,\"localId\":\"zaimanhua:zh\",\"localTitle\":\"再漫画\"},{\"id\":\"6466445276541048432\",\"title\":\"杂志迷\",\"language\":\"zh\",\"url\":\"https://www.zazhimi.net\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.zazhimi\",\"version\":\"1.6.0\",\"contentWarning\":1,\"localId\":\"zazhimi:zh\",\"localTitle\":\"杂志迷\"},{\"id\":\"8743284448117690086\",\"title\":\"zero搬运网\",\"language\":\"zh\",\"url\":\"http://www.zerobyw33.com\",\"pkg\":\"eu.kanade.tachiyomi.extension.zh.zerobyw\",\"version\":\"1.6.0\",\"contentWarning\":2,\"localId\":\"zerobyw:zh\",\"localTitle\":\"zero搬运网\"}]};\n  const RUNNABLE_SOURCES = SOURCES.filter(source=>source.supported!==false);\n  const SETTINGS_KEY = 'kotatsu-comic:settings';\n  const DEFAULT_SOURCE_IDS = RUNNABLE_SOURCES.filter(source=>['zh','all'].includes(String(source.language||'').toLowerCase())).map(source=>source.id);\n  const selected = new Set();\n  let hanabiUpscaleEnabled=false,manwa2ApiLine=0,manwa2ImageLine='auto';\n  const elements = Object.fromEntries(['source-summary','adult-enabled','filter','kind-filter','save','authorize-selected','authorize-all','defaults','select-all','select-visible','clear','status','selection-count','visible-count','sources'].map(id => [id, document.getElementById(id)]));\n  elements['source-summary'].textContent=`共收录 ${SOURCES.length} 个源，已适配 ${RUNNABLE_SOURCES.length} 个。“授权全部域名”只弹出一次宿主确认，不会自动启用全部源。`;\n  elements['select-all'].textContent=`全选已适配源（${RUNNABLE_SOURCES.length}）`;\n\n  function setStatus(message, error=false){elements.status.textContent=message;elements.status.className=error?'warn':''}\n  let repositoryLimit=50;\n  function renderRepository(){\n    if(!REPOSITORY)return;\n    const query=document.getElementById('repository-filter').value.trim().toLowerCase();\n    const rows=REPOSITORY.sources.filter(item=>!query||`${item.title} ${item.language} ${item.pkg}`.toLowerCase().includes(query));\n    const container=document.getElementById('repository-list');\n    container.replaceChildren(...rows.slice(0,repositoryLimit).map(item=>{\n      const row=document.createElement('div');row.className='source';\n      const text=document.createElement('span');text.style.gridColumn='1 / 3';\n      const title=document.createElement('strong');title.textContent=item.title;\n      const detail=document.createElement('small');detail.textContent=`${item.language} · ${item.version} · ${item.localId?'已关联 '+item.localTitle:'待适配'}`;\n      text.append(title,detail);row.append(text);\n      if(item.localId){\n        const button=document.createElement('button');button.textContent='定位现有源';\n        button.addEventListener('click',()=>{elements.filter.value=item.localId;elements['kind-filter'].value='all';render();elements.filter.scrollIntoView({block:'center'});});\n        row.append(button);\n      }else{const badge=document.createElement('span');badge.className='badge';badge.textContent='不可启用';row.append(badge);}\n      return row;\n    }));\n    document.getElementById('repository-more').hidden=rows.length<=repositoryLimit;\n  }\n  if(REPOSITORY){\n    document.getElementById('repository-summary').textContent=`索引：${REPOSITORY.sources.length} 项，关联现有源 ${REPOSITORY.sources.filter(item=>item.localId).length} 项；其余尚未适配。更新于 ${REPOSITORY.fetchedAt.slice(0,10)}。旧 JSON 地址已改用 index.pb。`;\n    document.getElementById('repository-filter').addEventListener('input',()=>{repositoryLimit=50;renderRepository()});\n    document.getElementById('repository-more').addEventListener('click',()=>{repositoryLimit+=50;renderRepository()});\n    renderRepository();\n  }\n  function domainList(sources){return [...new Set(sources.flatMap(source=>source.domains||[]).map(value=>String(value).trim().toLowerCase()).filter(Boolean))].sort()}\n  function visibleSources(){\n    const query=elements.filter.value.trim().toLowerCase();\n    const kind=elements['kind-filter'].value;\n    return SOURCES.filter(source=>(kind==='all'||(kind==='adult')===source.adult)&&(!query||`${source.title} ${source.language} ${source.id}`.toLowerCase().includes(query)));\n  }\n  function updateCounts(visible){\n    const adults=SOURCES.filter(source=>selected.has(source.id)&&source.adult).length;\n    elements['selection-count'].textContent=`已选 ${selected.size} 个（成人 ${adults} 个）`;\n    elements['visible-count'].textContent=`当前显示 ${visible.length} / ${SOURCES.length}`;\n  }\n  function render(){\n    const visible=visibleSources();\n    elements.sources.replaceChildren(...visible.map(source=>{\n      const label=document.createElement('div');label.className='source';\n      const input=document.createElement('input');input.type='checkbox';input.checked=selected.has(source.id);input.disabled=source.supported===false;\n      input.setAttribute('aria-label',`启用${source.title}`);\n      input.addEventListener('change',()=>{input.checked?selected.add(source.id):selected.delete(source.id);updateCounts(visible)});\n      const text=document.createElement('span');const title=document.createElement('strong');title.textContent=source.title;\n      const detail=document.createElement('small');detail.textContent=`${source.language||'all'} · ${source.id}${source.supported===false?' · 暂未适配':''}`;text.append(title,detail);\n      if(source.domain){const domain=document.createElement('small');domain.textContent=source.domain;text.append(domain)}\n      if(source.login){\n        const actions=document.createElement('div');actions.className='login-actions';\n        const state=document.createElement('small');state.className='login-state';state.textContent='登录状态以站点为准；不会自动登录或保存密码';\n        if(source.login.mode){\n          const form=document.createElement('form');form.className='login-actions';form.hidden=true;\n          const email=document.createElement('input');email.type=source.login.mode==='vomic'?'text':'email';email.autocomplete='username';email.placeholder=source.login.mode==='vomic'?'账号':'账号邮箱';email.required=true;email.setAttribute('aria-label',source.title+email.placeholder);\n          const password=document.createElement('input');password.type='password';password.autocomplete='current-password';password.placeholder='密码（不保存）';password.required=true;password.setAttribute('aria-label',source.title+'密码');\n          const submit=document.createElement('button');submit.type='submit';submit.textContent='登录';\n          const open=document.createElement('button');open.type='button';open.textContent='账号登录';open.onclick=()=>{form.hidden=!form.hidden;if(!form.hidden)email.focus();};actions.append(open);\n          form.append(email,password,submit);\n          form.onsubmit=async event=>{event.preventDefault();submit.disabled=true;try{await authorize([source],source.title);await accountStore().signIn(source.login,email.value.trim(),password.value);state.textContent='登录成功，已保存令牌（不保存密码）；内容权限仍以站点为准';form.hidden=true;}catch(error){state.textContent=error.message||'登录失败，请重试';}finally{password.value='';submit.disabled=false;}};\n          text.append(form);\n        }\n        for(const [caption,action] of [...(source.login.mode==='vomic'?[]:[['网页登录',()=>login(source,state)]]),['检查凭据',()=>loginState(source,state)],['清除登录',()=>logout(source,state)]]){\n          const button=document.createElement('button');button.type='button';button.textContent=caption;\n          button.addEventListener('click',async()=>{button.disabled=true;try{await action()}catch(_error){state.textContent='操作未完成，请检查授权或重新打开网页登录'}finally{button.disabled=false}});actions.append(button);\n        }\n        text.append(actions,state);\n      }\n      if(source.id==='hanabimanga:zh'){\n        const option=document.createElement('label');option.className='source-option';\n        const toggle=document.createElement('input');toggle.type='checkbox';toggle.checked=hanabiUpscaleEnabled;toggle.setAttribute('aria-label','花火漫画 AI 超分辨率');\n        const words=document.createElement('span');const heading=document.createElement('strong');heading.textContent='AI 超分辨率';\n        const note=document.createElement('small');note.textContent='尝试获取超分辨率图片，普通用户每日限 5 个章节。不建议非 VIP 用户开启，避免额度用完后还要再关。';\n        words.append(heading,note);option.append(toggle,words);text.append(option);\n        toggle.addEventListener('change',async()=>{\n          toggle.disabled=true;const previous=hanabiUpscaleEnabled;hanabiUpscaleEnabled=toggle.checked;\n          try{const settings=await FishReader.storage.get(SETTINGS_KEY)||{};\n            await FishReader.storage.set(SETTINGS_KEY,{...settings,hanabiAiSuperResolution:hanabiUpscaleEnabled});\n            setStatus(`花火 AI 超分辨率已${hanabiUpscaleEnabled?'开启':'关闭'}。`);\n          }catch(error){hanabiUpscaleEnabled=previous;toggle.checked=previous;setStatus(`保存花火设置失败：${error&&error.message?error.message:String(error)}`,true)}\n          finally{toggle.disabled=false}\n        });\n      }\n      if(source.id==='manwa_general:zh'){\n        const lineOption=(caption,key,current,choices,convert)=>{\n          const label=document.createElement('label');label.className='source-option';\n          const heading=document.createElement('strong');heading.textContent=caption;\n          const select=document.createElement('select');select.setAttribute('aria-label',`漫蛙 ${caption}`);\n          for(const [value,title] of choices){const option=document.createElement('option');option.value=value;option.textContent=title;select.append(option)}\n          let savedValue=current;select.value=String(current);label.append(heading,select);text.append(label);\n          select.addEventListener('change',async()=>{\n            select.disabled=true;const previous=savedValue;const value=convert(select.value);\n            try{const settings=await FishReader.storage.get(SETTINGS_KEY)||{};\n              await FishReader.storage.set(SETTINGS_KEY,{...settings,[key]:value});\n              savedValue=value;\n              if(key==='manwa2ApiLine')manwa2ApiLine=value;else manwa2ImageLine=value;\n              setStatus(`漫蛙 ${caption}已保存，重新打开章节即可使用。`);\n            }catch(error){select.value=String(previous);setStatus(`保存漫蛙线路失败：${error&&error.message?error.message:String(error)}`,true)}\n            finally{select.disabled=false}\n          });\n        };\n        lineOption('网站线路','manwa2ApiLine',manwa2ApiLine,[['0','自动'],['1','线路一'],['2','线路二'],['3','线路三'],['4','线路四'],['5','线路五'],['6','线路六']],Number);\n        lineOption('图片线路','manwa2ImageLine',manwa2ImageLine,[['auto','自动'],['fast','高速源'],['stable','稳定源'],['backup1','备用源一'],['backup2','备用源二']],String);\n      }\n      const badge=document.createElement('span');badge.className=`badge${source.adult?' adult':''}`;badge.textContent=source.supported===false?'待适配':(source.adult?'成人':'普通');\n      label.append(input,text,badge);return label;\n    }));\n    updateCounts(visible);\n  }\n  async function save(){\n    const settings=await FishReader.storage.get(SETTINGS_KEY)||{};\n    await FishReader.storage.set(SETTINGS_KEY,{...settings,adultEnabled:elements['adult-enabled'].checked,enabledSourceIds:[...selected],hanabiAiSuperResolution:hanabiUpscaleEnabled});\n    setStatus(`已保存 ${selected.size} 个启用源。`);\n  }\n  async function login(source,state){\n    if(!FishReader.ui||typeof FishReader.ui.openLoginBrowser!=='function')throw new Error('当前宿主没有网页登录能力');\n    await authorize([source],source.title);\n    state.textContent='请在站点完成登录后返回，再点击“检查凭据”';\n    await FishReader.ui.openLoginBrowser({url:source.login.url,title:`${source.title} · 登录`});\n  }\n  async function loginState(source,state){\n    if(source.login.mode){const saved=await accountStore().read(source.login);state.textContent=saved&&!saved.guest?(source.login.mode==='vomic'?'已保存账号令牌；失效时请重新登录':'已保存账号令牌；'+(Number(saved.expiresAt)>Date.now()?'尚未过期':'下次请求将刷新，失效时需重新登录')):'尚未账号登录';return;}\n    let found=false;\n    for(const url of source.login.cookieUrls){\n      const cookie=String(await FishReader.cookie.get(url)||'');\n      found=found||cookie.split(';').some(pair=>{const at=pair.indexOf('=');return at>0&&source.login.cookieNames.includes(pair.slice(0,at).trim().toLowerCase())&&pair.slice(at+1).trim()!==''});\n    }\n    state.textContent=found?'已读取登录凭据；有效性及内容权限以站点为准':'尚未读取登录凭据，请在网页登录后返回检查';\n  }\n  async function logout(source,state){\n    if(!window.confirm(`清除${source.title}的登录？同站点的其它线路也会退出。`))return;\n    if(source.login.mode)await accountStore().clear(source.login);\n    const related=SOURCES.filter(item=>item.login&&item.login.family===source.login.family);\n    const urls=[...new Set(related.flatMap(item=>[...item.login.cookieUrls,...item.login.apiHosts.map(host=>`https://${host}/`)]))];\n    for(const url of urls)await FishReader.cookie.clear(url);\n    state.textContent='已清除插件内该站点的登录凭据；网页登录页可能仍保留站点会话';\n  }\n  async function authorize(sources,label){\n    const domains=domainList(sources);\n    if(!domains.length){setStatus('没有需要授权的域名。');return}\n    setStatus(`等待一次确认：${label}，共 ${domains.length} 个域名…`);\n    const result=await FishReader.plugin.requestNetworkDomains(domains);\n    if(!result||result.granted!==true)throw new Error('未授权漫画源网络域名');\n    setStatus(`授权完成：${domains.length} 个域名。`);\n  }\n  async function busy(button,action){\n    const buttons=[elements.save,elements['authorize-selected'],elements['authorize-all']];buttons.forEach(value=>value.disabled=true);\n    try{await action()}catch(error){setStatus(error&&error.message?error.message:String(error),true)}finally{buttons.forEach(value=>value.disabled=false)}\n  }\n  elements.filter.addEventListener('input',render);elements['kind-filter'].addEventListener('change',render);\n  elements.defaults.addEventListener('click',()=>{selected.clear();DEFAULT_SOURCE_IDS.forEach(id=>selected.add(id));render()});\n  elements['select-all'].addEventListener('click',()=>{RUNNABLE_SOURCES.forEach(source=>selected.add(source.id));render();setStatus(`已全选 ${selected.size} 个已适配漫画源，请保存或授权。`)});\n  elements['select-visible'].addEventListener('click',()=>{visibleSources().filter(source=>source.supported!==false).forEach(source=>selected.add(source.id));render()});\n  elements.clear.addEventListener('click',()=>{selected.clear();render()});\n  elements.save.addEventListener('click',()=>busy(elements.save,save));\n  elements['authorize-selected'].addEventListener('click',()=>busy(elements['authorize-selected'],async()=>{await authorize(SOURCES.filter(source=>selected.has(source.id)),'已选源');await save()}));\n  elements['authorize-all'].addEventListener('click',()=>busy(elements['authorize-all'],()=>authorize(RUNNABLE_SOURCES,'全部已适配漫画源')));\n  (async()=>{\n    try{\n      const settings=await FishReader.storage.get(SETTINGS_KEY)||{};\n      const ids=Array.isArray(settings.enabledSourceIds)?settings.enabledSourceIds:DEFAULT_SOURCE_IDS;\n      ids.forEach(id=>selected.add(String(id)==='manwayuplus:zh'?'manwa_general:zh':String(id)));elements['adult-enabled'].checked=settings.adultEnabled!==false;\n      hanabiUpscaleEnabled=settings.hanabiAiSuperResolution===true;\n      manwa2ApiLine=Number.isInteger(settings.manwa2ApiLine)&&settings.manwa2ApiLine>=1&&settings.manwa2ApiLine<=6?settings.manwa2ApiLine:0;\n      manwa2ImageLine=['fast','stable','backup1','backup2'].includes(settings.manwa2ImageLine)?settings.manwa2ImageLine:'auto';\n      render();\n    }catch(error){DEFAULT_SOURCE_IDS.forEach(id=>selected.add(id));render();setStatus(`读取设置失败：${error&&error.message?error.message:String(error)}`,true)}\n  })();\n</script>\n</body>\n</html>\n"
  }
}
