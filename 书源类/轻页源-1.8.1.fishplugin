ECT source_key, source_json FROM legado_sources ORDER BY import_order ASC ' +\n      'LIMIT 500 OFFSET ' + offset, [], 500);\n    if (!result || !Array.isArray(result.rows)) return null;\n    for (const row of result.rows) {\n      const source = databaseSourceFromRow(row);\n      if (source !== null && text(source.bookSourceUrl).trim() === key) return source;\n      const canonicalKey = text(row.source_key).trim();\n      if (source !== null && legacyBase && text(source.bookSourceUrl).trim() === legacyBase) {\n        if (!legacyCandidate) {\n          legacyCandidate = source;\n          legacyCandidateKey = canonicalKey;\n        } else if (legacyCandidateKey !== canonicalKey) {\n          legacyAmbiguous = true;\n        }\n      }\n    }\n    if (result.rows.length < 500) break;\n  }\n  return legacyCandidate && !legacyAmbiguous ? legacyCandidate : null;\n}\n\nfunction databaseFirstEnabledSource() {\n  const result = databaseQuery(\n    'SELECT source_key, source_json FROM legado_sources WHERE enabled = 1 ' +\n    'ORDER BY import_order ASC LIMIT 1', [], 1);\n  if (!result || !Array.isArray(result.rows) || result.rows.length === 0) return null;\n  try {\n    return attachSourceKey(object(JSON.parse(text(result.rows[0].source_json))),\n      result.rows[0].source_key);\n  } catch (_) { return null; }\n}\n\nfunction sourceGroups(source) {\n  const raw = text(source && (source.bookSourceGroup || source.group)).trim();\n  if (!raw) return [];\n  const groups = [];\n  for (const value of raw.split(/[\\n,，;；]+/)) {\n    const group = text(value).trim();\n    if (group && !groups.includes(group)) groups.push(group);\n  }\n  return groups;\n}\n\nasync function databaseSourceTargetsAsync(capability) {\n  const targets = [];\n  if (reader.database && typeof reader.database.queryJson === 'function') {\n    const result = await databaseQueryJsonAsync(\n      \"SELECT json_object('rows', json_group_array(json_object(\" +\n      \"'source_key', source_key, 'name', name, 'source_group', source_group, 'source_type', source_type)), \" +\n      \"'truncated', json('false')) FROM (\" +\n      \"SELECT source_key, name, json_extract(source_json, '$.bookSourceGroup') AS source_group, json_extract(source_json, '$.bookSourceType') AS source_type \" +\n      \"FROM legado_sources WHERE enabled = 1 AND \" +\n      \"length(trim(COALESCE(json_extract(source_json, ?), ''))) > 0 \" +\n      'ORDER BY import_order ASC)', ['$.' + capability]);\n    if (result && Array.isArray(result.rows)) {\n      for (const row of result.rows) {\n        targets.push({ sourceKey: text(row.source_key), name: text(row.name || row.source_key),\n          groups: sourceGroups({ bookSourceGroup: row.source_group }),\n          mediaType: legadoMediaType({ bookSourceType: row.source_type }) });\n      }\n      return targets;\n    }\n  }\n  for (let offset = 0; ; offset += 500) {\n    let portableRows = !(reader.database && typeof reader.database.queryJson === 'function');\n    let result = portableRows ? await databaseQueryAsync(\n      'SELECT source_key, name, source_json FROM legado_sources WHERE enabled = 1 ' +\n      'ORDER BY import_order ASC LIMIT 500 OFFSET ' + offset, [], 500) : await databaseQueryAsync(\n        \"SELECT source_key, name, json_extract(source_json, '$.bookSourceGroup') AS source_group, json_extract(source_json, '$.bookSourceType') AS source_type \" +\n        'FROM legado_sources WHERE enabled = 1 AND ' +\n        \"length(trim(COALESCE(json_extract(source_json, ?), ''))) > 0 \" +\n        'ORDER BY import_order ASC LIMIT 500 OFFSET ' + offset, ['$.' + capability], 500);\n    if (!result) {\n      portableRows = true;\n      result = await databaseQueryAsync(\n        'SELECT source_key, name, source_json FROM legado_sources WHERE enabled = 1 ' +\n        'ORDER BY import_order ASC LIMIT 500 OFFSET ' + offset, [], 500);\n    }\n    if (!result || !Array.isArray(result.rows)) return null;\n    for (const row of result.rows) {\n      if (portableRows) {\n        const source = databaseSourceFromRow(row);\n        if (source === null || !text(source[capability]).trim()) continue;\n        targets.push({ sourceKey: text(row.source_key),\n          name: text(row.name || source.bookSourceName || row.source_key), groups: sourceGroups(source), mediaType: legadoMediaType(source) });\n      } else {\n        targets.push({ sourceKey: text(row.source_key), name: text(row.name || row.source_key),\n          groups: sourceGroups({ bookSourceGroup: row.source_group }),\n          mediaType: legadoMediaType({ bookSourceType: row.source_type }) });\n      }\n    }\n    if (result.rows.length < 500) break;\n  }\n  return targets;\n}\n\nasync function databaseSourceTargetAsync(sourceKey, capability) {\n  const exact = await databaseQueryAsync(\n    'SELECT source_key, name, source_json FROM legado_sources WHERE enabled = 1 AND ' +\n    'source_key = ? LIMIT 1', [sourceKey], 1);\n  if (exact && Array.isArray(exact.rows) && exact.rows.length > 0) {\n    const row = exact.rows[0];\n    const source = databaseSourceFromRow(row);\n    if (source === null || !text(source[capability]).trim()) return null;\n    return { sourceKey: text(row.source_key || source.bookSourceUrl || source.bookSourceName),\n      name: text(row.name || source.bookSourceName || source.bookSourceUrl), groups: sourceGroups(source), mediaType: legadoMediaType(source) };\n  }\n  const declared = await databaseQueryAsync(\n    \"SELECT source_key, name, source_json FROM legado_sources WHERE enabled = 1 AND \" +\n    \"json_extract(source_json, '$.bookSourceUrl') = ? ORDER BY import_order ASC LIMIT 1\",\n    [sourceKey], 1);\n  if (declared && Array.isArray(declared.rows) && declared.rows.length > 0) {\n    const row = declared.rows[0];\n    const source = databaseSourceFromRow(row);\n    if (source === null || !text(source[capability]).trim()) return null;\n    return { sourceKey: text(row.source_key || source.bookSourceUrl || source.bookSourceName),\n      name: text(row.name || source.bookSourceName || source.bookSourceUrl), groups: sourceGroups(source), mediaType: legadoMediaType(source) };\n  }\n  for (let offset = 0; ; offset += 500) {\n    const result = await databaseQueryAsync(\n      'SELECT source_key, name, source_json FROM legado_sources WHERE enabled = 1 ' +\n      'ORDER BY import_order ASC LIMIT 500 OFFSET ' + offset, [], 500);\n    if (!result || !Array.isArray(result.rows)) return null;\n    for (const row of result.rows) {\n      const source = databaseSourceFromRow(row);\n      if (source === null) continue;\n      if (text(row.source_key).trim() !== sourceKey &&\n          text(source.bookSourceUrl).trim() !== sourceKey) continue;\n      if (!text(source[capability]).trim()) return null;\n      return {\n        sourceKey: text(row.source_key || source.bookSourceUrl || source.bookSourceName),\n        name: text(row.name || source.bookSourceName || source.bookSourceUrl),\n        groups: sourceGroups(source), mediaType: legadoMediaType(source)\n      };\n    }\n    if (result.rows.length < 500) break;\n  }\n  return null;\n}\n\nfunction isGrantedNetworkDomain(value) {\n  const domain = text(value).trim().toLowerCase();\n  return domain.length > 0 && domain.length <= 253 &&\n    /^(?:\\*\\.)?(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$/.test(domain);\n}\n\nfunction sourceStringValues(value, output) {\n  if (typeof value === 'string') { output.push(value); return; }\n  if (Array.isArray(value)) { value.forEach(item => sourceStringValues(item, output)); return; }\n  if (!value || typeof value !== 'object') return;\n  Object.keys(value).forEach(key => sourceStringValues(value[key], output));\n}\n\nfunction balancedSourceArray(value, start) {\n  let depth = 0, quote = '', escaped = false;\n  for (let index = start; index < value.length; index++) {\n    const char = value[index];\n    if (escaped) { escaped = false; continue; }\n    if (char === '\\\\') { escaped = true; continue; }\n    if (quote) { if (char === quote) quote = ''; continue; }\n    if (char === '\"' || char === \"'\" || char === '`') { quote = char; continue; }\n    if (char === '[') depth++;\n    else if (char === ']' && --depth === 0) return value.slice(start + 1, index);\n  }\n  return '';\n}\n\nfunction staticDynamicDomainLabels(sourceText) {\n  const labels = [];\n  const field = /(?:^|[,{;\\\\n])\\s*[\"']?([A-Za-z_$][\\w$]*)[\"']?\\s*:\\s*\\[/g;\n  let match;\n  while ((match = field.exec(sourceText)) !== null) {\n    if (!/(?:domain|host|server)/i.test(match[1])) continue;\n    const content = balancedSourceArray(sourceText, field.lastIndex - 1);\n    if (!content) continue;\n    const quoted = /[\"']([A-Za-z0-9-]{1,63})[\"']/g;\n    let label;\n    while ((label = quoted.exec(content)) !== null) {\n      const value = label[1].toLowerCase();\n      if (!/^(?:get|post|put|delete|true|false|null|utf8?|json|html|http|https)$/i.test(value) &&\n          !labels.includes(value)) labels.push(value);\n    }\n  }\n  return labels;\n}\n\nfunction domainsFromSource(source) {\n  let serialized = '';\n  try { serialized = JSON.stringify(source); } catch (_) { return []; }\n  const urls = serialized.match(/https?:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?/gi) || [];\n  const domains = [];\n  for (const raw of urls) {\n    const match = raw.match(/^https?:\\/\\/([^/:?#]+)/i);\n    const domain = text(match && match[1]).trim().toLowerCase().replace(/\\.+$/, '');\n    if (isGrantedNetworkDomain(domain) && !domains.includes(domain)) domains.push(domain);\n  }\n  serialized.replace(/[\"']?dnsIp[\"']?\\s*:\\s*[\"']([^\"']+)[\"']/gi, (_all, raw) => {\n    text(raw).split(/[\\s,;]+/).forEach(value => {\n      const address = value.trim().replace(/^\\[|\\]$/g, '').toLowerCase();\n      if ((/^(?:\\d{1,3}\\.){3}\\d{1,3}$/.test(address) || /^[0-9a-f:]+$/i.test(address)) &&\n          isGrantedNetworkDomain(address) &&\n          !domains.includes(address)) domains.push(address);\n    });\n    return _all;\n  });\n  // A Reading source may construct a request host from a static candidate list\n  // (for example `https://api.${domain}.com`) and catch failed attempts inside\n  // its own rule.  The catch prevents FishReader from seeing a denied request\n  // and asking for that domain later.  Discover only labels declared in a\n  // domain/host/server list and only when a matching URL template is present;\n  // this grants no wildcard and does not infer domains from arbitrary strings.\n  const strings = [];\n  sourceStringValues(source, strings);\n  const sourceText = strings.join('\\n');\n  const labels = staticDynamicDomainLabels(sourceText);\n  const template = /https?:\\/\\/([A-Za-z0-9.-]*)\\$\\{[A-Za-z_$][\\w$]*\\}([A-Za-z0-9.-]*)/g;\n  let hostTemplate;\n  while ((hostTemplate = template.exec(sourceText)) !== null) {\n    labels.forEach(label => {\n      const domain = (hostTemplate[1] + label + hostTemplate[2]).toLowerCase().replace(/\\.+$/, '');\n      if (isGrantedNetworkDomain(domain) && !domains.includes(domain)) domains.push(domain);\n    });\n  }\n  return domains;\n}\n\nfunction permissionGroup(source, sourceKey, name) {\n  const domains = domainsFromSource(source);\n  const title = text(name || source.bookSourceName || source.bookSourceUrl || '未命名书源');\n  const key = text(sourceKey || source.bookSourceUrl || source.bookSourceName || `source:${title}`);\n  return {\n    key,\n    title,\n    domains\n  };\n}\n\nfunction databasePermissionGroups() {\n  const groups = [];\n  for (let offset = 0; ; offset += 500) {\n    const result = databaseQuery(\n      'SELECT source_key, name, source_json FROM legado_sources ' +\n      'ORDER BY import_order ASC LIMIT 500 OFFSET ' + offset, [], 500);\n    if (!result || !Array.isArray(result.rows)) return null;\n    for (const row of result.rows) {\n      let source = {};\n      try { source = object(JSON.parse(text(row.source_json))); } catch (_) { continue; }\n      groups.push(permissionGroup(source, row.source_key, row.name));\n    }\n    if (result.rows.length < 500) break;\n  }\n  return groups;\n}\n\nfunction importedSources() {\n  const stored = reader.storage.get(SOURCE_KEY) || reader.storage.get(LEGACY_SOURCE_KEY);\n  return Array.isArray(stored) ? stored : [];\n}\n\nasync function importedSourcesAsync() {\n  const current = await Promise.resolve(reader.storage.get(SOURCE_KEY));\n  const legacy = current || await Promise.resolve(reader.storage.get(LEGACY_SOURCE_KEY));\n  return Array.isArray(legacy) ? legacy : [];\n}\n\nfunction activeSource() {\n  const activeRecord = reader.storage.get(ACTIVE_SOURCE_RECORD_KEY);\n  if (activeRecord && typeof activeRecord === 'object' && activeRecord.enabled !== false) {\n    return object(activeRecord);\n  }\n  const databaseSource = databaseFirstEnabledSource();\n  if (databaseSource) return databaseSource;\n  const sources = importedSources().filter(item => item.enabled !== false);\n  if (sources.length === 0) throw new Error('请先打开插件页面导入轻页源');\n  const activeUrl = text(reader.storage.get(ACTIVE_SOURCE_KEY) ||\n    reader.storage.get(LEGACY_ACTIVE_SOURCE_KEY));\n  return object(sources.find(item => sourceRecordKey(item) === activeUrl ||\n    text(item.bookSourceUrl) === activeUrl) || sources[0]);\n}\n\nfunction query(values) {\n  return Object.keys(values).map(key => encodeURIComponent(key) + '=' +\n    encodeURIComponent(text(values[key]))).join('&');\n}\n\nfunction stored(key) {\n  return object(storageGet(key));\n}\n\nfunction storageGet(key) {\n  const normalized = text(key);\n  if (activeExecutionState.exploreVariables &&\n      Object.prototype.hasOwnProperty.call(activeExecutionState.exploreVariables, normalized)) {\n    return activeExecutionState.exploreVariables[normalized];\n  }\n  const values = object(activeExecutionState.storageValues);\n  if (Object.prototype.hasOwnProperty.call(values, normalized)) return values[normalized];\n  const value = reader.storage.get(normalized);\n  // ArkWeb's bridge is synchronous, while Android JavaScriptSandbox exposes\n  // host functions as Promises. Async entrypoints preload the values they need;\n  // never let a Promise masquerade as stored plugin data in compatibility code.\n  if (value && typeof value.then === 'function') return undefined;\n  if (activeExecutionState.storageValues) activeExecutionState.storageValues[normalized] = value;\n  return value;\n}\n\nfunction storageSet(key, value) {\n  const normalized = text(key);\n  if (activeExecutionState.exploreVariables &&\n      Object.prototype.hasOwnProperty.call(activeExecutionState.exploreVariables, normalized)) {\n    activeExecutionState.exploreVariables[normalized] = value;\n    return true;\n  }\n  if (activeExecutionState.storageValues) activeExecutionState.storageValues[normalized] = value;\n  const pending = reader.storage.set(normalized, value);\n  if (pending && typeof pending.then === 'function' && Array.isArray(activeExecutionState.pendingWrites)) {\n    activeExecutionState.pendingWrites.push(pending);\n  }\n  return pending;\n}\n\nfunction storageRemoveBatch(keys) {\n  const normalized = [...new Set((Array.isArray(keys) ? keys : [])\n    .map(key => text(key)).filter(Boolean))];\n  if (normalized.length === 0) return true;\n  if (!reader.storage || typeof reader.storage.removeBatch !== 'function') return false;\n  if (activeExecutionState.storageValues) {\n    normalized.forEach(key => { delete activeExecutionState.storageValues[key]; });\n  }\n  let result = true;\n  for (let offset = 0; offset < normalized.length; offset += 5000) {\n    const pending = reader.storage.removeBatch(normalized.slice(offset, offset + 5000));\n    if (pending && typeof pending.then === 'function' && Array.isArray(activeExecutionState.pendingWrites)) {\n      activeExecutionState.pendingWrites.push(pending);\n    }\n    result = pending;\n  }\n  return result;\n}\n\nfunction utf8ByteLength(value) {\n  try { return unescape(encodeURIComponent(text(value))).length; } catch (_) {\n    return text(value).length * 3;\n  }\n}\n\nfunction bookKey(item) {\n  return 'legado.book.' + encodeURIComponent(text(item.source || 'source')).slice(0, 80) + '.' +\n    encodeURIComponent(text(item.book_id || item.id)).slice(0, 160);\n}\n\nfunction chapterKey(bookIdentity, item, index) {\n  return 'legado.chapter.' + encodeURIComponent(text(item.item_id || item.id || index)).slice(0, 180) + '.' +\n    encodeURIComponent(bookIdentity).slice(-160);\n}\n\nfunction sourceIdentity(source) {\n  // Reading treats incidental leading/trailing whitespace around a declared\n  // source key as transport/storage noise.  Keep meaningful suffixes such as\n  // `#tag`, but make every execution stage use the same identity even when a\n  // database lookup returns the normalized source key.\n  const input = text(source.bookSourceUrl || source.bookSourceName).trim();\n  let hash = 2166136261;\n  for (let index = 0; index < input.length; index++) {\n    hash ^= input.charCodeAt(index);\n    hash = Math.imul(hash, 16777619);\n  }\n  return (hash >>> 0).toString(16);\n}\n\nfunction ruleFingerprint(value) {\n  return sourceIdentity({ bookSourceUrl: JSON.stringify(value) });\n}\n\nfunction detailResult(identity, detail, source, rules, result, fieldEnv) {\n  const kind = text(detail.kind);\n  // Keep the concrete URLs produced by BookInfo.  The book key is an internal\n  // storage identity, not a navigable document URL.  Returning that identity\n  // here used to make the host pass a hash-like key into the following catalog\n  // call, which only worked while the previous detail execution's private\n  // storage happened to be available.\n  const bookUrl = text(detail.bookUrl) || identity;\n  const tocUrl = text(detail.tocSourceUrl) || bookUrl || identity;\n  return { bookKey: identity, title: detail.title || '未命名书籍', author: detail.author,\n    sourceName: text(detail.sourceName),\n    intro: detail.intro, coverUrl: detail.coverUrl, bookUrl, tocUrl,\n    kind, types: normalizedBookTypes(kind), publicationStatus: normalizedPublicationStatus(detail.status || kind),\n    latestChapter: text(detail.latestChapter),\n    wordCount: text(detail.wordCount),\n    mediaType: legadoMediaType(source, detail, result),\n    lastUpdated: text(detail.updateTime || detail.lastUpdated) };\n}\n\n// 阅读 BookInfo 对分类、字数、最新章节、简介、封面和目录等可选字段逐项\n// 隔离解析异常；某个规则失败不能让整本书详情失败。书名和作者仍按原实现\n// 保持严格解析。这里统一承载该语义，避免各端宿主产生不同结果。\nfunction optionalRuleText(source, rule, input, env, fallback) {\n  try {\n    const value = text(ruleValue(source, rule, input, env, false));\n    return value || text(fallback);\n  } catch (_) {\n    return text(fallback);\n  }\n}\n\nfunction optionalRuleUrl(source, rule, input, env, baseUrl, fallback) {\n  try {\n    // BookInfo URL fields follow AnalyzeRule.getString(..., isUrl = true),\n    // including its first-match CSS behavior.  Applying ordinary scalar rules\n    // here let a multi-link tocUrl concatenate unrelated href values.\n    const raw = text(ruleUrlValue(source, rule, input, env)).trim();\n    // AnalyzeRule.getString(..., isUrl = true) delegates to\n    // NetworkUtils.getAbsoluteURL(), which deliberately turns javascript:\n    // links into an empty value.  Detail pages commonly expose a\n    // `javascript:;` expand button next to an already embedded chapter list;\n    // treating it as a transport address skips the existing detail body.\n    if (/^javascript:/i.test(raw)) return text(fallback);\n    const value = urlCompat(raw, baseUrl);\n    return value || text(fallback);\n  } catch (_) {\n    return text(fallback);\n  }\n}\n\nfunction parseDetailLoaded(identity, savedValue, source, loaded, input) {\n  const saved = Object.assign({}, object(savedValue));\n  // Reading evaluates BookInfo fields on one mutable Book instance.  A\n  // `java.put()` performed by tocUrl must therefore still be visible when the\n  // subsequent catalogue rule calls `java.get()`.  Keep a shared variable bag\n  // before creating the field facade below; otherwise a book that did not set a\n  // search-stage variable receives a new bag only on the facade and the value\n  // is lost when the detail snapshot is persisted.\n  saved.__legadoVariables = object(saved.__legadoVariables);\n  const rules = sourceRuleTemplate(source).bookInfo;\n  let result = loaded.body;\n  const env = { result, src: loaded.body, baseUrl: loaded.url, book: saved,\n    __legadoExecutionState: input && input.__legadoExecutionState };\n  if (rules.init) {\n    const initialized = ruleList(source, rules.init, result, env);\n    if (initialized.length > 0) result = initialized[0];\n  }\n  // BookInfo.init is AnalyzeRule.setContent(getElement(init)) in Reading.\n  // Subsequent detail rules therefore observe the initialized element through\n  // both `result` and `src` (unlike a same-rule pipeline, whose src remains the\n  // original response).  Keep that boundary explicit for API detail sources.\n  const fieldEnv = Object.assign({}, env, { result, src: result });\n  const parsedTitle = text(ruleValue(source, rules.name, result, fieldEnv, false));\n  const parsedAuthor = text(ruleValue(source, rules.author, result, fieldEnv, false));\n  const parsedKind = optionalRuleText(source, rules.kind, result, fieldEnv, text(saved.kind));\n  // BookInfo fields become the current Book before URL templates are expanded.\n  // In particular, Reading rules may derive tocUrl from `{{book.kind}}` where\n  // kind is supplied by the detail API rather than the search list.\n  fieldEnv.book = Object.assign({}, saved, {\n    name: parsedTitle || text(saved.title),\n    title: parsedTitle || text(saved.title),\n    author: parsedAuthor || text(saved.author),\n    kind: parsedKind\n  });\n  const detail = Object.assign({}, saved, {\n    raw: result,\n    infoHtml: text(loaded.body),\n    title: parsedTitle || text(saved.title),\n    author: parsedAuthor || text(saved.author),\n    kind: parsedKind,\n    intro: optionalRuleText(source, rules.intro, result, fieldEnv, text(saved.intro)),\n    latestChapter: optionalRuleText(source, rules.lastChapter, result, fieldEnv, text(saved.latestChapter)),\n    wordCount: optionalRuleText(source, rules.wordCount, result, fieldEnv, text(saved.wordCount)),\n    status: optionalRuleText(source, rules.status, result, fieldEnv, text(saved.status)),\n    updateTime: optionalRuleText(source, rules.updateTime, result, fieldEnv, text(saved.updateTime)),\n    coverUrl: text(saved.coverUrl) || optionalRuleUrl(source, rules.coverUrl, result, fieldEnv, loaded.url, ''),\n    tocSourceUrl: optionalRuleUrl(source, rules.tocUrl, result, fieldEnv, loaded.url, text(saved.tocSourceUrl))\n  });\n  if (!detail.tocSourceUrl) {\n    detail.tocSourceUrl = text(saved.bookUrl);\n  }\n  return { detail, rules, result, fieldEnv };\n}\n\nfunction detailSeed(identity, input) {\n  const saved = Object.assign({}, stored(identity));\n  saved.bookKey = identity;\n  // A discovery row carries the authoritative URL and source identity.  Prefer\n  // non-empty request values over an older per-book snapshot so a previously\n  // cached category-page fallback cannot poison a later detail/catalog open.\n  ['sourceKey', 'sourceName', 'bookUrl', 'title', 'author', 'kind', 'coverUrl', 'latestChapter',\n    'mediaType', 'wordCount', 'intro']\n    .forEach(key => {\n      const value = text(input && input[key]);\n      if (value) saved[key] = value;\n    });\n  if (text(input && input.lastUpdated)) saved.updateTime = text(input.lastUpdated);\n  if (text(input && input.publicationStatus)) saved.status = text(input.publicationStatus);\n  // Search/discover transfers the normalized type to the host instead of the\n  // mutable JS Book. Restore its content bits before consulting any old book\n  // snapshot; otherwise a previous text bit wins over the new comic marker.\n  const contentBits = { text: 8, book: 8, novel: 8, comic: 64, image: 64,\n    audiobook: 32, audio: 32, video: 4, file: 8 | 128 };\n  const selectedType = text(input && input.mediaType).trim().toLowerCase();\n  if (Object.prototype.hasOwnProperty.call(contentBits, selectedType)) {\n    saved.type = (Number(saved.type) & ~(8 | 32 | 64 | 4 | 128)) | contentBits[selectedType];\n  }\n  return saved;\n}\n\nfunction detailFingerprint(source, saved, rules) {\n  // One source/URL can represent multiple content modes. Cache only within the\n  // selected book's type context, including when the user switches back to text.\n  return ruleFingerprint([LEGADO_ENGINE_REVISION, saved.bookUrl, rules,\n    text(source.jsLib), source.bookSourceType, saved.type, saved.mediaType]);\n}\n\nfunction catalogStorageKey(sourceHash, bookHash, generation, chunkIndex) {\n  return `legado.catalog.v2.${sourceHash}.${bookHash}.${generation}.${chunkIndex}`;\n}\n\nfunction detailCacheKey(identity) {\n  return text(identity) + '.detail-cache.v2';\n}\n\nfunction catalogCacheKey(identity) {\n  return text(identity) + '.catalog-cache.v2';\n}\n\nfunction catalogChapterKey(sourceHash, bookHash, generation, chunkIndex, itemIndex) {\n  return `legado.chapter.v2.${sourceHash}.${bookHash}.${generation}.${chunkIndex}.${itemIndex}`;\n}\n\nfunction portableChapterLocator(chapter) {\n  const value = object(chapter);\n  const locator = {};\n  ['bookKey', 'sourceKey', 'chapterUrl', 'raw', 'index', 'title', 'updateTime', 'tag',\n    'isVolume', 'isLocked', 'isVip', 'isPay', 'nextChapterUrl', '__legadoVariables', 'mediaType']\n    .forEach(key => {\n      if (value[key] !== undefined) locator[key] = value[key];\n    });\n  return locator;\n}\n\nfunction publicChapter(chapter) {\n  return { chapterKey: text(chapter.chapterKey), title: text(chapter.title),\n    ordinal: Number(chapter.index || 0), chapterUrl: text(chapter.chapterKey),\n    locator: portableChapterLocator(chapter),\n    isVolume: chapter.isVolume === true, isLocked: chapter.isLocked === true,\n    mediaType: text(chapter.mediaType) };\n}\n\nfunction legacyCachedCatalog(identity, fingerprint) {\n  const cache