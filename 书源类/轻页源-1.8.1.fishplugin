[text, text.replace(/[“”]/g, '\"').replace(/'/g, '\"')]) {\r\n      try {\r\n        const parsed = JSON.parse(candidate)          ;\r\n        if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) return parsed                          ;\r\n      } catch (_) {}\r\n    }\r\n    return null;\r\n  }\r\n\r\n          static headerRecord(raw                    )                         {\r\n    let value                            = raw;\r\n    if (typeof value === 'string') value = this.parseOptionObject(value);\r\n    const headers                         = {};\r\n    if (!value || typeof value !== 'object' || Array.isArray(value)) return headers;\r\n    const record = value                          ;\r\n    for (const key of Object.keys(record)) {\r\n      const item = record[key];\r\n      if (!key.trim() || item === undefined || item === null || typeof item === 'object') continue;\r\n      const text = String(item).trim();\r\n      if (text && !/[\\r\\n]/.test(text)) headers[key.trim()] = text;\r\n    }\r\n    return headers;\r\n  }\r\n\r\n  /** Registrable-domain approximation: `a.cdn.example.com` and `www.example.com` share a site. */\r\n          static siteKey(url        )         {\r\n    const match = String(url || '').trim().match(/^[a-z][a-z0-9+.-]*:\\/\\/(?:[^/?#@]*@)?(\\[[^\\]]+\\]|[^/?#:]+)/i);\r\n    if (!match) return '';\r\n    const host = match[1].toLowerCase();\r\n    if (host.startsWith('[') || /^\\d{1,3}(?:\\.\\d{1,3}){3}$/.test(host)) return host;\r\n    const labels = host.split('.').filter((label        )          => label.length > 0);\r\n    if (labels.length <= 2) return labels.join('.');\r\n    const secondLevel = labels[labels.length - 2];\r\n    const countryCode = labels[labels.length - 1].length === 2;\r\n    const keep = countryCode && ['com', 'net', 'org', 'gov', 'edu', 'co', 'ac'].includes(secondLevel) ? 3 : 2;\r\n    return labels.slice(-keep).join('.');\r\n  }\r\n}\r\n\n// Upstream ../rule/JsonPathEvaluator.ts\n                         \r\n               \r\n               \r\n                  \r\n                    \r\n                       \r\n                     \r\n               \r\n                     \r\n \r\n\r\n                          \r\n                  \r\n \r\n\r\nclass JsonPathEvaluator {\r\n          static          MAX_RESULTS = 50000;\r\n          static          MAX_VISITED_NODES = 200000;\r\n          static          MAX_RECURSION_DEPTH = 64;\r\n\r\n  static evaluate(root        , path        )           {\r\n    const value = (path || '').trim();\r\n    if (!value) return [];\r\n    const tokens = this.tokenize(value);\r\n    if (tokens.length === 0 && (value === '$' || value === '@')) return [root];\r\n    if (tokens.length === 0) return [];\r\n\r\n    let current           = [root];\r\n    const budget                 = { visited: 0 };\r\n    for (const token of tokens) {\r\n      current = this.applyToken(current, token, budget);\r\n      if (current.length === 0) break;\r\n    }\r\n    return current;\r\n  }\r\n\r\n          static tokenize(path        )                  {\r\n    const tokens                  = [];\r\n    let i = path.startsWith('$') || path.startsWith('@') ? 1 : 0;\r\n    while (i < path.length) {\r\n      if (/\\s/.test(path.charAt(i))) { i++; continue; }\r\n      if (path.substring(i, i + 2) === '..') {\r\n        i += 2;\r\n        if (path.charAt(i) === '*') {\r\n          tokens.push(this.token('recursiveWildcard'));\r\n          i++;\r\n          continue;\r\n        }\r\n        if (path.charAt(i) === '[') {\r\n          const close = this.findBracket(path, i);\r\n          if (close < 0) return [];\r\n          const inner = path.substring(i + 1, close).trim();\r\n          const names = this.parseNames(inner);\r\n          if (names.length === 0) return [];\r\n          const token = this.token('recursiveProperty');\r\n          token.names = names;\r\n          tokens.push(token);\r\n          i = close + 1;\r\n          continue;\r\n        }\r\n        const read = this.readName(path, i);\r\n        if (!read.name) return [];\r\n        const token = this.token('recursiveProperty');\r\n        token.names = [read.name];\r\n        tokens.push(token);\r\n        i = read.end;\r\n        continue;\r\n      }\r\n      if (path.charAt(i) === '.') {\r\n        i++;\r\n        if (path.charAt(i) === '[') continue;\r\n        if (path.charAt(i) === '*') {\r\n          tokens.push(this.token('wildcard'));\r\n          i++;\r\n          continue;\r\n        }\r\n        const read = this.readName(path, i);\r\n        if (!read.name) return [];\r\n        const token = this.token('property');\r\n        token.name = read.name;\r\n        tokens.push(token);\r\n        i = read.end;\r\n        continue;\r\n      }\r\n      if (path.charAt(i) === '[') {\r\n        const close = this.findBracket(path, i);\r\n        if (close < 0) return [];\r\n        const token = this.parseBracket(path.substring(i + 1, close).trim());\r\n        if (!token) return [];\r\n        tokens.push(token);\r\n        i = close + 1;\r\n        continue;\r\n      }\r\n      const read = this.readName(path, i);\r\n      if (!read.name) return [];\r\n      const token = this.token('property');\r\n      token.name = read.name;\r\n      tokens.push(token);\r\n      i = read.end;\r\n    }\r\n    return tokens;\r\n  }\r\n\r\n          static token(kind        )                {\r\n    return { kind: kind, name: '', names: [], indexes: [], start: null, end: null, step: 1, expression: '' };\r\n  }\r\n\r\n          static readName(path        , start        )                                {\r\n    let i = start;\r\n    while (i < path.length && !/[.\\[\\]\\s]/.test(path.charAt(i))) i++;\r\n    return { name: path.substring(start, i), end: i };\r\n  }\r\n\r\n          static findBracket(path        , start        )         {\r\n    let depth = 0;\r\n    let quote = '';\r\n    for (let i = start; i < path.length; i++) {\r\n      const ch = path.charAt(i);\r\n      if (quote) {\r\n        if (ch === quote && path.charAt(i - 1) !== '\\\\') quote = '';\r\n        continue;\r\n      }\r\n      if (ch === '\"' || ch === \"'\") { quote = ch; continue; }\r\n      if (ch === '[' || ch === '(') depth++;\r\n      if (ch === ']' || ch === ')') {\r\n        depth--;\r\n        if (depth === 0) return i;\r\n      }\r\n    }\r\n    return -1;\r\n  }\r\n\r\n          static parseBracket(inner        )                       {\r\n    if (inner === '*') return this.token('wildcard');\r\n    if (inner.startsWith('?(') && inner.endsWith(')')) {\r\n      const token = this.token('filter');\r\n      token.expression = inner.substring(2, inner.length - 1).trim();\r\n      return token;\r\n    }\r\n    if (inner.includes(':') && /^\\s*-?\\d*\\s*:\\s*-?\\d*(?:\\s*:\\s*-?\\d+)?\\s*$/.test(inner)) {\r\n      const parts = inner.split(':');\r\n      const token = this.token('slice');\r\n      token.start = parts[0].trim() ? parseInt(parts[0]) : null;\r\n      token.end = parts[1].trim() ? parseInt(parts[1]) : null;\r\n      token.step = parts.length > 2 && parseInt(parts[2]) !== 0 ? parseInt(parts[2]) : 1;\r\n      return token;\r\n    }\r\n    const names = this.parseNames(inner);\r\n    if (names.length > 0) {\r\n      const token = this.token(names.length === 1 ? 'property' : 'properties');\r\n      token.name = names[0];\r\n      token.names = names;\r\n      return token;\r\n    }\r\n    if (/^\\s*-?\\d+(?:\\s*,\\s*-?\\d+)*\\s*$/.test(inner)) {\r\n      const token = this.token('indexes');\r\n      token.indexes = inner.split(',').map(value => parseInt(value.trim()));\r\n      return token;\r\n    }\r\n    return null;\r\n  }\r\n\r\n          static parseNames(inner        )           {\r\n    if (!/^\\s*(['\"])[\\s\\S]*\\1\\s*(?:,\\s*(['\"])[\\s\\S]*\\2\\s*)*$/.test(inner)) return [];\r\n    const names           = [];\r\n    const re = /(['\"])((?:\\\\.|(?!\\1)[\\s\\S])*)\\1/g;\r\n    let match                        ;\r\n    while ((match = re.exec(inner)) !== null) names.push(match[2].replace(/\\\\(['\"\\\\])/g, '$1'));\r\n    return names;\r\n  }\r\n\r\n          static applyToken(values          , token               , budget                )           {\r\n    const out           = [];\r\n    for (const value of values) {\r\n      if (!this.canVisit(budget) || out.length >= this.MAX_RESULTS) break;\r\n      if (token.kind === 'property') this.readProperty(value, token.name, out, budget);\r\n      else if (token.kind === 'properties') {\r\n        for (const name of token.names) {\r\n          this.readProperty(value, name, out, budget);\r\n          if (out.length >= this.MAX_RESULTS) break;\r\n        }\r\n      } else if (token.kind === 'recursiveProperty') {\r\n        for (const name of token.names) {\r\n          this.deepRead(value, name, out, budget, 0);\r\n          if (out.length >= this.MAX_RESULTS) break;\r\n        }\r\n      } else if (token.kind === 'wildcard') this.readWildcard(value, out);\r\n      else if (token.kind === 'recursiveWildcard') this.deepWildcard(value, out, budget, 0);\r\n      else if (token.kind === 'indexes') this.readIndexes(value, token.indexes, out);\r\n      else if (token.kind === 'slice') this.readSlice(value, token.start, token.end, token.step, out);\r\n      else if (token.kind === 'filter') this.readFilter(value, token.expression, out);\r\n    }\r\n    return out;\r\n  }\r\n\r\n          static readProperty(value        , name        , out          , budget                ,\r\n    depth         = 0)       {\r\n    if (!this.canVisit(budget) || depth > this.MAX_RECURSION_DEPTH || out.length >= this.MAX_RESULTS) return;\r\n    if (Array.isArray(value)) {\r\n      for (const item of value            ) {\r\n        this.readProperty(item, name, out, budget, depth + 1);\r\n        if (out.length >= this.MAX_RESULTS || !this.hasBudget(budget)) break;\r\n      }\r\n      return;\r\n    }\r\n    if (!value || typeof value !== 'object') return;\r\n    const found = (value                          )[name];\r\n    if (found !== undefined && found !== null && out.length < this.MAX_RESULTS) out.push(found);\r\n  }\r\n\r\n          static readWildcard(value        , out          )       {\r\n    if (Array.isArray(value)) {\r\n      for (const item of value            ) {\r\n        if (out.length >= this.MAX_RESULTS) break;\r\n        out.push(item);\r\n      }\r\n    } else if (value && typeof value === 'object') {\r\n      const record = value                          ;\r\n      for (const key in record) {\r\n        if (out.length >= this.MAX_RESULTS) break;\r\n        if (record[key] !== undefined && record[key] !== null) out.push(record[key]);\r\n      }\r\n    }\r\n  }\r\n\r\n          static deepRead(value        , name        , out          , budget                , depth        )       {\r\n    if (!this.canVisit(budget) || depth > this.MAX_RECURSION_DEPTH || out.length >= this.MAX_RESULTS) return;\r\n    if (!value || typeof value !== 'object') return;\r\n    if (Array.isArray(value)) {\r\n      for (const item of value            ) {\r\n        this.deepRead(item, name, out, budget, depth + 1);\r\n        if (out.length >= this.MAX_RESULTS || !this.hasBudget(budget)) break;\r\n      }\r\n      return;\r\n    }\r\n    const record = value                          ;\r\n    if (record[name] !== undefined && record[name] !== null && out.length < this.MAX_RESULTS) out.push(record[name]);\r\n    for (const key in record) {\r\n      this.deepRead(record[key], name, out, budget, depth + 1);\r\n      if (out.length >= this.MAX_RESULTS || !this.hasBudget(budget)) break;\r\n    }\r\n  }\r\n\r\n          static deepWildcard(value        , out          , budget                , depth        )       {\r\n    if (!this.canVisit(budget) || depth > this.MAX_RECURSION_DEPTH || out.length >= this.MAX_RESULTS) return;\r\n    if (!value || typeof value !== 'object') return;\r\n    const children           = [];\r\n    this.readWildcard(value, children);\r\n    for (const child of children) {\r\n      if (out.length >= this.MAX_RESULTS || !this.hasBudget(budget)) break;\r\n      out.push(child);\r\n      this.deepWildcard(child, out, budget, depth + 1);\r\n    }\r\n  }\r\n\r\n          static readIndexes(value        , indexes          , out          )       {\r\n    if (!Array.isArray(value)) return;\r\n    const array = value            ;\r\n    for (const raw of indexes) {\r\n      if (out.length >= this.MAX_RESULTS) break;\r\n      const index = raw < 0 ? array.length + raw : raw;\r\n      if (index >= 0 && index < array.length) out.push(array[index]);\r\n    }\r\n  }\r\n\r\n          static readSlice(value        , start               , end               , step        , out          )       {\r\n    if (!Array.isArray(value) || step === 0) return;\r\n    const array = value            ;\r\n    let from = start === null ? (step > 0 ? 0 : array.length - 1) : (start < 0 ? array.length + start : start);\r\n    let to = end === null ? (step > 0 ? array.length : -1) : (end < 0 ? array.length + end : end);\r\n    if (step > 0) {\r\n      from = Math.max(0, from);\r\n      to = Math.min(array.length, to);\r\n      for (let i = from; i < to && out.length < this.MAX_RESULTS; i += step) out.push(array[i]);\r\n    } else {\r\n      from = Math.min(array.length - 1, from);\r\n      to = Math.max(-1, to);\r\n      for (let i = from; i > to && out.length < this.MAX_RESULTS; i += step) out.push(array[i]);\r\n    }\r\n  }\r\n\r\n          static readFilter(value        , expression        , out          )       {\r\n    const candidates = Array.isArray(value) ? value             : [value];\r\n    let checked = 0;\r\n    for (const candidate of candidates) {\r\n      if (out.length >= this.MAX_RESULTS || checked >= this.MAX_VISITED_NODES) break;\r\n      checked++;\r\n      if (this.matchesFilter(candidate, expression)) out.push(candidate);\r\n    }\r\n  }\r\n\r\n          static canVisit(budget                )          {\r\n    if (budget.visited >= this.MAX_VISITED_NODES) return false;\r\n    budget.visited++;\r\n    return true;\r\n  }\r\n\r\n          static hasBudget(budget                )          {\r\n    return budget.visited < this.MAX_VISITED_NODES;\r\n  }\r\n\r\n          static matchesFilter(value        , expression        )          {\r\n    const orParts = this.splitLogical(expression, '||');\r\n    if (orParts.length > 1) return orParts.some(part => this.matchesFilter(value, part));\r\n    const andParts = this.splitLogical(expression, '&&');\r\n    if (andParts.length > 1) return andParts.every(part => this.matchesFilter(value, part));\r\n    let expr = expression.trim();\r\n    if (expr.startsWith('!')) return !this.matchesFilter(value, expr.substring(1));\r\n    const match = expr.match(/^(@(?:\\.[A-Za-z0-9_$-]+|\\[['\"][^'\"]+['\"]\\])*)\\s*(==|!=|>=|<=|>|<|=~)\\s*([\\s\\S]+)$/);\r\n    if (!match) return this.resolveFilterValue(value, expr) !== undefined;\r\n    const left = this.resolveFilterValue(value, match[1]);\r\n    const rightText = match[3].trim();\r\n    if (match[2] === '=~') {\r\n      const regex = rightText.match(/^\\/([\\s\\S]*)\\/([gimsuy]*)$/);\r\n      if (!regex) return false;\r\n      try { return new RegExp(regex[1], regex[2].replace('g', '')).test(String(left === undefined ? '' : left)); } catch (_) { return false; }\r\n    }\r\n    const right = this.parseLiteral(rightText);\r\n    const leftNumber = Number(left);\r\n    const rightNumber = Number(right);\r\n    const numeric = left !== undefined && right !== undefined && !Number.isNaN(leftNumber) && !Number.isNaN(rightNumber);\r\n    const a = numeric ? leftNumber : String(left === undefined ? '' : left);\r\n    const b = numeric ? rightNumber : String(right === undefined ? '' : right);\r\n    if (match[2] === '==') return a === b;\r\n    if (match[2] === '!=') return a !== b;\r\n    if (match[2] === '>') return a > b;\r\n    if (match[2] === '<') return a < b;\r\n    if (match[2] === '>=') return a >= b;\r\n    return a <= b;\r\n  }\r\n\r\n          static resolveFilterValue(value        , path        )                                                 {\r\n    const results = this.evaluate(value, path.trim());\r\n    return results.length > 0 ? results[0]                                       : undefined;\r\n  }\r\n\r\n          static parseLiteral(text        )                                                 {\r\n    const value = text.trim();\r\n    if ((value.startsWith('\"') && value.endsWith('\"')) || (value.startsWith(\"'\") && value.endsWith(\"'\"))) {\r\n      return value.substring(1, value.length - 1);\r\n    }\r\n    if (value === 'true') return true;\r\n    if (value === 'false') return false;\r\n    if (value === 'null') return undefined;\r\n    if (!Number.isNaN(Number(value))) return Number(value);\r\n    return value;\r\n  }\r\n\r\n          static splitLogical(expression        , delimiter        )           {\r\n    const parts           = [];\r\n    let quote = '';\r\n    let depth = 0;\r\n    let start = 0;\r\n    for (let i = 0; i <= expression.length - delimiter.length; i++) {\r\n      const ch = expression.charAt(i);\r\n      if (quote) {\r\n        if (ch === quote && expression.charAt(i - 1) !== '\\\\') quote = '';\r\n        continue;\r\n      }\r\n      if (ch === '\"' || ch === \"'\") { quote = ch; continue; }\r\n      if (ch === '(' || ch === '[') depth++;\r\n      if (ch === ')' || ch === ']') depth--;\r\n      if (depth === 0 && expression.substring(i, i + delimiter.length) === delimiter) {\r\n        parts.push(expression.substring(start, i).trim());\r\n        start = i + delimiter.length;\r\n        i += delimiter.length - 1;\r\n      }\r\n    }\r\n    parts.push(expression.substring(start).trim());\r\n    return parts.filter(part => part.length > 0);\r\n  }\r\n}\r\n\n// Upstream ../http/NetworkErrorText.ts\n/**\r\n * 把请求层的网络错误翻成给读者看的原因（原生与兼容书源共用）。只识别明确属于网络层的失败（域名解析、超时、连不上、\r\n * 安全连接、空响应）：这些情况与登录无关，不能再交给“需要登录或网页验证”的判定。\r\n * 认不出的错误返回空串，由调用方按原有逻辑处理。\r\n */\r\nclass NetworkErrorText {\r\n  static describe(error        , url        )         {\r\n    const text = error || '';\r\n    if (!text) return '';\r\n    const host = NetworkErrorText.hostOf(url);\r\n    const target = host || '服务器';\r\n    if (/2300006|resolve\\s+(the\\s+)?host|could\\s*n['o]?t\\s+resolve|name\\s+does\\s+not\\s+resolve/i.test(text)) {\r\n      return `无法解析域名 ${target}，请检查网络或代理`;\r\n    }\r\n    if (/2300028|operation\\s+timeout|timed?\\s*out|timeout/i.test(text)) {\r\n      return `连接 ${target} 超时，请检查网络`;\r\n    }\r\n    if (/2300007|could\\s*n['o]?t\\s+connect|connection\\s+refused|failed\\s+to\\s+connect|network\\s+is\\s+unreachable/i.test(text)) {\r\n      return `无法连接 ${target}，请检查网络或代理`;\r\n    }\r\n    if (/2300035|2300060|ssl|tls|certificate/i.test(text)) {\r\n      return `与 ${target} 建立安全连接失败`;\r\n    }\r\n    if (/2300052|2300056|empty\\s+reply|recv\\s+failure|connection\\s+reset/i.test(text)) {\r\n      return `${target} 没有返回数据，请稍后重试`;\r\n    }\r\n    return '';\r\n  }\r\n\r\n  static hostOf(url        )         {\r\n    const match = /^[a-z][a-z0-9+.-]*:\\/\\/([^/?#,\\s]+)/i.exec((url || '').trim());\r\n    if (!match) return '';\r\n    const authority = match[1];\r\n    const at = authority.lastIndexOf('@');\r\n    return (at >= 0 ? authority.substring(at + 1) : authority).replace(/:\\d+$/, '');\r\n  }\r\n}\r\n\n// Upstream SourceCoverUrl.ts\n/** A persistent HTTP URL with a local-only source reference. Never send the fragment to HTTP. */\r\nclass SourceCoverUrl {\r\n  static          MARKER = '#source-cover-v1=';\r\n\r\n  static wrap(url        , source        )         {\r\n    if (!/^https?:\\/\\//i.test(url) || !source) return url;\r\n    return url.split('#')[0] + this.MARKER + encodeURIComponent(source);\r\n  }\r\n\r\n  static isEncoded(raw        )          { return raw.includes(this.MARKER); }\r\n\r\n  static source(raw        )         {\r\n    if (raw.length > 8192) throw new Error('Cover URL too long');\r\n    const index = raw.indexOf(this.MARKER);\r\n    if (index < 0) return '';\r\n    const source = decodeURIComponent(raw.substring(index + this.MARKER.length));\r\n    if (!/^https?:\\/\\//i.test(source)) throw new Error('Invalid cover source');\r\n    return source;\r\n  }\r\n\r\n  static address(raw        )         {\r\n    const url = raw.split('#')[0];\r\n    if (!/^https?:\\/\\//i.test(url)) throw new Error('Invalid cover address');\r\n    return url;\r\n  }\r\n}\r\n\n// Upstream NativeExpr.ts\n/**\r\n * 原生书源的表达式语言。\r\n *\r\n * 它不是 JavaScript，也没有任何宿主对象：表达式只能对当前数据求值并调用内置函数。\r\n * 书源还可以在 lib 里用同一套语法定义函数（fn / let / if / for / while / return），用来写签名、\r\n * 解密这类纯计算；函数碰不到网络、Cookie 和文件。求值步数、调用深度和数据大小都有上限，\r\n * 死循环或无限递归会被中止并报错。\r\n *\r\n * 本文件不依赖系统 API，可直接在 Node 回归脚本中加载。\r\n */\r\n\r\n// 表达式在 JSON 值上求值，类型只有运行时才知道。\r\n// eslint-disable-next-line @typescript-eslint/no-explicit-any\r\n                              \r\n\r\n                                 \r\n                                    \r\n                                                           \r\n                                                         \r\n                                                                                  \r\n                                                              \r\n                                                  \r\n                                           \r\n                                                          \r\n                         \r\n                                             \r\n \r\n\r\n/**\r\n * 书源顶层 js 里定义的函数，由宿主的脚本引擎执行。表达式里按函数名直接调用；脚本里通过 native.名称\r\n * 回调内置函数（builtin）。和 lib 一样只做纯计算，碰不到网络和书源状态。\r\n */\r\n                                      \r\n                       \r\n                             \r\n                                                                                                                    \r\n \r\n\r\nclass NativeExprError extends Error {\r\n  constructor(message        ) {\r\n    super(message);\r\n    this.name = 'NativeExprError';\r\n  }\r\n}\r\n\r\nclass NativeScope {\r\n          values                              = {};\r\n          parent                    ;\r\n\r\n  constructor(parent                     = null) {\r\n    this.parent = parent;\r\n  }\r\n\r\n  set(name        , value             )              {\r\n    this.values[name] = value;\r\n    return this;\r\n  }\r\n\r\n  has(name        )          {\r\n    if (Object.prototype.hasOwnProperty.call(this.values, name)) return true;\r\n    return this.parent ? this.parent.has(name) : false;\r\n  }\r\n\r\n  get(name        )              {\r\n    if (Object.prototype.hasOwnProperty.call(this.values, name)) return this.values[name];\r\n    return this.parent ? this.parent.get(name) : undefined;\r\n  }\r\n\r\n  /** 给已声明的变量赋值；变量不存在时返回 false。 */\r\n  assign(name        , value             )          {\r\n    if (Object.prototype.hasOwnProperty.call(this.values, name)) {\r\n      this.values[name] = value;\r\n      return true;\r\n    }\r\n    return this.parent ? this.parent.assign(name, value) : false;\r\n  }\r\n\r\n  child()              {\r\n    return new NativeScope(this);\r\n  }\r\n}\r\n\r\n                 \r\n                                                   \r\n               \r\n                     \r\n              \r\n                                           \r\n               \r\n \r\n\r\n                \r\n            \r\n                  \r\n                \r\n              \r\n           \r\n           \r\n           \r\n                \r\n                \r\n                    \r\n \r\n\r\nclass FunctionDecl {\r\n  name        ;\r\n  params          ;\r\n  body      ;\r\n\r\n  constructor(name        , params          , body      ) {\r\n    this.name = name;\r\n    this.params = params;\r\n    this.body = body;\r\n  }\r\n}\r\n\r\n/** 语句执行中的跳转：return / break / continue。 */\r\nclass Signal {\r\n  kind        ;\r\n  value             ;\r\n\r\n  constructor(kind        , value              = null) {\r\n    this.kind = kind;\r\n    this.value = value;\r\n  }\r\n}\r\n\r\nclass Lambda {\r\n  params          ;\r\n  body      ;\r\n  scope             ;\r\n\r\n  constructor(params          , body      , scope             ) {\r\n    this.params = params;\r\n    this.body = body;\r\n    this.scope = scope;\r\n  }\r\n}\r\n\r\nconst OPERATORS = ['>>>', '=>', '??', '&&', '||', '==', '!=', '<=', '>=', '<<', '>>', '+', '-', '*', '/', '%', '!',\r\n  '<', '>', '?', ':', ',', '.', '(', ')', '[', ']', '{', '}', '&', '|', '^', '~', '=', ';'];\r\nconst KEYWORDS = ['fn', 'let', 'if', 'else', 'for', 'in', 'while', 'return', 'break', 'continue'];\r\nconst MAX_STEPS = 3000000;\r\nconst MAX_CALL_DEPTH = 64;\r\nconst MAX_STRING = 8 * 1024 * 1024;\r\nconst MAX_LIST = 100000;\r\nconst AST_CACHE_LIMIT = 800;\r\n\r\nfunction isIdStart(ch        )          {\r\n  return /[A-Za-z_\\u0080-\\uFFFF]/.test(ch);\r\n}\r\n\r\nfunction isIdPart(ch        )          {\r\n  return /[A-Za-z0-9_\\u0080-\\uFFFF]/.test(ch);\r\n}\r\n\r\nfunction tokenize(source        )          {\r\n  const tokens          = [];\r\n  let i = 0;\r\n  while (i < source.length) {\r\n    const ch = source[i];\r\n    if (ch === ' ' || ch === '\\n' || ch === '\\t' || ch === '\\r') {\r\n      i++;\r\n      continue;\r\n    }\r\n    if (ch === '/' && source[i + 1] === '/') {\r\n      while (i < source.length && source[i] !== '\\n') i++;\r\n      continue;\r\n    }\r\n    if (ch === '/' && source[i + 1] === '*') {\r\n      const end = source.indexOf('*/', i + 2);\r\n      if (end < 0) throw new NativeExprError(`注释没有结束：位置 ${i}`);\r\n      i = end + 2;\r\n      continue;\r\n    }\r\n    const start = i;\r\n    if (ch === '0' && (source[i + 1] === 'x' || source[i + 1] === 'X')) {\r\n      i += 2;\r\n      while (i < source.length && /[0-9a-fA-F]/.test(source[i])) i++;\r\n      const text = source.substring(start, i);\r\n      if (text.length <= 2) throw new NativeExprError(`十六进制数字不完整：位置 ${start}`);\r\n      tokens.push({ kind: 'num', text: text, value: parseInt(text.substring(2), 16), pos: start });\r\n      continue;\r\n    }\r\n    if (ch >= '0' && ch <= '9') {\r\n      while (i < source.length && /[0-9.]/.test(source[i])) i++;\r\n      const text = source.substring(start, i);\r\n      tokens.push({ kind: 'num', text: text, value: Number(text), pos: start });\r\n      continue;\r\n    }\r\n    if (ch === '\"' || ch === \"'\") {\r\n      let out = '';\r\n      i++;\r\n      let closed = false;\r\n      while (i < source.length) {\r\n        const c = source[i];\r\n        if (c === '\\\\' && i + 1 < source.length) {\r\n          const next = source[i + 1];\r\n          // 只转义这几个；其他反斜杠原样保留，写正则时不必再叠一层转义。\r\n          if (next === 'n') out += '\\n';\r\n          else if (next === 't') out += '\\t';\r\n          else if (next === 'r') out += '\\r';\r\n          else if (next === '\\\\' || next === '\"' || next === \"'\") out += next;\r\n          else out += c + next;\r\n          i += 2;\r\n          continue;\r\n        }\r\n        if (c === ch) {\r\n          closed = true;\r\n          i++;\r\n          break;\r\n        }\r\n        out += c;\r\n        i++;\r\n      }\r\n      if (!closed) throw new NativeExprError(`字符串没有结束：位置 ${start}`);\r\n      tokens.push({ kind: 'str', text: out, value: out, pos: start });\r\n      continue;\r\n    }\r\n    if (ch === '$' && (i + 1 >= source.length || !isIdPart(source[i + 1]))) {\r\n      i++;\r\n      // JSONPath 片段：.name、..name、.*、[...]，方括号内允许任意字符。\r\n      while (i < source.length) {\r\n        const c = source[i];\r\n        if (c === '.') {\r\n          let j = i + 1;\r\n          if (source[j] === '.') j++;\r\n          if (source[j] === '*') {\r\n            i = j + 1;\r\n            continue;\r\n          }\r\n          if (source[j] === '[') {\r\n            i = j;\r\n            continue;\r\n          }\r\n          if (j < source.length && isIdPart(source[j])) {\r\n            while (j < source.length && isIdPart(source[j])) j++;\r\n            i = j;\r\n            continue;\r\n          }\r\n          break;\r\n        }\r\n        if (c === '[') {\r\n          let depth = 0;\r\n          let j = i;\r\n          let quote = '';\r\n          while (j < source.length) {\r\n            const d = source[j];\r\n            if (quote) {\r\n              if (d === quote) quote = '';\r\n            } else if (d === '\"' || d === \"'\") {\r\n              quote = d;\r\n            } else if (d === '[') {\r\n              depth++;\r\n            } else if (d === ']') {\r\n              depth--;\r\n              if (depth === 0) break;\r\n            }\r\n            j++;\r\n          }\r\n          if (j >= source.length) throw new NativeExprError(`JSONPath 方括号没有结束：位置 ${i}`);\r\n          i = j + 1;\r\n          continue;\r\n        }\r\n        break;\r\n      }\r\n      const text = source.substring(start, i);\r\n      tokens.push({ kind: 'path', text: text, value: text, pos: start });\r\n      continue;\r\n    }\r\n    if (isIdStart(ch) || ch === '$') {\r\n      i++;\r\n      while (i < source.length && isIdPart(source[i])) i++;\r\n      const text = source.substring(start, i);\r\n      tokens.push({ kind: 'id', text: text, value: text, pos: start });\r\n      continue;\r\n    }\r\n    let matched = '';\r\n    for (const op of OPERATORS) {\r\n      if (source.startsWith(op, i)) {\r\n        matched = op;\r\n        break;\r\n      }\r\n    }\r\n    if (!matched) throw new NativeExprError(`无法识别的字符 “${ch}”：位置 ${i}`);\r\n    tokens.push({ kind: 'op', text: matched, value: matched, pos: start });\r\n    i += matched.length;\r\n  }\r\n  tokens.push({ kind: 'end', text: '', value: null, pos: source.length });\r\n  let previousEnd = 0;\r\n  for (const token of tokens) {\r\n    token.nl = source.substring(previousEnd, token.pos).indexOf('\\n') >= 0;\r\n    previousEnd = token.pos + Math.max(1, token.text.length);\r\n  }\r\n  return tokens;\r\n}\r\n\r\nclass Parser {\r\n          tokens         ;\r\n          index         = 0;\r\n\r\n  constructor(tokens         ) {\r\n    this.tokens = tokens;\r\n  }\r\n\r\n  /** 解析函数库：若干个 fn 定义。 */\r\n  parseLibrary()                 {\r\n    const functions                 = [];\r\n    while (this.peek().kind !== 'end') {\r\n      if (this.take(';')) continue;\r\n      if (!this.isWord('fn')) {\r\n        throw new NativeExprError(`lib 里只能写 fn 定义，实际是 “${this.peek().text}”：位置 ${this.peek().pos}`);\r\n      }\r\n      this.index++;\r\n      const name = this.identifier('函数名');\r\n      this.expect('(');\r\n      const params           = [];\r\n      while (!this.isOp(')')) {\r\n        params.push(this.identifier('参数名'));\r\n        if (!this.take(',')) break;\r\n      }\r\n      this.expect(')');\r\n      functions.push(new FunctionDecl(name, params, this.block()));\r\n    }\r\n    return functions;\r\n  }\r\n\r\n          isWord(word        , offset         = 0)          {\r\n    const token = this.peek(offset);\r\n    return token.kind === 'id' && token.text === word;\r\n  }\r\n\r\n          identifier(label        )         {\r\n    const token = this.peek();\r\n    if (token.kind !== 'id' || KEYWORDS.indexOf(token.text) >= 0) {\r\n      throw new NativeExprError(`此处应为${label}，实际是 “${token.text || '结尾'}”：位置 ${token.pos}`);\r\n    }\r\n    this.index++;\r\n    return token.text;\r\n  }\r\n\r\n          block()       {\r\n    this.expect('{');\r\n    const statements         = [];\r\n    while (!this.isOp('}')) {\r\n      if (this.peek().kind === 'end') throw new NativeExprError('代码块缺少 “}”');\r\n      if (this.take(';')) continue;\r\n      statements.push(this.statement());\r\n    }\r\n    this.expect('}');\r\n    return { t: 'block', args: statements };\r\n  }\r\n\r\n          statement()       {\r\n    if (this.isWord('let')) {\r\n      this.index++;\r\n      const name = this.identifier('变量名');\r\n      this.expect('=');\r\n      return { t: 'let', name: name, a: this.ternary() };\r\n    }\r\n    if (this.isWord('if')) {\r\n      this.index++;\r\n      const condition = this.ternary();\r\n      const whenTrue = this.block();\r\n      let whenFalse                   = undefined;\r\n      if (this.isWord('else')) {\r\n        this.index++;\r\n        whenFalse = this.isWord('if') ? this.statement() : this.block();\r\n      }\r\n      return { t: 'if', a: condition, b: whenTrue, c: whenFalse };\r\n    }\r\n    if (this.isWord('for')) {\r\n      this.index++;\r\n      const names = [this.identifier('循环变量')];\r\n      if (this.take(',')) names.push(this.identifier('循环变量'));\r\n      if (!this.isWord('in')) throw new NativeExprError(`for 语句缺少 in：位置 ${this.peek().pos}`);\r\n      this.index++;\r\n      const source = this.ternary();\r\n      return { t: 'for', params: names, a: source, b: this.block() };\r\n    }\r\n    if (this.isWord('while')) {\r\n      this.index++;\r\n      const condition = this.ternary();\r\n      return { t: 'while', a: condition, b: this.block() };\r\n    }\r\n    if (this.isWord('return')) {\r\n      this.index++;\r\n      const next = this.peek();\r\n      if (next.nl || next.kind === 'end' || this.isOp('}') || this.isOp(';')) return { t: 'return' };\r\n      return { t: 'return', a: this.ternary() };\r\n    }\r\n    if (this.isWord('break') || this.isWord('continue')) {\r\n      const word = this.peek().text;\r\n      this.index++;\r\n      return { t: word };\r\n    }\r\n    const target = this.ternary();\r\n    if (this.take('=')) {\r\n      if (target.t !== 'var' && target.t !== 'index' && target.t !== 'member') {\r\n        throw new NativeExprError(`“=” 左边只能是变量、下标或字段：位置 ${this.peek().pos}`);\r\n      }\r\n      return { t: 'assign', a: target, b: this.ternary() };\r\n    }\r\n    return { t: 'expr', a: target };\r\n  }\r\n\r\n  parse()       {\r\n    const node = this.ternary();\r\n    if (this.peek().kind !== 'end') {\r\n      throw new NativeExprError(`多余的内容 “${this.peek().text}”：位置 ${this.peek().pos}`);\r\n    }\r\n    return node;\r\n  }\r\n\r\n          peek(offset         = 0)        {\r\n    return this.tokens[Math.min(this.index + offset, this.tokens.length - 1)];\r\n  }\r\n\r\n          isOp(text        , offset         = 0)          {\r\n    const token = this.peek(offset);\r\n    return token.kind === 'op' && token.text === text;\r\n  }\r\n\r\n          take(text        )          {\r\n    if (!this.isOp(text)) return false;\r\n    this.index++;\r\n    return true;\r\n  }\r\n\r\n          expect(text        )       {\r\n    if (!this.take(text)) {\r\n      throw new NativeExprError(`此处应为 “${text}”，实际是 “${this.peek().text || '结尾'}”：位置 ${this.peek().pos}`);\r\n    }\r\n  }\r\n\r\n          ternary()       {\r\n    const condition = this.binary(0);\r\n    if (!this.take('?')) return condition;\r\n    const whenTrue = this.ternary();\r\n    this.expect(':');\r\n    const whenFalse = this.ternary();\r\n    return { t: 'cond', a: condition, b: whenTrue, c: whenFalse };\r\n  }\r\n\r\n          static          LEVELS             = [\r\n    ['??'], ['||'], ['&&'], ['|'], ['^'], ['&'], ['==', '!='], ['<', '>', '<=', '>='], ['<<', '>>', '>>>'],\r\n    ['+', '-'], ['*', '/', '%']\r\n  ];\r\n\r\n          binary(level        )       {\r\n    if (level >= Parser.LEVELS.length) return this.unary();\r\n    let left = this.binary(level + 1);\r\n    while (true) {\r\n      const token = this.peek();\r\n      if (token.kind !== 'op' || Parser.LEVELS[level].indexOf(token.text) < 0) return left;\r\n      this.index++;\r\n      left = { t: 'bin', op: token.text, a: left, b: this.binary(level + 1) };\r\n    }\r\n  }\r\n\r\n          unary()       {\r\n    if (this.take('!')) return { t: 'not', a: this.unary() };\r\n    if (this.take('-')) return { t: 'neg', a: this.unary() };\r\n    if (this.take('~')) return { t: 'bitnot', a: this.unary() };\r\n    return this.postfix();\r\n  }\r\n\r\n          postfix()       {\r\n    let node = this.primary();\r\n    while (true) {\r\n      if (this.take('.')) {\r\n        const name = this.peek();\r\n        if (name.kind !== 'id' && name.kind !== 'num') {\r\n          throw new NativeExprError(`“.” 后应为字段名：位置 ${name.pos}`);\r\n        }\r\n        this.index++;\r\n        node = { t: 'member', a: node, name: name.text };\r\n      } else if (this.isOp('[') && !this.peek().nl) {\r\n        this.index++;\r\n        const key = this.ternary();\r\n        this.expect(']');\r\n        node = { t: 'index', a: node, b: key };\r\n      } else if (this.isOp('(') && node.t === 'var' && !this.peek().nl) {\r\n        this.index++;\r\n        const args         = [];\r\n        while (!this.isOp(')')) {\r\n          args.push(this.ternary());\r\n          if (!this.take(',')) break;\r\n        }\r\n        this.expect(')');\r\n        node = { t: 'call', name: node.name, args: args };\r\n      } else {\r\n        return node;\r\n      }\r\n    }\r\n  }\r\n\r\n          lambdaParams()                  {\r\n    // (a, b) => …\r\n    let offset = 1;\r\n    const names           = [];\r\n    while (true) {\r\n      const token = this.peek(offset);\r\n      if (token.kind === 'op' && token.text === ')') break;\r\n      if (token.kind !== 'id') return null;\r\n      names.push(token.text);\r\n      offset++;\r\n      if (this.isOp(',', offset)) {\r\n        offset++;\r\n        continue;\r\n      }\r\n      if (!this.isOp(')', offset)) return null;\r\n    }\r\n    if (!this.isOp('=>', offset + 1)) return null;\r\n    this.index += offset + 2;\r\n    return names;\r\n  }\r\n\r\n          primary()       {\r\n    const token = this.peek();\r\n    if (token.kind === 'num' || token.kind === 'str') {\r\n      this.index++;\r\n      return { t: 'lit', v: token.value };\r\n    }\r\n    if (token.kind === 'path') {\r\n      this.index++;\r\n      return { t: 'path', v: token.text };\r\n    }\r\n    if (token.kind === 'id') {\r\n      if (this.isOp('=>', 1)) {\r\n        this.index += 2;\r\n        return { t: 'lambda', params: [token.text], a: this.ternary() };\r\n      }\r\n      this.index++;\r\n      if (token.text === 'true') return { t: 'lit', v: true };\r\n      if (token.text === 'false') return { t: 'lit', v: false };\r\n      if (token.text === 'null') return { t: 'lit', v: null };\r\n      return { t: 'var', name: token.text };\r\n    }\r\n    if (this.isOp('(')) {\r\n      const params = this.lambdaParams();\r\n      if (params) return { t: 'lambda', params: params, a: this.ternary() };\r\n      this.index++;\r\n      const inner = this.ternary();\r\n      this.expect(')');\r\n      return inner;\r\n    }\r\n    if (this.take('[')) {\r\n      const items         = [];\r\n      while (!this.isOp(']')) {\r\n        items.push(this.ternary());\r\n        if (!this.take(',')) break;\r\n      }\r\n      this.expect(']');\r\n      return { t: 'list', args: items };\r\n    }\r\n    if (this.take('{')) {\r\n      const keys         = [];\r\n      const values         = [];\r\n      while (!this.isOp('}')) {\r\n        const key = this.peek();\r\n        if (key.kind === 'id' || key.kind === 'str' || key.kind === 'num') {\r\n          this.index++;\r\n          keys.push({ t: 'lit', v: key.text });\r\n        } else if (this.take('[')) {\r\n          keys.push(this.ternary());\r\n          this.expect(']');\r\n        } else {\r\n          throw new NativeExprError(`对象的键写法不正确：位置 ${key.pos}`);\r\n        }\r\n        this.expect(':');\r\n        values.push(this.ternary());\r\n        if (!this.take(',')) break;\r\n      }\r\n      this.expect('}');\r\n      return { t: 'map', keys: keys, args: values };\r\n    }\r\n    throw new NativeExprError(`此处缺少表达式，实际是 “${token.text || '结尾'}”：位置 ${token.pos}`);\r\n  }\r\n}\r\n\r\n// 需要传入匿名函数的内置函数：JS 里用数组自带的方法，不经 native 提供。\r\nconst LAMBDA_BUILTINS = ['map', 'flatMap', 'filter', 'find'];\r\n\r\n// 内置函数名：函数库里的定义不能与之重名。新增内置函数时同步补到这里。\r\nconst BUILTIN_NAMES = ['str', 'num', 'int', 'bool', 'typeOf', 'len', 'trim', 'lower', 'upper', 'default', 'coalesce',\r\n  'replace', 'replaceText', 'match', 'matchAll', 'test', 'split', 'lines', 'join', 'compact', 'unique', 'first', 'last',\r\n  'slice', 'reverse', 'concat', 'contains', 'startsWith', 'endsWith', 'indexOf', 'substring', 'padStart', 'urlencode',\r\n  'urldecode', 'base64', 'unbase64', 'hex', 'unhex', 'md5', 'sha1', 'sha256', 'sha512', 'json', 'tojson', 'keys',\r\n  'values', 'entries', 'get', 'lookup', 'map', 'flatMap', 'filter', 'find', 'range', 'sum', 'min', 'max', 'abs', 'round', 'floor',\r\n  'ceil', 'now', 'formatDate', 'stripHtml', 'htmlDecode', 'absUrl', 'sel', 'selAll', 'u32', 'imul', 'pow', 'toHex',\r\n  'parseHex', 'charCode', 'fromCharCode', 'bytes', 'fromBytes', 'hexBytes', 'bytesHex', 'base64Bytes', 'bytesBase64',\r\n  'list', 'push', 'hash', 'hmac', 'encrypt', 'decrypt', 'rsaEncrypt', 'cookie'];\r\n\r\nconst astCache                    = new Map();\r\n\r\nfunction parseExpression(source        )       {\r\n  const cached = astCache.get(source);\r\n  if (cached) return cached;\r\n  const node = new Parser(tokenize(source)).parse();\r\n  if (astCache.size >= AST_CACHE_LIMIT) astCache.clear();\r\n  astCache.set(source, node);\r\n  return node;\r\n}\r\n\r\nfunction utf8Bytes(text        )           {\r\n  const bytes           = [];\r\n  const encoded = encodeURIComponent(text);\r\n  for (let i = 0; i < encoded.length; i++) {\r\n    if (encoded[i] === '%') {\r\n      bytes.push(parseInt(encoded.substring(i + 1, i + 3), 16));\r\n      i += 2;\r\n    } else {\r\n      bytes.push(encoded.charCodeAt(i));\r\n    }\r\n  }\r\n  return bytes;\r\n}\r\n\r\nfunction utf8Text(bytes          )         {\r\n  let encoded = '';\r\n  for (const byte of bytes) encoded += '%' + (byte < 16 ? '0' : '') + byte.toString(16);\r\n  try {\r\n    return decodeURIComponent(encoded);\r\n  } catch (e) {\r\n    let fallback = '';\r\n    for (const byte of bytes) fallback += String.fromCharCode(byte);\r\n    return fallback;\r\n  }\r\n}\r\n\r\nconst BASE64 = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\r\n\r\nfunction base64Encode(bytes          )         {\r\n  let out = '';\r\n  for (let i = 0; i < bytes.length; i += 3) {\r\n    const b0 = bytes[i];\r\n    const b1 = i + 1 < bytes.length ? bytes[i + 1] : 0;\r\n    const b2 = i + 2 < bytes.length ? bytes[i + 2] : 0;\r\n    out += BASE64[b0 >> 2] + BASE64[((b0 & 3) << 4) | (b1 >> 4)];\r\n    out += bytes.length > i + 1 ? BASE64[((b1 & 15) << 2) | (b2 >> 6)] : '=';\r\n    out += i + 2 < bytes.length ? BASE64[b2 & 63] : '=';\r\n  }\r\n  return out;\r\n}\r\n\r\nfunction base64Decode(text        )           {\r\n  const clean = text.replace(/-/g, '+').replace(/_/g, '/').replace(/[^A-Za-z0-9+/]/g, '');\r\n  const bytes           = [];\r\n  for (let i = 0; i < clean.length; i += 4) {\r\n    const c0 = BASE64.indexOf(clean[i]);\r\n    const c1 = i + 1 < clean.length ? BASE64.indexOf(clean[i + 1]) : 0;\r\n    const c2 = i + 2 < clean.length ? BASE64.indexOf(clean[i + 2]) : -1;\r\n    const c3 = i + 3 < clean.length ? BASE64.indexOf(clean[i + 3]) : -1;\r\n    bytes.push((c0 << 2) | (c1 >> 4));\r\n    if (c2 >= 0) bytes.push(((c1 & 15) << 4) | (c2 >> 2));\r\n    if (c3 >= 0) bytes.push(((c2 & 3) << 6) | c3);\r\n  }\r\n  return bytes;\r\n}\r\n\r\nconst HTML_ENTITIES                         = {\r\n  nbsp: ' ', lt: '<', gt: '>', amp: '&', quot: '\"', apos: \"'\", ldquo: '“', rdquo: '”', lsquo: '‘', rsquo: '’',\r\n  hellip: '…', mdash: '—', ndash: '–', middot: '·', emsp: ' ', ensp: ' '\r\n};\r\n\r\nfunction htmlDecode(text        )         {\r\n  return text.replace(/&(#x[0-9a-f]+|#\\d+|[a-z]+);/gi, (all        , body        )         => {\r\n    if (body[0] === '#') {\r\n      const code = body[1] === 'x' || body[1] === 'X' ? parseInt(body.substring(2), 16) : parseInt(body.substring(1), 10);\r\n      return isNaN(code) || code <= 0 || code > 0x10ffff ? all : String.fromCodePoint(code);\r\n    }\r\n    const mapped = HTML_ENTITIES[body.toLowerCase()];\r\n    return mapped === undefined ? all : mapped;\r\n  });\r\n}\r\n\r\nfunction stripHtml(text        )         {\r\n  const withBreaks = text\r\n    .replace(/<(script|style)\\b[\\s\\S]*?<\\/\\1>/gi, '')\r\n    .replace(/<br\\s*\\/?>/gi, '\\n')\r\n    .replace(/<\\/(p|div|h[1-6]|li|tr|section|article)>/gi, '\\n')\r\n    .replace(/<[^>]+>/g, '');\r\n  return htmlDecode(withBreaks).replace(/\\r\\n?/g, '\\n').replace(/\\n{3,}/g, '\\n\\n');\r\n}\r\n\r\nfunction pad2(value        )         {\r\n  return value < 10 ? '0' + value : String(value);\r\n}\r\n\r\nfunction formatDate(input             , pattern        )         {\r\n  if (input === null || input === undefined || input === '' || input === 0) return '';\r\n  let time = typeof input === 'number' ? input : Number(input);\r\n  if (isNaN(time)) {\r\n    time = Date.parse(String(input));\r\n    if (isNaN(time)) return '';\r\n  } else if (Math.abs(time) < 100000000000) {\r\n    time *= 1000; // 秒级时间戳\r\n  }\r\n  const date = new Date(time);\r\n  if (isNaN(date.getTime())) return '';\r\n  return pattern\r\n    .replace(/yyyy/g, String(date.getFullYear()))\r\n    .replace(/MM/g, pad2(date.getMonth() + 1))\r\n    .replace(/dd/g, pad2(date.getDate()))\r\n    .replace(/HH/g, pad2(date.getHours()))\r\n    .replace(/mm/g, pad2(date.getMinutes()))\r\n    .replace(/ss/g, pad2(date.getSeconds()));\r\n}\r\n\r\nclass NativeExpr {\r\n          host                ;\r\n          steps         = 0;\r\n          depth         = 0;\r\n          library                            = new Map();\r\n          script                             = null;\r\n\r\n  constructor(host                ) {\r\n    this.host = host;\r\n  }\r\n\r\n  /** 全部内置函数名。 */\r\n  static builtinNames()           {\r\n    return BUILTIN_NAMES.slice();\r\n  }\r\n\r\n  /** JS 函数库里可以通过 native.名称 调用的内置函数。 */\r\n  static scriptBuiltinNames()           {\r\n    return BUILTIN_NAMES.filter((name        )          => LAMBDA_BUILTINS.indexOf(name) < 0);\r\n  }\r\n\r\n  /** lib 里定义的函数名；语法有误时返回空列表。 */\r\n  static libraryFunctionNames(source                    )           {\r\n    if (!source || !source.trim()) return [];\r\n    try {\r\n      return NativeExpr.parseLibrary(source).map((fn              )         => fn.name);\r\n    } catch (e) {\r\n      return [];\r\n    }\r\n  }\r\n\r\n  /** 语法检查函数库，返回错误信息；通过时返回空串。 */\r\n  static checkLibrary(source        )         {\r\n    try {\r\n      NativeExpr.parseLibrary(source);\r\n      return '';\r\n    } catch (e) {\r\n      return (e         ).message || '函数库语法错误';\r\n    }\r\n  }\r\n\r\n          static parseLibrary(source        )                 {\r\n    const functions = new Parser(tokenize(source || '')).parseLibrary();\r\n    const seen              = new Set();\r\n    for (const fn of functions) {\r\n      if (BUILTIN_NAMES.indexOf(fn.name) >= 0) throw new NativeExprError(`函数名 “${fn.name}” 与内置函数重名`);\r\n      if (seen.has(fn.name)) throw new NativeExprError(`函数 “${fn.name}” 重复定义`);\r\n      seen.add(fn.name);\r\n    }\r\n    return functions;\r\n  }\r\n\r\n  /** 载入书源的函数库，之后的表达式可以直接调用其中的函数。 */\r\n  loadLibrary(source                    )             {\r\n    this.library = new Map();\r\n    if (!source || !source.trim()) return this;\r\n    for (const fn of NativeExpr.parseLibrary(source)) this.library.set(fn.name, fn);\r\n    return this;\r\n  }\r\n\r\n  /** 接上书源的 JS 函数库；查找顺序是 lib 函数、内置函数、JS 函数。 */\r\n  loadScript(script                            )             {\r\n    this.script = script;\r\n    return this;\r\n  }\r\n\r\n  /** 供 JS 里的 native.名称 调用内置函数；scope 是发起调用的那条表达式的作用域。 */\r\n  callBuiltin(name        , args               , scope             )              {\r\n    if (BUILTIN_NAMES.indexOf(name) < 0 || LAMBDA_BUILTINS.indexOf(name) >= 0) {\r\n      throw new NativeExprError(`native.${name} 不是可用的内置函数`);\r\n    }\r\n    return this.invoke(name, args, scope);\r\n  }\r\n\r\n  /** 语法检查，返回错误信息；通过时返回空串。 */\r\n  static check(source        )         {\r\n    try {\r\n      parseExpression(source);\r\n      return '';\r\n    } catch (e) {\r\n      return (e         ).message || '表达式语法错误';\r\n    }\r\n  }\r\n\r\n  /** 检查模板里每个 {{ }} 的语法。 */\r\n  static checkTemplate(template        )         {\r\n    try {\r\n      for (const part of NativeExpr.splitTemplate(template)) {\r\n        if (part.expr) parseExpression(part.text);\r\n      }\r\n      return '';\r\n    } catch (e) {\r\n      return (e         ).message || '模板语法错误';\r\n    }\r\n  }\r\n\r\n  static isTruthy(value             )          {\r\n    if (value === null || value === undefined || value === false || value === 0 || value === '') return false;\r\n    if (typeof value === 'number' && isNaN(value)) return false;\r\n    if (Array.isArray(value)) return value.length > 0;\r\n    return true;\r\n  }\r\n\r\n  static toText(value             )         {\r\n    if (value === null || value === undefined) return '';\r\n    if (typeof value === 'string') return value;\r\n    if (typeof value === 'number') return isNaN(value) ? '' : String(value);\r\n    if (typeof value === 'boolean') return value ? 'true' : 'false';\r\n    if (value instanceof Lambda) return '';\r\n    try {\r\n      return JSON.stringify(value);\r\n    } catch (e) {\r\n      return '';\r\n    }\r\n  }\r\n\r\n  static toNumber(value             )         {\r\n    if (typeof value === 'number') return value;\r\n    if (typeof value === 'boolean') return value ? 1 : 0;\r\n    if (value === null || value === undefined || value === '') return 0;\r\n    const parsed = Number(String(value).trim());\r\n    return isNaN(parsed) ? 0 : parsed;\r\n  }\r\n\r\n  evaluate(source        , scope             )              {\r\n    this.steps = 0;\r\n    this.depth = 0;\r\n    return this.run(parseExpression(source), scope);\r\n  }\r\n\r\n          callFunction(fn              , args               )              {\r\n    if (this.depth >= MAX_CALL_DEPTH) throw new NativeExprError(`函数 “${fn.name}” 调用层数过深`);\r\n    // 函数只看得到自己的参数，读不到书源变量和当前响应，保证它是纯计算。\r\n    const scope = new NativeScope();\r\n    for (let i = 0; i < fn.params.length; i++) scope.set(fn.params[i], i < args.length ? args[i] : null);\r\n    this.depth++;\r\n    try {\r\n      const signal = this.execute(fn.body, scope);\r\n      return signal && signal.kind === 'return' ? signal.value : null;\r\n    } finally {\r\n      this.depth--;\r\n    }\r\n  }\r\n\r\n          execute(node      , scope             )                {\r\n    this.tick();\r\n    switch (node.t) {\r\n      case 'block': {\r\n        const inner = scope.child();\r\n        for (const statement of node.args          ) {\r\n          const signal = this.execute(statement, inner);\r\n          if (signal) return signal;\r\n        }\r\n        return null;\r\n      }\r\n      case 'let':\r\n        scope.set(node.name          , this.run(node.a        , scope));\r\n        return null;\r\n      case 'assign':\r\n        this.assign(node.a        , this.run(node.b        , scope), scope);\r\n        return null;\r\n      case 'if':\r\n        if (NativeExpr.isTruthy(this.run(node.a        , scope))) return this.execute(node.b        , scope);\r\n        return node.c ? this.execute(node.c, scope) : null;\r\n      case 'for': {\r\n        const source = this.run(node.a        , scope);\r\n        const names = node.params            ;\r\n        const isMap = source !== null && typeof source === 'object' && !Array.isArray(source);\r\n        const items                = isMap ? Object.keys(source) : this.asList(source);\r\n        for (let i = 0; i < items.length; i++) {\r\n          const inner = scope.child().set(names[0], items[i]);\r\n          if (names.length > 1) inner.set(names[1], isMap ? source[items[i]] : i);\r\n          const signal = this.execute(node.b        , inner);\r\n          if (signal && signal.kind === 'break') break;\r\n          if (signal && signal.kind === 'return') return signal;\r\n        }\r\n        return null;\r\n      }\r\n      case 'while':\r\n        while (NativeExpr.isTruthy(this.run(node.a        , scope))) {\r\n          const signal = this.execute(node.b        , scope);\r\n          if (signal && signal.kind === 'break') break;\r\n          if (signal && signal.kind === 'return') return signal;\r\n        }\r\n        return null;\r\n      case 'return':\r\n        return new Signal('return', node.a ? this.run(node.a, scope) : null);\r\n      case 'break':\r\n        return new Signal('break');\r\n      case 'continue':\r\n        return new Signal('continue');\r\n      default:\r\n        this.run(node.a        , scope);\r\n        return null;\r\n    }\r\n  }\r\n\r\n          assign(target      , value             , scope             )       {\r\n    if (target.t === 'var') {\r\n      if (!scope.assign(target.name          , value)) {\r\n        throw new NativeExprError(`变量 “${target.name}” 还没有用 let 声明`);\r\n      }\r\n      return;\r\n    }\r\n    const container = this.run(target.a        , scope);\r\n    const key              = target.t === 'member' ? target.name : this.run(target.b        , scope);\r\n    if (Array.isArray(container)) {\r\n      const index = Number(key);\r\n      if (!Number.isInteger(index) || index < 0 || index > container.length || index >= MAX_LIST) {\r\n        throw new NativeExprError(`列表下标越界：${NativeExpr.toText(key)}`);\r\n      }\r\n      container[index] = value;\r\n      return;\r\n    }\r\n    if (container && typeof container === 'object' && !(container instanceof Lambda)) {\r\n      const name = NativeExpr.toText(key);\r\n      if (name === '__proto__' || name === 'constructor' || name === 'prototype') {\r\n        throw new NativeExprError(`不能使用键名 “${name}”`);\r\n      }\r\n      (container                               )[name] = value;\r\n      return;\r\n    }\r\n    throw new NativeExprError('只能给列表元素或对象字段赋值');\r\n  }\r\n\r\n  /** 渲染带 {{ 表达式 }} 的模板。 */\r\n  render(template        , scope             )         {\r\n    if (template.indexOf('{{') < 0) return template;\r\n    let out = '';\r\n    for (const part of NativeExpr.splitTemplate(template)) {\r\n      out += part.expr ? NativeExpr.toText(this.evaluate(part.text, scope)) : part.text;\r\n    }\r\n    return out;\r\n  }\r\n\r\n          static splitTemplate(template        )                                         {\r\n    const parts                                         = [];\r\n    let cursor = 0;\r\n    while (cursor < template.length) {\r\n      const open = template.indexOf('{{', cursor);\r\n      if (open < 0) break;\r\n      // 按花括号层数找结束的 }}：表达式里的对象字面量 {{ {a: 1}}} 取到最后一组，\r\n      // 模板外的 JSON {\"p\":{{page}}} 则在 page 后结束，多出的 } 原样输出。\r\n      let close = -1;\r\n      let quote = '';\r\n      let depth = 0;\r\n      for (let i = open + 2; i < template.length; i++) {\r\n        const ch = template[i];\r\n        if (quote) {\r\n          if (ch === '\\\\') i++;\r\n          else if (ch === quote) quote = '';\r\n        } else if (ch === '\"' || ch === \"'\") {\r\n          quote = ch;\r\n        } else if (ch === '{') {\r\n          depth++;\r\n        } else if (ch === '}') {\r\n          if (depth > 0) {\r\n            depth--;\r\n          } else if (template[i + 1] === '}') {\r\n            close = i;\r\n            break;\r\n          }\r\n        }\r\n      }\r\n      if (close < 0) throw new NativeExprError('模板里的 {{ 没有对应的 }}');\r\n      if (open > cursor) parts.push({ expr: false, text: template.substring(cursor, open) });\r\n      parts.push({ expr: true, text: template.substring(open + 2, close) });\r\n      cursor = close + 2;\r\n    }\r\n    if (cursor < template.length) parts.push({ expr: false, text: template.substring(cursor) });\r\n    return parts;\r\n  }\r\n\r\n          tick()       {\r\n    if (++this.steps > MAX_STEPS) throw new NativeExprError('表达式计算量超出上限');\r\n  }\r\n\r\n          run(node      , scope             )              {\r\n    this.tick();\r\n    switch (node.t) {\r\n      case 'lit':\r\n        return node.v;\r\n      case 'var': {\r\n        const name = node.name          ;\r\n        if (!scope.has(name)) throw new NativeExprError(`未定义的名称 “${name}”`);\r\n        return scope.get(name);\r\n      }\r\n      case 'path':\r\n        return this.readPath(scope.get('item'), node.v          );\r\n      case 'member':\r\n        return this.member(this.run(node.a        , scope), node.name          );\r\n      case 'index': {\r\n        const target = this.run(node.a        , scope);\r\n        const key = this.run(node.b        , scope);\r\n        return this.member(target, typeof key === 'number' ? key : NativeExpr.toText(key));\r\n      }\r\n      case 'not':\r\n        return !NativeExpr.isTruthy(this.run(node.a        , scope));\r\n      case 'neg':\r\n        return -NativeExpr.toNumber(this.run(node.a        , scope));\r\n      case 'bitnot':\r\n        return ~NativeExpr.toNumber(this.run(node.a        , scope));\r\n      case 'cond':\r\n        return NativeExpr.isTruthy(this.run(node.a        , scope)) ?\r\n          this.run(node.b        , scope) : this.run(node.c        , scope);\r\n      case 'bin':\r\n        return this.binary(node, scope);\r\n      case 'list': {\r\n        const items = node.args          ;\r\n        return items.map((item      )              => this.run(item, scope));\r\n      }\r\n      case 'map': {\r\n        const result                              = {};\r\n        const keys = node.keys          ;\r\n        const values = node.args          ;\r\n        for (let i = 0; i < keys.length; i++) {\r\n          result[NativeExpr.toText(this.run(keys[i], scope))] = this.run(values[i], scope);\r\n        }\r\n        return result;\r\n      }\r\n      case 'lambda':\r\n        return new Lambda(node.params            , node.a        , scope);\r\n      case 'call':\r\n        return this.call(node.name          , node.args          , scope);\r\n      default:\r\n        throw new NativeExprError('无法求值的表达式');\r\n    }\r\n  }\r\n\r\n          readPath(item             , path        )              {\r\n    let root              = item;\r\n    if (typeof root === 'string') {\r\n      const text = root.trim();\r\n      if (!text || (text[0] !== '{' && text[0] !== '[')) return null;\r\n      try {\r\n        root = JSON.parse(text);\r\n      } catch (e) {\r\n        return null;\r\n      }\r\n    }\r\n    if (root === null || root === undefined) return null;\r\n    if (path === '$') return root;\r\n    const matches = this.host.jsonPath(root, path);\r\n    const multiple = /\\*|\\.\\.|\\?|:|,/.test(path);\r\n    if (multiple) return matches;\r\n    return matches.length > 0 ? matches[0] : null;\r\n  }\r\n\r\n          member(target             , key                 )              {\r\n    if (target === null || target === undefined) return null;\r\n    if (typeof target === 'string') {\r\n      if (key === 'length') return target.length;\r\n      const index = Number(key);\r\n      return isNaN(index) ? null : (target[index < 0 ? target.length + index : index] ?? null);\r\n    }\r\n    if (Array.isArray(target)) {\r\n      if (key === 'length') return target.length;\r\n      const index = Number(key);\r\n      if (isNaN(index)) return null;\r\n      const value = target[index < 0 ? target.length + index : index];\r\n      return value === undefined ? null : value;\r\n    }\r\n    if (typeof target === 'object' && !(target instanceof Lambda)) {\r\n      const name = String(key);\r\n      if (!Object.prototype.hasOwnProperty.call(target, name)) return null;\r\n      const value = (target                               )[name];\r\n      return value === undefined ? null : value;\r\n    }\r\n    return null;\r\n  }\r\n\r\n          binary(node      , scope             )              {\r\n    const op = node.op          ;\r\n    const left = this.run(node.a        , scope);\r\n    if (op === '&&') return NativeExpr.isTruthy(left) ? this.run(node.b        , scope) : left;\r\n    if (op === '||') return NativeExpr.isTruthy(left) ? left : this.run(node.b        , scope);\r\n    if (op === '??') return left === null || left === undefined ? this.run(node.b        , scope) : left;\r\n    const right = this.run(node.b        , scope);\r\n    switch (op) {\r\n      case '+':\r\n        if (typeof left === 'number' && typeof right === 'number') return left + right;\r\n        if (Array.isArray(left) && Array.isArray(right)) return this.limitList(left.concat(right));\r\n        return this.limitText(NativeExpr.toText(left) + NativeExpr.toText(right));\r\n      case '-':\r\n        return NativeExpr.toNumber(left) - NativeExpr.toNumber(right);\r\n      case '*':\r\n        return NativeExpr.toNumber(left) * NativeExpr.toNumber(right);\r\n      case '/': {\r\n        const divisor = NativeExpr.toNumber(right);\r\n        return divisor === 0 ? 0 : NativeExpr.toNumber(left) / divisor;\r\n      }\r\n      case '%': {\r\n        const divisor = NativeExpr.toNumber(right);\r\n        return divisor === 0 ? 0 : NativeExpr.toNumber(left) % divisor;\r\n      }\r\n      case '==':\r\n        return this.equals(left, right);\r\n      case '!=':\r\n        return !this.equals(left, right);\r\n      case '&':\r\n        return NativeExpr.toNumber(left) & NativeExpr.toNumber(right);\r\n      case '|':\r\n        return NativeExpr.toNumber(left) | NativeExpr.toNumber(right);\r\n      case '^':\r\n        return NativeExpr.toNumber(left) ^ NativeExpr.toNumber(right);\r\n      case '<<':\r\n        return NativeExpr.toNumber(left) << NativeExpr.toNumber(right);\r\n      case '>>':\r\n        return NativeExpr.toNumber(left) >> NativeExpr.toNumber(right);\r\n      case '>>>':\r\n        return NativeExpr.toNumber(left) >>> NativeExpr.toNumber(right);\r\n      default: {\r\n        const bothText = typeof left === 'string' && typeof right === 'string' &&\r\n          (isNaN(Number(left)) || isNaN(Number(right)));\r\n        const a              = bothText ? left : NativeExpr.toNumber(left);\r\n        const b              = bothText ? right : NativeExpr.toNumber(right);\r\n        if (op === '<') return a < b;\r\n        if (op === '>') return a > b;\r\n        if (op === '<=') return a <= b;\r\n        return a >= b;\r\n      }\r\n    }\r\n  }\r\n\r\n          equals(left             , right             )          {\r\n    const a = left === undefined ? null : left;\r\n    const b = right === undefined ? null : right;\r\n    if (a === b) return true;\r\n    if (a === null || b === null) return false;\r\n    if (typeof a === 'object' || typeof b === 'object') return NativeExpr.toText(a) === NativeExpr.toText(b);\r\n    // 数字与数字字符串视为相等，接口里 \"3\" 和 3 混用很常见。\r\n    return NativeExpr.toText(a) === NativeExpr.toText(b);\r\n  }\r\n\r\n          limitText(text        )         {\r\n    if (text.length > MAX_STRING) throw new NativeExprError('表达式生成的文本过大');\r\n    return text;\r\n  }\r\n\r\n          limitList(list               )                {\r\n    if (list.length > MAX_LIST) throw new NativeExprError('表达式生成的列表过大');\r\n    return list;\r\n  }\r\n\r\n          apply(fn             , args               , name        )              {\r\n    if (!(fn instanceof Lambda)) throw new NativeExprError(`${name} 需要一个 x => … 形式的参数`);\r\n    const scope = fn.scope.child();\r\n    for (let i = 0; i < fn.params.length; i++) scope.set(fn.params[i], i < args.length ? args[i] : null);\r\n    return this.run(fn.body, scope);\r\n  }\r\n\r\n          regex(pattern             , flags        )         {\r\n    const text = NativeExpr.toText(pattern);\r\n    try {\r\n      return new RegExp(text, flags);\r\n    } catch (e) {\r\n      throw new NativeExprError(`正则写法不正确：${text}`);\r\n    }\r\n  }\r\n\r\n          asList(value             )                {\r\n    if (Array.isArray(value)) return value;\r\n    if (value === null || value === undefined || value === '') return [];\r\n    return [value];\r\n  }\r\n\r\n          byteList(value             )           {\r\n    if (Array.isArray(value)) return value.map((item             )         => NativeExpr.toNumber(item) & 255);\r\n    return utf8Bytes(NativeExpr.toText(value));\r\n  }\r\n\r\n          crypto(name        , args               )              {\r\n    if (!this.host.crypto) throw new NativeExprError(`当前环境不支持 ${name}`);\r\n    return this.host.crypto(name, args);\r\n  }\r\n\r\n          call(name        , argNodes        , scope             )              {\r\n    const args = argNodes.map((arg      )              => this.run(arg, scope));\r\n    const userFunction = this.library.get(name);\r\n    if (userFunction) return this.callFunction(userFunction, args);\r\n    return this.invoke(name, args, scope);\r\n  }\r\n\r\n          callScript(script                     , name        , args               , scope             )              {\r\n    if (this.depth >= MAX_CALL_DEPTH) throw new NativeExprError(`函数 “${name}” 调用层数过深`);\r\n    this.depth++;\r\n    try {\r\n      return script.call(name, args,\r\n        (builtin        , builtinArgs               )              => this.callBuiltin(builtin, builtinArgs, scope));\r\n    } finally {\r\n      this.depth--;\r\n    }\r\n  }\r\n\r\n          invoke(name        , args               , scope             )              {\r\n    const text = (index        )         => NativeExpr.toText(args[index]);\r\n    const num = (index        , fallback         = 0)         =>\r\n      index < args.length && args[index] !== null && args[index] !== undefined ? NativeExpr.toNumber(args[index]) : fallback;\r\n    switch (name) {\r\n      case 'str':\r\n        return text(0);\r\n      case 'num':\r\n        return num(0);\r\n      case 'int': {\r\n        const parsed = parseInt(text(0), 10);\r\n        return isNaN(parsed) ? num(1) : parsed;\r\n      }\r\n      case 'bool':\r\n        return NativeExpr.isTruthy(args[0]);\r\n      case 'typeOf': {\r\n        const value = args[0];\r\n        if (value === null || value === undefined) return 'null';\r\n        if (Array.isArray(value)) return '