h.min(batch.length, Math.max(0, Number(progress.errorCount) || 0)));\n        if (typeof onProgress === 'function') onProgress({ completed: offset + batchCompleted,\n          total: keys.length, failed: failed + batchFailed, errorCount: errorCount + batchErrors, done: false });\n        if (status && status.done === true) {\n          if (status.ok !== true) throw new Error(text(status.error) || '书源校验执行失败');\n          // Cancellation discards this run in the UI; wait for the active task\n          // to settle, then submit no further batches.\n          if (stopped()) return { rows };\n          const result = status.result;\n          const batchRows = Array.isArray(result) ? result : result && result.rows;\n          if (!Array.isArray(batchRows)) throw new Error('书源校验返回格式无效，未执行失效处理');\n          const byKey = new Map(batchRows.map(row => [text(row && row.sourceKey), row]));\n          for (const key of batch) {\n            const row = byKey.get(key);\n            // Missing/malformed rows are execution failures, never evidence\n            // that a source is invalid and may safely be disabled/deleted.\n            if (!row || (row.executionError !== true && typeof row.valid !== 'boolean')) {\n              rows.push({ sourceKey: key, executionError: true, message: '校验未返回有效结果' });\n              errorCount++;\n            } else {\n              rows.push(row);\n              if (row.executionError === true) errorCount++;\n              else if (row.valid === false) failed++;\n            }\n          }\n          break;\n        }\n        await new Promise(resolve => setTimeout(resolve, 80));\n      }\n      if (typeof onProgress === 'function') onProgress({ completed: rows.length,\n        total: keys.length, failed, errorCount, done: rows.length === keys.length });\n    }\n    return { rows };\n  }\n\n  async function getLoginInfo(source) {\n    return jsonObject(await FishReader.storage.get(stateKey(source, 'loginInfo')), {});\n  }\n\n  async function getLoginUi(source, loginData) {\n    const raw = text(source.loginUi).trim();\n    if (!raw) return [];\n    if (!/^@js:|^<js>/i.test(raw)) {\n      try { return parseLoginUi(raw); } catch (_) { return []; }\n    }\n    if (!FishReader.plugin || typeof FishReader.plugin.execute !== 'function') {\n      throw new Error('当前宿主不支持动态 loginUi');\n    }\n    const sourceKey = text(source.__fishreaderTtsKey ||\n      source.bookSourceUrl || source.bookSourceName).trim();\n    if (!sourceKey) throw new Error('动态 loginUi 缺少书源标识');\n    const value = await FishReader.plugin.execute('manage', {\n      mode: 'getLoginUi', sourceKey, loginData: object(loginData)\n    });\n    if (!Array.isArray(value)) throw new Error('动态 loginUi 未返回配置数组');\n    return value;\n  }\n\n  async function getLoginLabels(source, rows, loginData) {\n    const labels = [], codes = [], indexes = [];\n    (Array.isArray(rows) ? rows : []).forEach((row, index) => {\n      const item = row && typeof row === 'object' ? row : {};\n      const name = text(item.name);\n      const viewName = item.viewName == null ? '' : text(item.viewName);\n      if (!viewName) { labels[index] = name; return; }\n      if (viewName.length >= 3 && viewName.length <= 19 &&\n          viewName.startsWith(\"'\") && viewName.endsWith(\"'\")) {\n        labels[index] = viewName.slice(1, -1);\n        return;\n      }\n      labels[index] = name;\n      codes.push(viewName);\n      indexes.push(index);\n    });\n    if (codes.length === 0) return labels;\n    if (!FishReader.plugin || typeof FishReader.plugin.execute !== 'function') return labels;\n    const sourceKey = text(source.__fishreaderTtsKey ||\n      source.bookSourceUrl || source.bookSourceName).trim();\n    if (!sourceKey) return labels;\n    const resolved = await FishReader.plugin.execute('manage', {\n      mode: 'getLoginLabels', sourceKey, codes, loginData: object(loginData)\n    });\n    if (Array.isArray(resolved)) resolved.forEach((value, offset) => {\n      if (value !== null && value !== undefined && text(value)) labels[indexes[offset]] = text(value);\n    });\n    return labels;\n  }\n\n  async function deleteSource(source) {\n    const prefix = stateKey(source, '');\n    await FishReader.storage.set(prefix + 'loginInfo', '');\n    await FishReader.storage.set(prefix + 'loginHeader', '');\n    await FishReader.storage.set(prefix + 'variable', '');\n    return true;\n  }\n\n  async function deleteSources(sourceKeys) {\n    return FishReader.plugin.execute('manage', { mode: 'deleteSources', sourceKeys,\n      deleteAll: arguments.length > 1 && arguments[1] === true });\n  }\n\n  async function cleanupDeletedSources(sourceKeys) {\n    return FishReader.plugin.execute('manage', { mode: 'cleanupDeletedSources', sourceKeys });\n  }\n\n  global.FishReaderLegadoManage = Object.freeze({\n    execute, validateSources, getLoginInfo, getLoginUi, getLoginLabels, deleteSource, deleteSources,\n    cleanupDeletedSources\n  });\n})(window);\n</script>\n  <script>\n    'use strict';\n    const SOURCE_KEY='lightpage.sources.v1',OLD_SOURCE_KEY='lightpage.sources.legacy',ACTIVE_KEY='lightpage.activeSource.v1',OLD_ACTIVE_KEY='lightpage.activeSource.legacy',ACTIVE_RECORD_KEY='lightpage.activeSourceRecord.v1';\n    // Validation uses the host's background search workflow directly. The\n    // workflow owns the HTTP slots and reports progress while each source\n    // completes, so the management page does not create batch-sized waves.\n    const PAGE_SIZE=50,DATABASE_BATCH_MAX_CHARS=700*1024,DATABASE_BATCH_MAX_STATEMENTS=32,VALIDATION_CONCURRENCY=12,GROUP_SEPARATOR='\\u001f',$=id=>document.getElementById(id);\n    let activeKey='',page=1,total=0,descending=false,openedSource=null,pendingBrowser=null,browserOpenedAt=0,browserOpenPending=false,lastBrowserTarget='',lastBrowserOpenedAt=0,filterTimer=0,loginExtraData={},loginRowsState=[],loginRenderOverride=null,managing=false,activeGroup='',sourceTotal=0,sourceGroupCounts=new Map(),sourceIndexDirty=true,editingGroupOriginal=null,pendingGroupAction='',manageTab='books';\n    const selectedKeys=new Set();\n    function status(value){$('status').textContent=String(value)}\n    function sourceStatus(value){const message=String(value);$('sourceStatus').textContent=message;if(message==='请选择操作')return;$('sourceActionMessage').textContent=message;$('sourceActionDialog').hidden=false}\n    function closeSourceActionDialog(){$('sourceActionDialog').hidden=true}\n    function sourceTypeFor(item){const value=Number(item&&item.bookSourceType);return Number.isFinite(value)?value:0}\n    function sourceTypeSql(){if(manageTab==='comics')return'source_type=2';if(manageTab==='reading')return'source_type=1';if(manageTab==='discover')return\"TRIM(COALESCE(json_extract(source_json,'$.exploreUrl'),''))<>''\";return'(source_type IS NULL OR source_type NOT IN (1,2))'}\n    function applyManageTab(){document.querySelectorAll('[data-manage-tab]').forEach(button=>button.classList.toggle('active',button.dataset.manageTab===manageTab));$('sourceManagerCard').hidden=false;$('validateSources').hidden=false;$('exportAll').hidden=false;$('manageSources').hidden=false;$('sourceGroups').hidden=false}\n    function selectManageTab(value){manageTab=['books','comics','reading','discover'].includes(value)?value:'books';page=1;selectedKeys.clear();managing=false;activeGroup='';sourceIndexDirty=true;applyManageTab();loadPage();scrollTo(0,0)}\n    function sourceKeyHash(value){let hash=2166136261;for(const character of String(value)){hash^=character.charCodeAt(0);hash=Math.imul(hash,16777619)}return(hash>>>0).toString(16).padStart(8,'0')}\n\n    function stableSourceKey(item){const base=String(item&&item.bookSourceUrl||'').trim();return base?base+'#fishreader='+sourceKeyHash(base):''}\n    function sourceKey(item){return String(item&&item.__fishreaderSourceKey||stableSourceKey(item))}\n    function attachSourceKey(item,key){if(!item||typeof item!=='object')return item;try{Object.defineProperty(item,'__fishreaderSourceKey',{value:String(key),configurable:true,enumerable:false,writable:true})}catch(_){item.__fishreaderSourceKey=String(key)}return item}\n    function sourceGroups(item){return[...new Set(String(item&&item.bookSourceGroup||'').split(/[\\n,，;；]+/).map(value=>value.trim()).filter(Boolean))]}\n    function sourceGroupIndex(item){return GROUP_SEPARATOR+sourceGroups(item).join(GROUP_SEPARATOR)+GROUP_SEPARATOR}\n\n    function normalizeSources(value){const list=Array.isArray(value)?value:(value&&Array.isArray(value.value)?value.value:[value]);return list.map(lightpageNativeImport).filter(item=>item&&typeof item==='object'&&!Array.isArray(item)&&String(item.bookSourceUrl||'').trim()&&String(item.bookSourceName||'').trim())}\n\n    function normalizeImportedRules(value){return {sources:normalizeSources(value)}}\n    function applyImportGrouping(imported,grouping){if(!grouping||grouping.mode==='keep')return imported;return{sources:imported.sources.map(item=>Object.assign({},item,{bookSourceGroup:grouping.name}))}}\n    function importGroupingSummary(grouping){return grouping.mode==='merge'?'合并进【'+grouping.name+'】分组':grouping.mode==='new'?'导入新建分组【'+grouping.name+'】':'沿用源分组信息'}\n    async function loadImportGroupNames(){\n      const groups=new Set();\n      // Read only the existing lightweight group indexes, across all media tabs.\n      for(const table of ['legado_sources']){\n        for(let offset=0;;offset+=500){\n          const result=await query('SELECT group_index FROM '+table+' ORDER BY group_index LIMIT 500 OFFSET '+offset,[],500);\n          for(const row of result.rows)for(const name of String(row.group_index||'').split(GROUP_SEPARATOR).filter(Boolean))groups.add(name);\n          if(result.rows.length<500)break;\n          await new Promise(resolve=>setTimeout(resolve,0))\n        }\n      }\n      return [...groups].sort((a,b)=>a.localeCompare(b,'zh-CN',{numeric:true}))\n    }\n    function chooseImportGrouping(){\n      const dialog=$('importGroupDialog'),previousFocus=document.activeElement;\n      const buttons=['importGroupKeep','importGroupMerge','importGroupNew','importGroupCancel','importGroupBack','importGroupNext'];\n      let step='mode',draft=null,groups=null,settled=false,loading=false;\n      return new Promise(resolve=>{\n        const finish=value=>{if(settled)return;settled=true;dialog.hidden=true;for(const id of buttons){$(id).onclick=null;$(id).disabled=false}document.removeEventListener('keydown',onKey);if(previousFocus&&typeof previousFocus.focus==='function')previousFocus.focus();resolve(value)};\n        const render=next=>{\n          step=next;$('importGroupError').textContent='';\n          $('importGroupTitle').textContent=next==='mode'?'是否沿用源分组？':next==='merge'?'合并到现有分组':next==='new'?'新增分组':'确认导入';\n          $('importGroupHint').textContent=next==='confirm'?'确认后开始导入。':next==='mode'?'沿用保留原分组；合并或新增会替换本次导入书源的分组。':'仅调整本次导入条目的分组，不更改其它已有条目。';\n          $('importGroupModes').hidden=next!=='mode';$('importGroupSelectFields').hidden=next!=='merge';$('importGroupNameFields').hidden=next!=='new';$('importGroupSummary').hidden=next!=='confirm';\n          $('importGroupBack').hidden=next==='mode';$('importGroupNext').hidden=next==='mode';$('importGroupNext').textContent=next==='confirm'?'确认导入':'确定';\n          if(next==='confirm')$('importGroupSummary').textContent='当前选择为：'+importGroupingSummary(draft);\n          $(next==='merge'?'importGroupSelect':next==='new'?'importGroupName':next==='confirm'?'importGroupNext':'importGroupKeep').focus()\n        };\n        const openGroupStep=async next=>{\n          if(loading||settled)return;loading=true;\n          for(const id of ['importGroupKeep','importGroupMerge','importGroupNew'])$(id).disabled=true;\n          $('importGroupError').textContent='正在读取现有分组…';\n          try{\n            if(groups===null)groups=await loadImportGroupNames();\n            if(settled)return;\n            const select=$('importGroupSelect');select.innerHTML='';\n            const empty=document.createElement('option');empty.value='';empty.textContent=groups.length?'请选择分组':'暂无现有分组，请返回选择新增';select.appendChild(empty);\n            for(const name of groups){const option=document.createElement('option');option.value=name;option.textContent=name;select.appendChild(option)}\n            render(next)\n          }catch(error){if(!settled)$('importGroupError').textContent='读取分组失败：'+String(error&&error.message||error)}\n          finally{loading=false;if(!settled)for(const id of ['importGroupKeep','importGroupMerge','importGroupNew'])$(id).disabled=false}\n        };\n        const advance=()=>{\n          if(loading||settled)return;\n          if(step==='confirm'){finish(draft);return}\n          if(step==='merge'){\n            const name=$('importGroupSelect').value;\n            if(!name||!groups.includes(name)){$('importGroupError').textContent='请选择一个现有分组；没有分组时请返回选择新增。';return}\n            draft={mode:'merge',name}\n          }else if(step==='new'){\n            const name=$('importGroupName').value.trim();\n            if(!name||name.length>40||/[\\u0000-\\u001f\\u007f,，;；]/.test(name)){$('importGroupError').textContent='分组名称须为 1–40 个字符，不能含逗号、分号、换行或控制字符。';return}\n            if(groups.includes(name)){$('importGroupError').textContent='该分组已存在，请返回选择“合并”。';return}\n            draft={mode:'new',name}\n          }else return;\n          render('confirm')\n        };\n        const onKey=event=>{if(event.key==='Escape'){event.preventDefault();event.stopPropagation();finish(null)}else if(event.key==='Enter'&&step==='new'){event.preventDefault();advance()}};\n        $('importGroupKeep').onclick=()=>{if(loading)return;draft={mode:'keep',name:''};render('confirm')};\n        $('importGroupMerge').onclick=()=>openGroupStep('merge');$('importGroupNew').onclick=()=>openGroupStep('new');\n        $('importGroupCancel').onclick=()=>finish(null);$('importGroupBack').onclick=()=>{draft=null;render('mode')};$('importGroupNext').onclick=advance;\n        $('importGroupName').value='';dialog.hidden=false;render('mode');document.addEventListener('keydown',onKey)\n      })\n    }\n    async function pickImportFiles(){\n      if(typeof FishReader.ui.pickDataFiles==='function')return await FishReader.ui.pickDataFiles();\n      // Older hosts retain their existing single-file flow.\n      const file=await FishReader.ui.pickDataFile();return file?[file]:[]\n    }\n    let importRunning=false;\n    async function runGroupedImport(loadDescriptor,selectFileFirst=false){\n      if(importRunning){status('已有导入流程正在进行，请先完成或取消。');return}\n      importRunning=true;$('importFile').disabled=true;$('importNetwork').disabled=true;\n      let descriptors=[],handedOff=new Set();\n      const select=async()=>{const value=await loadDescriptor();descriptors=Array.isArray(value)?value:(value?[value]:[]);return descriptors.length>0};\n      try{\n        if(selectFileFirst&&!await select()){status('已取消导入');return}\n        const grouping=await chooseImportGrouping();if(!grouping){status('已取消导入');return}\n        if(!selectFileFirst&&!await select()){status('已取消导入');return}\n        const results=[];let completed=0;\n        for(let index=0;index<descriptors.length;index++){\n          const descriptor=descriptors[index],name=String(descriptor.name||('文件 '+(index+1)));\n          status('正在导入文件 '+(index+1)+' / '+descriptors.length+'：'+name);\n          try{\n            if(descriptor.error)throw new Error(String(descriptor.error));\n            // Sequential import keeps staging tables isolated; importer closes its own token.\n            handedOff.add(descriptor);\n            const result=await importLargeFile(descriptor,grouping);\n            if(!result||result.ok)completed++;\n            results.push(name+'：'+(result?result.message:'导入完成'))\n          }catch(error){const message=name+'：导入未完成：'+String(error&&error.message||error);results.push(message);status(message)}\n        }\n        if(descriptors.length>1)status('批量导入结束：'+completed+' / '+descriptors.length+' 个文件完成\\n'+results.join('\\n'));\n        else if(results.length&&descriptors[0].error)status(results[0])\n      }catch(error){const message=String(error&&error.message||error);status(message==='未选择书源文件'?'已取消导入':'导入未完成：'+message)}\n      finally{\n        for(const descriptor of descriptors)if(descriptor.token&&!handedOff.has(descriptor))try{await FishReader.ui.closeDataFile(String(descriptor.token))}catch(_){}\n        importRunning=false;$('importFile').disabled=false;$('importNetwork').disabled=false\n      }\n    }\n    function normalizeSingleQuotedJson(value){const raw=String(value||'');let output='',quote='',escaped=false;for(let index=0;index<raw.length;index++){const character=raw[index];if(!quote){if(character===\"'\"){quote=\"'\";output+='\"'}else{if(character==='\"')quote='\"';output+=character}continue}if(escaped){if(quote===\"'\"&&character===\"'\")output+=\"'\";else if(quote===\"'\"&&character==='\"')output+='\\\\\"';else output+='\\\\'+character;escaped=false;continue}if(character==='\\\\'){escaped=true;continue}if(character===quote){output+='\"';quote='';continue}output+=quote===\"'\"&&character==='\"'?'\\\\\"':character}if(escaped)output+='\\\\';if(quote)throw new Error('登录界面配置包含未闭合字符串');return output}\n    function parseLoginUi(value){const raw=String(value||'').trim();if(!raw)return[];try{const parsed=JSON.parse(raw);return Array.isArray(parsed)?parsed:[]}catch(_){const parsed=JSON.parse(normalizeSingleQuotedJson(raw));return Array.isArray(parsed)?parsed:[]}}\n    function validNetworkDomain(value){const domain=String(value||'').trim().toLowerCase();return domain.length>0&&domain.length<=253&&/^(?:\\*\\.)?(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?))*$/.test(domain)}\n    function domainsFrom(value){const serialized=JSON.stringify(value),urls=(serialized.match(/https?:\\/\\/[A-Za-z0-9.-]+(?::\\d+)?/gi)||[]),dns=[];serialized.replace(/[\"']?dnsIp[\"']?\\s*:\\s*[\"']([^\"']+)[\"']/gi,(_all,raw)=>{String(raw).split(/[\\s,;]+/).forEach(item=>{item=item.trim().replace(/^\\[|\\]$/g,'').toLowerCase();if((/^(?:\\d{1,3}\\.){3}\\d{1,3}$/.test(item)||/^[0-9a-f:]+$/i.test(item))&&validNetworkDomain(item))dns.push(item)});return _all});return[...new Set(urls.map(raw=>{try{return new URL(raw).hostname.toLowerCase().replace(/\\.+$/,'')}catch(_){return''}}).concat(dns).filter(validNetworkDomain))]}\n    function loginRows(source){try{return typeof source.loginUi==='string'?parseLoginUi(source.loginUi):(Array.isArray(source.loginUi)?source.loginUi:[])}catch(_){return[]}}\n    function hasManagePage(source){return !!lightpageNativeDefinition(source)||!!String(source.loginUrl||source.loginUi||source.loginCheckJs||'').trim()}\n    async function query(sql,bindArgs=[],maximumRows=PAGE_SIZE){return FishReader.database.query({sql,bindArgs,maximumRows})}\n    async function initializeDatabase(){await FishReader.database.execute({sql:'CREATE TABLE IF NOT EXISTS legado_sources (source_key TEXT PRIMARY KEY, name TEXT NOT NULL, enabled INTEGER NOT NULL DEFAULT 1, import_order INTEGER NOT NULL, source_json TEXT NOT NULL, group_index TEXT NOT NULL DEFAULT \\'\\', source_type INTEGER NOT NULL DEFAULT 0, created_at_ms INTEGER NOT NULL, updated_at_ms INTEGER NOT NULL)'});try{await FishReader.database.execute({sql:'ALTER TABLE legado_sources ADD COLUMN group_index TEXT NOT NULL DEFAULT \\'\\''})}catch(_){}try{await FishReader.database.execute({sql:'ALTER TABLE legado_sources ADD COLUMN source_type INTEGER'})}catch(_){}await FishReader.database.execute({sql:'CREATE TABLE IF NOT EXISTS legado_source_import_stage (source_key TEXT PRIMARY KEY, name TEXT NOT NULL, enabled INTEGER NOT NULL, source_json TEXT NOT NULL, position INTEGER NOT NULL)'});await FishReader.database.execute({sql:'CREATE INDEX IF NOT EXISTS idx_legado_sources_name ON legado_sources(name)'});await FishReader.database.execute({sql:'CREATE INDEX IF NOT EXISTS idx_legado_sources_enabled_order ON legado_sources(enabled, import_order)'});await FishReader.database.execute({sql:'CREATE INDEX IF NOT EXISTS idx_legado_sources_type_order ON legado_sources(source_type, import_order)'});}\n    async function ensureSourceGroupIndex(){let migrated=0;for(;;){const result=await query(\"SELECT source_key,source_json FROM legado_sources WHERE group_index='' LIMIT 32\",[],32);if(!result.rows.length)break;const statements=[];for(const row of result.rows){let source={};try{source=JSON.parse(String(row.source_json))}catch(_){}statements.push({sql:'UPDATE legado_sources SET group_index=? WHERE source_key=?',bindArgs:[sourceGroupIndex(source),String(row.source_key)]})}await flushDatabaseStatements(statements);migrated+=result.rows.length;if(migrated%128===0){status('正在分批升级书源分类索引：'+migrated+' 个');await new Promise(resolve=>setTimeout(resolve,0))}}if(migrated)sourceIndexDirty=true}\n\n    async function ensureSourceTypeIndex(){let migrated=0;for(;;){const result=await query('SELECT source_key,source_json FROM legado_sources WHERE source_type IS NULL LIMIT 64',[],64);if(!result.rows.length)break;const statements=[];for(const row of result.rows){let source={};try{source=JSON.parse(String(row.source_json))}catch(_){}statements.push({sql:'UPDATE legado_sources SET source_type=? WHERE source_key=?',bindArgs:[sourceTypeFor(source),String(row.source_key)]})}await flushDatabaseStatements(statements);migrated+=result.rows.length;if(migrated%256===0){status('正在整理书源类型：'+migrated+' 个');await new Promise(resolve=>setTimeout(resolve,0))}}if(migrated)sourceIndexDirty=true}\n    async function flushDatabaseStatements(statements){\n      if(!statements.length)return;\n      const emptySize=JSON.stringify({statements:[]}).length;let batch=[],size=emptySize;\n      for(const statement of statements.splice(0)){\n        const serialized=JSON.stringify(statement),statementSize=serialized.length+(batch.length?1:0);\n        if(emptySize+serialized.length>DATABASE_BATCH_MAX_CHARS){\n          if(batch.length){await FishReader.database.batch({statements:batch});batch=[];size=emptySize}\n          await writeOversizedStatement(statement);continue\n        }\n        if(batch.length&&(batch.length>=DATABASE_BATCH_MAX_STATEMENTS||size+statementSize>DATABASE_BATCH_MAX_CHARS)){\n          await FishReader.database.batch({statements:batch});batch=[];size=emptySize\n        }\n        size+=serialized.length+(batch.length?1:0);batch.push(statement)\n      }\n      if(batch.length)await FishReader.database.batch({statements:batch})\n    }\n    async function sourceByKey(key){const result=await query(\"SELECT source_key,source_json FROM legado_sources WHERE source_key=? OR json_extract(source_json,'$.bookSourceUrl')=? ORDER BY CASE WHEN source_key=? THEN 0 ELSE 1 END,import_order ASC LIMIT 1\",[key,key,key],1);return result.rows.length?attachSourceKey(JSON.parse(String(result.rows[0].source_json)),result.rows[0].source_key):null}\n    async function firstEnabled(){const result=await query('SELECT source_key,source_json FROM legado_sources WHERE enabled = 1 ORDER BY import_order ASC LIMIT 1',[],1);return result.rows.length?attachSourceKey(JSON.parse(String(result.rows[0].source_json)),result.rows[0].source_key):null}\n    async function setActive(source){activeKey=source?sourceKey(source):'';await FishReader.storage.set(ACTIVE_KEY,activeKey);await FishReader.storage.set(ACTIVE_RECORD_KEY,source||null)}\n    async function ensureActive(){let source=activeKey?await sourceByKey(activeKey):null;if(!source||source.enabled===false)source=await firstEnabled();await setActive(source)}\n    async function migrateLegacy(){const count=await query('SELECT COUNT(*) AS count FROM legado_sources',[],1);if(Number(count.rows[0].count)>0)return;const legacy=normalizeSources(await FishReader.storage.get(SOURCE_KEY)||await FishReader.storage.get(OLD_SOURCE_KEY)||[]);if(!legacy.length)return;status('正在迁移 '+legacy.length+' 个旧版书源…');await upsertSources(legacy);await FishReader.storage.set(SOURCE_KEY,[]);await FishReader.storage.set(OLD_SOURCE_KEY,[])}\n    async function migrateSourceKeys(){let migrated=0;for(;;){const result=await query(\"SELECT source_key,name,enabled,import_order,source_json,created_at_ms,updated_at_ms FROM legado_sources WHERE instr(source_key,'#fishreader=')=0 ORDER BY import_order ASC LIMIT 50\",[],50);if(!result.rows.length)break;const statements=[];for(const row of result.rows){let source;try{source=JSON.parse(String(row.source_json))}catch(_){continue}const oldKey=String(row.source_key),nextKey=stableSourceKey(source);if(!nextKey||nextKey===oldKey)continue;statements.push({sql:'INSERT INTO legado_sources (source_key,name,enabled,import_order,source_json,source_type,created_at_ms,updated_at_ms) VALUES (?,?,?,?,?,?,?,?) ON CONFLICT(source_key) DO UPDATE SET name=excluded.name,enabled=excluded.enabled,import_order=excluded.import_order,source_json=excluded.source_json,updated_at_ms=excluded.updated_at_ms',bindArgs:[nextKey,String(row.name),Number(row.enabled),Number(row.import_order),String(row.source_json),sourceTypeFor(source),Number(row.created_at_ms),Number(row.updated_at_ms)]},{sql:'DELETE FROM legado_sources WHERE source_key=?',bindArgs:[oldKey]});if(activeKey===oldKey)activeKey=nextKey;migrated++}if(!statements.length)break;await flushDatabaseStatements(statements)}if(migrated){await FishReader.storage.set(ACTIVE_KEY,activeKey);sourceIndexDirty=true;status('已升级 '+migrated+' 个书源标识')}}\n    async function upsertSources(items){\n      if(!items.length)return;\n      // Keep an installed source's private key, login and book references even\n      // when its display name changes. New imports identify a source by URL.\n      const urls=[...new Set(items.map(item=>String(item.bookSourceUrl).trim()))],existing=new Map();\n      for(let offset=0;offset<urls.length;offset+=32){\n        const batch=urls.slice(offset,offset+32),rows=await query(\"SELECT source_key,source_json FROM legado_sources WHERE json_extract(source_json,'$.bookSourceUrl') IN (\"+batch.map(()=>'?').join(',')+\") ORDER BY import_order ASC\",batch,500);\n        for(const row of rows.rows){try{const url=String(JSON.parse(String(row.source_json)).bookSourceUrl||'').trim();if(!existing.has(url))existing.set(url,String(row.source_key))}catch(_){}}\n      }\n      const max=await query('SELECT COALESCE(MAX(import_order), 0) AS maximum FROM legado_sources',[],1);\n      let order=Number(max.rows[0].maximum)||0;const now=Date.now(),statements=[];\n      for(const item of items){const prior=existing.get(String(item.bookSourceUrl).trim());if(prior)attachSourceKey(item,prior);\n        const key=sourceKey(item),name=String(item.bookSourceName||key),enabled=item.enabled===false?0:1;\n        statements.push({sql:'INSERT INTO legado_sources (source_key, name, enabled, import_order, source_json, group_index, source_type, created_at_ms, updated_at_ms) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(source_key) DO UPDATE SET name = excluded.name, enabled = excluded.enabled, source_json = excluded.source_json, group_index = excluded.group_index, source_type = excluded.source_type, updated_at_ms = excluded.updated_at_ms',\n          bindArgs:[key,name,enabled,++order,JSON.stringify(item),sourceGroupIndex(item),sourceTypeFor(item),now,now]})}\n      await flushDatabaseStatements(statements);sourceIndexDirty=true\n    }\n\n    function bytesFromBase64(value){const raw=atob(String(value)),bytes=new Uint8Array(raw.length);for(let index=0;index<raw.length;index++)bytes[index]=raw.charCodeAt(index);return bytes}\n    function sourceStreamParser(onSource,onInvalid=error=>{throw error}){\n      let mode='head',header='',element='',depth=0,inString=false,escaped=false,done=false,first='',started=false,structured=false,oversized=false;\n      const deliver=async(raw,tooLarge=false)=>{\n        let item;\n        try{\n          if(tooLarge)throw new Error('单条规则超过 8 MiB');\n          item=JSON.parse(raw);\n          if(!item||typeof item!=='object'||Array.isArray(item))throw new Error('规则条目不是对象');\n        }catch(error){await onInvalid(error);return}\n        // Only item parsing is recoverable here. Storage/permission failures from\n        // the consumer must propagate instead of being counted as invalid rules.\n        await onSource(item)\n      };\n      const finish=async()=>{const raw=element,tooLarge=oversized;element='';started=false;oversized=false;await deliver(raw,tooLarge)};\n      return{async feed(text,eof=false){\n        for(let index=0;index<text.length;index++){\n          const char=text[index];\n          if(mode==='head'){\n            header+=char;\n            if(!first&&char!=='\\uFEFF'&&!/\\s/.test(char)){\n              first=char;\n              if(char==='['){mode='array';header='';continue}\n              if(char!=='{')throw new Error('规则文件必须是 JSON 数组、单个对象或包装对象')\n            }\n            if(first==='{'){\n              if(/\"(?:value)\"\\s*:\\s*\\[$/.test(header)){mode='array';header='';continue}\n              if(header.length>8*1024*1024)throw new Error('包装对象头部或单个书源超过 8 MiB')\n            }else if(header.length>1024*1024)throw new Error('书源文件头部无效');\n            continue\n          }\n          if(mode==='done')continue;\n          if(!started){\n            if(/\\s|,/.test(char))continue;\n            if(char===']'){done=true;mode='done';continue}\n            started=true;structured=char==='{'||char==='[';depth=0;inString=false;escaped=false\n          }else if(!structured&&!inString&&depth===0&&(char===','||char===']')){\n            await finish();if(char===']'){done=true;mode='done'}continue\n          }\n          if(!oversized){element+=char;if(element.length>8*1024*1024){element='';oversized=true}}\n          if(inString){\n            if(escaped)escaped=false;\n            else if(char==='\\\\')escaped=true;\n            else if(char==='\"')inString=false\n          }else if(char==='\"')inString=true;\n          else if(char==='{'||char==='[')depth++;\n          else if(char==='}'||char===']')depth--;\n          if(structured&&depth===0&&!inString)await finish()\n        }\n        if(eof){\n          if(mode==='head'){\n            await deliver(header);done=true;mode='done'\n          }\n          if(started||!done)throw new Error('规则文件不完整或不是有效 JSON')\n        }\n      }}\n    }\n    async function authorizeDomainList(domains,targetStatus=status){if(!domains.length)return;targetStatus('等待确认 '+domains.length+' 个书源域名…');const grant=await FishReader.plugin.requestNetworkDomains(domains);if(!grant||grant.granted!==true)throw new Error('未授权书源所需网络域名')}\n    function browserRequest(target){if(target&&typeof target==='object')return Object.assign({},target,{url:String(target.url||'').trim()});return{url:String(target||'').trim()}}\n    function browserDomains(target){const raw=browserRequest(target).url;if(/^https?:\\/\\//i.test(raw))return domainsFrom(raw);if(!/^data:text\\/html(?:;charset=[A-Za-z0-9._-]+)?;base64,/i.test(raw))return[];try{return domainsFrom(new TextDecoder('utf-8',{fatal:true}).decode(bytesFromBase64(raw.slice(raw.indexOf(',')+1))))}catch(_){return[]}}\n    async function openPluginBrowser(target,targetStatus=sourceStatus,source=openedSource){const request=browserRequest(target),normalized=request.url,now=Date.now();if(!normalized||browserOpenPending||(normalized===lastBrowserTarget&&now-lastBrowserOpenedAt<1200))return;browserOpenPending=true;lastBrowserTarget=normalized;lastBrowserOpenedAt=now;try{const declared=new Set(source?domainsFrom(source):[]),missing=browserDomains(request).filter(domain=>!declared.has(domain));if(missing.length)await authorizeDomainList(missing,targetStatus);if(targetStatus===sourceStatus)closeSourceActionDialog();await FishReader.ui.openLoginBrowser(request)}finally{browserOpenPending=false}}\n    async function importLargeFile(descriptor=null,grouping={mode:'keep',name:''}){\n  let sourceCount=0,skippedCount=0,sourceStage=[],domains=new Set(),firstSource=null;\n  const skipReasons=[];\n  const skip=error=>{skippedCount++;if(skipReasons.length<3)skipReasons.push(String(error&&error.message||'规则格式无效').slice(0,160))};\n  const summary=()=>skippedCount?'；跳过 '+skippedCount+' 条问题规则（'+skipReasons.join('；')+'）':'';\n  const clear=()=>FishReader.database.execute({sql:'DELETE FROM legado_source_import_stage'});\n  try{\n    descriptor=descriptor||await FishReader.ui.pickDataFile();await clear();\n    const size=Number(descriptor.size),token=String(descriptor.token);\n    if(!Number.isFinite(size)||size<1||size>100*1024*1024)throw new Error('文件需为 1 字节至 100 MiB');\n    const parser=sourceStreamParser(async item=>{\n      let imported;\n      try{imported=applyImportGrouping(normalizeImportedRules(item),grouping);\n        if(!imported.sources.length)throw new Error('缺少 bookSourceUrl/bookSourceName，或不是轻页规则');\n        for(const source of imported.sources){sourceKey(source);sourceGroupIndex(source);sourceTypeFor(source);domainsFrom(source)}\n      }catch(error){skip(error);return}\n      for(const source of imported.sources){const key=sourceKey(source);if(!firstSource)firstSource=source;\n        for(const domain of domainsFrom(source))domains.add(domain);sourceCount++;\n        sourceStage.push({sql:'INSERT OR REPLACE INTO legado_source_import_stage (source_key,name,enabled,source_json,position) VALUES (?,?,?,?,?)',bindArgs:[key,String(source.bookSourceName),source.enabled===false?0:1,JSON.stringify(source),sourceCount]})}\n      if(sourceStage.length>=DATABASE_BATCH_MAX_STATEMENTS)await flushDatabaseStatements(sourceStage)\n    },skip);\n    const decoder=new TextDecoder('utf-8',{fatal:true});let offset=0;\n    while(offset<size){const chunk=await FishReader.ui.readDataFile(token,offset,128*1024),eof=chunk.eof===true;\n      const next=Number(chunk.nextOffset);if(!Number.isFinite(next)||next<=offset||next>size)throw new Error('读取文件进度无效');\n      if(eof&&next!==size)throw new Error('读取文件提前结束');\n      const final=eof||next===size;\n      await parser.feed(decoder.decode(bytesFromBase64(chunk.base64),{stream:!final}),final);offset=next;\n      status('正在解析：'+Math.min(100,Math.floor(offset*100/size))+'% · '+sourceCount+' 个书源 · 跳过 '+skippedCount+' 条');\n      await new Promise(resolve=>setTimeout(resolve,0));if(eof)break}\n    await flushDatabaseStatements(sourceStage);if(!sourceCount){const message='没有有效的轻页规则'+summary();status(message);return{ok:false,message}}\n    await authorizeDomainList([...domains]);\n    for(let offset=0;offset<sourceCount;offset+=32){const result=await query('SELECT source_json FROM legado_source_import_stage ORDER BY position ASC LIMIT 32 OFFSET '+offset,[],32);\n      await upsertSources(result.rows.map(row=>JSON.parse(String(row.source_json))));status('正在写入：'+Math.min(sourceCount,offset+result.rows.length)+' / '+sourceCount);await new Promise(resolve=>setTimeout(resolve,0))}\n    if(firstSource){const selected=await sourceByKey(sourceKey(firstSource));await setActive(selected&&selected.enabled!==false?selected:await firstEnabled())}\n    page=1;await loadPage();const message='导入完成：'+sourceCount+' 个书源'+summary();status(message);return{ok:true,message}\n  }catch(error){const message='导入未完成：'+error.message+summary();status(message);return{ok:false,message}}\n  finally{try{await clear()}catch(_){}if(descriptor)try{await FishReader.ui.closeDataFile(String(descriptor.token))}catch(_){}}\n}\n    function sortSql(){const column=$('sourceSort').value==='name'?'name COLLATE NOCASE':$('sourceSort').value==='enabled'?'enabled':'import_order';return column+' '+(descending?'DESC':'ASC')+', source_key ASC'}\n    function filterSql(options={}){const search=$('sourceFilter').value.trim(),parts=[sourceTypeSql()],bind=[];if(search){parts.push(\"name LIKE ? ESCAPE '\\\\'\");bind.push('%'+search.replace(/[\\\\%_]/g,'\\\\$&')+'%')}if(editingGroupOriginal===null&&activeGroup){parts.push('instr(group_index, ?) > 0');bind.push(GROUP_SEPARATOR+activeGroup+GROUP_SEPARATOR)}if(options.enabledOnly===true)parts.push('enabled=1');return{text:search,where:' WHERE '+parts.join(' AND '),bind}}\n    async function refreshSourceIndex(){if(!sourceIndexDirty)return;const typeWhere=' WHERE '+sourceTypeSql(),count=await query('SELECT COUNT(*) AS count FROM legado_sources'+typeWhere,[],1);sourceTotal=Number(count.rows[0]&&count.rows[0].count)||0;const counts=new Map();for(let offset=0;;offset+=500){const result=await query('SELECT group_index FROM legado_sources'+typeWhere+' ORDER BY import_order ASC LIMIT 500 OFFSET '+offset,[],500);for(const row of result.rows){for(const group of String(row.group_index||'').split(GROUP_SEPARATOR).filter(Boolean))counts.set(group,(counts.get(group)||0)+1)}if(result.rows.length<500)break;await new Promise(resolve=>setTimeout(resolve,0))}sourceGroupCounts=counts;sourceIndexDirty=false;renderGroups()}\n    async function collectSourceKeys(filter={where:'',bind:[]},enabledOnly=false){const keys=[],next={where:String(filter.where||''),bind:Array.isArray(filter.bind)?filter.bind.slice():[]};if(enabledOnly)next.where+=(next.where?' AND ':' WHERE ')+'enabled=1';for(let offset=0;;offset+=500){const result=await query('SELECT source_key,name,enabled FROM legado_sources'+next.where+' ORDER BY import_order ASC LIMIT 500 OFFSET '+offset,next.bind,500);for(const row of result.rows)keys.push({key:String(row.source_key),name:String(row.name),enabled:Number(row.enabled)});if(result.rows.length<500)break;await new Promise(resolve=>setTimeout(resolve,0))}return keys}\n    function closeGroupActions(){pendingGroupAction='';$('groupActionSheet').hidden=true}\n    function openGroupActions(name){if(!name||editingGroupOriginal!==null)return;pendingGroupAction=String(name);$('groupActionTitle').textContent='分类：'+pendingGroupAction;$('groupActionSheet').hidden=false}\n    function bindGroupInteraction(button,name,onClick){let timer=0,longPressed=false,startX=0,startY=0;const cancel=()=>{if(timer){clearTimeout(timer);timer=0}};button.onclick=()=>{if(longPressed){longPressed=false;return}onClick()};if(!name)return;button.title+=' · 长按编辑';button.onpointerdown=event=>{if(event.button!==undefined&&event.button!==0)return;cancel();longPressed=false;startX=Number(event.clientX)||0;startY=Number(event.clientY)||0;timer=setTimeout(()=>{timer=0;longPressed=true;openGroupActions(name)},550)};button.onpointermove=event=>{if(timer&&(Math.abs((Number(event.clientX)||0)-startX)>10||Math.abs((Number(event.clientY)||0)-startY)>10))cancel()};button.onpointerup=cancel;button.onpointercancel=cancel;button.onpointerleave=cancel;button.oncontextmenu=event=>{event.preventDefault();cancel();longPressed=true;openGroupActions(name)}}\n    function renderGroups(){const root=$('sourceGroups'),counts=sourceGroupCounts,names=[...counts.keys()].sort((a,b)=>a.localeCompare(b,'zh-CN',{numeric:true}));if(editingGroupOriginal===null&&activeGroup&&!counts.has(activeGroup))activeGroup='';root.innerHTML='';const fixed=document.createElement('div'),scroll=document.createElement('div');fixed.className='source-group-fixed';scroll.className='source-group-scroll';root.append(fixed,scroll);const appendGroup=(name,target)=>{const button=document.createElement('button');button.className='source-group'+(activeGroup===name?' active':'');button.textContent=name||'全部';button.title=name?(name+' · '+counts.get(name)+' 个书源'):('全部 · '+sourceTotal+' 个书源');button.disabled=editingGroupOriginal!==null;bindGroupInteraction(button,name,()=>{activeGroup=name;page=1;renderGroups();loadPage()});target.appendChild(button)};appendGroup('',fixed);const add=document.createElement('button');add.className='source-group tool';add.textContent='+ 新建';add.disabled=editingGroupOriginal!==null;add.onclick=()=>beginGroupEdit('');fixed.appendChild(add);for(const name of names)appendGroup(name,scroll)}\n\n    async function loadPage(){await refreshSourceIndex();$('sourceHeadingText').textContent=manageTab==='comics'?'已导入漫画源':(manageTab==='reading'?'已导入朗读源':(manageTab==='discover'?'带发现规则的书源':'已导入图书源'));const filter=filterSql(),count=await query('SELECT COUNT(*) AS count FROM legado_sources'+filter.where,filter.bind,1);total=Number(count.rows[0]&&count.rows[0].count)||0;const pages=Math.max(1,Math.ceil(total/PAGE_SIZE));page=Math.min(Math.max(1,page),pages);const result=await query('SELECT source_key,name,enabled,source_json FROM legado_sources'+filter.where+' ORDER BY '+sortSql()+' LIMIT '+PAGE_SIZE+' OFFSET '+((page-1)*PAGE_SIZE),filter.bind,PAGE_SIZE);renderSources(result.rows,pages);updateManagementUi()}\n    function actionButton(label,kind,handler,disabled=false){const button=document.createElement('button');button.textContent=label;button.className=kind==='delete'?'warn':'alt';button.disabled=disabled;button.onclick=handler;return button}\n    function enabledSwitch(source,enabled){const label=document.createElement('label');label.className='source-toggle';label.title=enabled?'已启用，点击停用':'已停用，点击启用';const input=document.createElement('input');input.type='checkbox';input.checked=enabled;input.setAttribute('aria-label',(enabled?'停用':'启用')+'书源 '+String(source.bookSourceName||sourceKey(source)));const track=document.createElement('span');track.className='source-toggle-track';input.onchange=async()=>{const next=input.checked;input.disabled=true;try{await setSourceEnabled(source,next)}catch(error){input.checked=!next;status('修改状态失败：'+error.message)}finally{input.disabled=false}};label.append(input,track);return label}\n    function setSelected(key,selected){if(selected)selectedKeys.add(key);else selectedKeys.delete(key);updateManagementUi()}\n    function updateManagementUi(){const groupEditing=editingGroupOriginal!==null,selecting=managing||groupEditing,empty=selectedKeys.size===0;$('sourceManagerCard').classList.toggle('manage-mode',selecting);$('managementTools').hidden=!managing||groupEditing;$('selectionActions').hidden=!managing||groupEditing;$('groupEditor').hidden=!groupEditing;$('manageSources').disabled=groupEditing;$('manageSources').textContent=managing?'完成':'管理';$('selectedCount').textContent='已选 '+selectedKeys.size+' 个';$('clearSelection').disabled=empty;$('exportSelected').disabled=empty;$('deleteSelected').disabled=empty;$('enableSelected').disabled=empty;$('disableSelected').disabled=empty;$('exportAll').disabled=sourceTotal===0}\n    function renderSources(rows,pages){const root=$('sources');root.innerHTML='';$('sourceCount').textContent='共 '+total+' 个';$('pageInfo').textContent='第 '+page+' / '+pages+' 页';$('pageJump').value=String(page);$('previousPage').disabled=page<=1;$('nextPage').disabled=page>=pages;if(!rows.length){root.innerHTML='<p class=\"hint\">没有符合条件的书源</p>';return}for(const row of rows){const source=attachSourceKey(JSON.parse(String(row.source_json)),row.source_key),enabled=Number(row.enabled)===1,key=String(row.source_key),div=document.createElement('div');div.className='source'+(selectedKeys.has(key)?' selected':'');const selectLabel=document.createElement('label');selectLabel.className='source-select';const checkbox=document.createElement('input');checkbox.type='checkbox';checkbox.checked=selectedKeys.has(key);checkbox.setAttribute('aria-label','选择书源 '+String(row.name||key));checkbox.onchange=()=>{setSelected(key,checkbox.checked);div.classList.toggle('selected',checkbox.checked)};selectLabel.appendChild(checkbox);const main=document.createElement('div');main.className='source-main';const title=document.createElement('strong');title.textContent=String(row.name||'未命名书源');const small=document.createElement('small');small.textContent=key;main.append(title,small);const content=document.createElement('div');content.className='source-content';const actions=document.createElement('div');actions.className='chips';if(hasManagePage(source))actions.appendChild(actionButton('打开书源','open',()=>openSource(source)));actions.appendChild(enabledSwitch(source,enabled));actions.appendChild(actionButton('删除','delete',()=>removeSource(source)));content.append(main,actions);div.append(selectLabel,content);div.onclick=event=>{if((!managing&&editingGroupOriginal===null)||event.target===checkbox)return;checkbox.checked=!checkbox.checked;checkbox.onchange()};root.appendChild(div)}}\n\n    async function beginGroupEdit(name){await refreshSourceIndex();editingGroupOriginal=String(name);activeGroup=String(name);selectedKeys.clear();if(name){const filter={where:' WHERE instr(group_index, ?) > 0',bind:[GROUP_SEPARATOR+name+GROUP_SEPARATOR]};for(const item of await collectSourceKeys(filter))selectedKeys.add(item.key)}$('groupName').value=String(name);$('deleteGroup').hidden=!name;page=1;renderGroups();await loadPage();$('groupName').focus()}\n    async function writeGroupEdit(nextName,removeOnly=false){const original=String(editingGroupOriginal??''),statements=[];for(let offset=0;;offset+=100){const result=await query('SELECT source_key,source_json FROM legado_sources WHERE '+sourceTypeSql()+' ORDER BY import_order ASC LIMIT 100 OFFSET '+offset,[],100);for(const row of result.rows){let source;try{source=JSON.parse(String(row.source_json))}catch(_){continue}const key=String(row.source_key),before=sourceGroups(source),after=before.filter(group=>group!==original),included=selectedKeys.has(key);if(!removeOnly&&included&&nextName&&!after.includes(nextName))after.push(nextName);if(before.join('\\n')===after.join('\\n'))continue;if(after.length)source.bookSourceGroup=after.join(',');else delete source.bookSourceGroup;statements.push({sql:'UPDATE legado_sources SET source_json=?,group_index=?,updated_at_ms=? WHERE source_key=?',bindArgs:[JSON.stringify(source),sourceGroupIndex(source),Date.now(),key]});if(statements.length>=DATABASE_BATCH_MAX_STATEMENTS)await flushDatabaseStatements(statements)}if(result.rows.length<100)break;await new Promise(resolve=>setTimeout(resolve,0))}await flushDatabaseStatements(statements)}\n    async function saveGroupEdit(){if(editingGroupOriginal===null)return;const name=$('groupName').value.trim();if(!name){status('请输入分类名称');return}const duplicate=sourceGroupCounts.has(name)&&name!==editingGroupOriginal;if(duplicate){status('已存在同名分类，请换一个名称');return}status('正在保存分类“'+name+'”…');await writeGroupEdit(name,false);editingGroupOriginal=null;selectedKeys.clear();activeGroup=name;sourceIndexDirty=true;page=1;await loadPage();status('分类已保存')}\n    async function cancelGroupEdit(){editingGroupOriginal=null;selectedKeys.clear();page=1;renderGroups();await loadPage();status('已取消分类编辑')}\n    async function deleteGroupEdit(){if(editingGroupOriginal===null||!editingGroupOriginal)return;const name=editingGroupOriginal;if(!confirm('删除分类“'+name+'”？\\n\\n只移除分类，不会删除分类中的书源。'))return;status('正在删除分类“'+name+'”…');await writeGroupEdit('',true);editingGroupOriginal=null;selectedKeys.clear();activeGroup='';sourceIndexDirty=true;page=1;await loadPage();status('分类已删除，书源仍然保留')}\n    function toggleManagement(){managing=!managing;if(!managing)selectedKeys.clear();updateManagementUi();loadPage()}\n    async function selectAllResults(){await refreshSourceIndex();for(const item of await collectSourceKeys(filterSql()))selectedKeys.add(item.key);await loadPage();status('已选择当前结果中的 '+selectedKeys.size+' 个书源')}\n    async function clearSelected(){selectedKeys.clear();await loadPage()}\n    function bytesToBase64(bytes){let raw='';for(let offset=0;offset<bytes.length;offset+=8192)raw+=String.fromCharCode.apply(null,bytes.subarray(offset,Math.min(bytes.length,offset+8192)));return btoa(raw)}\n    async function writeExportText(token,text){const bytes=new TextEncoder().encode(text);for(let offset=0;offset<bytes.length;offset+=192*1024){const chunk=bytes.subarray(offset,Math.min(bytes.length,offset+192*1024));await FishReader.ui.writeExportFile(token,bytesToBase64(chunk))}}\n    function exportFileName(count){const stamp=new Date().toISOString().replace(/[-:T]/g,'').slice(0,14);return'FishReader_轻页书源_'+count+'条_'+stamp+'.json'}\n\n    async function exportSources(selectedOnly){await refreshSourceIndex();const selected=selectedOnly?new Set(selectedKeys):null,targetCount=selected?selected.size:sourceTotal,typeWhere=selected?'':' WHERE '+sourceTypeSql();if(!targetCount){status(selectedOnly?'请先选择要导出的书源':'没有可导出的书源');return}let descriptor=null,exported=0,buffer='[';try{status('正在准备导出 '+targetCount+' 个书源…');descriptor=await FishReader.ui.createExportFile(exportFileName(targetCount));for(let offset=0;;offset+=100){const result=await query('SELECT source_key, source_json FROM legado_sources'+typeWhere+' ORDER BY import_order ASC LIMIT 100 OFFSET '+offset,[],100);if(!result.rows.length)break;for(const row of result.rows){if(selected&&!selected.has(String(row.source_key)))continue;const fragment=(exported?',':'')+JSON.stringify(lightpageNativeExport(JSON.parse(String(row.source_json))));if(buffer.length+fragment.length>96*1024){await writeExportText(descriptor.token,buffer);buffer=''}if(fragment.length>96*1024)await writeExportText(descriptor.token,fragment);else buffer+=fragment;exported++}status('正在生成导出文件：'+exported+' / '+targetCount);await new Promise(resolve=>setTimeout(resolve,0));if(result.rows.length<100)break}buffer+=']';await writeExportText(descriptor.token,buffer);status('文件已生成，请选择保存位置…');await FishReader.ui.finishExportFile(descriptor.token);descriptor=null;status('导出完成：'+exported+' 个书源')}catch(error){if(descriptor)try{await FishReader.ui.cancelExportFile(descriptor.token)}catch(_){}status('导出失败：'+error.message)}}\n\n    let validationRunning=false,validationPreparing=false,validationStopRequested=false,validationExecutionFailed=false,validationExecutionErrors=0,validationExecutionErrorMessage='',validationCandidates=[],validationInvalid=[],validationChecked=0,validationLiveChecked=0,validationLiveInvalid=0;\n    function selectedValidationAction(){const node=document.querySelector('input[name=\"validationAction\"]:checked');return node?String(node.value):'none'}\n    function setValidationOptionState(disabled){document.querySelectorAll('input[name=\"validationAction\"]').forEach(node=>{node.disabled=disabled})}\n    function renderValidationStatus(){const checked=validationRunning?Math.max(validationChecked,validationLiveChecked):validationChecked,invalid=validationRunning?Math.max(validationInvalid.length,validationLiveInvalid):validationInvalid.length,errorText=validationExecutionErrors>0?'•异常：'+validationExecutionErrors:'';$('validationProgress').textContent='已校验：'+checked+'/'+validationCandidates.length+'•失效：'+invalid+errorText}\n    function closeSourceValidation(){if(validationRunning||validationPreparing){validationStopRequested=true;return}$('sourceValidationSheet').hidden=true;$('validateSources').disabled=false;setValidationOptionState(false)}\n    function requestValidationStop(){if(validationRunning||validationPreparing){validationStopRequested=true;$('sourceValidationSheet').hidden=true;$('cancelValidation').disabled=true;$('startValidation').disabled=true;status('正在停止书源校验，等待当前请求完成…');return}closeSourceValidation()}\n    async function deleteValidatedSources(keys){if(!keys.length)return 0;const result=await FishReaderLegadoManage.deleteSources(keys,false);sourceIndexDirty=true;selectedKeys.clear();await ensureActive();page=1;await loadPage();let cleaned=0;for(let offset=0;offset<keys.length;offset+=50){const chunk=keys.slice(offset,Math.min(keys.length,offset+50));await FishReaderLegadoManage.cleanupDeletedSources(chunk);cleaned+=chunk.length;renderValidationStatus();await new Promise(resolve=>setTimeout(resolve,0))}return Number(result&&result.deleted||keys.length)}\n    async function applyValidatedAction(){const keys=validationInvalid.map(item=>item.key),action=selectedValidationAction();if(!keys.length||action==='none')return 0;if(action==='disable'){selectedKeys.clear();keys.forEach(key=>selectedKeys.add(key));await setSelectedSourcesEnabled(false);selectedKeys.clear();return keys.length}if(action==='delete')return deleteValidatedSources(keys);return 0}\n    function consumeValidationRows(items,rows){const list=Array.isArray(rows)?rows:(rows&&Array.isArray(rows.rows)?rows.rows:[]),byKey=new Map(list.map(row=>[String(row&&row.sourceKey||''),row]));for(const item of items){const result=byKey.get(item.key)||{valid:false,message:'校验未返回结果'};if(result.executionError===true||(result.valid!==true&&/\\b(?:401|403|429|5\\d\\d)\\b|timeout|timed out|network|网络|超时|登录|验证码|验证页|授权/i.test(String(result.message||'')))){validationExecutionErrors++;validationExecutionErrorMessage=String(result.message||'批量请求或规则解析失败');continue}validationChecked++;if(result.valid!==true)validationInvalid.push({key:item.key,name:item.name,message:String(result.message||'校验失败')});validationLiveChecked=validationChecked;validationLiveInvalid=validationInvalid.length;renderValidationStatus()}}\n    async function prepareSourceValidation(){validationPreparing=true;try{await refreshSourceIndex();if(validationStopRequested)return;validationCandidates=await collectSourceKeys({where:'',bind:[]},true);validationExecutionFailed=false;validationExecutionErrors=0;validationExecutionErrorMessage='';validationInvalid=[];validationChecked=0;validationLiveChecked=0;validationLiveInvalid=0;renderValidationStatus();$('startValidation').disabled=validationCandidates.length===0;if(validationCandidates.length===0)$('validationProgress').textContent='已校验：0/0•失效：0\\\\n没有已启用书源'}catch(error){$('validationProgress').textContent='校验准备失败：'+(error&&error.message?error.message:String(error));$('startValidation').disabled=true}finally{validationPreparing=false;if(validationStopRequested){$('sourceValidationSheet').hidden=true;$('validateSources').disabled=false;setValidationOptionState(false)}else $('cancelValidation').disabled=false}}\n    async function runSourceValidation(){\n      if(validationRunning||validationPreparing||validationCandidates.length===0)return;\n      validationRunning=true;validationStopRequested=false;validationExecutionFailed=false;validationExecutionErrors=0;validationExecutionErrorMessage='';validationInvalid=[];validationChecked=0;\n      validationLiveChecked=0;validationLiveInvalid=0;\n      $('startValidation').disabled=true;$('cancelValidation').disabled=false;setValidationOptionState(true);\n      try{\n        validationLiveChecked=0;validationLiveInvalid=0;renderValidationStatus();\n        const rows=await FishReaderLegadoManage.validateSources({sourceKeys:validationCandidates.map(item=>item.key),keyword:'我的',concurrency:VALIDATION_CONCURRENCY},value=>{if(value&&typeof value==='object'){const completed=Math.max(0,Number(value.completed)||0),failed=Math.max(0,Number(value.failed)||0),errorCount=Math.max(0,Number(value.errorCount)||0);validationLiveChecked=Math.max(validationLiveChecked,completed);validationLiveInvalid=Math.max(validationLiveInvalid,failed);validationExecutionErrors=Math.max(validationExecutionErrors,errorCount);renderValidationStatus()}},()=>validationStopRequested);\n        if(!validationStopRequested){validationExecutionErrors=0;consumeValidationRows(validationCandidates,rows);}\n        const stopped=validationStopRequested;const affected=await applyValidatedAction();sourceIndexDirty=true;await loadPage();validationLiveChecked=validationChecked;validationLiveInvalid=validationInvalid.length;renderValidationStatus();\n        const action=selectedValidationAction(),actionText=affected>0?(action==='disable'?'，已关闭失效书源':(action==='delete'?'，已删除失效书源':'')):'';\n         const errorText=validationExecutionErrors>0?'，异常 '+validationExecutionErrors+' 个（未按失效处理'+(validationExecutionErrorMessage?'：'+validationExecutionErrorMessage:'')+'）':'';status((stopped?'书源校验已停止：':'书源校验完成：')+'已校验 '+validationChecked+' / '+validationCandidates.length+' 个，失效 '+validationInvalid.length+' 个'+actionText+errorText)\n      }catch(error){$('validationProgress').textContent='校验失败：'+(error&&error.message?error.message:String(error));status('书源校验失败：'+(error&&error.message?error.message:String(error)))}\n      finally{validationRunning=false;if(validationStopRequested){$('sourceValidationSheet').hidden=true;$('validateSources').disabled=false;setValidationOptionState(false)}else{$('startValidation').disabled=false;$('startValidation').textContent='重新校验';$('cancelValidation').disabled=false;setValidationOptionState(false)}}\n    }\n    function openSourceValidation(){if(validationRunning||validationPreparing)return;$('sourceValidationSheet').hidden=false;$('validateSources').disabled=true;$('startValidation').disabled=true;$('cancelValidation').disabled=false;$('cancelValidation').textContent='退出';$('startValidation').textContent='开始校验';const none=document.querySelector('input[name=\"validationAction\"][value=\"none\"]');if(none)none.checked=true;setValidationOptionState(false);validationStopRequested=false;validationCandidates=[];validationInvalid=[];validationChecked=0;validationLiveChecked=0;validationLiveInvalid=0;renderValidationStatus();void prepareSourceValidation()}\n    async function removeSelectedSources(){const keys=[...selectedKeys];if(!keys.length)return;if(!confirm('确定删除选中的 '+keys.length+' 个书源？\\n\\n对应登录信息、运行变量也会删除，且无法撤销。'))return;try{const deleteAll=false;status('正在删除 '+keys.length+' 个书源…');const result=await FishReaderLegadoManage.deleteSources(keys,deleteAll);sourceIndexDirty=true;selectedKeys.clear();await ensureActive();page=1;await loadPage();const deleted=Number(result&&result.deleted||keys.length);status('已删除 '+deleted+' 个书源；正在分批清理登录信息和运行变量…');let cleaned=0;for(let offset=0;offset<keys.length;offset+=50){const chunk=keys.slice(offset,offset+50);await FishReaderLegadoManage.cleanupDeletedSources(chunk);cleaned+=chunk.length;status('已删除 '+deleted+' 个书源；正在清理运行数据 '+cleaned+' / '+keys.length);await new Promise(resolve=>setTimeout(resolve,0))}status('已删除 '+deleted+' 个书源，相关登录信息和运行变量已清理')}catch(error){status('批量删除未完全完成：'+error.message+'。已删除的书源不会恢复，可重新进入页面查看剩余项。');await loadPage()}}\n    async function setSelectedSourcesEnabled(enabled){const keys=[...selectedKeys];if(!keys.length)return;const action=enabled?'启用':'禁用';let changed=0;try{status('正在'+action+' '+keys.length+' 个书源…');for(let offset=0;offset<keys.length;offset+=200){const chunk=keys.slice(offset,offset+200),result=await query('SELECT source_key,source_json FROM legado_sources WHERE source_key IN ('+chunk.map(()=>'?').join(',')+')',chunk,chunk.length),statements=[];for(const row of result.rows){const key=String(row.source_key),now=Date.now();try{const source=JSON.parse(String(row.source_json));source.enabled=enabled;statements.push({sql:'UPDATE legado_sources SET enabled=?,source_json=?,updated_at_ms=? WHERE source_key=?',bindArgs:[enabled?1:0,JSON.stringify(source),now,key]})}catch(_){statements.push({sql:'UPDATE legado_sources SET enabled=?,updated_at_ms=? WHERE source_key=?',bindArgs:[enabled?1:0,now,key]})}}await flushDatabaseStatements(statements);changed+=result.rows.length;status('正在'+action+'书源：'+changed+' / '+keys.length);await new Promise(resolve=>setTimeout(resolve,0))}sourceIndexDirty=true;await ensureActive();await loadPage();status('已'+action+' '+changed+' 个书源')}catch(error){sourceIndexDirty=true;await loadPage();status('批量'+action+'未完全完成：'+error.message+'。已更新的状态会保留。')}}\n    async function setSourceEnabled(source,enabled){source.enabled=enabled;await flushDatabaseStatements([{sql:'UPDATE legado_sources SET enabled = ?, source_json = ?, updated_at_ms = ? WHERE source_key = ?',bindArgs:[enabled?1:0,JSON.stringify(source),Date.now(),sourceKey(source)]}]);sourceIndexDirty=true;if(sourceKey(source)===activeKey&&!enabled)await ensureActive();else if(sourceKey(source)===activeKey)await setActive(source);await loadPage();status(enabled?'书源已启用':'书源已停用')}\n    async function deleteRecord(source,clearRuntime=true){if(clearRuntime)await FishReaderLegadoManage.deleteSource(source);await FishReader.database.execute({sql:'DELETE FROM legado_sources WHERE source_key = ?',bindArgs:[sourceKey(source)]});sourceIndexDirty=true;if(sourceKey(source)===activeKey)await ensureActive()}\n    async function removeSource(source){if(!confirm('删除书源“'+(source.bookSourceName||sourceKey(source))+'”？\\n登录信息和运行变量也会被删除。'))return;await deleteRecord(source);await loadPage();status('书源已删除')}\n    async function authorizeDomains(next,targetStatus=status){return authorizeDomainList(domainsFrom(next),targetStatus)}\n\n    async function applySourceUpdate(next,previous){await authorizeDomains(next,sourceStatus);const oldKey=sourceKey(previous),sameIdentity=next.some(item=>String(item.bookSourceUrl||'').trim()===String(previous.bookSourceUrl||'').trim());if(sameIdentity){if(!confirm('更新文件中的书源与旧书源标识相同，将原位替换旧版本。\\n\\n是否继续？')){sourceStatus('已取消书源更新');return}}else if(confirm('更新书源已下载。是否删除旧书源“'+(previous.bookSourceName||oldKey)+'”？\\n\\n确定：删除旧源并导入更新\\n取消：保留旧源，同时导入更新'))await deleteRecord(previous);await upsertSources(next);await setActive(next[0].enabled===false?await firstEnabled():next[0]);openedSource=next[0];await loadPage();await renderLogin(openedSource);sourceStatus('书源更新完成：'+(openedSource.bookSourceName||sourceKey(openedSource)))}\n\n    if (typeof FishReader.plugin.registerFileImport === 'function') {\n      FishReader.plugin.registerFileImport('importSources', importFile);\n    }\n    async function importFile(){await runGroupedImport(async()=>{status('请选择规则文件（支持多选，每个最大 100 MiB）…');return pickImportFiles()},true)}\n    async function importNetwork(){try{const raw=$('importUrl').value.trim(),parsed=new URL(raw);if(!/^https?:$/.test(parsed.protocol))throw new Error('仅支持 HTTP/HTTPS');await runGroupedImport(async()=>{const grant=await FishReader.plugin.requestNetworkDomains([parsed.hostname.toLowerCase()]);if(!grant||grant.granted!==true)throw new Error('未授权下载域名');status('正在流式下载轻页 规则（最大 100 MiB）…');return FishReader.http.downloadDataFile({url:raw,headers:{}})})}catch(error){status('网络导入失败：'+error.message)}}\n    function loginFieldName(row){return String(row.name||row.viewName||'').trim()}\n    function loginDefaultValue(row){if(Object.prototype.hasOwnProperty.call(row,'value'))return row.value;if(Object.prototype.hasOwnProperty.call(row,'default'))return row.default;if(Object.prototype.hasOwnProperty.call(row,'defaultValue'))return row.defaultValue;return''}\n    function loginChoices(row){let raw=row.chars;if(typeof raw==='string'){try{const decoded=JSON.parse(raw);if(Array.isArray(decoded))raw=decoded}catch(_){raw=raw.split(/[|,\\n]/)}}if(!Array.isArray(raw))return[];return raw.map(item=>{if(item&&typeof item==='object'){const value=Object.prototype.hasOwnProperty.call(item,'value')?item.value:(item.name??item.label??'');return{label:String(item.name??item.label??value),value:String(value)}}return{label:String(item),value:String(item)}})}\n    function collectLogin(){const data=Object.assign({},loginExtraData);document.querySelectorAll('#sourcePage [data-login-name]').forEach(node=>{const name=node.dataset.loginName;if(name)data[name]=node.value});return data}\n    function bindLoginAction(node,source,row,labelText,delay=0){const action=String(row.action||'').trim();if(!action)return;const invoke=()=>runLogin(source,action,labelText||row.name||'操作');if(delay>0)node.oninput=()=>{clearTimeout(node.loginActionTimer);node.loginActionTimer=setTimeout(invoke,delay)};else node.onchange=invoke}\n    function bindLoginPress(node,handler){let startedAt=0,suppressClickUntil=0;node.onpointerdown=()=>{startedAt=Date.now()};node.onpointerup=event=>{if(!startedAt)return;const longClick=Date.now()-startedAt>666;startedAt=0;suppressClickUntil=Date.now()+700;event.preventDefault();event.stopPropagation();handler(longClick)};node.onpointercancel=()=>{startedAt=0};node.onclick=event=>{if(Date.now()<suppressClickUntil){event.preventDefault();event.stopPropagation();return}handler(false)}}\n    async function copyLoginText(value){const text=String(value||'');try{if(navigator.clipboard&&navigator.clipboard.writeText){await navigator.clipboard.writeText(text);return true}}catch(_){}const area=document.createElement('textarea');area.value=text;area.style.cssText='position:fixed;left:-9999px;top:0';document.body.append(area);area.select();const copied=document.execCommand('copy');area.remove();return copied}\n    async function applyLoginEffects(source,effects){let changed=false;for(const effect of Array.isArray(effects)?effects:[]){if(!effect||typeof effect!=='object')continue;if(effect.type==='updateLoginData'){if(effect.data===null){const reset={};for(const row of loginRowsState){if(!row||typeof row!=='object')continue;const name=loginFieldName(row),type=String(row.type||'').toLowerCase();if(!name||type==='button')continue;const choices=loginChoices(row),fallback=choices.length?choices[0].value:'';reset[name]=String(loginDefaultValue(row)??fallback)}loginRenderOverride=reset}else{loginRenderOverride=Object.assign({},collectLogin(),effect.data||{})}await renderLogin(source);changed=true}else if(effect.type==='rerenderLoginUi'){loginRenderOverride=collectLogin();await renderLogin(source)}else if(effect.type==='copyText'){sourceStatus(await copyLoginText(effect.text)?'文本已复制':'复制失败，请长按文本手动复制')}else if(effect.type==='refreshBookInfo'||effect.type==='refreshBookToc'||effect.type==='refreshContent'){sourceStatus('设置已保存，返回阅读页后将刷新内容')}else if(effect.type==='openSearch'){sourceStatus('请返回搜索页搜索：'+String(effect.keyword||''))}else if(effect.type==='openPage'){sourceStatus('请求打开：'+String(effect.name||effect.target||''))}}if(changed)await FishReaderLegadoManage.execute(source,'',collectLogin(),{})}\n    function requestVerification(imageUrl){return new Promise(resolve=>{const shade=document.createElement('div'),card=document.createElement('div'),title=document.createElement('strong'),image=document.createElement('img'),input=document.createElement('input'),actions=document.createElement('div'),cancel=document.createElement('button'),confirm=document.createElement('button');shade.style.cssText='position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.42);display:flex;align-items:center;justify-content:center;padding:20px';card.style.cssText='width:min(360px,100%);background:#fff;border-radius:18px;padding:18px;display:grid;gap:12px;color:#17231d';title.textContent='请输入图片验证码';image.src=String(imageUrl||'');image.alt='验证码';image.style.cssText='max-width:100%;max-height:180px;justify-self:center;object-fit:contain';input.type='text';input.autocomplete='off';input.placeholder='验证码';input.style.cssText='height:44px;border:1px solid #ccd8d1;border-radius:10px;padding:0 12px;font-size:16px';actions.style.cssText='display:flex;justify-content:flex-end;gap:10px';cancel.type=confirm.type='button';cancel.textContent='取消';confirm.textContent='确认';confirm.style.cssText='background:#167c5a;color:#fff';const done=value=>{shade.remove();resolve(value)};cancel.onclick=()=>done('');confirm.onclick=()=>done(input.value.trim());input.onkeydown=event=>{if(event.key==='Enter')confirm.click()};actions.append(cancel,confirm);card.append(title,image,input,actions);shade.append(card);document.body.append(shade);setTimeout(()=>input.focus(),0)})}\n    async function runLogin(source,action,rowName,browserCompleted=false,session=null,isLongClick=false,verificationCode=''){if(!source)return;try{const actionText=String(action||'').trim();if(/^https?:\\/\\//i.test(actionText)){sourceStatus('正在打开“'+rowName+'”…');await openPluginBrowser(actionText,sourceStatus,source);return}sourceStatus('正在执行“'+rowName+'”…');const result=await FishReaderLegadoManage.execute(source,actionText,collectLogin(),{fullCompat:true,browserCompleted,verificationCode,time:session&&session.time,random:session&&session.random,isLongClick});if(result&&result.verification&&result.verification.imageUrl){const code=await requestVerification(result.verification.imageUrl);if(!code){sourceStatus('已取消验证码输入');return}return await runLogin(source,actionText,rowName,false,result.session,isLongClick,code)}await applyLoginEffects(source,result&&result.uiEffects);if(result&&Array.isArray(result.sourceUpdate)&&result.sourceUpdate.length){sourceStatus('正在校验更新书源的域名授权…');await applySourceUpdate(result.sourceUpdate,source)}else if(result&&Array.isArray(result.messages)&&result.messages.length)sourceStatus(result.messages.join('\\n'));else sourceStatus('操作已完成');if(result&&result.browser&&result.browser.url){pendingBrowser={source,action:actionText,rowName,session:result.session,isLongClick};browserOpenedAt=Date.now();await openPluginBrowser(result.browser,sourceStatus,source)}}catch(error){sourceStatus('操作失败：'+error.message)}}\n    function primaryLoginAction(source,rows){const raw=String(source&&source.loginUrl||'').trim();if(/^https?:\\/\\//i.test(raw))return raw;const list=Array.isArray(rows)?rows:[],hasAction=list.some(row=>row&&String(row.action||'').trim()),hasEditable=list.some(row=>row&&String(row.type||'').toLowerCase()!=='button'&&String(row.name||row.viewName||'').trim());return raw&&(hasEditable||!hasAction)?'__login__':''}\n    async function renderLogin(source){if(lightpageNativeDefinition(source))return renderNativeSettings(source);$('saveLogin').hidden=false;$('sourcePageTitle').textContent=source.bookSourceName||'书源管理';$('sourcePageKey').textContent=String(source.bookSourceUrl||source.bookSourceName||'');$('loginTitle').textContent='登录与设置';const root=$('loginFields');root.innerHTML='';let saved={},rows=loginRows(source),labels=[];try{saved=loginRenderOverride===null?(await FishReaderLegadoManage.getLoginInfo(source)||{}):loginRenderOverride;loginRenderOverride=null;rows=await FishReaderLegadoManage.getLoginUi(source,saved)||rows;labels=await FishReaderLegadoManage.getLoginLabels(source,rows,saved);loginExtraData=Object.assign({},saved);loginRowsState=rows}catch(error){sourceStatus('读取登录配置失败：'+error.message)}let hasEditable=false,rowIndex=-1;for(const row of rows){rowIndex++;if(!row||typeof row!=='object')continue;const type=String(row.type||'').toLowerCase(),name=loginFieldName(row),labelText=String(labels[rowIndex]||row.name||row.viewName||''),savedValue=name&&Object.prototype.hasOwnProperty.call(saved,name)?saved[name]:loginDefaultValue(row);if(['text','input','email','number','password'].includes(type)){if(!name)continue;const label=document.createElement('label');label.textContent=labelText||name;const input=document.createElement('input');input.type=type==='password'?'password':(type==='email'?'email':(type==='number'?'number':'text'));input.placeholder=String(row.placeholder||'');input.dataset.loginName=name;input.dataset.loginType=type;input.value=String(savedValue??'');bindLoginAction(input,source,row,labelText||name,600);root.append(label,input);hasEditable=true}else if(type==='toggle'||type==='checkbox'||type==='switch'){if(!name)continue;const choices=loginChoices(row);if(!choices.length)choices.push({label:'关闭',value:'false'},{label:'开启',value:'true'});const wrap=document.createElement('div'),caption=document.createElement('span'),button=document.createElement('button');wrap.className='login-toggle-row';caption.textContent=labelText||name;button.type='button';button.className='login-toggle-value';button.dataset.loginName=name;button.dataset.loginType='toggle';let index=choices.findIndex(choice=>choice.value===String(savedValue??''));if(index<0)index=0;const showChoice=()=>{button.value=choices[index].value;button.textContent=choices[index].label};showChoice();bindLoginPress(button,isLongClick=>{index=(index+1)%choices.length;showChoice();if(String(row.action||'').trim())runLogin(source,String(row.action),labelText||name,false,null,isLongClick)});wrap.append(caption,button);root.appendChild(wrap);hasEditable=true}else if(type==='select'){if(!name)continue;const choices=loginChoices(row),label=document.createElement('label'),select=document.createElement('select');label.textContent=labelText||name;select.dataset.loginName=name;select.dataset.loginType='select';for(const choice of choices){const option=document.createElement('option');option.value=choice.value;option.textContent=choice.label;select.appendChild(option)}const selected=String(savedValue??'');if(choices.some(choice=>choice.value===selected))select.value=selected;else if(choices.length)select.value=choices[0].value;bindLoginAction(select,source,row,labelText||name);root.append(label,select);hasEditable=true}else if(type==='button'||row.action){const button=document.createElement('button');button.className='login-button';button.textContent=labelText||'操作';bindLoginPress(button,isLongClick=>runLogin(source,String(row.action||''),labelText||'操作',false,null,isLongClick));root.appendChild(button)}}const primaryAction=primaryLoginAction(source,rows);$('saveLogin').textContent=/^https?:\\/\\//i.test(primaryAction)?'打开登录页面':(primaryAction?'保存登录信息并执行登录':'保存登录信息');$('saveLogin').hidden=!primaryAction&&!hasEditable}\n    async function openSource(source){openedSource=source;$('managerPage').hidden=true;$('sourcePage').hidden=false;sourceStatus('请选择操作');await renderLogin(source);scrollTo(0,0)}\n    function closeSource(){openedSource=null;pendingBrowser=null;closeSourceActionDialog();$('sourcePage').hidden=true;$('managerPage').hidden=false;scrollTo(0,0)}\n    async function continueBrowserAction(){if(!pendingBrowser||Date.now()-browserOpenedAt<700)return;const next=pendingBrowser;pendingBrowser=null;await runLogin(next.source,next.action,next.rowName,true,next.session,next.isLongClick===true)}\n    document.querySelectorAll('[data-manage-tab]').forEach(button=>button.onclick=()=>selectManageTab(button.dataset.manageTab));\n    $('importFile').onclick=importFile;$('importNetwork').onclick=importNetwork;$('validateSources').onclick=openSourceValidation;$('startValidation').onclick=runSourceValidation;$('cancelValidation').onclick=requestValidationStop;$('exportAll').onclick=()=>exportSources(false);$('manageSources').onclick=toggleManagement;$('selectAllResults').onclick=selectAllResults;$('clearSelection').onclick=clearSelected;$('exportSelected').onclick=()=>exportSources(true);$('deleteSelected').onclick=removeSelectedSources;$('enableSelected').onclick=()=>setSelectedSourcesEnabled(true);$('disableSelected').onclick=()=>setSelectedSourcesEnabled(false);$('groupSelectAll').onclick=selectAllResults;$('groupClear').onclick=clearSelected;$('saveGroup').onclick=saveGroupEdit;$('cancelGroup').onclick=cancelGroupEdit;$('deleteGroup').onclick=deleteGroupEdit;$('editGroupAction').onclick=()=>{const name=pendingGroupAction;closeGroupActions();if(name)beginGroupEdit(name)};$('cancelGroupAction').onclick=closeGroupActions;$('groupActionSheet').onclick=event=>{if(event.target===$('groupActionSheet'))closeGroupActions()};$('saveLogin').onclick=()=>{const action=primaryLoginAction(openedSource,loginRowsState);runLogin(openedSource,action,/^https?:\\/\\//i.test(action)?'打开登录页面':(action?'保存并登录':'保存'))};$('closeSource').onclick=closeSource;$('closeSourceActionDialog').onclick=closeSourceActionDialog;$('sourceActionDialog').onclick=event=>{if(event.target===$('sourceActionDialog'))closeSourceActionDialog()};\n    $('previousPage').onclick=()=>{if(page>1){page--;loadPage()}};$('nextPage').onclick=()=>{if(page*PAGE_SIZE<total){page++;loadPage()}};$('jumpPage').onclick=()=>{page=Math.max(1,Number($('pageJump').value)||1);loadPage()};$('sourceSort').onchange=()=>{page=1;loadPage()};$('sortDirection').onclick=()=>{descending=!descending;$('sortDirection').textContent=descending?'降序':'升序';page=1;loadPage()};$('sourceFilter').oninput=()=>{clearTimeout(filterTimer);filterTimer=setTimeout(()=>{page=1;loadPage()},250)};\n    document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='visible')setTimeout(continueBrowserAction,150)});window.addEventListener('focus',()=>setTimeout(continueBrowserAction,150));\n    FishReader.ready.then(async()=>{try{await initializeDatabase();activeKey=String(await FishReader.storage.get(ACTIVE_KEY)||await FishReader.storage.get(OLD_ACTIVE_KEY)||'');await migrateSourceKeys();await migrateLegacy();await ensureSourceGroupIndex();await ensureSourceTypeIndex();await ensureActive();await loadPage();applyManageTab();status(sourceTotal?'已加载 '+sourceTotal+' 个轻页书源':'请导入轻页书源')}catch(error){status('初始化失败：'+error.message)}});\n  </script>\n</body>\n</html>\n"
  }
}
