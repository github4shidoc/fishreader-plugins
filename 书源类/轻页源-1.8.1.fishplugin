rules, loaded, rowEnv, visited);\n    if (urls.length > 1) {\n      remaining = urls;\n      parallelPlan = { urls: [target].concat(urls), declared: true, disabled: false };\n      target = remaining.shift() || ''; continue;\n    }\n    target = urls[0] || '';\n    if (page === 1) parallelPlan = lightpageCatalogParallelPlan(source, rules, loaded, rowEnv, items.length, target);\n  }\n  return pages;\n}\n\nfunction lightpageImageMarkup(value, baseUrl) {\n  return (Array.isArray(value) ? value : [value]).flatMap(item => {\n    const raw = text(item).trim();\n    if (!raw) return [];\n    if (/<(?:img|image)\\b/i.test(raw)) return [lightpageContentMarkup(raw.replace(/<image\\b/gi, '<img').replace(/\\bxlink:href=/gi, 'src='), baseUrl)];\n    return raw.split(/\\r?\\n/).filter(Boolean).map(url => '<img src=\"' +\n      urlCompat(url.trim(), baseUrl).replace(/&/g, '&amp;').replace(/\"/g, '&quot;') + '\">');\n  }).join('\\n');\n}\n\nfunction lightpageWebMedia(body, baseUrl, sourceRegex) {\n  const raw = text(body).trim();\n  const candidates = /^https?:\\/\\/[^\\s<>]+$/i.test(raw) ? [raw] : [];\n  const tags = raw.match(/<(?:audio|video|source)\\b[^>]*>/gi) || [];\n  for (const tag of tags) {\n    const match = tag.match(/\\bsrc\\s*=\\s*([\"'])(.*?)\\1/i);\n    if (match) candidates.push(urlCompat(htmlDecode(match[2]), baseUrl));\n  }\n  const support = lightpageNative.AudioRuleSupport;\n  const pattern = support.compileSourceRegex(sourceRegex);\n  const direct = candidates.find(url => /^https?:\\/\\//i.test(url) && (!pattern || pattern.test(url)));\n  return direct || support.captureFromBody(raw, sourceRegex).map(value => urlCompat(value, baseUrl))\n    .find(url => /^https?:\\/\\/[^\\s<>]+$/i.test(url)) || '';\n}\n\n// One sequential state machine is shared by both FishReader host ABIs.\n// Only explicit rule output is used; there is no raw-response recovery path.\nfunction* lightpageContentFlow(source, saved, book, input, state, overrideRules) {\n  const rules = overrideRules || sourceRuleTemplate(source).content;\n  const mediaType = chapterExecutionMediaType(source, input, book, saved);\n  const audio = mediaType === 'audiobook';\n  if (audio && text(rules.audioUrl).trim()) {\n    try { return yield* lightpageContentFlow(source, saved, book, input, state,\n      Object.assign({}, rules, { content: rules.audioUrl, audioUrl: '' })); }\n    catch (error) { if (!/内容为空|音频规则未返回/.test(text(error.message)) || !rules.content) throw error; }\n  }\n  let baseUrl = saved.chapterUrl;\n  let env = { result: saved.raw, src: saved.raw, book, chapter: saved, title: saved.title,\n    baseUrl, page: 1, __legadoExecutionState: state };\n  const headers = audio ? sourceHeaders(source, env) : {};\n  const chunks = [], visited = new Set();\n  const limit = 8 * 1024 * 1024;\n  let size = 0, target = baseUrl;\n  const initialRequest = parseAjaxRequest(target, source, env);\n  const webJs = audio ? lightpageNative.AudioRuleSupport.webJsCode(rules.content) : '';\n  const audioRule = text(rules.content).trim().replace(/^<js>\\s*|\\s*<\\/js>$/gi, '')\n    .replace(/^@?js:\\s*/i, '').replace(/;\\s*$/, '').trim();\n  const directAudio = !audioRule || audioRule === 'baseUrl' || audioRule === 'String(baseUrl)';\n  if (audio && directAudio && !initialRequest.webView) chunks.push(target);\n  else for (let page = 1; target && !visited.has(target) && page <= 50; page++) {\n    visited.add(target);\n    const pageEnv = Object.assign({}, env, { page, baseUrl: target });\n    const webAudio = audio && (parseAjaxRequest(target, source, pageEnv).webView || !!webJs);\n    let loaded;\n    try {\n      loaded = yield { target, env: pageEnv, options: { sourceRegex: rules.sourceRegex, webJs, forceWebView: !!webJs } };\n    } catch (error) {\n      const message = text(error && (error.message || error.code) || error);\n      if (!webAudio || !text(rules.content).trim() || /cancel|abort|取消|permission_denied/i.test(message)) throw error;\n      loaded = yield { target, env: pageEnv, options: { disableWebView: true } };\n    }\n    baseUrl = loaded.url || target;\n    let body = loaded.body;\n    if (/^data:/i.test(target) && !parseAjaxRequest(target, source, env).type &&\n        /java\\.hexDecode(?:ToString|ToByteArray)\\s*\\(/.test(text(rules.content))) body = utf8Hex(body);\n    env = Object.assign({}, env, { result: body, src: body, page, baseUrl,\n      nextChapterUrl: saved.nextChapterUrl });\n    const capturedMedia = webAudio ? lightpageWebMedia(body, baseUrl, rules.sourceRegex) : '';\n    let content = capturedMedia || (webJs ? text(body) :\n      (rules.content ? text(ruleValue(source, rules.content, body, env, false)) : ''));\n    if (audio && !content.trim()) content = lightpageWebMedia(body, baseUrl, rules.sourceRegex) ||\n      (lightpageNative.AudioRuleSupport.matchesSourceRegex(baseUrl, rules.sourceRegex) ? baseUrl : '');\n    const images = rules.images ? lightpageImageMarkup(ruleList(source, rules.images, body, env), baseUrl) : '';\n    // Resolve image locations against their own page before merging pages. Do\n    // not strip HTML until the authored replacement has run on the whole text.\n    const chunk = images || (audio ? content : content.replace(/(<(?:img|image)\\b[^>]*?\\b(?:src|xlink:href)\\s*=\\s*)([\"'])(.*?)\\2/gi,\n      (_all, prefix, quote, value) => prefix + quote + urlCompat(htmlDecode(value), baseUrl).replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;') + quote));\n    const bytes = utf8ByteLength(chunk) + (chunk && chunks.length ? 2 : 0);\n    if (size + bytes > limit) break;\n    size += bytes;\n    if (chunk) chunks.push(chunk);\n    if (!rules.nextContentUrl) break;\n    target = ruleList(source, rules.nextContentUrl, body, env).map(value => urlCompat(value, baseUrl))\n      .find(value => value && !visited.has(value) && value !== saved.nextChapterUrl) || '';\n  }\n  let content = chunks.join('\\n\\n');\n  if (rules.replaceRegex) content = applyContentReplacement(source, rules.replaceRegex, content,\n    Object.assign({}, env, { result: content, src: content }));\n  if (!audio) content = lightpageContentMarkup(content, baseUrl);\n  if (utf8ByteLength(content) > limit) throw new Error('正文超过 8 MiB 限制');\n  if (!content.trim()) throw new Error('内容为空');\n  const metadata = { baseUrl, title: text(saved.title), imageStyle: text(rules.imageStyle) };\n  if (audio) {\n    const request = mediaRequest(content);\n    const mediaUrl = urlCompat(request.url, baseUrl);\n    if (!/^https?:\\/\\//i.test(mediaUrl)) throw new Error('音频规则未返回可播放的 HTTP(S) 地址');\n    return Object.assign({ content: '', contentType: 'audio', mediaUrl, mediaUrls: [mediaUrl],\n      mediaHeaders: lightpageNative.AudioRuleSupport.mergeHeaders(\n        lightpageNative.AudioRuleSupport.scopeHeadersToMediaHost(headers, sourceNetworkUrl(source), mediaUrl), request.headers) }, metadata);\n  }\n  return Object.assign({ content, contentType: 'text' }, metadata);\n}\n\n\n/* ===== catalog-pagination.js ===== */\n'use strict';\n\nconst LIGHTPAGE_CATALOG_CONCURRENCY = 10;\n\nfunction lightpageCatalogNextUrls(source, rules, loaded, env, visited) {\n  return [...new Set(ruleList(source, rules.nextTocUrl, loaded.body, env)\n    .flatMap(value => text(value).split(/\\r?\\n/)).map(value => urlCompat(value.trim(), loaded.url))\n    .filter(value => value && !visited.has(value)))].slice(0, Math.max(0, 1000 - visited.size));\n}\n\nfunction lightpageCatalogMustStop(error) {\n  return /cancel|abort|取消|已停止|permission[_ ]denied/i.test(text(error && error.message || error));\n}\n\n// This is an optimization eligibility check, NOT a new rule dialect. Unknown\n// syntax keeps the normal rule executor. Only bounded, local expressions may\n// be replayed to prove a page plan: no host calls, loops, globals or mutations.\nfunction lightpagePurePaginationCode(rule) {\n  const raw = text(rule).trim();\n  const code = /^@?js:/i.test(raw) ? raw.replace(/^@?js:/i, '') :\n    /^<js>[\\s\\S]*<\\/js>$/i.test(raw) ? raw.slice(4, -5) : '';\n  if (!code || code.length > 8192) return null;\n  const tokens = [];\n  for (let index = 0; index < code.length;) {\n    const rest = code.slice(index), char = code[index];\n    if (/\\s/.test(char)) { index++; continue; }\n    if (rest.startsWith('//')) { const end = code.indexOf('\\n', index + 2); index = end < 0 ? code.length : end + 1; continue; }\n    if (rest.startsWith('/*')) { const end = code.indexOf('*/', index + 2); if (end < 0) return null; index = end + 2; continue; }\n    if (char === '`' || char === '\\\\') return null;\n    if (char === '\"' || char === \"'\") {\n      let end = index + 1;\n      for (; end < code.length && code[end] !== char; end++) {\n        if (code[end] === '\\\\') end++;\n        else if (/[\\r\\n]/.test(code[end])) return null;\n      }\n      if (end >= code.length) return null;\n      tokens.push('#literal'); index = end + 1; continue;\n    }\n    if (char === '/' && ['(', ',', '=', ':', '?', '!', '&&', '||'].includes(tokens[tokens.length - 1])) {\n      let end = index + 1, inClass = false;\n      for (; end < code.length; end++) {\n        if (code[end] === '\\\\') { end++; continue; }\n        if (code[end] === '[') inClass = true;\n        if (code[end] === ']') inClass = false;\n        if (code[end] === '/' && !inClass) break;\n        if (/[\\r\\n]/.test(code[end])) return null;\n      }\n      if (end >= code.length) return null;\n      end++; while (/[gimsuy]/.test(code[end] || '') && end < code.length) end++;\n      tokens.push('#literal'); index = end; continue;\n    }\n    const match = rest.match(/^(?:[A-Za-z_$][\\w$]*|\\d+(?:\\.\\d+)?|===|!==|==|!=|<=|>=|&&|\\|\\||[.(){};,?:+\\-*\\/%<>!=\\[\\]])/);\n    if (!match) return null;\n    tokens.push(match[0]); index += match[0].length;\n  }\n  const locals = new Set();\n  tokens.forEach((token, index) => {\n    if (['var', 'let', 'const'].includes(token) && /^[A-Za-z_$][\\w$]*$/.test(tokens[index + 1] || '')) locals.add(tokens[index + 1]);\n  });\n  const globals = new Set(['var', 'let', 'const', 'if', 'else', 'true', 'false', 'null', 'undefined',\n    'JSON', 'Math', 'parseInt', 'parseFloat', 'Number', 'String', 'result', 'baseUrl', 'page']);\n  const methods = new Set(['parse', 'replace', 'split', 'trim', 'toString', 'ceil', 'floor', 'round', 'min', 'max']);\n  if ([...locals].some(name => globals.has(name))) return null;\n  for (let index = 0; index < tokens.length; index++) {\n    const token = tokens[index], before = tokens[index - 1], after = tokens[index + 1];\n    if (['constructor', '__proto__', 'prototype'].includes(token)) return null;\n    if (/^[A-Za-z_$]/.test(token) && before !== '.' && !locals.has(token) && !globals.has(token)) return null;\n    if (before === '.' && after === '(' && !methods.has(token)) return null;\n    if (after === '(' && /^[A-Za-z_$]/.test(token) && before !== '.' &&\n        !['if', 'parseInt', 'parseFloat', 'Number', 'String'].includes(token)) return null;\n    if (token === '[' && !( /^\\d+$/.test(after || '') && tokens[index + 2] === ']' )) return null;\n    if (token === '=' && (!locals.has(before) || tokens[index - 2] === '.')) return null;\n    if ((token === '+' || token === '-') && [token, '='].includes(after)) return null;\n    if (token === 'JSON' && tokens.slice(index, index + 6).join(' ') !== 'JSON . parse ( result )') return null;\n    if (token === 'result' && tokens.slice(index - 4, index + 2).join(' ') !== 'JSON . parse ( result )') return null;\n  }\n  return code;\n}\n\nfunction lightpagePaginationValue(code, body, baseUrl, page) {\n  const reads = new Map();\n  const wrap = (value, path) => value && typeof value === 'object' ? new Proxy(value, {\n    get(target, key) {\n      if (typeof key !== 'string' || !Object.prototype.hasOwnProperty.call(target, key)) throw Error('Non-data pagination property');\n      const next = path.concat(key), selected = target[key];\n      if (selected === null || typeof selected !== 'object') reads.set(JSON.stringify(next), selected);\n      return wrap(selected, next);\n    },\n    set() { throw Error('Pagination data mutation'); },\n    deleteProperty() { throw Error('Pagination data mutation'); }\n  }) : value;\n  // The lexer excludes user eval/Function and access to any host/global object.\n  const execute = new Function('result', 'baseUrl', 'page', 'JSON',\n    '\"use strict\"; return eval(' + JSON.stringify(code) + ');');\n  const value = execute(body, baseUrl, page, { parse: input => wrap(JSON.parse(input), []) });\n  return { value: text(value).trim(), reads: [...reads.entries()] };\n}\n\nfunction lightpagePaginationQuery(url) {\n  const match = text(url).match(/^(https?:\\/\\/[^?#]+)\\?([^#]+)(#.*)?$/i);\n  if (!match) return null;\n  const parts = match[2].split('&').map(part => part.split('='));\n  if (parts.some(part => part.length !== 2) || new Set(parts.map(part => part[0])).size !== parts.length) return null;\n  return { prefix: match[1], suffix: match[3] || '', parts };\n}\n\nfunction lightpageCatalogParallelPlan(source, rules, loaded, env, rowCount, nextUrl) {\n  try {\n    if (!nextUrl || rowCount < 1 || text(source.jsLib).trim() || text(source.loginCheckJs).trim() ||\n        text(source.concurrentRate).trim() || /^@?js:|^<js>/i.test(text(source.header).trim()) ||\n        !/^\\$\\.[\\w.\\[\\]*-]+$/.test(text(rules.chapterList).trim())) return null;\n    const code = lightpagePurePaginationCode(rules.nextTocUrl);\n    if (!code) return null;\n    const first = lightpagePaginationValue(code, loaded.body, loaded.url, 1);\n    if (urlCompat(first.value, loaded.url) !== nextUrl) return null;\n    const totals = first.reads.filter(entry => Number(entry[1]) > rowCount);\n    if (totals.length !== 1 || first.reads.some(entry => entry !== totals[0] && Number(entry[1]) !== rowCount)) return null;\n    const total = Number(totals[0][1]);\n    if (!Number.isSafeInteger(total) || total <= rowCount) return null;\n    const start = lightpagePaginationQuery(loaded.url), next = lightpagePaginationQuery(nextUrl);\n    if (!start || !next || start.prefix !== next.prefix || start.suffix !== next.suffix || start.parts.length !== next.parts.length) return null;\n    const changed = [];\n    for (let index = 0; index < start.parts.length; index++) {\n      if (start.parts[index][0] !== next.parts[index][0]) return null;\n      if (start.parts[index][1] !== next.parts[index][1]) changed.push(index);\n    }\n    if (changed.length !== 1) return null;\n    const pageIndex = changed[0], startPage = Number(start.parts[pageIndex][1]);\n    if (![0, 1].includes(startPage) || Number(next.parts[pageIndex][1]) !== startPage + 1 ||\n        !(start.parts.some((part, index) => index !== pageIndex && /^\\d+$/.test(part[1]) && Number(part[1]) === rowCount) ||\n          first.reads.some(entry => entry !== totals[0] && Number(entry[1]) === rowCount))) return null;\n    const pageCount = Math.ceil(total / rowCount);\n    if (pageCount > 1000) return null;\n    const urls = [loaded.url];\n    for (let page = 1; page <= pageCount; page++) {\n      const evaluated = lightpagePaginationValue(code, loaded.body, urls[page - 1], page);\n      if (page === pageCount) { if (evaluated.value) return null; break; }\n      const parts = start.parts.map((part, index) => part[0] + '=' + (index === pageIndex ? startPage + page : part[1]));\n      const expected = start.prefix + '?' + parts.join('&') + start.suffix;\n      if (urlCompat(evaluated.value, urls[page - 1]) !== expected) return null;\n      urls.push(expected);\n    }\n    return { urls, total, pageSize: rowCount, totalPath: JSON.parse(totals[0][0]), disabled: false };\n  } catch (_) { return null; }\n}\n\nfunction lightpageCatalogBatchJobs(source, step) {\n  const plan = step.parallelPlan;\n  if (!plan || plan.disabled) return [];\n  const start = plan.urls.indexOf(step.target);\n  if (start < 1) { plan.disabled = true; return []; }\n  try {\n    return plan.urls.slice(start, start + (plan.declared ? 4 : LIGHTPAGE_CATALOG_CONCURRENCY)).map((url, offset) => {\n      if (/\\{\\{|@?js:|<js>/i.test(url)) throw Error('Dependent pagination request');\n      const env = Object.assign({}, step.env, { baseUrl: url, page: step.env.page + offset });\n      const request = parseAjaxRequest(url, source, env);\n      if (request.method !== 'GET' || request.body || request.bodyJs || request.webJs || request.webView || request.type) throw Error('Non-independent request');\n      request.__fishreaderSourceCharset = text(source.charset || source.responseCharset || source.encoding).trim();\n      lightpageRequestHeaders(request, source, env);\n      return { source, env, request, target: url };\n    });\n  } catch (error) { if (lightpageCatalogMustStop(error)) throw error; plan.disabled = true; return []; }\n}\n\nfunction lightpageCatalogRememberBatch(jobs, responses, cache) {\n  jobs.forEach((job, index) => {\n    try {\n      const item = responses[index];\n      if (!item || item.ok !== true || !item.result) throw Error(text(item && item.error) || '分页请求失败');\n      const response = item.result;\n      if (Number(response.status || 200) >= 400) throw Error('HTTP ' + response.status);\n      const decoded = Object.assign({}, response, { body: responseBodyWithEncoding(response, prepareResponseRequest(job.request)).body });\n      cache.set(job.target, { loaded: batchLoaded(job, decoded) });\n    } catch (error) {\n      if (lightpageCatalogMustStop(error)) throw error;\n      cache.set(job.target, { error: text(error && error.message || error) });\n    }\n  });\n}\n\nfunction lightpageCatalogCheckPage(source, rules, step, loaded) {\n  const plan = step.parallelPlan;\n  if (!plan || plan.disabled || plan.declared) return;\n  const body = JSON.parse(loaded.body);\n  let total = body;\n  for (const key of plan.totalPath) total = total && total[key];\n  if (Number(total) !== plan.total) throw Error('目录总章节数发生变化');\n  const index = plan.urls.indexOf(step.target);\n  if (loaded.url !== step.target) throw Error('目录分页发生跳转');\n  const expected = Math.min(plan.pageSize, plan.total - index * plan.pageSize);\n  if (ruleList(source, rules.chapterList, loaded.body, step.env).length !== expected) throw Error('目录分页返回数量不完整');\n}\n\nfunction lightpageCatalogLoadSync(source, rules, step, cache) {\n  if (!cache.has(step.target) && reader.http && typeof reader.http.fetchBatch === 'function') {\n    const jobs = lightpageCatalogBatchJobs(source, step);\n    if (jobs.length) {\n      let responses = [];\n      try { responses = reader.http.fetchBatch({ requests: jobs.map(job => prepareResponseRequest(job.request)), concurrency: LIGHTPAGE_CATALOG_CONCURRENCY }); }\n      catch (error) { if (lightpageCatalogMustStop(error)) throw error; }\n      lightpageCatalogRememberBatch(jobs, responses || [], cache);\n    }\n  }\n  const item = cache.get(step.target); cache.delete(step.target);\n  if (item && item.loaded) {\n    try { lightpageCatalogCheckPage(source, rules, step, item.loaded); return item.loaded; } catch (_) {}\n  }\n  const loaded = loadByUrl(source, step.target, step.env);\n  // Retry a failed speculative page once in order. Never commit a short catalog.\n  if (item) lightpageCatalogCheckPage(source, rules, step, loaded);\n  return loaded;\n}\n\nasync function lightpageCatalogLoadAsync(source, rules, step, cache) {\n  if (!cache.has(step.target)) {\n    const jobs = lightpageCatalogBatchJobs(source, step);\n    if (jobs.length) {\n      let responses = [];\n      try {\n        if (reader.http && typeof reader.http.fetchBatch === 'function') {\n          responses = await reader.http.fetchBatch({ requests: jobs.map(job => prepareResponseRequest(job.request)), concurrency: LIGHTPAGE_CATALOG_CONCURRENCY });\n        } else {\n          responses = await Promise.all(jobs.map(async job => {\n            try { return { ok: true, result: await reader.http.fetch(prepareResponseRequest(job.request)) }; }\n            catch (error) { return { ok: false, error: text(error && error.message || error) }; }\n          }));\n        }\n      } catch (error) { if (lightpageCatalogMustStop(error)) throw error; }\n      lightpageCatalogRememberBatch(jobs, responses || [], cache);\n    }\n  }\n  const item = cache.get(step.target); cache.delete(step.target);\n  if (item && item.loaded) {\n    try { lightpageCatalogCheckPage(source, rules, step, item.loaded); return item.loaded; } catch (_) {}\n  }\n  const loaded = await loadByUrlAsync(source, step.target, step.env);\n  if (item) lightpageCatalogCheckPage(source, rules, step, loaded);\n  return loaded;\n}\n\n\n/* ===== engine.js ===== */\n'use strict';\n\n/*\n * FishReader 开源轻页书源兼容插件\n * 规则适配独立以 legado3-harmony 文档为准；共用鱼书宿主基础设施，非阅读兼容模式。\n * 3.11.916（2026-10-11 文档与源码）对齐。\n * Upstream: https://github.com/wip3l/legado-harmony\n * License: GNU General Public License v3.0\n */\n\nconst SOURCE_KEY = 'lightpage.sources.v1';\nconst LEGACY_SOURCE_KEY = 'lightpage.sources.legacy';\nconst ACTIVE_SOURCE_KEY = 'lightpage.activeSource.v1';\nconst LEGACY_ACTIVE_SOURCE_KEY = 'lightpage.activeSource.legacy';\nconst ACTIVE_SOURCE_RECORD_KEY = 'lightpage.activeSourceRecord.v1';\nconst CATALOG_CACHE_VERSION = 5;\nconst LEGADO_ENGINE_REVISION = 'lightpage-3.11.916-81425e84-independent-r8';\nconst EXPLORE_MENU_CACHE_TTL_MS = 5 * 60 * 1000;\nconst CATALOG_CHUNK_MAXIMUM_BYTES = 384 * 1024;\n// Reading's Jsoup Elements are not truncated at 1000 entries. Keep a generous\n// host safety ceiling while allowing long single-page catalogues to preserve\n// every chapter that fits in the host's 16 MiB HTML envelope.\nconst HTML_PARSE_RESULT_MAXIMUM_COUNT = 50000;\n// Keep each host HTML batch bounded.  Harmony's broker accepts larger batches,\n// but 2,000 requests keeps worker/IPC memory predictable while still letting\n// one completed batch immediately feed the next one for very large catalogues.\nconst HTML_PARSE_BATCH_CHUNK_SIZE = 2000;\n// A single aggregate endpoint can return several thousand rows. Reading keeps\n// search results as a transient list; carrying hundreds of per-row JS rule\n// evaluations through one plugin invocation only increases latency and can hit\n// the isolated-runtime deadline before the first usable result reaches the UI.\nlet activeExecutionState = {};\nconst sharedJsLibMemoryCache = new Map();\nconst normalizedJsLibMemoryCache = new Map();\nconst jsLibProgramMemoryCache = new Map();\nconst normalizedSourceRuleMemoryCache = new WeakMap();\n// Rules run with a fresh scope, but a source's jsLib itself is immutable during\n// a search. Cache the compiled wrapper, not the scope or any rule state: this\n// preserves Reading's per-rule isolation while avoiding repeated parsing of a\n// large helper library once per returned book.\nconst compiledJsRuleRunnerMemoryCache = new Map();\nconst COMPILED_JS_RULE_RUNNER_CACHE_LIMIT = 128;\nconst jsLibRuleDependencyMemoryCache = new Map();\nconst javaSystemPropertiesCompat = new Map();\n// A few older sites omit the charset from Content-Type and only declare it in\n// the HTML meta tag.  Keep the detected value per origin so subsequent catalog\n// and chapter requests can ask the host for raw bytes directly instead of\n// parsing a UTF-8-decoded (and already corrupted) string.\nconst responseEncodingMemory = new Map();\n\nfunction text(value) {\n  if (value === undefined || value === null) return '';\n  if (typeof value === 'string') return value;\n  if (typeof value === 'object') {\n    if (value.__legadoHtmlNode === true && typeof value.outerHtml === 'function') {\n      return value.outerHtml();\n    }\n    // Jsoup Elements is list-shaped, but Java's String(Elements) returns its\n    // element markup.  Preserve that explicitly supplied collection coercion\n    // before treating ordinary JavaScript arrays as JSON data.  This is also\n    // how SourceRule receives the final value from a JavaScript content rule.\n    if (Array.isArray(value) && Object.prototype.hasOwnProperty.call(value, 'toString') &&\n        value.toString !== Array.prototype.toString) {\n      try {\n        const rendered = value.toString();\n        if (typeof rendered === 'string' && rendered !== '[object Object]') return rendered;\n      } catch (_) {}\n    }\n    // Java compatibility wrappers (notably java.lang.String) intentionally\n    // expose toString/valueOf methods but have no enumerable data. Serializing\n    // them first turns their value into \"{}\" and breaks Base64/crypto rules.\n    if (!Array.isArray(value) && typeof value.toString === 'function') {\n      try {\n        const rendered = value.toString();\n        if (typeof rendered === 'string' && rendered !== '[object Object]') return rendered;\n      } catch (_) {}\n    }\n    try { return JSON.stringify(value); } catch (_) {}\n  }\n  return String(value);\n}\n\n// AnalyzeRule template substitutions are scalar text operations.  A JsonPath\n// expression can yield a one-item (or multi-item) list, but Reading flattens\n// that list through its getString semantics before it is embedded in a URL or\n// another rule.  JSON.stringify() would instead produce \"[123]\", turning a\n// valid template URL such as /chapter/{{ $..bookId }} into /chapter/[123].\nfunction templateText(value) {\n  return Array.isArray(value) ? value.map(item => text(item)).join('\\n') : text(value);\n}\n\n// Kotlin Reading's String.isTrue() treats every non-empty value as true except\n// false/no/not/0.  This matters for JSON values too: an existing empty array\n// is represented as \"[]\" by the JSON engine and therefore remains truthy for\n// rules such as `isVolume: region`.  Keep that distinction from a missing\n// field, which is an empty string and false.\n\n\n// Catalogue rows returned by JSON APIs are already Java Maps in Reading.\n// AnalyzeByJSonPath therefore resolves a plain field or a literal template\n// directly against that row; it does not send every chapter back through the\n// complete SourceRule analyser. Large catalogues commonly contain thousands of\n// rows, so preserve that inexpensive path when the rule is provably limited to\n// simple JSON fields/templates. Any JS, replacement, variable or selector rule\n// continues through ruleValue below.\n\nfunction normalizedBookTypes(value) {\n  const result = [];\n  text(value).split(/[，,、|/·\\s]+/).forEach(item => {\n    const type = text(item).trim();\n    if (type && type !== '连载' && type !== '完结' && type !== '停更' && !result.includes(type)) {\n      result.push(type);\n    }\n  });\n  return result.slice(0, 32);\n}\n\nfunction normalizedPublicationStatus(value) {\n  const source = text(value);\n  if (source.includes('完结')) return '完结';\n  if (source.includes('停更')) return '停更';\n  if (source.includes('连载')) return '连载';\n  return '';\n}\n\nfunction object(value) {\n  return value && typeof value === 'object' && !Array.isArray(value) ? value : {};\n}\n\nconst INTERNAL_SOURCE_KEY = '__fishreaderSourceKey';\n\nfunction attachSourceKey(source, key) {\n  const target = object(source);\n  const value = text(key).trim();\n  if (!value) return target;\n  try {\n    Object.defineProperty(target, INTERNAL_SOURCE_KEY, {\n      value, configurable: true, enumerable: false, writable: true\n    });\n  } catch (_) {\n    target[INTERNAL_SOURCE_KEY] = value;\n  }\n  return target;\n}\n\nfunction sourceRecordKey(source) {\n  return text(source && source[INTERNAL_SOURCE_KEY]).trim() ||\n    text(source && (source.bookSourceUrl || source.bookSourceName)).trim();\n}\n\nfunction stableSourceBase(key) {\n  const match = text(key).trim().match(/^(.*)#fishreader=[0-9a-f]{8}$/i);\n  return match ? text(match[1]).trim() : '';\n}\n\nfunction normalizeSingleQuotedJson(value) {\n  const raw = text(value);\n  let output = '';\n  let quote = '';\n  let escaped = false;\n  for (let index = 0; index < raw.length; index++) {\n    const character = raw[index];\n    if (!quote) {\n      if (character === \"'\") {\n        quote = \"'\";\n        output += '\"';\n      } else {\n        if (character === '\"') quote = '\"';\n        output += character;\n      }\n      continue;\n    }\n    if (escaped) {\n      if (quote === \"'\" && character === \"'\") output += \"'\";\n      else if (quote === \"'\" && character === '\"') output += '\\\\\"';\n      else output += '\\\\' + character;\n      escaped = false;\n      continue;\n    }\n    if (character === '\\\\') {\n      escaped = true;\n      continue;\n    }\n    if (character === quote) {\n      output += '\"';\n      quote = '';\n      continue;\n    }\n    output += quote === \"'\" && character === '\"' ? '\\\\\"' : character;\n  }\n  if (escaped) output += '\\\\';\n  if (quote) throw new Error('登录界面配置包含未闭合字符串');\n  return output;\n}\n\nfunction normalizeLenientLoginUiJson(value) {\n  const raw = normalizeSingleQuotedJson(value);\n  let output = '';\n  let quoted = false;\n  let escaped = false;\n  for (let index = 0; index < raw.length; index++) {\n    const character = raw[index];\n    if (quoted) {\n      output += character;\n      if (escaped) escaped = false;\n      else if (character === '\\\\') escaped = true;\n      else if (character === '\"') quoted = false;\n      continue;\n    }\n    if (character === '\"') {\n      quoted = true;\n      output += character;\n      continue;\n    }\n    if (character !== '{' && character !== ',') {\n      output += character;\n      continue;\n    }\n    output += character;\n    let cursor = index + 1;\n    while (cursor < raw.length && /\\s/.test(raw[cursor])) {\n      output += raw[cursor];\n      cursor++;\n    }\n    if (cursor >= raw.length || !/[A-Za-z_$]/.test(raw[cursor])) {\n      index = cursor - 1;\n      continue;\n    }\n    const keyStart = cursor;\n    cursor++;\n    while (cursor < raw.length && /[A-Za-z0-9_$]/.test(raw[cursor])) cursor++;\n    const keyEnd = cursor;\n    while (cursor < raw.length && /\\s/.test(raw[cursor])) cursor++;\n    if (raw[cursor] !== ':') {\n      output += raw.slice(keyStart, cursor);\n      index = cursor - 1;\n      continue;\n    }\n    output += '\"' + raw.slice(keyStart, keyEnd) + '\"' + raw.slice(keyEnd, cursor) + ':';\n    index = cursor;\n  }\n\n  let normalized = '';\n  quoted = false;\n  escaped = false;\n  for (let index = 0; index < output.length; index++) {\n    const character = output[index];\n    if (quoted) {\n      normalized += character;\n      if (escaped) escaped = false;\n      else if (character === '\\\\') escaped = true;\n      else if (character === '\"') quoted = false;\n      continue;\n    }\n    if (character === '\"') {\n      quoted = true;\n      normalized += character;\n      continue;\n    }\n    if (character === ',') {\n      let cursor = index + 1;\n      while (cursor < output.length && /\\s/.test(output[cursor])) cursor++;\n      if (output[cursor] === '}' || output[cursor] === ']') continue;\n    }\n    normalized += character;\n  }\n  return normalized;\n}\n\nfunction parseLoginUi(value) {\n  const raw = text(value).trim();\n  if (!raw) return [];\n  try {\n    const parsed = JSON.parse(raw);\n    return Array.isArray(parsed) ? parsed : [];\n  } catch (_) {\n    const parsed = JSON.parse(normalizeLenientLoginUiJson(raw));\n    return Array.isArray(parsed) ? parsed : [];\n  }\n}\n\nfunction sourceRuleTemplate(source) { return lightpageRuleTemplate(source); }\n\nfunction hasRuleValue(value) {\n  if (value === undefined || value === null) return false;\n  if (typeof value === 'string') return value.trim().length > 0;\n  if (Array.isArray(value)) return value.length > 0;\n  if (typeof value === 'object') return Object.keys(value).length > 0;\n  return true;\n}\n\nfunction bookListRulesFor(source, entrypoint) {\n  const template = sourceRuleTemplate(source);\n  const explore = template.explore;\n  return entrypoint === 'explore' && ['bookList', 'name', 'bookUrl'].every(key => hasRuleValue(explore[key])) ? explore : template.search;\n}\n\nfunction sourceNetworkUrl(source) {\n  // Reading normalizes the source origin before resolving relative rule URLs.\n  // Imported source packs often carry display whitespace before an optional\n  // `#tag` suffix; keep that metadata out of the transport URL.\n  return text(source && source.bookSourceUrl).trim().replace(/#.*$/, '').trim();\n}\n\nfunction sourceCookieProbeUrl(source) {\n  const declared = sourceNetworkUrl(source).trim();\n  if (/^https?:\\/\\//i.test(declared)) return declared;\n  // Reading permits a logical source identifier in bookSourceUrl. In that\n  // case it must not be passed to the host Cookie API as though it were a URL.\n  // Resolve a real operational origin from the rules instead. jsLib is checked\n  // before discover/login HTML because aggregate sources commonly keep their\n  // active service list there while explore/login contain unrelated sites.\n  const candidates = [source && source.searchUrl, source && source.jsLib,\n    source && source.exploreUrl, source && source.loginUrl, source && source.header];\n  for (const candidate of candidates) {\n    const match = text(candidate).match(/https?:\\/\\/[^\\s\"'<>},]+/i);\n    if (!match) continue;\n    const origin = match[0].match(/^(https?:\\/\\/[^/?#]+)/i);\n    if (origin) return origin[1] + '/';\n  }\n  return '';\n}\n\nfunction resultSourceName(value) {\n  const item = object(value);\n  const raw = item.sourceName || item.source_name || item.source || item.originName ||\n    item.origin_name || item.origin || item.siteName || item.site_name || item.site;\n  if (raw && typeof raw === 'object') return text(raw.name || raw.title || raw.id).trim().slice(0, 512);\n  return text(raw).trim().slice(0, 512);\n}\n\nfunction resultSourceDisplayName(source, value) {\n  const parent = text(source && (source.bookSourceName || source.bookSourceUrl)).trim().slice(0, 512);\n  const child = resultSourceName(value);\n  if (!child || child === parent || parent.includes(child)) return parent || child;\n  if (child.includes(parent)) return child;\n  return `${parent}•${child}`;\n}\n\nfunction leadingJsonValue(value) {\n  const raw = text(value).trim();\n  if (!raw || (!raw.startsWith('{') && !raw.startsWith('['))) return '';\n  let depth = 0;\n  let quoted = false;\n  let escaped = false;\n  for (let index = 0; index < raw.length; index++) {\n    const character = raw[index];\n    if (quoted) {\n      if (escaped) escaped = false;\n      else if (character === '\\\\') escaped = true;\n      else if (character === '\"') quoted = false;\n      continue;\n    }\n    if (character === '\"') quoted = true;\n    else if (character === '{' || character === '[') depth++;\n    else if (character === '}' || character === ']') {\n      depth--;\n      if (depth === 0) return raw.slice(0, index + 1);\n      if (depth < 0) return '';\n    }\n  }\n  return '';\n}\n\nfunction legadoBookTypeForSource(source) {\n  const sourceType = Number(source && source.bookSourceType);\n  if (sourceType === 1) return 32;\n  if (sourceType === 2) return 64;\n  if (sourceType === 3) return 8;\n  return 8;\n}\n\nfunction normalizedLightpageMediaType(value) {\n  const raw = text(value).trim().toLowerCase();\n  if (/^(?:audio|audiobook|听书|有声|有声书)$/.test(raw)) return 'audiobook';\n  if (/^(?:comic|image|漫画|图片)$/.test(raw)) return 'comic';\n  if (/^(?:novel|text|小说|图书)$/.test(raw)) return 'text';\n  return '';\n}\n\nfunction lightpageDeclaredMediaType(source) {\n  const declarations = object(activeExecutionState && activeExecutionState.sourceDeclaredMediaTypes);\n  return normalizedLightpageMediaType(declarations[sourceRecordKey(source)]);\n}\n\nfunction legadoMediaType(source, book) {\n  const declared = lightpageDeclaredMediaType(source);\n  if (declared) return declared;\n  const bookType = Number(book && book.type);\n  if (Number.isFinite(bookType)) {\n    if ((bookType & 32) !== 0) return 'audiobook';\n    if ((bookType & 64) !== 0) return 'comic';\n  }\n  const persisted = normalizedLightpageMediaType(book && book.mediaType);\n  if (persisted) return persisted;\n  const sourceType = Number(source && source.bookSourceType);\n  if (sourceType === 1) return 'audiobook';\n  if (sourceType === 2) return 'comic';\n  const style = text(sourceRuleTemplate(source).content.imageStyle).trim();\n  if (/^(FULL|comic|manga|webtoon)$/i.test(style)) return 'comic';\n  return 'text';\n}\n\nfunction chapterExecutionMediaType(source, input, book, chapter) {\n  return normalizedLightpageMediaType(input && (input.mediaType || input.contentType)) ||\n    normalizedLightpageMediaType(chapter && chapter.mediaType) ||\n    legadoMediaType(source, book);\n}\n\nfunction mediaHeaders(sample) {\n  const headers = Object.assign({}, object(sample.headers || sample.header));\n  const referer = text(sample.referer || sample.referrer).trim();\n  if (referer && !Object.keys(headers).some(key => key.toLowerCase() === 'referer')) {\n    headers.Referer = referer;\n  }\n  const normalized = {};\n  Object.keys(headers).slice(0, 64).forEach(key => {\n    const name = text(key).trim();\n    const value = text(headers[key]).trim();\n    if (name && value) normalized[name] = value.slice(0, 8192);\n  });\n  return normalized;\n}\n\nfunction normalizeMediaText(value) {\n  return text(value).trim()\n    .replace(/\\\\u([0-9a-f]{4})/gi, (_all, hex) => String.fromCharCode(parseInt(hex, 16)))\n    .replace(/\\\\\\//g, '/')\n    .replace(/\\\\\"/g, '\"')\n    .replace(/&amp;/gi, '&');\n}\n\nfunction isAudioMediaUrl(value) {\n  const url = normalizeMediaText(value);\n  return /\\.(?:mp3|m4a|aac|ogg|opus|flac|wav|ape|wma)(?:[?#]|$)/i.test(url) ||\n    /(?:[?&](?:mime[_-]?type|content[_-]?type)=audio(?:[_\\/-]|%5f|%2f)|\\baudio[_\\/-])/i.test(url);\n}\n\nfunction isVideoMediaUrl(value) {\n  const url = normalizeMediaText(value);\n  return /\\.(?:m3u8|mp4|m4v|webm|mov|avi|flv)(?:[?#]|$)/i.test(url) ||\n    /(?:[?&](?:mime[_-]?type|content[_-]?type)=video(?:[_\\/-]|%5f|%2f))/i.test(url);\n}\n\nfunction isImageMediaUrl(value) {\n  const url = normalizeMediaText(value);\n  return /^(?:data:)?image\\//i.test(url) ||\n    /\\.(?:avif|bmp|gif|heic|heif|ico|jpe?g|png|svg|webp)(?:[?#]|$)/i.test(url) ||\n    /(?:[?&](?:mime[_-]?type|content[_-]?type)=image(?:[_\\/-]|%5f|%2f))/i.test(url);\n}\n\nfunction isImageMediaKey(value) {\n  return /(?:^|[_-])(?:cover|image|img|poster|thumb(?:nail)?|avatar|logo|icon|pic(?:ture)?)(?:$|[_-])/i\n    .test(text(value).replace(/([a-z0-9])([A-Z])/g, '$1_$2'));\n}\n\nfunction mediaUrlForType(value, mediaTypeHint, explicit = false) {\n  const url = normalizeMediaText(value);\n  if (!/^https?:\\/\\//i.test(url) || isImageMediaUrl(url)) return false;\n  if (mediaTypeHint === 'audiobook') {\n    if (isVideoMediaUrl(url)) return false;\n    return explicit || isAudioMediaUrl(url);\n  }\n  if (mediaTypeHint === 'video') {\n    if (isAudioMediaUrl(url)) return false;\n    return explicit || isVideoMediaUrl(url);\n  }\n  return explicit || isAudioMediaUrl(url) || isVideoMediaUrl(url);\n}\n\nfunction responseContentType(value) {\n  const contentType = responseHeader(value, 'content-type').toLowerCase();\n  return contentType.split(';', 1)[0].trim();\n}\n\nfunction isEmptyAudioSentinel(value) {\n  if (value === null || value === undefined || value === false) return true;\n  if (typeof value !== 'string') return false;\n  return /^(?:|none|null|nil|undefined|false|no\\s*data|empty)$/i.test(value.trim());\n}\n\nfunction isEmptyAudioPayload(value, depth = 0) {\n  if (depth > 8) return false;\n  if (isEmptyAudioSentinel(value)) return true;\n  if (Array.isArray(value)) {\n    return value.length > 0 && value.every(item => isEmptyAudioPayload(item, depth + 1));\n  }\n  if (!value || typeof value !== 'object') return false;\n  const item = object(value);\n  const mediaKeys = ['content', 'audio', 'audioUrl', 'audio_url', 'mediaUrl', 'media_url',\n    'playUrl', 'play_url', 'streamUrl', 'stream_url', 'url'];\n  const presentMedia = mediaKeys.filter(key => Object.prototype.hasOwnProperty.call(item, key));\n  if (presentMedia.length > 0) {\n    return presentMedia.every(key => isEmptyAudioPayload(item[key], depth + 1));\n  }\n  // Many aggregate interfaces wrap the actual chapter response.  A valid JSON\n  // envelope whose nested media value is empty must trigger the same fallback\n  // as a top-level `content: None` response.\n  const envelopeKeys = ['data', 'result', 'payload', 'body', 'chapter'];\n  const presentEnvelope = envelopeKeys.filter(key => Object.prototype.hasOwnProperty.call(item, key));\n  return presentEnvelope.length > 0 &&\n    presentEnvelope.every(key => isEmptyAudioPayload(item[key], depth + 1));\n}\n\nfunction isEmptyAudioResponse(value) {\n  const body = text(value && value.body).trim();\n  if (!body) return false;\n  if (isEmptyAudioSentinel(body.replace(/^[\"']|[\"']$/g, ''))) return true;\n  let parsed;\n  try { parsed = JSON.parse(body); } catch (_) { return false; }\n  return isEmptyAudioPayload(parsed);\n}\n\nfunction responseHasPlayableAudio(value, baseUrl) {\n  if (isEmptyAudioResponse(value)) return false;\n  const response = object(value);\n  const body = text(response.body);\n  const parsed = structuredChapterContent(body, 'audiobook', baseUrl,\n    mediaHeaders({ headers: object(response.requestHeaders) }), true);\n  if (!(parsed && parsed.contentType === 'audio' &&\n      Array.isArray(parsed.mediaUrls) && parsed.mediaUrls.length > 0)) return false;\n  // Anonymous/login retries must not turn a human-readable API error into a\n  // relative media URL merely because the book is marked as an audiobook.\n  // Accept a resolved URL only when the response actually contains it, or its\n  // path has an unmistakable audio extension.\n  return parsed.mediaUrls.some(url => isAudioMediaUrl(url) || body.includes(text(url)));\n}\n\nfunction declaredFallbackOrigins(source, currentUrl) {\n  const code = text(source && source.jsLib);\n  const origins = [];\n  const declaration = /(?:var|let|const)\\s+(?:host|hosts|server|servers)\\s*=\\s*\\[([\\s\\S]{0,16384}?)\\]/gi;\n  let block;\n  while ((block = declaration.exec(code)) !== null) {\n    const quotedUrl = /[\"'](https?:\\/\\/[^\"']+)[\"']/gi;\n    let match;\n    while ((match = quotedUrl.exec(block[1])) !== null) {\n      try {\n        const origin = new URL(match[1]).origin;\n        if (!origins.includes(origin)) origins.push(origin);\n      } catch (_) {}\n    }\n  }\n  let currentOrigin = '';\n  try { currentOrigin = new URL(text(currentUrl)).origin; } catch (_) {}\n  return origins.filter(origin => origin !== currentOrigin).slice(0, 16);\n}\n\nfunction recordExecutionMediaResponse(state, requestValue, responseValue) {\n  const executionState = object(state);\n  if (executionState.captureMediaRequests !== 'audiobook') return responseValue;\n  const request = object(requestValue);\n  const response = object(responseValue);\n  const status = Number(response.status || 0);\n  if (status < 200 || status >= 400) return responseValue;\n  const target = text(response.url || request.url).trim();\n  if (!/^https?:\\/\\//i.test(target) || isImageMediaUrl(target) || isVideoMediaUrl(target)) {\n    return responseValue;\n  }\n  const contentType = responseContentType(response);\n  if (/^(?:image|video)\\//i.test(contentType)) return responseValue;\n  const method = text(request.method || 'GET').toUpperCase();\n  const body = text(response.body).trim();\n  const appendCandidate = (url, headers, score) => {\n    const candidateUrl = text(url).trim().slice(0, 4096);\n    if (!candidateUrl || isImageMediaUrl(candidateUrl) || isVideoMediaUrl(candidateUrl)) return;\n    const candidate = { url: candidateUrl, headers: mediaHeaders({ headers }), score };\n    if (!Array.isArray(executionState.mediaRequestCandidates)) {\n      executionState.mediaRequestCandidates = [];\n    }\n    const existing = executionState.mediaRequestCandidates.findIndex(item =>\n      item && item.url === candidate.url);\n    if (existing >= 0) executionState.mediaRequestCandidates.splice(existing, 1);\n    executionState.mediaRequestCandidates