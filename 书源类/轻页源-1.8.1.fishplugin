rt) {\r\n      return typeof part === 'string' ? part : JSON.stringify(part);\r\n    }).join(' ')]);\r\n  });\r\n  define('sleep', function (ms) { call('@sleep', [Number(ms) || 0]); });\r\n  define('ui', Object.freeze({\r\n    toast: function (message) { call('@toast', [message === undefined || message === null ? '' : String(message)]); },\r\n    refreshExplore: function () { call('@refreshExplore', []); }\r\n  }));\r\n  define('browser', Object.freeze({\r\n    verify: function (url, hint) {\r\n      return call('@browserVerify', [String(url), hint === undefined || hint === null ? '' : String(hint)]);\r\n    },\r\n    open: function (url, title) {\r\n      call('@browserOpen', [String(url), title === undefined || title === null ? '' : String(title)]);\r\n    },\r\n    render: function (url, options) { return call('@render', [String(url), options || {}]); }\r\n  }));\r\n  define('page', function (body, url) {\r\n    return { __nativePage: true, body: body === undefined || body === null ? '' : String(body),\r\n      url: url === undefined || url === null ? '' : String(url) };\r\n  });`;\r\n\r\n  /** 表达式环境里的同名占位：规则在主线程同步求值，不能等网络，也不应改动状态。 */\r\n          static          EXPRESSION_STUBS         = `\r\n  var refuse = function () { throw new Error('表达式里不能发请求或读写状态，请改用阶段的 script'); };\r\n  ['http', 'vars', 'temp', 'cache', 'cookie', 'login', 'device', 'ui', 'browser'].forEach(function (name) {\r\n    define(name, new Proxy({}, {\r\n      get: function (target, key) {\r\n        if (typeof key !== 'string' || key === 'toJSON' || key === 'then') return undefined;\r\n        return refuse();\r\n      }\r\n    }));\r\n  });\r\n  ['keep', 'log', 'sleep', 'page'].forEach(function (name) { define(name, refuse); });`;\r\n\r\n  /** 脚本阶段返回 page(body, url) 时的标记。 */\r\n  static isPage(value             )          {\r\n    return !!value && typeof value === 'object' && !Array.isArray(value) && value['__nativePage'] === true;\r\n  }\r\n\r\n  /** 调用脚本阶段的函数：fn(ctx)，结果是 JSON 文本；async 函数在本次运行里求出结果。 */\r\n  static stageSource(fn        , ctx             )         {\r\n    return `(function () { var r = ${fn}(${JSON.stringify(ctx === undefined ? null : ctx)});\\n` +\r\n      `return r && typeof r.then === 'function' ? r.then(__nativeReturn) : __nativeReturn(r); })()`;\r\n  }\r\n\r\n  /** JS 保留字不能用作函数名；内置函数里有 default，拼进检查代码会成为语法错误。 */\r\n          static          RESERVED           = ['break', 'case', 'catch', 'class', 'const', 'continue', 'debugger',\r\n    'default', 'delete', 'do', 'else', 'enum', 'export', 'extends', 'false', 'finally', 'for', 'function', 'if',\r\n    'import', 'in', 'instanceof', 'new', 'null', 'return', 'super', 'switch', 'this', 'throw', 'true', 'try',\r\n    'typeof', 'var', 'void', 'while', 'with', 'yield', 'let', 'static', 'implements', 'interface', 'package',\r\n    'private', 'protected', 'public', 'await'];\r\n\r\n  /** 能否作为 JS 函数名出现在生成的代码里。 */\r\n  static isIdentifier(name        )          {\r\n    return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(name || '') && NativeJsPrelude.RESERVED.indexOf(name) < 0;\r\n  }\r\n\r\n  /** 求值结果为 \"true\" 表示脚本里有这个函数（包括顶层 const/let 定义的）。 */\r\n  static hasSource(name        )         {\r\n    return `typeof ${name} === 'function'`;\r\n  }\r\n\r\n  /** 调用脚本函数，结果是 JSON 文本。 */\r\n  static callSource(name        , args               )         {\r\n    return `__nativeReturn(${name}.apply(null, ${JSON.stringify(args.map((arg             )              =>\r\n      arg === undefined ? null : arg))}))`;\r\n  }\r\n\r\n  /** 列出 names 里被脚本定义成函数的名字，结果是 JSON 数组。 */\r\n  static definedSource(names          )         {\r\n    const checks = names.filter((name        )          => NativeJsPrelude.isIdentifier(name))\r\n      .map((name        )         => `typeof ${name} === 'function' ? ${JSON.stringify(name)} : ''`);\r\n    return `JSON.stringify([${checks.join(', ')}].filter(Boolean))`;\r\n  }\r\n\r\n  /** definedSource 查出的重名给出导入时的错误信息；没有重名时返回空串。 */\r\n  static clashMessage(clashes          , builtins          )         {\r\n    if (clashes.length === 0) return '';\r\n    const name = clashes[0];\r\n    return builtins.indexOf(name) >= 0 ? `js 里的函数 “${name}” 与内置函数重名` :\r\n      `js 里的函数 “${name}” 与 lib 里的函数重名`;\r\n  }\r\n\r\n  /** 阶段 script 指向的函数没有在 js 里定义时的错误信息；都在时返回空串。 */\r\n  static missingMessage(required          , defined          )         {\r\n    const missing = required.filter((name        )          => defined.indexOf(name) < 0);\r\n    return missing.length > 0 ? `js 里没有阶段 script 用到的函数 “${missing[0]}”` : '';\r\n  }\r\n\r\n  static parseResult(text        )              {\r\n    if (text === undefined || text === null || text === '') return null;\r\n    return JSON.parse(text);\r\n  }\r\n\r\n  /** 脚本里 native.名称(...) 的宿主端：解出参数，调内置函数，把结果编码回去。 */\r\n  static answerBuiltin(builtin                                                    , name        ,\r\n    payload        )         {\r\n    const args = payload ? JSON.parse(payload) : [];\r\n    const value              = builtin(name, Array.isArray(args) ? args : []);\r\n    const text = JSON.stringify(value === undefined ? null : value);\r\n    return text === undefined ? 'null' : text;\r\n  }\r\n\r\n  /** 错误信息只留前几行，避免整段堆栈塞进界面。 */\r\n  static shortError(message        )         {\r\n    const lines = (message || '').split('\\n').map((line        )         => line.trim()).filter(Boolean);\r\n    return lines.slice(0, 3).join(' ') || '未知错误';\r\n  }\r\n}\r\n\n// Upstream NativeSourceSpec.ts\n/**\r\n * 原生书源的定义格式：解析、校验，以及与书源表字段之间的打包/还原。\r\n *\r\n * 原生书源不新增数据库列：完整定义以 JSON 存进 jsLib 字段（以 \"nativeSource\" 键开头作为标记），\r\n * 其余列只保留名称、分组、请求头等列表与请求层需要的信息。这样备份、云同步、导入导出都沿用现有通道。\r\n *\r\n * 本文件不依赖系统 API，可直接在 Node 回归脚本中加载。\r\n */\r\n\r\n/** 听书音色：id 是传给接口的值，name 是显示名。 */\r\n                                  \r\n             \r\n               \r\n \r\n\r\n                                    \r\n               \r\n                  \r\n                                   \r\n                     \r\n     \r\n                                      \r\n                                                         \r\n     \r\n                                        \r\n                                                 \r\n                   \r\n                          \r\n                 \r\n \r\n\r\n                                    \r\n                              \r\n                   \r\n                            \r\n                   \r\n \r\n\r\n/** 点一下发一个请求、把结果提示给用户的动作。open 有值时改为在应用内打开这个网页。 */\r\n                                                             \r\n                \r\n                                                        \r\n                  \r\n                \r\n                \r\n                       \r\n                   \r\n \r\n\r\n                                       \r\n              \r\n                 \r\n                                 \r\n                   \r\n \r\n\r\n                                                                  \r\n                    \r\n             \r\n                                         \r\n                 \r\n                                   \r\n                \r\n                     \r\n                   \r\n \r\n\r\n/** 先取一次、之后复用的值（如访问令牌）。只能在这里声明，规则不能随处写入状态。 */\r\n                                                            \r\n                     \r\n                \r\n                                    \r\n               \r\n                \r\n \r\n\r\n                                                                 \r\n                   \r\n             \r\n                  \r\n                \r\n \r\n\r\n                                  \r\n                                       \r\n               \r\n                                                             \r\n                                \r\n                      \r\n                                 \r\n                                                                              \r\n                  \r\n                           \r\n                              \r\n                                      \r\n                     \r\n                               \r\n \r\n\r\n                                         \r\n                    \r\n \r\n\r\n                                                            \r\n     \r\n                                                       \r\n                                                        \r\n     \r\n                  \r\n                                    \r\n                               \r\n                \r\n                \r\n                                       \r\n \r\n\r\n                                 \r\n                \r\n               \r\n                \r\n                                        \r\n                                   \r\n                                                         \r\n                  \r\n                     \r\n \r\n\r\n                                                                  \r\n               \r\n                \r\n                 \r\n \r\n\r\n                                                            \r\n                           \r\n                                       \r\n \r\n\r\n                                                           \r\n                                       \r\n                                     \r\n                                         \r\n                                          \r\n \r\n\r\n                                                        \r\n                   \r\n                    \r\n                                                  \r\n                 \r\n \r\n\r\n                                                            \r\n                \r\n \r\n\r\n                                    \r\n                  \r\n                \r\n                 \r\n \r\n\r\n/** 段评与章末评论入口：书源只给数据和地址，气泡与卡片由应用绘制。 */\r\n                                     \r\n                \r\n                             \r\n                            \r\n                                \r\n                  \r\n                                                      \r\n                        \r\n                          \r\n                      \r\n               \r\n \r\n\r\n/** 正文末尾的链接按钮，点击后在应用内打开网页（例如视频播放页）。 */\r\n                                 \r\n                \r\n                                    \r\n               \r\n                \r\n                                         \r\n                              \r\n                   \r\n \r\n\r\n/** 漫画图片解密：密钥和 IV 在取正文时算好，应用下载图片后用系统加密框架解密。 */\r\n                                        \r\n                                \r\n                    \r\n              \r\n              \r\n \r\n\r\n                                                            \r\n                                \r\n                           \r\n                                          \r\n                \r\n                  \r\n                 \r\n                                    \r\n                 \r\n                                                                       \r\n                      \r\n                                  \r\n                                        \r\n                                          \r\n                   \r\n                                                 \r\n                 \r\n                                      \r\n                                \r\n \r\n\r\n/** Literal cover parameters, shared by search, explore and detail. IV is hex or a 16-byte file prefix. */\r\n                                        \r\n                    \r\n              \r\n                               \r\n              \r\n                         \r\n \r\n\r\n                                         \r\n                                      \r\n                       \r\n               \r\n              \r\n                 \r\n                   \r\n                                     \r\n                \r\n                    \r\n                           \r\n                \r\n                                   \r\n                         \r\n                                  \r\n               \r\n                                                               \r\n              \r\n                                              \r\n                                        \r\n                          \r\n                                                               \r\n                             \r\n                                          \r\n                                 \r\n                               \r\n                                    \r\n                           \r\n                              \r\n                            \r\n                      \r\n                              \r\n \r\n\r\nclass NativeSourceSpec {\r\n  static          FORMAT         = 'native';\r\n  static          VERSION         = 1;\r\n  static          SEARCH_MARKER         = 'native:search';\r\n  /** 可以写 script 的阶段。 */\r\n  static          SCRIPT_STAGES           = ['search', 'explore', 'detail', 'toc', 'content'];\r\n\r\n  /** 定义里所有指向 js 函数的地方：阶段 script、动作按钮、动态选项、脚本登录。 */\r\n  static scriptRefs(definition                        )                                           {\r\n    const refs                                           = [];\r\n    const raw = definition                                              ;\r\n    for (const name of NativeSourceSpec.SCRIPT_STAGES) {\r\n      const stage = raw[name]                               ;\r\n      if (stage && stage.script !== undefined) refs.push({ path: `${name}.script`, fn: stage.script });\r\n    }\r\n    (Array.isArray(definition.actions) ? definition.actions : []).forEach((action                  , i        )       => {\r\n      if (action && action.script !== undefined) refs.push({ path: `actions[${i}].script`, fn: action.script });\r\n    });\r\n    for (const item of Array.isArray(definition.vars) ? definition.vars : []) {\r\n      if (item && item.optionsScript !== undefined) refs.push({ path: `vars.${item.key}.optionsScript`, fn: item.optionsScript });\r\n    }\r\n    const login = definition.login;\r\n    if (login && typeof login === 'object') {\r\n      if (login.script !== undefined) refs.push({ path: 'login.script', fn: login.script });\r\n      if (login.sendCode && login.sendCode.script !== undefined) {\r\n        refs.push({ path: 'login.sendCode.script', fn: login.sendCode.script });\r\n      }\r\n    }\r\n    return refs;\r\n  }\r\n\r\n  /** 定义里所有 script 指向的函数名（去重），导入时检查它们在 js 里存在。 */\r\n  static scriptFunctions(definition                        )           {\r\n    const names           = [];\r\n    for (const ref of NativeSourceSpec.scriptRefs(definition)) {\r\n      const fn = typeof ref.fn === 'string' ? ref.fn.trim() : '';\r\n      if (fn && names.indexOf(fn) < 0) names.push(fn);\r\n    }\r\n    return names;\r\n  }\r\n  static          EXPLORE_MARKER         = 'native:explore';\r\n\r\n          static unpackCache                                      = new Map();\r\n\r\n  /** jsLib 字段里存的是不是原生书源定义。 */\r\n  static isPacked(jsLib        )          {\r\n    return /^\\s*\\{\\s*\"nativeSource\"\\s*:/.test(jsLib || '');\r\n  }\r\n\r\n  /** 导入的 JSON 对象是不是原生书源。 */\r\n  static isDefinitionObject(value             )          {\r\n    if (!value || typeof value !== 'object' || Array.isArray(value)) return false;\r\n    return value['sourceFormat'] === NativeSourceSpec.FORMAT || typeof value['nativeSource'] === 'number';\r\n  }\r\n\r\n  /** 从导入对象整理出定义；不合法时抛出带原因的错误。 */\r\n  static fromObject(value             )                         {\r\n    if (!NativeSourceSpec.isDefinitionObject(value)) throw new Error('不是原生书源：缺少 \"sourceFormat\": \"native\"');\r\n    const raw = value                               ;\r\n    const version = Number(raw['version'] || raw['nativeSource'] || NativeSourceSpec.VERSION);\r\n    if (version > NativeSourceSpec.VERSION) {\r\n      throw new Error(`该原生书源需要更新版本的应用（格式版本 ${version}）`);\r\n    }\r\n    const definition                              = { nativeSource: NativeSourceSpec.VERSION };\r\n    for (const key of Object.keys(raw)) {\r\n      if (key === 'sourceFormat' || key === 'version' || key === 'nativeSource') continue;\r\n      definition[key] = raw[key];\r\n    }\r\n    definition['name'] = String(raw['name'] || '').trim();\r\n    definition['url'] = String(raw['url'] || '').trim();\r\n    const errors = NativeSourceSpec.validate(definition                          );\r\n    if (errors.length > 0) throw new Error(errors.slice(0, 5).join('；'));\r\n    return definition                          ;\r\n  }\r\n\r\n  /** 导出给用户的对象：把内部标记换回 sourceFormat/version。 */\r\n  static toExportObject(definition                        )                              {\r\n    const out                              = {\r\n      sourceFormat: NativeSourceSpec.FORMAT,\r\n      version: definition.nativeSource || NativeSourceSpec.VERSION\r\n    };\r\n    const raw = definition                                              ;\r\n    for (const key of Object.keys(raw)) {\r\n      if (key !== 'nativeSource') out[key] = raw[key];\r\n    }\r\n    return out;\r\n  }\r\n\r\n  static pack(definition                        )         {\r\n    const ordered                              = { nativeSource: definition.nativeSource || NativeSourceSpec.VERSION };\r\n    const raw = definition                                              ;\r\n    for (const key of Object.keys(raw)) {\r\n      if (key !== 'nativeSource') ordered[key] = raw[key];\r\n    }\r\n    return JSON.stringify(ordered);\r\n  }\r\n\r\n  static unpack(jsLib        )                                {\r\n    if (!NativeSourceSpec.isPacked(jsLib)) return null;\r\n    const cached = NativeSourceSpec.unpackCache.get(jsLib);\r\n    if (cached) return cached;\r\n    try {\r\n      const parsed = JSON.parse(jsLib)                          ;\r\n      if (NativeSourceSpec.unpackCache.size >= 64) NativeSourceSpec.unpackCache.clear();\r\n      NativeSourceSpec.unpackCache.set(jsLib, parsed);\r\n      return parsed;\r\n    } catch (e) {\r\n      return null;\r\n    }\r\n  }\r\n\r\n  static bookSourceType(definition                        )         {\r\n    const type = String(definition.type || 'text').toLowerCase();\r\n    if (type === 'audio') return 1;\r\n    if (type === 'comic' || type === 'image') return 2;\r\n    return 0;\r\n  }\r\n\r\n  /** Decoded AES key length in bytes, or -1 when the key or its encoding is malformed. */\r\n  static coverKeyBytes(spec                       )         {\r\n    if (typeof spec.key !== 'string' || !spec.key || spec.key.length > 128) return -1;\r\n    if (spec.keyEncoding === 'utf8') {\r\n      // Same byte count util.TextEncoder produces (lone surrogates become U+FFFD), without a platform import.\r\n      let bytes = 0;\r\n      for (let i = 0; i < spec.key.length; i++) {\r\n        const code = spec.key.charCodeAt(i);\r\n        const next = spec.key.charCodeAt(i + 1);\r\n        if (code < 0x80) bytes += 1;\r\n        else if (code < 0x800) bytes += 2;\r\n        else if (code >= 0xD800 && code <= 0xDBFF && next >= 0xDC00 && next <= 0xDFFF) { bytes += 4; i++; }\r\n        else bytes += 3;\r\n      }\r\n      return bytes;\r\n    }\r\n    if (spec.keyEncoding !== undefined && spec.keyEncoding !== 'hex') return -1;\r\n    return /^(?:[a-f0-9]{2})+$/i.test(spec.key) ? spec.key.length / 2 : -1;\r\n  }\r\n\r\n  static validate(definition                        )           {\r\n    const errors           = [];\r\n    const cover = definition.coverDecode;\r\n    if (cover !== undefined) {\r\n      if (!cover || !/^AES\\/CBC\\/PKCS(?:5|7)Padding$/i.test(cover.algorithm || '') ||\r\n        ![16, 24, 32].includes(NativeSourceSpec.coverKeyBytes(cover)) ||\r\n        (cover.ivPrefixBytes === 16 ? !!cover.iv :\r\n          (cover.ivPrefixBytes !== undefined && cover.ivPrefixBytes !== 0) || !/^[a-f0-9]{32}$/i.test(cover.iv || ''))) {\r\n        errors.push('coverDecode 需要 AES/CBC/PKCS7Padding、16/24/32 字节的 key，以及 iv 或 ivPrefixBytes:16');\r\n      }\r\n    }\r\n    if (!definition.name) errors.push('缺少书源名称 name');\r\n    if (!/^https?:\\/\\//i.test(definition.url || '')) errors.push('书源地址 url 必须以 http:// 或 https:// 开头');\r\n    if (!definition.search && !definition.explore) errors.push('至少需要 search 或 explore 其中之一');\r\n    const type = String(definition.type || 'text').toLowerCase();\r\n    if (['text', 'audio', 'comic', 'image', 'video'].indexOf(type) < 0) {\r\n      errors.push('type 只能是 text、audio、comic 或 video');\r\n    }\r\n\r\n    const keys              = new Set();\r\n    for (const item of definition.vars || []) {\r\n      if (!item || !/^[A-Za-z_][A-Za-z0-9_]*$/.test(item.key || '')) {\r\n        errors.push('vars 里的 key 只能用字母、数字和下划线');\r\n        continue;\r\n      }\r\n      if (keys.has(item.key)) errors.push(`vars 里的 key 重复：${item.key}`);\r\n      keys.add(item.key);\r\n      if (item.options !== undefined && !Array.isArray(item.options)) errors.push(`vars.${item.key}.options 必须是数组`);\r\n    }\r\n\r\n    if (definition.lib !== undefined && typeof definition.lib !== 'string') {\r\n      errors.push('lib 必须是字符串');\r\n    } else if (definition.lib) {\r\n      const problem = NativeExpr.checkLibrary(definition.lib);\r\n      if (problem) errors.push(`lib：${problem}`);\r\n    }\r\n    if (definition.js !== undefined && typeof definition.js !== 'string') {\r\n      errors.push('js 必须是字符串');\r\n    } else if (definition.js && definition.js.length > NativeJsPrelude.MAX_CODE_LENGTH) {\r\n      errors.push(`js 太长：上限 ${Math.round(NativeJsPrelude.MAX_CODE_LENGTH / 1024)} KB`);\r\n    }\r\n    for (const ref of NativeSourceSpec.scriptRefs(definition)) {\r\n      if (typeof ref.fn !== 'string' || !NativeJsPrelude.isIdentifier(ref.fn.trim())) {\r\n        errors.push(`${ref.path} 必须是 js 里的函数名`);\r\n      } else if (!definition.js || !definition.js.trim()) {\r\n        errors.push(`${ref.path} 需要在 js 里定义函数 ${ref.fn.trim()}`);\r\n      }\r\n    }\r\n    if (definition.scriptLimits !== undefined) {\r\n      const limits = definition.scriptLimits;\r\n      const requests = limits && typeof limits === 'object' ? limits.requests : undefined;\r\n      if (!limits || typeof limits !== 'object' || (requests !== undefined &&\r\n        !(Number.isInteger(requests) && requests >= 1 && requests <= 100))) {\r\n        errors.push('scriptLimits.requests 必须是 1 到 100 的整数');\r\n      }\r\n    }\r\n    if (definition.voices !== undefined) {\r\n      if (!Array.isArray(definition.voices)) {\r\n        errors.push('voices 必须是数组');\r\n      } else if (definition.voices.some((voice                 )          =>\r\n        !voice || String(voice.id === undefined ? '' : voice.id) === '' || !voice.name)) {\r\n        errors.push('voices 的每一项都需要 id 和 name');\r\n      }\r\n    }\r\n    NativeSourceSpec.checkValues(definition.let, 'let', errors);\r\n    NativeSourceSpec.checkValues(definition.headers, 'headers', errors);\r\n    if (definition.cache !== undefined) {\r\n      if (!definition.cache || typeof definition.cache !== 'object' || Array.isArray(definition.cache)) {\r\n        errors.push('cache 必须是对象');\r\n      } else {\r\n        for (const name of Object.keys(definition.cache)) {\r\n          const entry = definition.cache[name];\r\n          if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(name)) errors.push(`cache 的名称只能用字母、数字和下划线：${name}`);\r\n          if (!entry || !entry.url || !entry.value) errors.push(`cache.${name} 需要 url 和 value`);\r\n        }\r\n        NativeSourceSpec.checkValues(definition.cache, 'cache', errors);\r\n      }\r\n    }\r\n    if (definition.actions !== undefined) {\r\n      if (!Array.isArray(definition.actions)) {\r\n        errors.push('actions 必须是数组');\r\n      } else {\r\n        for (const action of definition.actions) {\r\n          if (!action || !action.label || (!action.url && !action.open && !action.script)) {\r\n            errors.push('actions 的每一项都需要 label，以及 url、open 或 script');\r\n          }\r\n        }\r\n        NativeSourceSpec.checkValues(definition.actions, 'actions', errors);\r\n      }\r\n    }\r\n    if (definition.login !== undefined) {\r\n      const login = definition.login;\r\n      if (!login || typeof login !== 'object') {\r\n        errors.push('login 必须是对象');\r\n      } else if (!login.url && !login.submit && !login.script) {\r\n        errors.push('login 需要 url（网页登录）、submit（表单登录）或 script（脚本登录）');\r\n      } else if (login.url && !/^https?:\\/\\//i.test(String(login.url))) {\r\n        errors.push('login.url 必须是以 http:// 或 https:// 开头的登录页地址');\r\n      } else {\r\n        if (login.submit) {\r\n          if (!login.submit.url || !login.submit.ok) errors.push('login.submit 需要 url 和 ok');\r\n          if (!Array.isArray(login.form) || login.form.length === 0) errors.push('表单登录需要 login.form');\r\n          NativeSourceSpec.checkValues(login.submit, 'login.submit', errors);\r\n        }\r\n        for (const field of Array.isArray(login.form) ? login.form : []) {\r\n          if (!field || !/^[A-Za-z_][A-Za-z0-9_]*$/.test(field.key || '')) {\r\n            errors.push('login.form 里的 key 只能用字母、数字和下划线');\r\n          }\r\n        }\r\n        if (login.sendCode) {\r\n          if (!login.sendCode.url && !login.sendCode.script) errors.push('login.sendCode 需要 url 或 script');\r\n          NativeSourceSpec.checkValues(login.sendCode, 'login.sendCode', errors);\r\n        }\r\n        if (login.cookies !== undefined && !Array.isArray(login.cookies)) errors.push('login.cookies 必须是数组');\r\n        if (login.check) {\r\n          if (!login.check.url || !login.check.ok) errors.push('login.check 需要 url 和 ok');\r\n          NativeSourceSpec.checkValues(login.check, 'login.check', errors);\r\n        }\r\n      }\r\n    }\r\n    const stages                                               = [\r\n      ['search', definition.search], ['explore', definition.explore], ['detail', definition.detail],\r\n      ['toc', definition.toc], ['content', definition.content]\r\n    ];\r\n    for (const entry of stages) {\r\n      if (entry[1] === undefined) continue;\r\n      if (!entry[1] || typeof entry[1] !== 'object' || Array.isArray(entry[1])) {\r\n        errors.push(`${entry[0]} 必须是对象`);\r\n        continue;\r\n      }\r\n      NativeSourceSpec.checkValues(entry[1], entry[0], errors);\r\n    }\r\n    if (definition.search) {\r\n      if (!definition.search.url && !definition.search.script) errors.push('search 缺少 url');\r\n      NativeSourceSpec.requireBookFields(definition.search, 'search', errors);\r\n    }\r\n    if (definition.explore) {\r\n      const explore = definition.explore;\r\n      if ((!explore.menus || explore.menus.length === 0) && !explore.dynamicMenus) {\r\n        errors.push('explore 需要 menus 或 dynamicMenus');\r\n      }\r\n      if (explore.menus !== undefined && !Array.isArray(explore.menus)) errors.push('explore.menus 必须是数组');\r\n      if (explore.dynamicMenus && (!explore.dynamicMenus.url || !explore.dynamicMenus.list ||\r\n        !explore.dynamicMenus.title || !explore.dynamicMenus.target)) {\r\n        errors.push('explore.dynamicMenus 需要 url、list、title 和 target');\r\n      }\r\n      NativeSourceSpec.requireBookFields(explore, 'explore', errors);\r\n    }\r\n    if (definition.toc) {\r\n      // 脚本阶段可以不写 list 和 fields（按返回数组的每项、同名键取值）；写了 fields 就要写全。\r\n      const scripted = !!definition.toc.script;\r\n      const fields = definition.toc.fields || {};\r\n      if (!definition.toc.list && !scripted) errors.push('toc 缺少 list');\r\n      if (!scripted || definition.toc.fields) {\r\n        if (!fields['title']) errors.push('toc.fields 缺少 title');\r\n        if (!fields['url']) errors.push('toc.fields 缺少 url');\r\n      }\r\n      NativeSourceSpec.checkBatch(definition.toc.batch, 'toc.batch', errors);\r\n    }\r\n    if (definition.content) {\r\n      const content = definition.content;\r\n      if (!content.text && !content.images && !content.audio && !content.video && !content.script) {\r\n        errors.push('content 需要 text、images、audio 或 video 之一');\r\n      }\r\n      if (content.replace !== undefined && !Array.isArray(content.replace)) errors.push('content.replace 必须是数组');\r\n      NativeSourceSpec.checkBatch(content.batch, 'content.batch', errors);\r\n      if (content.links !== undefined) {\r\n        if (!Array.isArray(content.links)) {\r\n          errors.push('content.links 必须是数组');\r\n        } else if (content.links.some((link                )          =>\r\n          !link || !link.label || (!link.url && !(link.request && link.request.url)))) {\r\n          errors.push('content.links 的每一项都需要 label，以及 url 或 request');\r\n        }\r\n      }\r\n      if (content.imageDecode !== undefined) {\r\n        const decode = content.imageDecode;\r\n        if (!decode || !decode.algorithm || !decode.key) {\r\n          errors.push('content.imageDecode 需要 algorithm 和 key');\r\n        } else if (!/^(aes|desede|3des)\\//i.test(String(decode.algorithm))) {\r\n          errors.push('content.imageDecode.algorithm 只支持 AES 和 3DES，例如 AES/CBC/PKCS5Padding');\r\n        }\r\n      }\r\n      if (content.comments) {\r\n        if (!content.comments.paragraphUrl && !content.comments.chapterUrl) {\r\n          errors.push('content.comments 需要 paragraphUrl 或 chapterUrl');\r\n        }\r\n        if (content.comments.paragraphUrl && !content.comments.counts) {\r\n          errors.push('content.comments 使用 paragraphUrl 时需要 counts');\r\n        }\r\n      }\r\n      for (const rule of Array.isArray(content.replace) ? content.replace : []) {\r\n        try {\r\n          new RegExp(rule.pattern || '', rule.flags === undefined ? 'g' : rule.flags);\r\n        } catch (e) {\r\n          errors.push(`content.replace 的正则写法不正确：${rule.pattern}`);\r\n        }\r\n      }\r\n    }\r\n    return errors;\r\n  }\r\n\r\n          static checkBatch(batch                    , path        , errors          )       {\r\n    if (batch !== undefined && !(typeof batch === 'number' && Number.isInteger(batch) && batch >= 1 && batch <= 16)) {\r\n      errors.push(`${path} 必须是 1 到 16 的整数`);\r\n    }\r\n  }\r\n\r\n          static requireBookFields(stage                 , name        , errors          )       {\r\n    const fields = stage.fields || {};\r\n    if (!stage.list && !stage.script) errors.push(`${name} 缺少 list`);\r\n    if (stage.script && !stage.fields) return;\r\n    if (!fields['name']) errors.push(`${name}.fields 缺少 name`);\r\n    if (!fields['bookUrl']) errors.push(`${name}.fields 缺少 bookUrl`);\r\n  }\r\n\r\n  /** 递归检查每个字符串值：表达式和模板的语法，以及是否混入了脚本。 */\r\n          static checkValues(value             , path        , errors          )       {\r\n    if (errors.length >= 20 || value === null || value === undefined) return;\r\n    if (typeof value === 'string') {\r\n      const text = value.trim();\r\n      let problem = '';\r\n      if (text.startsWith('=')) {\r\n        problem = NativeExpr.check(text.substring(1));\r\n      } else if (/^@?js\\s*:|<js>|@js\\s*:/i.test(text)) {\r\n        problem = '原生书源不支持脚本，请改用 = 表达式';\r\n      } else if (text.indexOf('{{') >= 0) {\r\n        problem = NativeExpr.checkTemplate(text);\r\n      }\r\n      if (problem) errors.push(`${path}：${problem}`);\r\n      return;\r\n    }\r\n    if (Array.isArray(value)) {\r\n      for (let i = 0; i < value.length; i++) NativeSourceSpec.checkValues(value[i], `${path}[${i}]`, errors);\r\n      return;\r\n    }\r\n    if (typeof value === 'object') {\r\n      for (const key of Object.keys(value)) {\r\n        // replace 的 pattern/with 是正则与替换文本，不按规则语法检查。\r\n        if (/\\.replace\\[\\d+\\]$/.test(path)) continue;\r\n        NativeSourceSpec.checkValues(value[key], `${path}.${key}`, errors);\r\n      }\r\n    }\r\n  }\r\n}\r\n\n// Upstream NativeScriptHost.ts\n/**\r\n * 脚本阶段的宿主端：脚本里的 http、vars、temp、cache、cookie、login、keep、log、sleep、device 和 native.*\r\n * 调用都在这里分发，并按预算计数。脚本本身在后台线程同步等待，这里的处理都在主线程上（可以是异步的）。\r\n *\r\n * 本文件不依赖系统 API，可直接在 Node 回归脚本中加载。\r\n */\r\n\r\n/** 宿主对脚本一次调用的处理；抛出的错误会成为脚本里可以 catch 的错误。 */\r\n                                                                                                                \r\n\r\n                                         \r\n                               \r\n                \r\n                                               \r\n                 \r\n                           \r\n                          \r\n \r\n\r\n/** 在后台运行书源 js 里的函数 fn(ctx)：真机是 QuickJS 后台会话，Node 回归是 worker。 */\r\n                                     \r\n                                                                                                                             \r\n \r\n\r\n/** 一次阶段运行的预算。 */\r\nclass NativeScriptLimits {\r\n  static          DEFAULT_REQUESTS         = 30;\r\n  static          MAX_REQUESTS         = 100;\r\n  requests         = NativeScriptLimits.DEFAULT_REQUESTS;\r\n  bytes         = 16 * 1024 * 1024;\r\n  cpuMs         = 2000;\r\n  wallMs         = 60000;\r\n\r\n  static of(requests                    )                     {\r\n    const limits = new NativeScriptLimits();\r\n    if (requests !== undefined && requests !== null && Number.isFinite(Number(requests))) {\r\n      limits.requests = Math.max(1, Math.min(Math.floor(Number(requests)), NativeScriptLimits.MAX_REQUESTS));\r\n    }\r\n    return limits;\r\n  }\r\n}\r\n\r\n/** 运行器提供给脚本宿主的状态与操作。 */\r\n                                      \r\n                         \r\n                    \r\n                                                             \r\n                \r\n             \r\n                             \r\n                           \r\n                                                              \r\n                                       \r\n                                                             \r\n                                 \r\n                                \r\n                                                                 \r\n                                    \r\n                                      \r\n     \r\n                                              \r\n                                                \r\n     \r\n                       \r\n \r\n\r\nconst BATCH = 8;\r\nconst MAX_SLEEP_MS = 5000;\r\nconst NOT_INTERACTIVE = '搜索和发现时不能打开网页';\r\nconst DEFAULT_CACHE_TTL = 600;\r\nconst MAX_CACHE_TTL = 7 * 24 * 3600;\r\n\r\nclass NativeScriptHost {\r\n          context                     ;\r\n          requests         = 0;\r\n          bytes         = 0;\r\n          paused         = 0;\r\n\r\n  constructor(context                     ) {\r\n    this.context = context;\r\n  }\r\n\r\n  get requestCount()         {\r\n    return this.requests;\r\n  }\r\n\r\n  /** 等用户在网页里操作的总时长，不计入脚本的总时长预算。 */\r\n  get pausedMs()         {\r\n    return this.paused;\r\n  }\r\n\r\n  /** 交给脚本引擎的处理函数。 */\r\n  handler()                          {\r\n    return (name        , args               )                                     => this.handle(name, args);\r\n  }\r\n\r\n          handle(name        , args               )                                     {\r\n    if (this.context.cancelled()) throw new Error('已取消');\r\n    if (!name.startsWith('@')) return this.context.builtin(name, args);\r\n    switch (name) {\r\n      case '@http':\r\n        return this.http(args[0]);\r\n      case '@httpAll':\r\n        return this.httpAll(Array.isArray(args[0]) ? args[0] : []);\r\n      case '@varsGet':\r\n        return this.context.getVar(this.text(args[0]));\r\n      case '@varsSet':\r\n        return this.context.setVar(this.text(args[0]), args[1] === undefined ? null : args[1]).then(()              => null);\r\n      case '@tempGet': {\r\n        const value = this.context.temp.get(this.text(args[0]));\r\n        return value === undefined ? null : value;\r\n      }\r\n      case '@tempSet':\r\n        this.context.temp.set(this.text(args[0]), args[1] === undefined ? null : args[1]);\r\n        return null;\r\n      case '@cacheGet': {\r\n        const value = this.cacheHost().cacheGet (this.cacheKey(args[0]));\r\n        return value === undefined ? null : value;\r\n      }\r\n      case '@cacheSet': {\r\n        const ttl = Math.max(1, Math.min(Number(args[2]) || DEFAULT_CACHE_TTL, MAX_CACHE_TTL));\r\n        this.cacheHost().cachePut (this.cacheKey(args[0]), args[1] === undefined ? null : args[1], ttl);\r\n        return null;\r\n      }\r\n      case '@cookieGet':\r\n        return this.cookieHost('读取').cookieGet (this.url(args[0]), this.text(args[1]));\r\n      case '@cookieSet':\r\n        this.cookieHost('写入').cookieSet (this.url(args[0]), this.text(args[1]));\r\n        return null;\r\n      case '@cookieRemove':\r\n        this.cookieHost('删除').cookieRemove (this.url(args[0]), this.text(args[1]));\r\n        return null;\r\n      case '@login':\r\n        return this.context.credential();\r\n      case '@loginSave':\r\n        return this.context.saveCredential(this.text(args[0]), this.text(args[1])).then(()              => null);\r\n      case '@keep':\r\n        if (!this.context.keep) throw new Error('keep 只能在详情阶段使用');\r\n        this.context.keep[this.text(args[0])] = this.text(args[1]);\r\n        return null;\r\n      case '@log':\r\n        this.trace('log', this.text(args[0]), '');\r\n        return null;\r\n      case '@sleep': {\r\n        const ms = Math.max(0, Math.min(Number(args[0]) || 0, MAX_SLEEP_MS));\r\n        return new Promise             ((resolve                              )       => {\r\n          setTimeout(()       => resolve(null), ms);\r\n        });\r\n      }\r\n      case '@toast': {\r\n        const host = this.context.host;\r\n        if (!host.toast) throw new Error('当前环境不支持提示');\r\n        host.toast(this.text(args[0]));\r\n        return null;\r\n      }\r\n      case '@refreshExplore': {\r\n        const host = this.context.host;\r\n        if (!host.refreshExplore) throw new Error('当前环境不支持刷新发现页');\r\n        return host.refreshExplore().then(()              => null);\r\n      }\r\n      case '@browserVerify':\r\n        return this.browserVerify(this.url(args[0]), this.text(args[1]));\r\n      case '@browserOpen': {\r\n        const host = this.context.host;\r\n        if (!this.context.interactive) throw new Error(NOT_INTERACTIVE);\r\n        if (!host.openBrowser) throw new Error('当前环境不支持打开网页');\r\n        return host.openBrowser(this.url(args[0]), this.text(args[1]), false).then(()              => null);\r\n      }\r\n      case '@render':\r\n        return this.render(this.url(args[0]), args[1]);\r\n      case '@device': {\r\n        const host = this.context.host;\r\n        if (this.text(args[0]) === 'ua') return host.userAgent ? host.userAgent() : '';\r\n        return host.deviceId ? host.deviceId() : '';\r\n      }\r\n      default:\r\n        throw new Error(`没有这个宿主接口：${name.substring(1)}`);\r\n    }\r\n  }\r\n\r\n  /** 交互场景里打开网页等用户完成，返回页面；非交互场景提示「去验证」。 */\r\n          async browserVerify(url        , hint        )                       {\r\n    if (!/^https?:/i.test(url)) throw new Error(`网页地址无效：${url}`);\r\n    const host = this.context.host;\r\n    if (!this.context.interactive) {\r\n      if (host.requestVerification) host.requestVerification(url, hint || '网页验证');\r\n      throw new Error(`需要网页验证${hint ? `（${hint}）` : ''}，请点「去验证」后重试`);\r\n    }\r\n    if (!host.openBrowser) throw new Error('当前环境不支持打开网页');\r\n    const startedAt = Date.now();\r\n    this.trace(`browser.verify ${url}`, '等待用户在网页里完成', '');\r\n    try {\r\n      const result = await host.openBrowser(url, hint, true);\r\n      if (result.error) throw new Error(result.error);\r\n      return result.body;\r\n    } finally {\r\n      this.paused += Date.now() - startedAt;\r\n    }\r\n  }\r\n\r\n  /** 在内置浏览器里加载页面并执行注入的表达式，返回结果（对象会转成 JSON 文本）。 */\r\n          async render(url        , raw             )                       {\r\n    const options                              = raw && typeof raw === 'object' && !Array.isArray(raw) ?\r\n      raw                                : {};\r\n    const request = this.request({\r\n      url: url, headers: options['headers'],\r\n      webView: { waitFor: options['waitFor'] || '', timeout: options['timeout'] }\r\n    });\r\n    request.webJs = this.text(options['js']).trim();\r\n    this.count(1);\r\n    const response = await this.fetch(request)                               ;\r\n    if (!response['ok']) throw new Error(`网页渲染失败：${response['error'] || `HTTP ${response['status']}`}`);\r\n    return response['body'];\r\n  }\r\n\r\n          async http(raw             )                       {\r\n    this.count(1);\r\n    return await this.fetch(this.request(raw));\r\n  }\r\n\r\n          async httpAll(list               )                       {\r\n    const requests = list.map((raw             )                => this.request(raw));\r\n    this.count(requests.length);\r\n    const results                = [];\r\n    for (let offset = 0; offset < requests.length; offset += BATCH) {\r\n      if (this.context.cancelled()) throw new Error('已取消');\r\n      const batch = requests.slice(offset, offset + BATCH);\r\n      const responses = await Promise.all(batch.map((request               )                       => this.fetch(request)));\r\n      for (const response of responses) results.push(response);\r\n    }\r\n    return results;\r\n  }\r\n\r\n          count(added        )       {\r\n    this.requests += added;\r\n    if (this.requests > this.context.limits.requests) {\r\n      throw new Error(`脚本请求次数超过上限（${this.context.limits.requests} 次）`);\r\n    }\r\n  }\r\n\r\n          async fetch(request               )                       {\r\n    const startedAt = Date.now();\r\n    let response                ;\r\n    try {\r\n      response = await this.context.host.fetch(request);\r\n    } catch (e) {\r\n      response = { ok: false, status: 0, body: '', url: request.url, error: (e         ).message || '网络异常' };\r\n    }\r\n    const body = response.body || '';\r\n    this.bytes += body.length;\r\n    this.trace(`${request.method} ${request.url}`,\r\n      `${response.status || '-'} · ${body.length} 字 · ${Date.now() - startedAt} ms`, response.ok ? '' : (response.error || ''));\r\n    if (this.bytes > this.context.limits.bytes) {\r\n      throw new Error(`脚本收到的数据超过上限（${Math.round(this.context.limits.bytes / 1024 / 1024)} MB）`);\r\n    }\r\n    return {\r\n      ok: response.ok, status: response.status, body: body, url: response.url || request.url, error: response.error || ''\r\n    };\r\n  }\r\n\r\n  /** 脚本给出的请求（地址字符串或对象）整理成与声明式请求相同的 NativeRequest。 */\r\n          request(raw             )                {\r\n    const spec                              = raw && typeof raw === 'object' && !Array.isArray(raw) ?\r\n      raw                                : { url: raw };\r\n    const url = this.url(spec['url']);\r\n    if (!/^(https?:|data:)/i.test(url)) throw new Error(`请求地址无效：${this.text(spec['url'])}`);\r\n    const headers                         = {};\r\n    const rawHeaders = spec['headers'];\r\n    if (rawHeaders && typeof rawHeaders === 'object') {\r\n      for (const name of Object.keys(rawHeaders)) {\r\n        const value = (rawHeaders                               )[name];\r\n        if (value !== undefined && value !== null && value !== '') headers[name] = String(value);\r\n      }\r\n    }\r\n    const body = spec['body'] === undefined || spec['body'] === null ? '' : String(spec['body']);\r\n    const method = (this.text(spec['method']).trim() || (body ? 'POST' : 'GET')).toUpperCase();\r\n    if (!/^[A-Z]+$/.test(method)) throw new Error(`请求方法无效：${spec['method']}`);\r\n    const web = spec['webView'];\r\n    const webSpec                                     = web && typeof web === 'object' ? web                                : null;\r\n    return {\r\n      url: url, method: method, headers: headers, body: body, webView: web === true || !!webSpec,\r\n      webWaitFor: webSpec && webSpec['waitFor'] ? String(webSpec['waitFor']).trim() : '',\r\n      webTimeout: Math.max(3, Math.min(Number(webSpec ? webSpec['timeout'] : 0) || 15, 60)),\r\n      charset: this.text(spec['charset']).trim(),\r\n      retry: Math.max(0, Math.min(Math.floor(Number(spec['retry']) || 0), 3)),\r\n      primary: false\r\n    };\r\n  }\r\n\r\n          cookieHost(action        )                   {\r\n    const host = this.context.host;\r\n    if (!host.cookieGet || !host.cookieSet || !host.cookieRemove) throw new Error(`当前环境不支持${action} Cookie`);\r\n    return host;\r\n  }\r\n\r\n  /** 没有缓存时明确报错：静默丢掉写入会让脚本读到空值，难以排查。 */\r\n          cacheHost()                   {\r\n    const host = this.context.host;\r\n    if (!host.cacheGet || !host.cachePut) throw new Error('当前环境不支持缓存');\r\n    return host;\r\n  }\r\n\r\n          cacheKey(key             )         {\r\n    return `script\\n${this.text(key)}`;\r\n  }\r\n\r\n          url(value             )         {\r\n    return NativeExpr.resolveUrl(this.text(value).trim(), this.context.sourceUrl);\r\n  }\r\n\r\n          text(value             )         {\r\n    return value === undefined || value === null ? '' : String(value);\r\n  }\r\n\r\n          trace(rule        , preview        , error        )       {\r\n    if (!this.context.host.trace) return;\r\n    this.context.host.trace({\r\n      field: `${this.context.stage}.script ${this.context.fn}`, rule: rule, type: 'script', count: 1,\r\n      preview: preview, error: error\r\n    });\r\n  }\r\n}\r\n\n// Upstream NativeSourceRunner.ts\n/**\r\n * 原生书源执行器：按定义依次完成请求、取列表、取字段，全程不经过任何脚本引擎。\r\n *\r\n * 网络与选择器通过 NativeRunnerHost 注入，本文件不依赖系统 API，可直接在 Node 回归脚本中加载。\r\n */\r\n\r\n/** 一条规则的求值记录，供调试页显示。 */\r\n                                  \r\n                \r\n               \r\n                                         \r\n               \r\n                \r\n                  \r\n                \r\n \r\n\r\n/** 已保存的登录凭据（表单登录得到的）。 */\r\n                                        \r\n                \r\n               \r\n \r\n\r\n                                    \r\n              \r\n                \r\n               \r\n                  \r\n \r\n\r\n/** 一个动作按钮：open 有值时打开网页，否则点击后执行对应序号的请求。 */\r\n                                    \r\n                \r\n                \r\n               \r\n \r\n\r\n                                                          \r\n                                                         \r\n                           \r\n                                       \r\n                                     \r\n                                      \r\n                                                                       \r\n                                                   \r\n                                                                             \r\n                                          \r\n                                                    \r\n                                  \r\n                                                  \r\n                                               \r\n                                                \r\n                                               \r\n                                                 \r\n                                   \r\n                                                                \r\n                            \r\n                                                              \r\n                      \r\n                       \r\n                      \r\n                                \r\n                               \r\n                                   \r\n                                                                   \r\n                                                                                        \r\n                                     \r\n                                                         \r\n \r\n\r\n/** 设置页动态选项的结果：失败时 options 为空、error 为原因。 */\r\n                                   \r\n                    \r\n                \r\n \r\n\r\n                                   \r\n               \r\n                 \r\n               \r\n                \r\n                   \r\n                    \r\n                      \r\n                     \r\n                 \r\n                  \r\n                 \r\n                                                 \r\n               \r\n                               \r\n \r\n\r\n                                  \r\n                  \r\n                 \r\n               \r\n                 \r\n               \r\n               \r\n                                    \r\n \r\n\r\n                                     \r\n              \r\n                \r\n                \r\n \r\n\r\n                                      \r\n                \r\n              \r\n                 \r\n                 \r\n                    \r\n              \r\n \r\n\r\n                                  \r\n                \r\n                  \r\n                 \r\n \r\n\r\n                                         \r\n                         \r\n               \r\n                \r\n              \r\n \r\n\r\n                                      \r\n                                      \r\n               \r\n               \r\n                  \r\n                                              \r\n                        \r\n                            \r\n                   \r\n                             \r\n                                  \r\n                   \r\n                       \r\n                                       \r\n                                        \r\n \r\n\r\n                                    \r\n                \r\n                              \r\n              \r\n                                       \r\n                                \r\n                  \r\n \r\n\r\n/** 图片解密参数，密钥与 IV 为十六进制。 */\r\n                                    \r\n                    \r\n              \r\n             \r\n \r\n\r\nclass NativeSourceError extends Error {\r\n  constructor(message        ) {\r\n    super(message);\r\n    this.name = 'NativeSourceError';\r\n  }\r\n}\r\n\r\n                     \r\n                     \r\n                  \r\n \r\n\r\n/** 详情页的响应，留给紧接着的目录第一页复用（目录与详情是同一个请求时）。 */\r\n                    \r\n               \r\n                  \r\n                 \r\n \r\n\r\n/** 一次脚本函数运行的结果。 */\r\n                     \r\n                     \r\n                   \r\n             \r\n \r\n\r\n/** loadStage 对响应的处理：keep 记下供之后复用，take 有记下的同一请求时直接用、不再请求。 */\r\n                                       \r\n\r\nconst MENU_STATIC = 'native:menu:';\r\n/** 脚本阶段不写 fields 时，按同名键取值的字段。 */\r\nconst BOOK_FIELD_NAMES = ['name', 'author', 'kind', 'intro', 'coverUrl', 'wordCount', 'lastChapter', 'updateTime',\r\n  'status', 'bookUrl', 'tocUrl', 'type'];\r\nconst CHAPTER_FIELD_NAMES = ['title', 'url', 'isVip', 'isPay', 'isVolume', 'tag'];\r\nconst STAGE_NAMES                         = {\r\n  '搜索': 'search', '发现': 'explore', '详情': 'detail', '目录': 'toc', '正文': 'content'\r\n};\r\nconst MENU_ITEM = 'native:item:';\r\nconst MAX_TOC_PAGES = 1000;\r\n/** 目录或正文的 nextUrl 一次给出多个地址时，剩余分页每批并发请求的页数；书源可用 batch 改为 1～16。 */\r\nconst DEFAULT_PAGE_BATCH = 4;\r\nconst MAX_PAGE_BATCH = 16;\r\n/** 记下的详情页只在这段时间内、只复用一次；打开书、换源都是取完详情立即取目录。 */\r\nconst KEPT_PAGE_TTL_MS = 60 * 1000;\r\nconst MAX_KEPT_PAGES = 4;\r\n/** 正文分页最多跟随的页数，以及多页拼接后的正文长度上限（与兼容书源相同的 8 MB）。 */\r\nconst MAX_CONTENT_PAGES = 200;\r\nconst MAX_CONTENT_CHARS = 8 * 1024 * 1024;\r\nconst MAX_LIST_ITEMS = 20000;\r\nconst DEFAULT_COMMENT_BUBBLES = 60;\r\nconst MAX_COMMENT_BUBBLES = 300;\r\n\r\n/**\r\n * 逐章取字段时让出主线程，节奏与兼容书源的 RuleExecutionService 相同：连续执行约 6 ms 让出一次，\r\n * 距上次空出整帧超过 50 ms 时改为空出一帧（只让 1 ms 可能仍落在同一个原生定时器任务里）。\r\n */\r\nclass UiPacer {\r\n          static          SLICE_MS         = CooperativeScheduler.DEFAULT_UI_SLICE_MS;\r\n          static          FRAME_MS         = 50;\r\n          sliceStartedAt         = Date.now();\r\n          frameYieldedAt         = Date.now();\r\n\r\n  /** 时间片用完时让出；没用完时不产生 await，避免每章多一次微任务。 */\r\n  due()          {\r\n    return Date.now() - this.sliceStartedAt >= UiPacer.SLICE_MS;\r\n  }\r\n\r\n  async yield()                {\r\n    if (Date.now() - this.frameYieldedAt >= UiPacer.FRAME_MS) {\r\n      await CooperativeScheduler.yieldToNextUiFrame();\r\n      this.frameYieldedAt = Date.now();\r\n    } else {\r\n      await CooperativeScheduler.yieldToEventLoop();\r\n    }\r\n    this.sliceStartedAt = Date.now();\r\n  }\r\n}\r\n\r\nclass NativeSourceRunner {\r\n          static keptPages                        = new Map                  ();\r\n          definition                        ;\r\n          host                  ;\r\n          expr            ;\r\n          varValues                        ;\r\n          cancelled                = ()          => false;\r\n          credential                        = { token: '', user: '' };\r\n  /** 已保存的全部书源变量，包括没有在 vars 里声明、由脚本写入的键。 */\r\n          storedVars                             ;\r\n  /** 脚本的 temp：只在这个运行器（一次操作）里有效。 */\r\n          temp                           = new Map();\r\n  /** 详情阶段脚本用 keep() 记下的书籍变量。 */\r\n          scriptKeep                                = null;\r\n          engine                            = null;\r\n\r\n  constructor(definition                        , host                  , storedVars                              = {}) {\r\n    this.definition = definition;\r\n    this.host = host;\r\n    this.expr = new NativeExpr(host).loadLibrary(definition.lib).loadScript(NativeSourceRunner.scriptOf(definition, host));\r\n    this.varValues = NativeSourceRunner.resolveVars(definition, storedVars);\r\n    this.storedVars = Object.assign({}, storedVars || {});\r\n  }\r\n\r\n          static scriptOf(definition                        , host                  )                             {\r\n    const code = definition.js || '';\r\n    if (!code.trim()) return null;\r\n    if (host.scriptLibrary) return host.scriptLibrary(code);\r\n    // 宿主没有脚本引擎时，调用 JS 函数给出明确原因，而不是“没有这个内置函数”。\r\n    return {\r\n      has: ()          => true,\r\n      call: (name        )              => {\r\n        throw new NativeExprError(`当前环境不支持 JS 函数库，无法调用 “${name}”`);\r\n      }\r\n    };\r\n  }\r\n\r\n  /** 表单登录保存下来的凭据，规则里通过 login.token / login.user 读取。 */\r\n  setCredential(credential                       )                     {\r\n    this.credential = { token: credential.token || '', user: credential.user || '' };\r\n    return this;\r\n  }\r\n\r\n  /** 表单登录：用用户填写的值发登录请求。 */\r\n  async submitLogin(form                        )                             {\r\n    const login = this.definition.login;\r\n    if (login && login.script) return await this.scriptLogin(String(login.script).trim(), form);\r\n    const submit = login ? login.submit : undefined;\r\n    if (!submit) return { ok: false, token: '', user: '', message: '该书源没有配置表单登录' };\r\n    const scope = (await this.baseScope()).set('form', form);\r\n    const response = await this.host.fetch(this.buildRequest(submit, scope, ''));\r\n    if (!response.ok || !response.body) {\r\n      return { ok: false, token: '', user: '', message: this.describeFailure('登录', response) };\r\n    }\r\n    const page = this.responseScope(scope, response.body, response.url);\r\n    const ok = NativeExpr.isTruthy(this.value(submit.ok, page, false, 'login.submit.ok'));\r\n    const message = submit.message ?\r\n      NativeExpr.toText(this.value(submit.message, page, false, 'login.submit.message')).trim() : '';\r\n    if (!ok) return { ok: false, token: '', user: '', message: message || '登录失败' };\r\n    return {\r\n      ok: true,\r\n      token: submit.token ? NativeExpr.toText(this.value(submit.token, page, false, 'login.submit.token')).trim() : '',\r\n      user: submit.user ? NativeExpr.toText(this.value(submit.user, page, false, 'login.submit.user')).trim() : '',\r\n      message: message\r\n    };\r\n  }\r\n\r\n  /**\r\n   * 脚本登录：函数拿到 ctx.form，自己发请求，成功时调用 login.save(令牌, 用户名)。返回值可以是提示文字，\r\n   * 或 { ok, message }；没有明确给出 ok 时，以是否保存了凭据为准。密码只在这次调用里使用，不会保存。\r\n   */\r\n          async scriptLogin(fn        , form                        )                             {\r\n    const scope = (await this.baseScope()).set('form', form);\r\n    const before = this.credential.token;\r\n    const ctx = this.scriptContext(scope, 'login');\r\n    ctx['form'] = form;\r\n    let value             ;\r\n    try {\r\n      value = (await this.runScriptFunction(fn, ctx, 'login.script', scope, true, null)).value;\r\n    } catch (e) {\r\n      return { ok: false, token: '', user: '', message: `登录失败：${(e         ).message}` };\r\n    }\r\n    const saved = !!this.credential.token && this.credential.token !== before;\r\n    const explicit = value && typeof value === 'object' && !Array.isArray(value) && value['ok'] !== undefined;\r\n    const ok = explicit ? NativeExpr.isTruthy(value['ok']) : saved;\r\n    const message = NativeSourceRunner.scriptMessage(value);\r\n    return {\r\n      ok: ok,\r\n      token: ok ? this.credential.token : '',\r\n      user: ok ? this.credential.user : '',\r\n      message: message || (ok ? '' : '登录失败')\r\n    };\r\n  }\r\n\r\n  /** 脚本返回值里给用户看的提示：字符串本身，或对象的 message。 */\r\n          static scriptMessage(value             )         {\r\n    if (typeof value === 'string') return value.trim();\r\n    if (value && typeof value === 'object' && !Array.isArray(value) && value['message'] !== undefined) {\r\n      return NativeExpr.toText(value['message']).trim();\r\n    }\r\n    return '';\r\n  }\r\n\r\n  /**\r\n   * 书源设置页的动态选项：vars 里写了 optionsScript 的变量，运行对应函数取选项列表。\r\n   * 函数失败时给出原因，设置页退回到 options 里写死的选项。\r\n   */\r\n  async varOptions()                                            {\r\n    const result                                   = {};\r\n    const specs = (this.definition.vars || []).filter((item               )          => !!item.optionsScript);\r\n    if (specs.length === 0) return result;\r\n    const scope = await this.baseScope();\r\n    for (const item of specs) {\r\n      const fn = String(item.optionsScript).trim();\r\n      const ctx = this.scriptContext(scope, 'options');\r\n      ctx['key'] = item.key;\r\n      try {\r\n        const value              = (await this.runScriptFunction(fn, ctx, `vars.${item.key}`, scope, true, null)).value;\r\n        const options = (Array.isArray(value) ? value : []).map((option             )         => NativeExpr.toText(option).trim())\r\n          .filter((option        )          => !!option);\r\n        result[item.key] = options.length > 0 ? { options: options, error: '' } :\r\n          { options: [], error: '没有拿到选项' };\r\n      } catch (e) {\r\n        result[item.key] = { options: [], error: (e         ).message };\r\n      }\r\n    }\r\n    return result;\r\n  }\r\n\r\n  /** 表单登录的辅助请求（发送验证码等），返回提示文字。 */\r\n  async sendLoginCode(form                        )                  {\r\n    const spec = this.definition.login ? this.definition.login.sendCode : undefined;\r\n    if (!spec) return '该书源没有配置这个操作';\r\n    return await this.performAction(spec, (await this.baseScope()).set('form', form), 'login.sendCode', { form: form });\r\n  }\r\n\r\n  /** 书源设置页里可用的动作按钮。 */\r\n  async actions()                               {\r\n    const specs = this.definition.actions || [];\r\n    if (specs.length === 0) return [];\r\n    const scope = await this.baseScope();\r\n    const entries                      = [];\r\n    for (let i = 0; i < specs.length; i++) {\r\n      const spec = specs[i];\r\n      if (spec.when && !NativeExpr.isTruthy(this.value(spec.when, scope, false, `actions[${i}].when`))) continue;\r\n      const label = NativeExpr.toText(this.template(spec.label, scope)).trim();\r\n      if (!label) continue;\r\n      const open = spec.open ? NativeExpr.resolveUrl(NativeExpr.toText(this.template(spec.open, scope)).trim(),\r\n        this.definition.url) : '';\r\n      entries.push({ index: i, label: label, open: /^https?:\\/\\//i.test(open) ? open : '' });\r\n    }\r\n    return entries;\r\n  }\r\n\r\n  /** 执行一个动作按钮，返回提示文字。 */\r\n  async runAction(index        )                  {\r\n    const spec = (this.definition.actions || [])[index];\r\n    if (!spec) return '没有这个操作';\r\n    return await this.performAction(spec, await this.baseScope(), `actions[${index}]`);\r\n  }\r\n\r\n  /** 执行正文里的请求按钮：请求在取正文时已经渲染好，这里只发出并求提示文字。 */\r\n  async runLinkAction(request               , messageSpec        )                  {\r\n    const scope = await this.baseScope();\r\n    const response = await this.host.fetch(request);\r\n    if (!response.ok) return this.describeFailure('操作', response);\r\n    if (!messageSpec) return '已完成';\r\n    const page = this.responseScope(scope, response.body || '', response.url || request.url);\r\n    return NativeExpr.toText(this.value(messageSpec, page, false, 'content.links.message')).trim() || '已完成';\r\n  }\r\n\r\n          async performAction(spec                  , scope             , field        ,\r\n    extra                              = {})                  {\r\n    if (spec.script) {\r\n      const fn = String(spec.script).trim();\r\n      const ctx = this.scriptContext(scope, 'action');\r\n      ctx['action'] = NativeExpr.toText(this.template(spec.label || '', scope)).trim();\r\n      for (const key of Object.keys(extra)) ctx[key] = extra[key];\r\n      try {\r\n        const run = await this.runScriptFunction(fn, ctx, field, scope, true, null);\r\n        return NativeSourceRunner.scriptMessage(run.value) || '已完成';\r\n      } catch (e) {\r\n        return `操作失败：${(e         ).message}`;\r\n      }\r\n    }\r\n    const request = this.buildRequest(spec, scope, '');\r\n    if (!request.url) return '操作没有可用的地址';\r\n    const response = await this.host.fetch(request);\r\n    if (!response.ok) return this.describeFailure('操作', response);\r\n    if (!spec.message) return '已完成';\r\n    const page = this.responseScope(scope, response.body || '', response.url || request.url);\r\n    return NativeExpr.toText(this.value(spec.message, page, false, `${field}.message`)).trim() || '已完成';\r\n  }\r\n\r\n  setCancelCheck(check               )                     {\r\n    this.cancelled = check;\r\n    return this;\r\n  }\r\n\r\n  /** 合并默认值与已保存的值；已保存的值不在选项内时回退到默认值。 */\r\n  static resolveVars(definition                        , stored                             )                         {\r\n    const values                         = {};\r\n    for (const item of definition.vars || []) {\r\n      const options = Array.isArray(item.options) ? item.options.map((option        )         => String(option)) : [];\r\n      const fallback = item.default !== undefined ? String(item.default) : (options.length > 0 ? options[0] : '');\r\n      const saved = stored && stored[item.key] !== undefined && stored[item.key] !== null ? String(stored[item.key]) : '';\r\n      values[item.key] = saved && (options.length === 0 || options.indexOf(saved) >= 0) ? saved : fallback;\r\n    }\r\n    return values;\r\n  }\r\n\r\n  async search(key        , page         = 1)                              {\r\n    const stage = this.scripted(this.requireStage(this.definition.search, '搜索'), BOOK_FIELD_NAMES);\r\n    const scope = (await this.baseScope()).set('key', key).set('page', page);\r\n    const loaded = await this.loadStage(stage, scope, '', '搜索');\r\n    return this.readBooks(stage, loaded, 'search');\r\n  }\r\n\r\n  /** 用书源声明的检查接口确认登录状态。 */\r\n  async checkLogin()                            {\r\n    const check = this.definition.login ? this.definition.login.check : undefined;\r\n    if (!check) return { ok: false, name: '', message: '该书源没有配置登录检查' };\r\n    const scope = (await this.baseScope());\r\n    const request = this.buildRequest(check, scope, '');\r\n    const response = await this.host.fetch(request);\r\n    if (!response.ok || !response.body) {\r\n      return { ok: false, name: '', message: this.describeFailure('登录检查', response) };\r\n    }\r\n    const pageScope = this.responseScope(scope, response.body, response.url || request.url);\r\n    const ok = NativeExpr.isTruthy(this.value(check.ok, pageScope));\r\n    return {\r\n      ok: ok,\r\n      name: ok && check.name ? NativeExpr.toText(this.value(check.name, pageScope)).trim() : '',\r\n      message: ok ? '' : '未登录或登录已失效'\r\n    };\r\n  }\r\n\r\n  async exploreMenus()                             {\r\n    const explore = this.requireStage(this.definition.explore, '发现');\r\n    const scope = (await this.baseScope());\r\n    const entries                    = [];\r\n    const menus = explore.menus || [];\r\n    for (let i = 0; i < menus.length; i++) {\r\n      const menu = menus[i];\r\n      if (menu.when && !NativeExpr.isTruthy(this.value(menu.when, scope))) continue;\r\n      const title = NativeExpr.toText(this.template(menu.title || '', scope));\r\n      if (!title) continue;\r\n      entries.push({ title: title, target: menu.url ? `${MENU_STATIC}${i}` : '' });\r\n    }\r\n    const dynamic = explore.dynamicMenus;\r\n    if (dynamic) {\r\n      const request = this.buildRequest(dynamic, scope, '');\r\n      if (request.url) {\r\n        const response = await this.host.fetch(request);\r\n        if (!response.ok || !response.body) {\r\n          if (entries.length === 0) throw new NativeSourceError(this.describeFailure('发现分类', response));\r\n        } else {\r\n          const baseUrl = response.url || request.url;\r\n          const pageScope = this.responseScope(scope, response.body, baseUrl);\r\n          const items = this.listItems(dynamic.list, pageScope, baseUrl);\r\n          for (const item of items) {\r\n            const itemScope = pageScope.child().set('item', item);\r\n            const title = NativeExpr.toText(this.value(dynamic.title, itemScope)).trim();\r\n            if (!title) continue;\r\n            // 目标地址里通常带页码，到真正打开分类时再渲染，这里只记下条目本身。\r\n            const hasTarget = NativeExpr.isTruthy(this.value(dynamic.target, itemScope.child().set('page', 1)));\r\n            entries.push({ title: title, target: hasTarget ? MENU_ITEM + JSON.stringify(item) : '' });\r\n          }\r\n        }\r\n      }\r\n    }\r\n    return entries;\r\n  }\r\n\r\n  async explore(target        , page         = 1)                              {\r\n    const explore = this.scripted(this.requireStage(this.definition.explore, '发现'), BOOK_FIELD_NAMES);\r\n    const scope = (await this.baseScope()).set('page', page);\r\n    let url = '';\r\n    let title = '';\r\n    let menuItem              = null;\r\n    let menu                             = undefined;\r\n    if (target.startsWith(MENU_STATIC)) {\r\n      menu = (explore.menus || [])[Number(target.substring(MENU_STATIC.length))];\r\n      url = menu && menu.url ? NativeExpr.toText(this.template(menu.url, scope)) : '';\r\n      title = menu ? NativeExpr.toText(this.template(menu.title || '', scope)) : '';\r\n    } else if (target.startsWith(MENU_ITEM) && explore.dynamicMenus) {\r\n      let item              = null;\r\n      try {\r\n        item = JSON.parse(target.substring(MENU_ITEM.length));\r\n      } catch (e) {\r\n        item = null;\r\n      }\r\n      url = NativeExpr.toText(this.value(explore.dynamicMenus.target, scope.child().set('item', item)));\r\n      menuItem = item;\r\n    }\r\n    if (!url) throw new NativeSourceError('发现分类没有可用的地址');\r\n    const stage                  = Object.assign({}, explore, {\r\n      url: '= __url', headers: Object.assign({}, explore.headers || {}, menu && menu.headers ? menu.headers : {})\r\n    });\r\n    // 静态分类可以各用各的请求方法和请求体，一个书源对接请求方式不同的几个接口。\r\n    if (menu && menu.method !== undefined) stage.method = menu.method;\r\n    if (menu && menu.body !== undefined) stage.body = menu.body;\r\n    const loaded = await this.loadStage(stage,\r\n      scope.child().set('__url', url).set('__title', title).set('__menuItem', menuItem), '', '发现');\r\n    return this.readBooks(explore, loaded, 'explore');\r\n  }\r\n\r\n  async detail(book                 )                            {\r\n    const stage = this.scripted(this.definition.detail || {}, BOOK_FIELD_NAMES);\r\n    const scope = (await this.baseScope()).set('book', book);\r\n    this.scriptKeep = stage.script ? {} : null;\r\n    let loaded           ;\r\n    let scriptKeep                         = {};\r\n    try {\r\n      loaded = await this.loadStage(stage, scope, book.bookUrl, '详情', 'keep');\r\n      scriptKeep = this.scriptKeep || {};\r\n    } finally {\r\n      this.scriptKeep = null;\r\n    }\r\n    await this.runExtraFetches(this.definition.detail ? this.definition.detail.fetch : undefined, loaded);\r\n    const record = this.readBook(stage.fields || {}, loaded.scope, loaded.baseUrl, 'detail');\r\n    if (!record.bookUrl) record.bookUrl = book.bookUrl;\r\n    for (const key of Object.keys(scriptKeep)) record.keep[key] = scriptKeep[key];\r\n    const keep = this.definition.detail ? this.definition.detail.keep : undefined;\r\n    if (keep) {\r\n      for (const key of Object.keys(keep)) {\r\n        record.keep[key] = NativeExpr.toText(this.value(keep[key], loaded.scope, false, `detail.keep.${key}`));\r\n      }\r\n    }\r\n    return record;\r\n  }\r\n\r\n  async toc(book                 , limit         = 0)                                 {\r\n    const stage = this.scripted(this.requireStage(this.definition.toc, '目录'), CHAPTER_FIELD_NAMES);\r\n    const chapters                        = [];\r\n    const visited              = new Set();\r\n    const defaultUrl = book.tocUrl || book.bookUrl;\r\n    const nextStage                  = Object.assign({}, stage, { url: '= __url' });\r\n    const pageScope = async (page        , url        )                       =>\r\n      (await this.baseScope()).set('book', book).set('page', page).child().set('__url', url);\r\n    const pacer = new UiPacer();\r\n    let nextUrl = '';\r\n    for (let page = 1; page <= MAX_TOC_PAGES; page++) {\r\n      if (this.cancelled()) return [];\r\n      const loaded = await this.loadStage(page === 1 ? stage : nextStage, await pageScope(page, nextUrl),\r\n        defaultUrl, '目录', page === 1 ? 'take' : '');\r\n      visited.add(loaded.baseUrl);\r\n      const full = await this.appendTocPage(stage, loaded, chapters, limit, pacer);\r\n      if (this.cancelled()) return [];\r\n      if (full) break;\r\n      // 脚本阶段自己处理翻页。\r\n      if (!stage.nextUrl || stage.script) break;\r\n      const pending = this.nextUrls(stage.nextUrl, loaded, 'toc.nextUrl').filter((url        )          => !visited.has(url));\r\n      if (pending.length === 0) break;\r\n      if (pending.length === 1) {\r\n        nextUrl = pending[0];\r\n        visited.add(nextUrl);\r\n        continue;\r\n      }\r\n      // 一次给出多个地址表示“剩余全部目录页”：按列出顺序分批并发请求，不再跟随这些页自己的 nextUrl。\r\n      const listed = pending.slice(0, MAX_TOC_PAGES - page);\r\n      const batchSize = this.batchSize(stage.batch);\r\n      for (let offset = 0; offset < listed.length; offset += batchSize) {\r\n        if (this.cancelled()) return [];\r\n        const batch = listed.slice(offset, offset + batchSize);\r\n        const pages = await Promise.all(batch.map(async (url        , index        )                     =>\r\n          this.loadStage(nextStage, await pageScope(page + offset + index + 1, url), defaultUrl, '目录')));\r\n        for (const listedPage of pages) {\r\n          const listedFull = await this.appendTocPage(stage, listedPage, chapters, limit, pacer);\r\n          if (this.cancelled()) return [];\r\n          if (listedFull) return stage.reverse === true ? chapters.reverse() : chapters;\r\n        }\r\n      }\r\n      break;\r\n    }\r\n    return stage.reverse === true ? chapters.reverse() : chapters;\r\n  }\r\n\r\n  /** 把一页目录的章节追加到 chapters；到达条数上限或已取消时返回 true。 */\r\n          async appendTocPage(stage               , loaded           , chapters                       ,\r\n    limit        , pacer         )                   {\r\n    const fields = stage.fields || {};\r\n    for (const item of this.listItems(stage.list || '', loaded.scope, loaded.baseUrl, 'toc.list')) {\r\n      if (pacer.due()) {\r\n        await pacer.yield();\r\n        if (this.cancelled()) return true;\r\n      }\r\n      const itemScope = loaded.scope.child().set('item', item).set('index', chapters.length);\r\n      const title = NativeExpr.toText(this.value(fields['title'], itemScope, false, 'toc.fields.title')).trim();\r\n      if (!title) continue;\r\n      const isVolume = NativeExpr.isTruthy(this.value(fields['isVolume'], itemScope, false, 'toc.fields.isVolume'));\r\n      const url = NativeExpr.resolveUrl(\r\n        this.firstLine(this.first(this.value(fields['url'], itemScope, false, 'toc.fields.url'))), loaded.baseUrl);\r\n      if (!url && !isVolume) continue;\r\n      chapters.push({\r\n        title: title,\r\n        url: url,\r\n        isVip: NativeExpr.isTruthy(this.value(fields['isVip'], itemScope, false, 'toc.fields.isVip')),\r\n        isPay: NativeExpr.isTruthy(this.value(fields['isPay'], itemScope, false, 'toc.fields.isPay')),\r\n        isVolume: isVolume,\r\n        tag: NativeExpr.toText(this.value(fields['tag'] || fields['updateTime'], itemScope, false,\r\n          'toc.fields.tag')).trim()\r\n      });\r\n      if (chapters.length >= MAX_LIST_ITEMS || (limit > 0 && chapters.length >= limit)) return true;\r\n    }\r\n    return false;\r\n  }\r\n\r\n  /** nextUrl 的结果：一个地址是下一页；列表或多行文本是剩余全部分页。已补全、去重。 */\r\n          nextUrls(spec             , loaded           , field        )           {\r\n    const raw = this.value(spec, loaded.scope, false, field);\r\n    const values                = Array.isArray(raw) ? raw : NativeExpr.toText(raw).split(/\\r?\\n/);\r\n    const urls           = [];\r\n    for (const value of values) {\r\n      const text = NativeExpr.toText(value).trim();\r\n      const url = text ? NativeExpr.resolveUrl(text, loaded.baseUrl) : '';\r\n      if (url && urls.indexOf(url) < 0) urls.push(url);\r\n    }\r\n    return urls;\r\n  }\r\n\r\n  /** 分页列表每批并发请求的页数：书源的 batch，没写或不合法时用默认值。 */\r\n          batchSize(batch                    )         {\r\n    return Math.max(1, Math.min(Math.floor(Number(batch)) || DEFAULT_PAGE_BATCH, MAX_PAGE_BATCH));\r\n  }\r\n\r\n  /** 把一页正文（文本或图片）追加到结果里，返回追加的字符数。 */\r\n          appendContentPage(stage                   , kind        , loaded           , parts          ,\r\n    imageUrls          )         {\r\n    if (kind === 'images') {\r\n      let added = 0;\r\n      const images = this.value(stage.images, loaded.scope, true, 'content.images');\r\n      for (const image of Array.isArray(images) ? images : [images]) {\r\n        const url = NativeExpr.resolveUrl(NativeExpr.toText(image).trim(), loaded.baseUrl);\r\n        if (url) {\r\n          imageUrls.push(url);\r\n          const tag = `<img src=\"${url.replace(/\"/g, '%22')}\">`;\r\n          parts.push(tag);\r\n          added += tag.length;\r\n        }\r\n      }\r\n      return added;\r\n    }\r\n    const text = this.value(stage.text, loaded.scope, false, 'content.text');\r\n    const added = Array.isArray(text) ?\r\n      text.map((line             )         => NativeExpr.toText(line)).join('\\n') : NativeExpr.toText(text);\r\n    parts.push(added);\r\n    return added.length;\r\n  }\r\n\r\n  async content(book                 , chapter                    )                               {\r\n    const stage = this.scriptedContent(this.requireStage(this.definition.content, '正文'));\r\n    const bookType = String(book.type || this.definition.type || 'text').toLowerCase();\r\n    const kind = bookType === 'video' && stage.video ? 'video' : (bookType === 'audio' && stage.audio ? 'audio' :\r\n      ((bookType === 'comic' || bookType === 'image') && stage.images ? 'images' :\r\n        (stage.text ? 'text' : (stage.images ? 'images' : (stage.audio ? 'audio' : 'video')))));\r\n    const empty = (baseUrl        )                      => ({\r\n      kind: kind, text: '', baseUrl: baseUrl, paragraphComments: [], chapterCommentUrl: '', links: [],\r\n      images: [], mediaHeaders: {}, imageDecode: null\r\n    });\r\n    if (this.cancelled()) return empty('');\r\n    const pageScope = async (page        , url        )                       =>\r\n      (await this.baseScope()).set('book', book).set('chapter', chapter).set('page', page).child().set('__url', url);\r\n    const firstPage = await this.loadStage(stage, await pageScope(1, ''), chapter.url, '正文');\r\n    const firstBase = firstPage.baseUrl;\r\n    await this.runExtraFetches(stage.fetch, firstPage);\r\n    if (kind === 'audio' || kind === 'video') {\r\n      const audio = this.firstLine(this.first(this.value(kind === 'audio' ? stage.audio : stage.video,\r\n        firstPage.scope, false, `content.${kind}`)));\r\n      if (!audio) throw new NativeSourceError(this.mediaFailure(stage, firstPage, kind));\r\n      return {\r\n        kind: kind, text: NativeExpr.resolveUrl(audio, firstPage.baseUrl), baseUrl: firstPage.baseUrl,\r\n        paragraphComments: [], chapterCommentUrl: '', links: [], images: [],\r\n        mediaHeaders: this.renderHeaders(stage.mediaHeaders, firstPage.scope), imageDecode: null\r\n      };\r\n    }\r\n    const parts           = [];\r\n    const imageUrls           = [];\r\n    let size = this.appendContentPage(stage, kind, firstPage, parts, imageUrls);\r\n    const visited              = new Set([firstBase, NativeExpr.resolveUrl(chapter.url, this.definition.url)]);\r\n    const nextStage                  = Object.assign({}, stage, { url: '= __url' });\r\n    let loaded = firstPage;\r\n    let page = 1;\r\n    let skipped = 0;\r\n    while (stage.nextUrl && !stage.script) {\r\n      if (this.cancelled()) return empty(firstBase);\r\n      const pending = this.nextUrls(stage.nextUrl, loaded, 'content.nextUrl')\r\n        .filter((url        )          => !visited.has(url));\r\n      if (pending.length === 0) break;\r\n      if (page >= MAX_CONTENT_PAGES || size >= MAX_CONTENT_CHARS) {\r\n        skipped = pending.length;\r\n        break;\r\n      }\r\n      if (pending.length === 1) {\r\n        visited.add(pending[0]);\r\n        page++;\r\n        loaded = await this.loadStage(nextStage, await pageScope(page, pending[0]), chapter.url, '正文');\r\n        visited.add(loaded.baseUrl);\r\n        await this.runExtraFetches(stage.fetch, loaded);\r\n        size += this.appendContentPage(stage, kind, loaded, parts, imageUrls);\r\n        continue;\r\n      }\r\n      // 一次给出多个地址表示“本章剩余全部分页”：按列出顺序分批并发请求，不再跟随这些页自己的 nextUrl。\r\n      const listed = pending.slice(0, MAX_CONTENT_PAGES - page);\r\n      skipped = pending.length - listed.length;\r\n      const batchSize = this.batchSize(stage.batch);\r\n      for (let offset = 0; offset < listed.length; offset += batchSize) {\r\n        if (this.cancelled()) return empty(firstBase);\r\n        if (size >= MAX_CONTENT_CHARS) {\r\n          skipped += listed.length - offset;\r\n          break;\r\n        }\r\n        const batch = listed.slice(offset, offset + batchSize);\r\n        const pages = await Promise.all(batch.map(async (url        , index        )                     =>\r\n          this.loadStage(nextStage, await pageScope(page + offset + index + 1, url), chapter.url, '正文')));\r\n        for (const listedPage of pages) {\r\n          await this.runExtraFetches(stage.fetch, listedPage);\r\n          size += this.appendContentPage(stage, kind, listedPage, parts, imageUrls);\r\n        }\r\n      }\r\n      break;\r\n    }\r\n    if (skipped > 0 && this.host.trace) {\r\n      this.host.trace({\r\n        field: 'content.nextUrl', rule: NativeExpr.toText(stage.nextUrl), type: 'limit', count: skipped, preview: '',\r\n        error: `本章分页超过 ${MAX_CONTENT_PAGES} 页或正文超过 8 MB，后面 ${skipped} 页没有获取`\r\n      });\r\n    }\r\n    let text = parts.join('\\n');\r\n    if (kind === 'text') {\r\n      for (const rule of stage.replace || []) {\r\n        if (!rule || !rule.pattern) continue;\r\n        text = text.replace(new RegExp(rule.pattern, rule.flags === undefined ? 'g' : rule.flags), rule.with || '');\r\n      }\r\n    }\r\n    const result                      = {\r\n      kind: kind, text: text, baseUrl: firstBase, paragraphComments: [], chapterCommentUrl: '', links: [],\r\n      images: imageUrls, mediaHeaders: this.renderHeaders(stage.mediaHeaders, firstPage.scope),\r\n      imageDecode: null\r\n    };\r\n    if (kind === 'images' && stage.imageDecode && firstPage) {\r\n      const decode = stage.imageDecode;\r\n      const toHex = (value             )         => {\r\n        const bytes           = Array.isArray(value) ? value : this.expr.evaluate('bytes(__text)',\r\n          new NativeScope().set('__text', NativeExpr.toText(value)));\r\n        return bytes.map((byte        )         => ((byte & 255) < 16 ? '0' : '') + (byte & 255).toString(16)).join('');\r\n      };\r\n      result.imageDecode = {\r\n        algorithm: NativeExpr.toText(this.template(decode.algorithm, firstPage.scope)).trim(),\r\n        key: toHex(this.value(decode.key, firstPage.scope, false, 'content.imageDecode.key')),\r\n        iv: decode.iv ? toHex(this.value(decode.iv, firstPage.scope, false, 'content.imageDecode.iv')) : ''\r\n      };\r\n    }\r\n    if (kind === 'text' && firstPage) {\r\n      const links = stage.links || [];\r\n      for (let i = 0; i < links.length; i++) {\r\n        const link = links[i];\r\n        if (link.when && !NativeExpr.isTruthy(this.value(link.when, firstPage.scope, false,\r\n          `content.links[${i}].when`))) {\r\n          continue;\r\n        }\r\n        const label = NativeExpr.toText(this.template(link.label, firstPage.scope)).trim();\r\n        if (!label) continue;\r\n        if (link.request && link.request.url) {\r\n          const request = this.buildRequest(link.request, firstPage.scope, '');\r\n          if (/^https?:\\/\\//i.test(request.url)) {\r\n            result.links.push({ label: label, url: '', request: request, message: link.message || '' });\r\n          }\r\n          continue;\r\n        }\r\n        const url = NativeExpr.resolveUrl(NativeExpr.toText(this.template(link.url || '', firstPage.scope)).trim(),\r\n          firstPage.baseUrl);\r\n        if (/^https?:\\/\\//i.test(url)) result.links.push({ label: label, url: url, request: null, message: '' });\r\n      }\r\n    }\r\n    if (kind === 'text' && stage.comments && firstPage && text.trim()) {\r\n      // 评论只是附加信息，任何一步失败都不影响正文。\r\n      try {\r\n        await this.collectComments(stage.comments, firstPage, text, result);\r\n      } catch (e) {\r\n        result.paragraphComments = [];\r\n        result.chapterCommentUrl = '';\r\n      }\r\n    }\r\n    return result;\r\n  }\r\n\r\n          async collectComments(spec                    , page           , text        ,\r\n    result                     )                {\r\n    if (spec.when && !NativeExpr.isTruthy(this.value(spec.when, page.scope))) return;\r\n    const scope = page.scope.child();\r\n    scope.set('stats', spec.stats ? await this.fetchValue(spec.stats, scope) : null);\r\n    let total = 0;\r\n    if (spec.paragraphUrl && spec.counts) {\r\n      const counts = this.value(spec.counts, scope);\r\n      const lines = text.split('\\n');\r\n      const limit = Math.max(1, Math.min(Number(spec.max) || DEFAULT_COMMENT_BUBBLES, MAX_COMMENT_BUBBLES));\r\n      const keys = counts && typeof counts === 'object' ? Object.keys(counts) : [];\r\n      keys.sort((a        , b        )         => Number(a) - Number(b));\r\n      for (const key of keys) {\r\n        const line = Number(key);\r\n        const count = Math.floor(NativeExpr.toNumber(counts[key]));\r\n        if (!Number.isInteger(line) || count <= 0) continue;\r\n        total += count;\r\n        if (line < 0 || line >= lines.length || result.paragraphComments.length >= limit) continue;\r\n        const plain = lines[line].replace(/<[^>]+>/g, '').trim();\r\n        if (!plain) continue;\r\n        const para = { index: line, count: count, text: plain.length > 90 ? plain.substring(0, 90) : plain };\r\n        const url = NativeExpr.resolveUrl(\r\n          NativeExpr.toText(this.template(spec.paragraphUrl, scope.child().set('para', para))).trim(), page.baseUrl);\r\n        if (/^https?:\\/\\//i.test(url)) result.paragraphComments.push({ line: line, count: count, url: url });\r\n      }\r\n    }\r\n    if (spec.chapterUrl) {\r\n      const url = NativeExpr.resolveUrl(\r\n        NativeExpr.toText(this.template(spec.chapterUrl, scope.child().set('total', total))).trim(), page.baseUrl);\r\n      if (/^https?:\\/\\//i.test(url)) result.chapterCommentUrl = url;\r\n    }\r\n  }\r\n\r\n  /** 发一个附加请求：响应是 JSON 时返回解析后的对象，否则返回文本；失败返回 null。 */\r\n          async fetchValue(spec                   , scope             )                       {\r\n    const request = this.buildRequest(spec, scope, '');\r\n    if (!request.url) return null;\r\n    try {\r\n      const response = await this.host.fetch(request);\r\n      if (!response.ok || !response.body) return null;\r\n      try {\r\n        return JSON.parse(response.body);\r\n      } catch (e) {\r\n        return response.body;\r\n      }\r\n    } catch (e) {\r\n      return null;\r\n    }\r\n  }\r\n\r\n          requireStage   (stage               , label        )    {\r\n    if (!stage) throw new NativeSourceError(`该书源没有配置${label}`);\r\n    return stage;\r\n  }\r\n\r\n          renderHeaders(headers                                    , scope             )                         {\r\n    const rendered                         = {};\r\n    for (const name of Object.keys(headers || {})) {\r\n      const value = NativeExpr.toText(this.template((headers                          )[name], scope));\r\n      if (value) rendered[name] = value;\r\n    }\r\n    return rendered;\r\n  }\r\n\r\n  /** 声明式缓存：有效期内直接复用，否则发请求取值并保存。结果按名称绑定到求值环境。 */\r\n          async applyCaches(scope             )                {\r\n    const caches = this.definition.cache;\r\n    if (!caches) return;\r\n    for (const name of Object.keys(caches)) {\r\n      const spec = caches[name];\r\n      let value              = null;\r\n      if (!spec.when || NativeExpr.isTruthy(this.value(spec.when, scope))) {\r\n        // 变量变了（换服务器、换账号）缓存就不该再用，所以把变量值算进键里。\r\n        const key = `${name}\\n${JSON.stringify(this.varValues)}`;\r\n        const cached = this.host.cacheGet ? this.host.cacheGet(key) : undefined;\r\n        if (cached !== undefined && cached !== null) {\r\n          value = cached;\r\n        } else {\r\n          const request = this.buildRequest(spec, scope, '');\r\n          if (request.url) {\r\n            try {\r\n              const response = await this.host.fetch(request);\r\n              if (response.ok && response.body) {\r\n                value = this.value(spec.value, this.responseScope(scope, response.body, response.url || request.url));\r\n              }\r\n            } catch (e) {\r\n              value = null;\r\n            }\r\n            if (value !== null && value !== undefined && value !== '' && this.host.cachePut) {\r\n              const ttl = Math.max(1, Math.min(Number(spec.ttl) || 600, 7 * 24 * 3600));\r\n              this.host.cachePut(key, value, ttl);\r\n            }\r\n          }\r\n        }\r\n      }\r\n      scope.set(name, value === undefined ? null : value);\r\n    }\r\n  }\r\n\r\n          async baseScope()                       {\r\n    const scope = new NativeScope()\r\n      .set('vars', this.varValues)\r\n      .set('source', { url: this.definition.url, name: this.definition.name })\r\n      .set('key', '')\r\n      .set('page', 1)\r\n      .set('book', null)\r\n      .set('chapter', null)\r\n      .set('item', null)\r\n      .set('index', 0)\r\n      .set('body', '')\r\n      .set('data', null)\r\n      .set('baseUrl', this.definition.url)\r\n      .set('login', this.credential)\r\n      .set('form', {});\r\n    await this.applyCaches(scope);\r\n    this.applyLets(this.definition.let, scope);\r\n    return scope.child();\r\n  }\r\n\r\n          applyLets(lets                                         , scope             )       {\r\n    if (!lets) return;\r\n    for (const name of Object.keys(lets)) scope.set(name, this.value(lets[name], scope, false, `let.${name}`));\r\n  }\r\n\r\n  /** 请求一个阶段的页面并准备好求值环境；地址渲染为空时不发请求。reuse 见 StageReuse。 */\r\n          async loadStage(stage                 , scope             , defaultUrl        , label        ,\r\n    reuse             = '')                     {\r\n    if (stage.script) return this.finishStage(stage, await this.loadScriptStage(stage, scope, label), label);\r\n    const request = this.buildRequest(stage, scope, defaultUrl, true);\r\n    let body = '';\r\n    let baseUrl = request.url || NativeExpr.toText(scope.get('baseUrl'));\r\n    if (request.url) {\r\n      const key = reuse ? this.keptPageKey(request) : '';\r\n      const kept = reuse === 'take' ? NativeSourceRunner.takeKeptPage(key) : null;\r\n      if (kept) {\r\n        body = kept.body;\r\n        baseUrl = kept.baseUrl;\r\n        if (this.host.trace) {\r\n          this.host.trace({\r\n            field: `${label}请求`, rule: request.url, type: 'reuse', count: 1,\r\n            preview: '与详情是同一个请求，复用详情页响应，未重新请求', error: ''\r\n          });\r\n        }\r\n      } else {\r\n        const response = await this.host.fetch(request);\r\n        if (!response.ok || !response.body) throw new NativeSourceError(this.describeFailure(label, response));\r\n        body = response.body;\r\n        baseUrl = response.url || request.url;\r\n        if (reuse === 'keep') NativeSourceRunner.keepPage(key, body, baseUrl);\r\n      }\r\n    }\r\n    return this.finishStage(stage, { scope: this.responseScope(scope, body, baseUrl), baseUrl: baseUrl }, label);\r\n  }\r\n\r\n  /** 页面到手之后：阶段的 let 与 fail。 */\r\n          finishStage(stage                 , page           , label        )            {\r\n    this.applyLets(stage.let, page.scope);\r\n    if (stage.fail) {\r\n      const failure = NativeExpr.toText(this.value(stage.fail, page.scope, false, 'fail')).trim();\r\n      if (failure && failure !== 'false') throw new NativeSourceError(`${label}接口返回失败：${failure}`);\r\n    }\r\n    return page;\r\n  }\r\n\r\n  /**\r\n   * 脚本阶段：在后台运行 js 里的函数，它的返回值就是这个阶段的“页面”。字符串当作原文，数组或对象当作\r\n   * 已解析的 JSON，page(body, url) 带上页面地址。之后的 list、fields 等规则照常在上面求值。\r\n   */\r\n  /**\r\n   * 在后台运行 js 里的函数 fn(ctx)。interactive 表示用户主动发起的操作，可以弹出网页；搜索、发现不行。\r\n   * 出错时抛出原始原因，由调用方加上是哪个阶段、哪个按钮。\r\n   */\r\n          async runScriptFunction(fn        , ctx                             , stageName        , scope             ,\r\n    interactive         , keep                               )                     {\r\n    const limits = NativeScriptLimits.of(this.definition.scriptLimits ? this.definition.scriptLimits.requests : undefined);\r\n    const scriptHost = new (this.host.ScriptHost || NativeScriptHost)({\r\n      host: this.host,\r\n      sourceUrl: this.definition.url,\r\n      stage: stageName,\r\n      fn: fn,\r\n      limits: limits,\r\n      cancelled: this.cancelled,\r\n      builtin: (name        , args               )              => this.expr.callBuiltin(name, args, scope),\r\n      getVar: (key        )              => this.getVar(key),\r\n      setVar: (key        , value             )                => this.setVar(key, value),\r\n      temp: this.temp,\r\n      credential: ()              => ({ token: this.credential.token, user: this.credential.user }),\r\n      saveCredential: (token        , user        )                => this.saveCredential(token, user),\r\n      keep: keep,\r\n      interactive: interactive\r\n    });\r\n    const startedAt = Date.now();\r\n    try {\r\n      const value              = await this.scriptEngine().run(fn, ctx, scriptHost.handler(), {\r\n        cpuMs: limits.cpuMs, wallMs: limits.wallMs, cancelled: this.cancelled,\r\n        pausedMs: ()         => scriptHost.pausedMs\r\n      });\r\n      return { value: value, requests: scriptHost.requestCount, ms: Date.now() - startedAt };\r\n    } catch (e) {\r\n      const message = e instanceof Error ? e.message : String(e);\r\n      this.traceScript(stageName, fn, 'return', '', message);\r\n      throw new Error(message);\r\n    }\r\n  }\r\n\r\n          async loadScriptStage(stage                 , scope             , label        )                     {\r\n    const fn = String(stage.script || '').trim();\r\n    const stageName = STAGE_NAMES[label] || label;\r\n    const interactive = stageName === 'detail' || stageName === 'toc' || stageName === 'content';\r\n    let run           ;\r\n    try {\r\n      run = await this.runScriptFunction(fn, this.scriptContext(scope, stageName), stageName, scope, interactive,\r\n        stageName === 'detail' ? this.scriptKeep : null);\r\n    } catch (e) {\r\n      throw new NativeSourceError(`${label}脚本 ${fn}：${(e         ).message}`);\r\n    }\r\n    const value              = run.value;\r\n    let baseUrl = NativeExpr.toText(scope.get('baseUrl')) || this.definition.url;\r\n    let pageScope             ;\r\n    if (NativeJsPrelude.isPage(value) || typeof value === 'string') {\r\n      const body = typeof value === 'string' ? value : NativeExpr.toText(value['body']);\r\n      const pageUrl = typeof value === 'string' ? '' : NativeExpr.toText(value['url']).trim();\r\n      if (pageUrl) baseUrl = NativeExpr.resolveUrl(pageUrl, this.definition.url);\r\n      pageScope = this.responseScope(scope, body, baseUrl);\r\n    } else {\r\n      pageScope = scope.child().set('body', value === null || value === undefined ? '' : JSON.stringify(value))\r\n        .set('data', value === undefined ? null : value).set('item', value === undefined ? null : value)\r\n        .set('baseUrl', baseUrl);\r\n    }\r\n    const data = pageScope.get('data');\r\n    pageScope.set('__items', Array.isArray(data) ? data : (data === null || data === undefined ? [] : [data]));\r\n    this.traceScript(stageName, fn, 'return', `${Array.isArray(data) ? `${data.length} 项` :\r\n      (data !== null ? '对象' : `${NativeExpr.toText(pageScope.get('body')).length} 字`)}，请求 ${run.requests} 次，` +\r\n      `${run.ms} ms`, '');\r\n    return { scope: pageScope, baseUrl: baseUrl };\r\n  }\r\n\r\n  /** 传给脚本函数的 ctx：与规则里可用的名字一致。 */\r\n          scriptContext(scope             , stageName        )                              {\r\n    const ctx                              = { stage: stageName };\r\n    for (const name of ['key', 'page', 'book', 'chapter', 'source', 'login', 'baseUrl']) ctx[name] = scope.get(name);\r\n    for (const name of Object.keys(this.definition.cache || {}).concat(Object.keys(this.definition.let || {}))) {\r\n      ctx[name] = scope.get(name);\r\n    }\r\n    ctx['vars'] = Object.assign({}, this.storedVars, this.varValues);\r\n    ctx['url'] = scope.has('__url') ? NativeExpr.toText(scope.get('__url')) : '';\r\n    ctx['title'] = scope.has('__title') ? NativeExpr.toText(scope.get('__title')) : '';\r\n    ctx['menu'] = scope.has('__menuItem') ? scope.get('__menuItem') : null;\r\n    return ctx;\r\n  }\r\n\r\n          scriptEngine()                     {\r\n    if (this.engine) return this.engine;\r\n    const code = this.definition.js || '';\r\n    if (!code.trim()) throw new NativeSourceError('阶段写了 script，但书源没有 js');\r\n    if (!this.host.scriptEngine) throw new NativeSourceError('当前环境不支持脚本阶段');\r\n    this.engine = this.host.scriptEngine(code);\r\n    return this.engine;\r\n  }\r\n\r\n          getVar(key        )              {\r\n    if (Object.prototype.hasOwnProperty.call(this.varValues, key)) return this.varValues[key];\r\n    const value = this.storedVars[key];\r\n    return value === undefined ? null : value;\r\n  }\r\n\r\n          async setVar(key        , value             )                {\r\n    if (!key) throw new Error('变量名不能为空');\r\n    this.storedVars[key] = value;\r\n    if (Object.prototype.hasOwnProperty.call(this.varValues, key)) {\r\n      this.varValues[key] = value === null || value === undefined ? '' : NativeExpr.toText(value);\r\n    }\r\n    if (!this.host.saveVars) throw new Error('当前环境不支持保存书源变量');\r\n    await this.host.saveVars(Object.assign({}, this.storedVars, this.varValues));\r\n  }\r\n\r\n          async saveCredential(token        , user        )                {\r\n    if (!this.host.saveCredential) throw new Error('当前环境不支持保存登录凭据');\r\n    await this.host.saveCredential(token, user);\r\n    this.credential = { token: token, user: user };\r\n  }\r\n\r\n  /** 脚本阶段没写 list、fields 时：返回的数组每项一条，字段按同名键取值。 */\r\n          scripted                           (stage   , fieldNames          )    {\r\n    if (!stage.script) return stage;\r\n    const copy = Object.assign({}, stage)     ;\r\n    if (!copy.list) copy.list = '= __items';\r\n    if (!copy.fields) {\r\n      const fields                              = {};\r\n      for (const name of fieldNames) fields[name] = `$.${name}`;\r\n      copy.fields = fields;\r\n    }\r\n    return copy;\r\n  }\r\n\r\n  /** 脚本正文没写 text、images、audio、video 时：返回字符串即正文，返回对象时按同名键取。 */\r\n          scriptedContent(stage                   )                    {\r\n    if (!stage.script || stage.text || stage.images || stage.audio || stage.video) return stage;\r\n    return Object.assign({}, stage, {\r\n      text: '= data != null ? $.text : body',\r\n      images: '= data != null ? $.images : []',\r\n      audio: '= data != null ? $.audio : body',\r\n      video: '= data != null ? $.video : body'\r\n    });\r\n  }\r\n\r\n          traceScript(stageName        , fn        , rule        , preview        , error        )       {\r\n    if (!this.host.trace) return;\r\n    this.host.trace({ field: `${stageName}.script ${fn}`, rule: rule, type: 'script', count: 1, preview: preview, error: error });\r\n  }\r\n\r\n  /** 请求的完整特征：书源加上地址、方法、请求头、请求体与取页方式，全部相同才算同一个请求。 */\r\n          keptPageKey(request               )         {\r\n    return JSON.stringify([this.definition.url, this.definition.name, request.url, request.method, request.headers,\r\n      request.body, request.webView, request.webWaitFor, request.charset]);\r\n  }\r\n\r\n          static keepPage(key        , body        , baseUrl        )       {\r\n    const pages = NativeSourceRunner.keptPages;\r\n    pages.delete(key);\r\n    while (pages.size >= MAX_KEPT_PAGES) pages.delete(pages.keys().next().value          );\r\n    pages.set(key, { body: body, baseUrl: baseUrl, keptAt: Date.now() });\r\n  }\r\n\r\n          static takeKeptPage(key        )                  {\r\n    const kept = NativeSourceRunner.keptPages.get(key);\r\n    if (!kept) return null;\r\n    NativeSourceRunner.keptPages.delete(key);\r\n    return Date.now() - kept.keptAt <= KEPT_PAGE_TTL_MS ? kept : null;\r\n  }\r\n\r\n          responseScope(scope             , body        , baseUrl        )              {\r\n    let data              = null;\r\n    const trimmed = body.trim();\r\n    if (trimmed && (trimmed[0] === '{' || trimmed[0] === '[')) {\r\n      try {\r\n        data = JSON.parse(trimmed);\r\n      } catch (e) {\r\n        data = null;\r\n      }\r\n    }\r\n    return scope.child().set('body', body).set('data', data).set('item', data === null ? body : data)\r\n      .set('baseUrl', baseUrl);\r\n  }\r\n\r\n          describeFailure(label        , response                )         {\r\n    if (!response.ok) {\r\n      // 状态码正常却被判为失败（例如拿到的是验证页）时，以给出的原因为准。\r\n      const succeededStatus = response.status >= 200 && response.status < 300;\r\n      return response.status > 0 && !(succeededStatus && response.error) ?\r\n        `${label}请求失败（HTTP ${response.status}）` : `${label}请求失败：${response.error || '网络异常'}`;\r\n    }\r\n    return `${label}接口返回空响应`;\r\n  }\r\n\r\n          buildRequest(spec                   , scope             , defaultUrl        ,\r\n    primary          = false)                {\r\n    const rawUrl = spec.url === undefined ? defaultUrl : NativeExpr.toText(this.template(spec.url, scope));\r\n    const url = NativeExpr.resolveUrl(rawUrl.trim(), this.definition.url);\r\n    const headers                         = {};\r\n    for (const name of Object.keys(spec.headers || {})) {\r\n      const value = NativeExpr.toText(this.template((spec.headers                          )[name], scope));\r\n      if (value) headers[name] = value;\r\n    }\r\n    let body = '';\r\n    if (spec.body !== undefined && spec.body !== null) {\r\n      body = typeof spec.body === 'string' ? NativeExpr.toText(this.template(spec.body, scope)) :\r\n        JSON.stringify(this.renderDeep(spec.body, scope));\r\n    }\r\n    // 请求方法也按模板求值，可以随分类、变量切换 GET/POST。\r\n    const rendered = spec.method ? NativeExpr.toText(this.template(spec.method, scope)).trim() : '';\r\n    const method = (rendered || (body ? 'POST' : 'GET')).toUpperCase();\r\n    if (!/^[A-Z]+$/.test(method)) throw new NativeSourceError(`请求方法无效：${rendered}`);\r\n    const web = spec.webView && typeof spec.webView === 'object' ? spec.webView : null;\r\n    return {\r\n      url: url, method: method, headers: headers, body: body, webView: spec.webView === true || !!web,\r\n      webWaitFor: web && web.waitFor ? String(web.waitFor).trim() : '',\r\n      webTimeout: Math.max(3, Math.min(Number(web && web.timeout) || 15, 60)),\r\n      charset: String(spec.charset || '').trim(),\r\n      retry: Math.max(0, Math.min(Math.floor(Number(spec.retry) || 0), 3)),\r\n      primary: primary\r\n    };\r\n  }\r\n\r\n          renderDeep(value             , scope             )              {\r\n    if (typeof value === 'string') return this.template(value, scope);\r\n    if (Array.isArray(value)) return value.map((item             )              => this.renderDeep(item, scope));\r\n    if (value && typeof value === 'object') {\r\n      const out                              = {};\r\n      for (const key of Object.keys(value)) out[key] = this.renderDeep(value[key], scope);\r\n      return out;\r\n    }\r\n    return value;\r\n  }\r\n\r\n          async runExtraFetches(fetches                                             ,\r\n    loaded           )                {\r\n    if (!fetches) return;\r\n    for (const name of Object.keys(fetches)) {\r\n      const spec                  = fetches[name];\r\n      let result              = null;\r\n      // 附加请求只是补充数据，失败时变量为 null，由规则自行决定如何降级。\r\n      if (!spec.when || NativeExpr.isTruthy(this.value(spec.when, loaded.scope))) {\r\n        result = await this.fetchValue(spec, loaded.scope);\r\n      }\r\n      loaded.scope.set(name, result);\r\n    }\r\n  }\r\n\r\n  /** 音频/视频地址为空时的原因：书源写的 mediaError 优先，否则取附加请求、主请求里第一个报错的 code/message。 */\r\n          mediaFailure(stage                   , loaded           , kind        )         {\r\n    const label = kind === 'audio' ? '音频' : '视频';\r\n    if (stage.mediaError) {\r\n      const custom = NativeExpr.toText(this.value(stage.mediaError, loaded.scope, false, 'content.mediaError')).trim();\r\n      if (custom) return custom;\r\n    }\r\n    const responses                = Object.keys(stage.fetch || {})\r\n      .map((name        )              => loaded.scope.get(name));\r\n    responses.push(loaded.scope.get('data'));\r\n    for (const response of responses) {\r\n      const reason = NativeSourceRunner.apiFailure(response);\r\n      if (reason) return `${label}接口返回失败：${reason}`;\r\n    }\r\n    return `正文规则没有返回${label}地址`;\r\n  }\r\n\r\n          static apiFailure(value             )         {\r\n    if (!value || typeof value !== 'object' || Array.isArray(value)) return '';\r\n    const record = value                               ;\r\n    let code              = null;\r\n    for (const key of ['code', 'status_code', 'err_no']) {\r\n      if (record[key] !== undefined && record[key] !== null) {\r\n        code = record[key];\r\n        break;\r\n      }\r\n    }\r\n    if (code === null || code === 0 || code === '0' || code === 200) return '';\r\n    let message = '';\r\n    for (const key of ['message', 'msg', 'error', 'err_tips']) {\r\n      message = NativeExpr.toText(record[key] === undefined ? null : record[key]).trim();\r\n      if (message) break;\r\n    }\r\n    const codeText = NativeExpr.toText(code);\r\n    return message ? `${message}（code=${codeText}）` : `code=${codeText}`;\r\n  }\r\n\r\n          readBooks(stage                 , loaded           , prefix        )                     {\r\n    const books                     = [];\r\n    const items = this.listItems(stage.list || '', loaded.scope, loaded.baseUrl, `${prefix}.list`);\r\n    for (let i = 0; i < items.length; i++) {\r\n      const itemScope = loaded.scope.child().set('item', items[i]).set('index', i);\r\n      const book = this.readBook(stage.fields || {}, itemScope, loaded.baseUrl, prefix);\r\n      if (book.name && book.bookUrl) books.push(book);\r\n    }\r\n    return books;\r\n  }\r\n\r\n          readBook(fields                             , scope             , baseUrl        ,\r\n    prefix        )                   {\r\n    const text = (name        )         => {\r\n      const value = this.value(fields[name], scope, false, `${prefix}.fields.${name}`);\r\n      return (Array.isArray(value) ? value.map((part             )         => NativeExpr.toText(part).trim())\r\n        .filter((part        )          => !!part).join(',') : NativeExpr.toText(value)).trim();\r\n    };\r\n    const url = (name        )         => NativeExpr.resolveUrl(this.firstLine(this.first(\r\n      this.value(fields[name], scope, false, `${prefix}.fields.${name}`))), baseUrl);\r\n    const typeSpec = fields['type'];\r\n    const literalType = typeof typeSpec === 'string' && /^(text|audio|comic|image|video)$/i.test(typeSpec.trim());\r\n    return {\r\n      name: text('name'),\r\n      author: text('author'),\r\n      kind: text('kind'),\r\n      intro: text('intro'),\r\n      coverUrl: this.definition.coverDecode ? SourceCoverUrl.wrap(url('coverUrl'), this.definition.url) : url('coverUrl'),\r\n      wordCount: text('wordCount'),\r\n      lastChapter: text('lastChapter'),\r\n      updateTime: text('updateTime'),\r\n      status: text('status'),\r\n      bookUrl: url('bookUrl'),\r\n      tocUrl: url('tocUrl'),\r\n      type: (literalType ? String(typeSpec).trim() : text('type')).toLowerCase(),\r\n      keep: {}\r\n    };\r\n  }\r\n\r\n  /**\r\n   * 地址类字段只取第一项：选择器命中多个元素时，非列表求值会把结果按行拼起来（简介等文本需要这样），\r\n   * 而地址里不会有换行，取第一行与兼容书源“地址取第一个”的行为一致。\r\n   */\r\n          firstLine(value             )         {\r\n    for (const line of NativeExpr.toText(value).split(/\\r?\\n/)) {\r\n      const text = line.trim();\r\n      if (text) return text;\r\n    }\r\n    return '';\r\n  }\r\n\r\n          first(value             )              {\r\n    return Array.isArray(value) ? (value.length > 0 ? value[0] : '') : value;\r\n  }\r\n\r\n          listItems(rule        , scope             , baseUrl        , field         = '')                {\r\n    const spec = (rule || '').trim();\r\n    if (!spec) return [];\r\n    let items               ;\r\n    try {\r\n      if (spec.startsWith('=')) {\r\n        const value = this.expr.evaluate(spec.substring(1), scope);\r\n        items = Array.isArray(value) ? value : (value === null || value === undefined || value === '' ? [] : [value]);\r\n      } else {\r\n        const current = scope.get('item');\r\n        const jsonItems = this.jsonRule(spec, current, true);\r\n        items = jsonItems !== null ? (jsonItems                 ) :\r\n          this.host.selectItems(typeof current === 'string' ? current : NativeExpr.toText(current), spec, baseUrl);\r\n      }\r\n    } catch (e) {\r\n      throw this.fieldError(field, spec, e);\r\n    }\r\n    this.traceRule(field, spec, items, true);\r\n    return items.length > MAX_LIST_ITEMS ? items.slice(0, MAX_LIST_ITEMS) : items;\r\n  }\r\n\r\n  /** 给求值错误补上是哪条规则出的错，并记入调试信息。 */\r\n          fieldError(field        , spec             , error             )        {\r\n    const message = error instanceof Error ? error.message : String(error);\r\n    if (!field) return error instanceof Error ? error : new NativeSourceError(message);\r\n    if (this.host.trace) {\r\n      this.host.trace({\r\n        field: field, rule: typeof spec === 'string' ? spec : NativeExpr.toText(spec),\r\n        type: this.ruleType(spec), count: 0, preview: '', error: message\r\n      });\r\n    }\r\n    return new NativeSourceError(`规则 ${field} 出错：${message}`);\r\n  }\r\n\r\n          ruleType(spec             )         {\r\n    if (typeof spec !== 'string') return 'literal';\r\n    const text = spec.trim();\r\n    return text.startsWith('=') ? 'expression' : (text.indexOf('{{') >= 0 ? 'template' : 'selector');\r\n  }\r\n\r\n  /** 调试时记录一条规则的结果。列表里只记第一个元素的字段，避免上千条重复记录。 */\r\n          traceRule(field        , spec             , result             , isList         , scope              )       {\r\n    if (!field || !this.host.trace || spec === undefined || spec === null || spec === '') return;\r\n    if (scope && Number(scope.get('index')) > 0) return;\r\n    const text = NativeExpr.toText(Array.isArray(result) && isList ? result[0] : result);\r\n    this.host.trace({\r\n      field: field, rule: typeof spec === 'string' ? spec : NativeExpr.toText(spec), type: this.ruleType(spec),\r\n      count: Array.isArray(result) ? result.length : (text ? 1 : 0),\r\n      preview: text.length > 300 ? `${text.substring(0, 300)}…` : text, error: ''\r\n    });\r\n  }\r\n\r\n  /** 模板位置（地址、请求头、标题）：= 开头按表达式，其余按 {{ }} 模板。 */\r\n          template(spec             , scope             )              {\r\n    if (typeof spec !== 'string') return spec;\r\n    const text = spec.trim();\r\n    if (text.startsWith('=')) return this.expr.evaluate(text.substring(1), scope);\r\n    return this.expr.render(spec, scope);\r\n  }\r\n\r\n  /** 字段位置的求值。field 给出规则在定义里的位置，出错时用来定位，调试时用来记录。 */\r\n          value(spec             , scope             , list          = false, field         = '')              {\r\n    let result             ;\r\n    try {\r\n      result =