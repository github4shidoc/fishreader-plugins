placed there). Browser actions remain a\n    // management/login concern and are not fetchable discover categories.\n    if (isExploreFilter(item) || !text(item && item.url).trim() || isExploreBrowserAction(item)) continue;\n    result.push({ item, index, group });\n  }\n  return result;\n}\n\n// Filter actions can change another menu URL while leaving the current fixed\n// ranking untouched. Use actual menu changes, never source names or labels.\nfunction exploreFilterResultKey(before, after, currentKey) {\n  const signature = entry => JSON.stringify([entry.group, text(entry.item.title), text(entry.item.url)]);\n  const previous = new Set(before.map(signature));\n  const affected = after.filter(entry => !previous.has(signature(entry)));\n  if (!affected.length) return '';\n  const current = before.find(entry => exploreEntryKey(entry.item, entry.index) === currentKey);\n  const selected = current && affected.find(entry => entry.group === current.group &&\n    text(entry.item.title) === text(current.item.title));\n  const result = selected || affected[0];\n  return exploreEntryKey(result.item, result.index);\n}\n\nfunction selectExploreUrl(source, input, preparedInfoMap) {\n  const loadedMenu = loadExploreMenuEntries(source, input, preparedInfoMap);\n  const entries = loadedMenu.entries;\n  const env = loadedMenu.env;\n  const rawExploreUrl = loadedMenu.rawExploreUrl;\n  if (entries.length === 0) {\n    const url = evaluateUrl(source, rawExploreUrl, env);\n    loadedMenu.infoState.persist();\n    return { url, env };\n  }\n  const category = text(input.category);\n  const selected = entries.find((item, index) => exploreEntryKey(item, index) === category) ||\n    entries.find(item => text(item.title) === category || text(item.url) === category) ||\n    entries.find(item => !isExploreBrowserAction(item) && text(item.url).trim()) || entries[0];\n  const selectedUrl = text(selected.url);\n  const renderedUrl = evaluateUrl(source, selectedUrl, env);\n  loadedMenu.infoStat