h.ceil(num(0));\r\n      case 'now':\r\n        return Date.now();\r\n      case 'formatDate':\r\n        return formatDate(args[0], args.length > 1 ? text(1) : 'yyyy-MM-dd HH:mm');\r\n      case 'stripHtml':\r\n        return stripHtml(text(0));\r\n      case 'htmlDecode':\r\n        return htmlDecode(text(0));\r\n      case 'absUrl':\r\n        return NativeExpr.resolveUrl(text(0), args.length > 1 ? text(1) : NativeExpr.toText(scope.get('baseUrl')));\r\n      case 'sel':\r\n      case 'selAll': {\r\n        const target = args.length > 1 ? args[1] : scope.get('item');\r\n        const content = typeof target === 'string' ? target : NativeExpr.toText(target);\r\n        const found = this.host.select(content, text(0), NativeExpr.toText(scope.get('baseUrl')), name === 'selAll');\r\n        return name === 'selAll' ? found : (found.length > 0 ? found[0] : '');\r\n      }\r\n      default:\r\n        if (this.script && this.script.has(name)) return this.callScript(this.script, name, args, scope);\r\n        throw new NativeExprError(`没有名为 “${name}” 的内置函数`);\r\n    }\r\n  }\r\n\r\n  static resolveUrl(url        , base        )         {\r\n    const value = url.trim();\r\n    if (!value || /^[a-z][a-z0-9+.-]*:/i.test(value)) return value;\r\n    const origin = /^([a-z][a-z0-9+.-]*:)\\/\\/([^/?#]+)/i.exec(base || '');\r\n    if (!origin) return value;\r\n    if (value.startsWith('//')) return origin[1] + value;\r\n    if (value.startsWith('/')) return origin[0] + value;\r\n    const path = (base || '').substring(origin[0].length).replace(/[?#][\\s\\S]*$/, '');\r\n    if (value.startsWith('?') || value.startsWith('#')) return origin[0] + (path || '/') + value;\r\n    const tailAt = value.search(/[?#]/);\r\n    const tail = tailAt < 0 ? '' : value.substring(tailAt);\r\n    const segments = path.substring(0, path.lastIndexOf('/') + 1).split('/').filter((part        )          => !!part);\r\n    for (const part of (tailAt < 0 ? value : value.substring(0, tailAt)).split('/')) {\r\n      if (part === '.') continue;\r\n      if (part === '..') segments.pop();\r\n      else segments.push(part);\r\n    }\r\n    return origin[0] + '/' + segments.join('/') + tail;\r\n  }\r\n}\r\n\n// Upstream NativeJsPrelude.ts\n/**\r\n * 原生书源 JS 函数库与脚本引擎之间的约定：前置脚本、调用代码和结果的编码。\r\n *\r\n * 真机用 QuickJS（NativeJsLibrary），Node 回归用 node:vm，两边共用这里生成的代码，行为保持一致。\r\n * 本文件不依赖系统 API，可直接在 Node 回归脚本中加载。\r\n */\r\n\r\n                                                \r\n\r\nclass NativeJsPrelude {\r\n  /** js 字段的长度上限（字符数）。 */\r\n  static          MAX_CODE_LENGTH         = 512 * 1024;\r\n\r\n  /**\r\n   * 在书源代码之前执行：用 __host 搭出只读的 native 对象，之后删掉 __host，书源代码只能经 native 调内置函数。\r\n   * 内置函数的参数和返回值都按 JSON 传递。\r\n   *\r\n   * script 为 true 时是脚本阶段的后台环境，另外提供 http、vars、temp、cache、cookie、login、keep、log、sleep、\r\n   * page、device；为 false 时是表达式里调用的环境，这些名字存在但一用就报错，提示改用阶段的 script。\r\n   */\r\n  static source(builtins          , script          = false)         {\r\n    return `(function (g) {\r\n  var host = g.__host;\r\n  var define = function (name, value) {\r\n    Object.defineProperty(g, name, { value: value, writable: true, configurable: true, enumerable: false });\r\n  };\r\n  var call = function (name, args) {\r\n    var out = host(name, JSON.stringify(args));\r\n    return out === '' ? null : JSON.parse(out);\r\n  };\r\n  define('uuid', function () {\r\n    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {\r\n      var r = Math.random() * 16 | 0;\r\n      return (c === 'x' ? r : (r & 3 | 8)).toString(16);\r\n    });\r\n  });\r\n${script ? NativeJsPrelude.SCRIPT_API : NativeJsPrelude.EXPRESSION_STUBS}\r\n  var names = ${JSON.stringify(builtins)};\r\n  var api = {};\r\n  names.forEach(function (name) {\r\n    api[name] = function () {\r\n      var out = host(name, JSON.stringify(Array.prototype.slice.call(arguments)));\r\n      return out === '' ? null : JSON.parse(out);\r\n    };\r\n  });\r\n  // 写错名字时直接说明，而不是只得到 “not a function”。\r\n  var native = new P