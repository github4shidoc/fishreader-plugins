{\n    await finishExecutionState(state);\n  }\n};\n\nasync function detailAsync(input) {\n  const identity = text(input.bookKey || input.bookUrl);\n  const execution = await sourceAndExecutionState(input, [identity, detailCacheKey(identity)]);\n  const source = execution.source;\n  const state = execution.state;\n  try {\n    let saved = detailSeed(identity, input);\n    if (!saved.bookUrl) throw new Error('书籍标识已失效，请重新搜索');\n    const rules = sourceRuleTemplate(source).bookInfo;\n    const fingerprint = detailFingerprint(source, saved, rules);\n    const cache = stored(detailCacheKey(identity));\n    if (input.forceRefresh !== true && text(cache.fingerprint) === fingerprint &&\n        cache.detail && cache.result) {\n      const restored = Object.assign({}, saved, object(cache.detail));\n      // A cached detail may have been produced before the source was imported\n      // with its final BookSourceType (most visibly for type=2 comic sources).\n      // Re-evaluate the normalized type from the current source and the current\n      // search snapshot instead of letting the stale cached `text` value select\n      // FishReader's text reader.\n      restored.mediaType = legadoMediaType(source, restored, restored.raw);\n      const cachedResult = Object.assign({}, object(cache.result), {\n        mediaType: restored.mediaType\n      });\n      storageSet(identity, restored);\n      return cachedResult;\n    }\n    const loaded = text(saved.infoHtml) ? { body: text(saved.infoHtml), url: saved.bookUrl } :\n      await loadByUrlAsync(source, saved.bookUrl, { result: saved.raw, book: saved,\n        baseUrl: saved.bookUrl, __legadoExecutionState: state });\n    const parsed = parseDetailLoaded(identity, saved, source, loaded,\n      Object.assign({}, input || {}, { __legadoExecutionState: state }));\n    const detail = parsed.detail;\n    const output = detailResult(identity, detail, source, parsed.rules, parsed.result, parsed.fieldEnv);\n    const cachedDetail = Object.