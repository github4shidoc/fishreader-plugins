{
  "schemaVersion": 1,
  "manifest": {
    "schemaVersion": 1,
    "pluginId": "org.fishreader.multitts",
    "name": "MultiTTS在线语音包",
    "version": "0.0.16",
    "sdkVersion": "1.0",
    "sourceFormat": "fishreader-js",
    "pluginKinds": [
      "tts"
    ],
    "entryModule": "main.js",
    "managementModule": "manage.html",
    "entrypoints": [
      "ttsVoices",
      "ttsSynthesize",
      "ui"
    ],
    "permissions": {
      "networkDomains": [],
      "redirectDomains": [],
      "cookieScope": false,
      "pluginStorage": true,
      "pluginDatabase": false,
      "standardCrypto": false,
      "htmlParse": false,
      "webViewAutomation": false,
      "loginBrowser": false
    },
    "description": "管理 MultiTTS 在线语音包，并把可用音色接入 FishReader 朗读。"
  },
  "source": "'use strict';\n\n// This plugin is a capability switch and management surface. FishReader's\n// trusted native bridge supplies the catalog and audio for this exact plugin ID.\nmodule.exports.ttsVoices = async function () {\n  return [];\n};\n\nmodule.exports.ttsSynthesize = async function () {\n  throw new Error('MultiTTS 需要 FishReader 原生桥接');\n};\n",
  "modules": {
    "manage.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <title>MultiTTS在线语音包</title>\n  <style>\n    :root { color-scheme: light; font-family: system-ui, sans-serif; }\n    * { box-sizing: border-box; }\n    body { margin: 0; padding: 18px; background: #f7f4ec; color: #1d2a24; }\n    main { max-width: 760px; margin: 0 auto; }\n    h1 { margin: 0; font-size: 24px; }\n    h2 { margin: 24px 0 10px; font-size: 18px; }\n    p { margin: 7px 0; color: #65716b; line-height: 1.55; }\n    .card { margin-top: 12px; padding: 14px; border: 1px solid #d8ded9; border-radius: 16px; background: #fff; }\n    .row { display: flex; gap: 10px; align-items: center; }\n    .grow { flex: 1; min-width: 0; }\n    .title { font-weight: 700; overflow-wrap: anywhere; }\n    .meta, .reason { margin-top: 5px; font-size: 13px; color: #6a756f; overflow-wrap: anywhere; }\n    .reason { padding-left: 10px; border-left: 3px solid #d8ded9; }\n    .ready { color: #16834b; }\n    .blocked { color: #a05a24; }\n    button { border: 0; border-radius: 20px; padding: 11px 16px; background: #1688ee; color: #fff; font: inherit; font-weight: 700; }\n    button.secondary { background: #eef3f0; color: #26332d; }\n    button.danger { background: #fff0ef; color: #a8443c; }\n    button:disabled { opacity: .55; }\n    .tabs { display: flex; gap: 8px; overflow-x: auto; padding: 2px 0 8px; scrollbar-width: none; }\n    .tabs::-webkit-scrollbar { display: none; }\n    .tabs.sub { padding-top: 2px; margin-bottom: 2px; }\n    button.tab { flex: 0 0 auto; padding: 8px 13px; background: #eef3f0; color: #53605a; font-weight: 650; }\n    button.tab.active { background: #1688ee; color: #fff; }\n    button.tab.sub { padding: 6px 12px; font-size: 14px; }\n    .voice-filter-row { display: flex; gap: 8px; align-items: center; margin: 12px 0 6px; }\n    .voice-filter-row label { flex: 0 0 auto; margin: 0; }\n    .voice-filter-row input { flex: 1; min-width: 0; border: 1px solid #d8ded9; border-radius: 12px; padding: 9px 11px; background: #fff; color: #1d2a24; font: inherit; }\n    .voice-filter-row button { flex: 0 0 auto; padding: 9px 14px; }\n    .favorite-row { margin-top: 10px; justify-content: flex-end; }\n    .test-actions { display: flex; gap: 10px; margin-top: 10px; }\n    #testStatus { min-height: 22px; margin-top: 10px; color: #1676c8; }\n    .setting-row { display: flex; align-items: center; gap: 12px; min-height: 42px; }\n    .setting-row + .setting-row { margin-top: 8px; }\n    .setting-name { flex: 0 0 42px; font-weight: 650; }\n    .setting-row input[type=\"range\"] { flex: 1; min-width: 0; accent-color: #1688ee; }\n    .setting-value { flex: 0 0 34px; text-align: right; font-variant-numeric: tabular-nums; }\n    select, textarea { width: 100%; border: 1px solid #d8ded9; border-radius: 12px; padding: 11px; background: #fff; color: #1d2a24; font: inherit; }\n    #voice { display: none; }\n    .voice-picker { position: relative; }\n    .voice-picker-button { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; border: 1px solid #d8ded9; border-radius: 12px; padding: 11px; background: #fff; color: #1d2a24; font-weight: 400; text-align: left; }\n    .voice-picker-button::after { content: '▾'; flex: 0 0 auto; color: #65716b; }\n    .voice-picker-menu { position: absolute; z-index: 20; left: 0; right: 0; top: calc(100% + 6px); max-height: min(52vh, 360px); overflow-y: auto; padding: 6px; border: 1px solid #d8ded9; border-radius: 12px; background: #fff; box-shadow: 0 12px 32px rgba(29, 42, 36, .16); overscroll-behavior: contain; }\n    .voice-picker-menu[hidden] { display: none; }\n    button.voice-picker-option { width: 100%; display: block; border-radius: 9px; padding: 10px; background: transparent; color: #1d2a24; font-weight: 400; text-align: left; }\n    button.voice-picker-option.active { background: #e8f3fd; color: #126eb8; font-weight: 700; }\n    textarea { min-height: 76px; resize: vertical; }\n    label { display: block; margin: 12px 0 6px; font-weight: 650; }\n    #status { min-height: 22px; margin: 12px 2px; color: #1676c8; }\n    #empty { display: none; }\n    code { overflow-wrap: anywhere; }\n  </style>\n</head>\n<body>\n<main>\n  <h1>MultiTTS在线语音包</h1>\n  <p>导入免费在线语音包后，可在阅读设置 → 朗读音源中选择音色。付费登录包不处理。</p>\n  <p><strong>语音包请放入 <code>/Download/鱼书/TTS_packages</code> 或 <code>/Download/com.duckeaty.fishreader.huawei/TTS_packages</code>；Android 请按下方显示的实际目录放置，再点击“扫描并导入”。</strong></p>\n  <div class=\"card\">\n    <div class=\"row\">\n      <div class=\"grow\">\n        <div class=\"title\">语音包根目录</div>\n        <div id=\"root\" class=\"meta\">读取中…</div>\n      </div>\n      <button id=\"import\">扫描并导入</button>\n    </div>\n  </div>\n  <div id=\"status\"></div>\n\n  <h2>语音设置</h2>\n  <div class=\"card\">\n    <div class=\"setting-row\">\n      <span class=\"setting-name\">语速</span>\n      <input id=\"speed\" type=\"range\" min=\"0.1\" max=\"3.0\" step=\"0.1\" value=\"1.0\">\n      <output id=\"speedValue\" class=\"setting-value\" for=\"speed\">1.0</output>\n    </div>\n    <div class=\"setting-row\">\n      <span class=\"setting-name\">音高</span>\n      <input id=\"pitch\" type=\"range\" min=\"0.1\" max=\"2.0\" step=\"0.1\" value=\"1.0\">\n      <output id=\"pitchValue\" class=\"setting-value\" for=\"pitch\">1.0</output>\n    </div>\n  </div>\n\n  <h2>语音选择</h2>\n  <div class=\"card\">\n    <div id=\"voiceModeTabs\" class=\"tabs\">\n      <button class=\"tab active\" data-mode=\"all\">语音选择</button>\n      <button class=\"tab\" data-mode=\"favorites\">收藏语音</button>\n      <button class=\"tab\" data-mode=\"deleted\">已删除</button>\n    </div>\n    <div id=\"packageTabs\" class=\"tabs\"></div>\n    <div id=\"categoryTabs\" class=\"tabs sub\"></div>\n    <div class=\"voice-filter-row\">\n      <label for=\"voiceFilter\">可用音色</label>\n      <input id=\"voiceFilter\" type=\"text\" placeholder=\"输入音色关键词\">\n      <button id=\"filterVoice\" class=\"secondary\" type=\"button\">搜索</button>\n    </div>\n    <div class=\"voice-picker\">\n      <button id=\"voicePickerButton\" class=\"voice-picker-button\" type=\"button\" aria-haspopup=\"listbox\" aria-expanded=\"false\">暂无可用音色</button>\n      <div id=\"voicePickerMenu\" class=\"voice-picker-menu\" role=\"listbox\" hidden></div>\n      <select id=\"voice\" aria-hidden=\"true\" tabindex=\"-1\"></select>\n    </div>\n    <div class=\"row favorite-row\">\n      <button id=\"favorite\" class=\"secondary\" type=\"button\">收藏音色</button>\n    </div>\n    <label for=\"testText\">测试文字</label>\n    <textarea id=\"testText\">你好，这是 FishReader 的 MultiTTS 语音测试。</textarea>\n    <div class=\"test-actions\">\n      <button id=\"test\">试听</button>\n      <button id=\"deleteVoice\" class=\"danger\" type=\"button\">删除</button>\n    </div>\n    <p id=\"testStatus\">测试成功后会立即播放测试语音，不会加入阅读播放队列。</p>\n  </div>\n\n  <h2>已导入语音包</h2>\n  <p id=\"empty\">尚未导入语音包。</p>\n  <div id=\"packages\"></div>\n</main>\n<script>\n  const status = document.getElementById('status');\n  const importButton = document.getElementById('import');\n  const testButton = document.getElementById('test');\n  const deleteVoiceButton = document.getElementById('deleteVoice');\n  const favoriteButton = document.getElementById('favorite');\n  const packagesNode = document.getElementById('packages');\n  const voiceNode = document.getElementById('voice');\n  const voicePickerButton = document.getElementById('voicePickerButton');\n  const voicePickerMenu = document.getElementById('voicePickerMenu');\n  const voiceFilterNode = document.getElementById('voiceFilter');\n  const filterVoiceButton = document.getElementById('filterVoice');\n  const voiceModeTabsNode = document.getElementById('voiceModeTabs');\n  const packageTabsNode = document.getElementById('packageTabs');\n  const categoryTabsNode = document.getElementById('categoryTabs');\n  const testStatus = document.getElementById('testStatus');\n  const speedNode = document.getElementById('speed');\n  const speedValueNode = document.getElementById('speedValue');\n  const pitchNode = document.getElementById('pitch');\n  const pitchValueNode = document.getElementById('pitchValue');\n  let busy = false;\n  let availableVoices = [];\n  let activePackageId = '';\n  let activeCategory = '';\n  let selectedVoiceId = '';\n  let activeVoiceMode = 'all';\n  let favoriteVoiceIds = [];\n  let deletedVoiceIds = [];\n  let voiceSettings = [];\n  let voiceSearchQuery = '';\n  let testRequestSerial = 0;\n  const FAVORITE_VOICE_IDS_KEY = 'multitts.favoriteVoiceIds.v1';\n  const DELETED_VOICE_IDS_KEY = 'multitts.deletedVoiceIds.v1';\n  const VOICE_SETTINGS_KEY = 'multitts.voiceSettings.v1';\n\n  function escapeHtml(value) {\n    return String(value ?? '').replace(/[&<>\"']/g, (char) => ({\n      '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n    })[char]);\n  }\n\n  function setBusy(value, message = '') {\n    busy = value;\n    importButton.disabled = value;\n    testButton.disabled = value || !voiceNode.value;\n    favoriteButton.disabled = value || !voiceNode.value;\n    deleteVoiceButton.disabled = value || !voiceNode.value;\n    voicePickerButton.disabled = value || !voiceNode.value;\n    if (message) status.textContent = message;\n  }\n\n  function bindRange(input, output) {\n    const update = () => { output.textContent = Number(input.value).toFixed(1); };\n    input.addEventListener('input', update);\n    input.addEventListener('change', () => { void saveCurrentVoiceSettings(); });\n    update();\n  }\n\n  function normalizeSetting(value, minimum, maximum, fallback = 1) {\n    const parsed = Number(value);\n    return Number.isFinite(parsed) ? Math.max(minimum, Math.min(maximum, parsed)) : fallback;\n  }\n\n  function normalizeVoiceSettings(value) {\n    if (!Array.isArray(value)) return [];\n    const normalized = [];\n    value.forEach((item) => {\n      if (!item || typeof item !== 'object' || typeof item.voiceId !== 'string' || !item.voiceId) return;\n      const record = {\n        voiceId: item.voiceId,\n        speed: normalizeSetting(item.speed, 0.1, 3.0),\n        pitch: normalizeSetting(item.pitch, 0.1, 2.0)\n      };\n      const existing = normalized.findIndex((entry) => entry.voiceId === record.voiceId);\n      if (existing >= 0) normalized[existing] = record;\n      else normalized.push(record);\n    });\n    return normalized;\n  }\n\n  function applyVoiceSettings(voiceId) {\n    const saved = voiceSettings.find((item) => item.voiceId === voiceId);\n    speedNode.value = normalizeSetting(saved?.speed, 0.1, 3.0).toFixed(1);\n    pitchNode.value = normalizeSetting(saved?.pitch, 0.1, 2.0).toFixed(1);\n    speedValueNode.textContent = Number(speedNode.value).toFixed(1);\n    pitchValueNode.textContent = Number(pitchNode.value).toFixed(1);\n  }\n\n  async function saveCurrentVoiceSettings() {\n    const voiceId = voiceNode.value;\n    if (!voiceId) return;\n    const record = {\n      voiceId,\n      speed: normalizeSetting(speedNode.value, 0.1, 3.0),\n      pitch: normalizeSetting(pitchNode.value, 0.1, 2.0)\n    };\n    voiceSettings = voiceSettings.filter((item) => item.voiceId !== voiceId);\n    voiceSettings.push(record);\n    try {\n      await FishReader.tts.saveVoiceSettings(voiceId, record.speed, record.pitch);\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\n      status.textContent = selected ?\n        `已保存 ${selected.name} 的语速 ${record.speed.toFixed(1)}、音高 ${record.pitch.toFixed(1)}。` :\n        '当前音色的语速与音高已保存。';\n    } catch (error) {\n      status.textContent = `语音设置保存失败：${error.message || error}`;\n    }\n  }\n\n  function voiceCategory(voice, hasCategories) {\n    if (!hasCategories) return '';\n    return voice.group || '其他';\n  }\n\n  function visibleModeVoices() {\n    const deleted = new Set(deletedVoiceIds);\n    if (activeVoiceMode === 'deleted') {\n      return availableVoices.filter((voice) => deleted.has(voice.id));\n    }\n    const activeVoices = availableVoices.filter((voice) => !deleted.has(voice.id));\n    if (activeVoiceMode !== 'favorites') return activeVoices;\n    const favorites = new Set(favoriteVoiceIds);\n    return activeVoices.filter((voice) => favorites.has(voice.id));\n  }\n\n  function searchMatchedVoices() {\n    const voices = visibleModeVoices();\n    if (!voiceSearchQuery) return voices;\n    return voices.filter((voice) =>\n      [voice.name, voice.group, voice.packageName, voice.description, voice.locale]\n        .some((value) => String(value || '').toLocaleLowerCase().includes(voiceSearchQuery)));\n  }\n\n  function updateFavoriteButton() {\n    const voiceId = voiceNode.value;\n    const isFavorite = favoriteVoiceIds.includes(voiceId);\n    favoriteButton.textContent = isFavorite ? '取消收藏' : '收藏音色';\n    favoriteButton.disabled = busy || !voiceId;\n  }\n\n  function updateDeleteVoiceButton() {\n    const restoring = activeVoiceMode === 'deleted';\n    deleteVoiceButton.textContent = restoring ? '恢复' : '删除';\n    deleteVoiceButton.classList.toggle('danger', !restoring);\n    deleteVoiceButton.classList.toggle('secondary', restoring);\n    deleteVoiceButton.disabled = busy || !voiceNode.value;\n  }\n\n  function locateFiltersForVoice(voiceId, voices = searchMatchedVoices()) {\n    const selected = voices.find((voice) => voice.id === voiceId);\n    if (!selected) return false;\n    activePackageId = selected.packageId;\n    activeCategory = selected.group || '';\n    return true;\n  }\n\n  function renderVoiceOptions(selectFirst = false) {\n    const packageVoices = searchMatchedVoices().filter((voice) => voice.packageId === activePackageId);\n    const explicitCategories = [...new Set(packageVoices.map((voice) => voice.group).filter(Boolean))];\n    const hasCategories = explicitCategories.length > 0;\n    const categories = hasCategories ?\n      [...new Set(packageVoices.map((voice) => voice.group || '其他'))] : [];\n    if (activeCategory && !categories.includes(activeCategory)) activeCategory = '';\n    categoryTabsNode.style.display = categories.length > 0 ? 'flex' : 'none';\n    categoryTabsNode.innerHTML = categories.length === 0 ? '' :\n      [`<button class=\"tab sub ${activeCategory === '' ? 'active' : ''}\" data-category=\"\">全部</button>`]\n        .concat(categories.map((category) =>\n          `<button class=\"tab sub ${activeCategory === category ? 'active' : ''}\" ` +\n          `data-category=\"${escapeHtml(category)}\">${escapeHtml(category)}</button>`)).join('');\n    categoryTabsNode.querySelectorAll('.tab').forEach((button) => {\n      button.addEventListener('click', () => {\n        activeCategory = button.dataset.category || '';\n        renderVoiceOptions(true);\n      });\n    });\n    const filtered = packageVoices.filter((voice) =>\n      !activeCategory || voiceCategory(voice, hasCategories) === activeCategory);\n    const selectedVisible = filtered.some((voice) => voice.id === selectedVoiceId);\n    const targetVoiceId = selectedVisible ? selectedVoiceId : (filtered[0]?.id || '');\n    voiceNode.innerHTML = filtered.length > 0 ? filtered.map((voice, index) =>\n      `<option value=\"${escapeHtml(voice.id)}\"${voice.id === targetVoiceId ? ' selected' : ''}>${String(index + 1).padStart(3, '0')} - ${escapeHtml(voice.name)}</option>`).join('') :\n      `<option value=\"\">${voiceSearchQuery ? '未找到匹配音色' :\n        (activeVoiceMode === 'favorites' ? '暂无收藏音色' :\n          (activeVoiceMode === 'deleted' ? '暂无已删除音色' : '暂无可用音色'))}</option>`;\n    voiceNode.value = targetVoiceId;\n    applyVoiceSettings(targetVoiceId);\n    voicePickerMenu.innerHTML = filtered.map((voice, index) => {\n      const active = voice.id === targetVoiceId;\n      return `<button class=\"voice-picker-option${active ? ' active' : ''}\" type=\"button\" role=\"option\" ` +\n        `aria-selected=\"${active ? 'true' : 'false'}\" data-value=\"${escapeHtml(voice.id)}\">` +\n        `${String(index + 1).padStart(3, '0')} - ${escapeHtml(voice.name)}</button>`;\n    }).join('');\n    const targetIndex = filtered.findIndex((voice) => voice.id === targetVoiceId);\n    voicePickerButton.textContent = targetIndex >= 0 ?\n      `${String(targetIndex + 1).padStart(3, '0')} - ${filtered[targetIndex].name}` :\n      (voiceSearchQuery ? '未找到匹配音色' :\n        (activeVoiceMode === 'favorites' ? '暂无收藏音色' :\n          (activeVoiceMode === 'deleted' ? '暂无已删除音色' : '暂无可用音色')));\n    voicePickerMenu.querySelectorAll('.voice-picker-option').forEach((option) => {\n      option.addEventListener('click', () => {\n        const voiceId = option.dataset.value || '';\n        voiceNode.value = voiceId;\n        closeVoicePicker();\n        if (activeVoiceMode === 'deleted') {\n          renderVoiceOptions(false);\n          return;\n        }\n        void selectVoice(voiceId);\n      });\n    });\n    if (!selectedVisible && filtered.length > 0) {\n      if (selectFirst && activeVoiceMode !== 'deleted') void selectVoice(filtered[0].id);\n    }\n    voiceNode.disabled = filtered.length === 0;\n    voicePickerButton.disabled = busy || filtered.length === 0;\n    testButton.disabled = busy || filtered.length === 0;\n    updateFavoriteButton();\n    updateDeleteVoiceButton();\n  }\n\n  function locateSelectedVoiceOption() {\n    const targetVoiceId = voiceNode.value || selectedVoiceId;\n    const options = Array.from(voicePickerMenu.querySelectorAll('.voice-picker-option'));\n    const target = options.find((option) => option.dataset.value === targetVoiceId);\n    if (!target) return;\n    voicePickerMenu.scrollTop = Math.max(0,\n      target.offsetTop - (voicePickerMenu.clientHeight - target.offsetHeight) / 2);\n  }\n\n  function closeVoicePicker() {\n    voicePickerMenu.hidden = true;\n    voicePickerButton.setAttribute('aria-expanded', 'false');\n  }\n\n  function openVoicePicker() {\n    if (voicePickerButton.disabled) return;\n    voicePickerMenu.hidden = false;\n    voicePickerButton.setAttribute('aria-expanded', 'true');\n    requestAnimationFrame(locateSelectedVoiceOption);\n  }\n\n  function renderVoiceFilters(snapshot) {\n    availableVoices = (snapshot.voices || []).filter((voice) => voice.available);\n    selectedVoiceId = snapshot.selectedVoiceId || '';\n    const modeVoices = searchMatchedVoices();\n    const packageMap = new Map();\n    modeVoices.forEach((voice) => packageMap.set(voice.packageId, voice.packageName));\n    locateFiltersForVoice(selectedVoiceId, modeVoices);\n    if (!packageMap.has(activePackageId)) activePackageId = packageMap.keys().next().value || '';\n    packageTabsNode.innerHTML = [...packageMap.entries()].map(([id, name]) =>\n      `<button class=\"tab ${activePackageId === id ? 'active' : ''}\" data-package=\"${escapeHtml(id)}\">` +\n      `${escapeHtml(name)}</button>`).join('');\n    packageTabsNode.querySelectorAll('.tab').forEach((button) => {\n      button.addEventListener('click', () => {\n        activePackageId = button.dataset.package || '';\n        activeCategory = '';\n        packageTabsNode.querySelectorAll('.tab').forEach((item) =>\n          item.classList.toggle('active', item === button));\n        renderVoiceOptions(true);\n      });\n    });\n    renderVoiceOptions(false);\n    voiceModeTabsNode.querySelectorAll('.tab').forEach((button) =>\n      button.classList.toggle('active', button.dataset.mode === activeVoiceMode));\n  }\n\n  async function selectVoice(voiceId) {\n    if (!voiceId) return;\n    try {\n      await FishReader.tts.selectVoice(voiceId);\n      selectedVoiceId = voiceId;\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\n      if (selected) {\n        activePackageId = selected.packageId;\n        activeCategory = selected.group || '';\n        renderVoiceOptions(false);\n      }\n      status.textContent = selected ? `已选择音色：${selected.packageName} · ${selected.name}` : '已选择音色。';\n    } catch (error) {\n      status.textContent = `选择音色失败：${error.message || error}`;\n    }\n  }\n\n  function render(snapshot) {\n    document.getElementById('root').textContent = snapshot.rootDirectory || 'TTS_packages';\n    renderVoiceFilters(snapshot);\n\n    const packages = snapshot.packages || [];\n    document.getElementById('empty').style.display = packages.length === 0 ? 'block' : 'none';\n    packagesNode.innerHTML = packages.map((item) => {\n      const engines = (item.engines || []).map((engine) => {\n        const ready = engine.availability === 'ready';\n        return `<div class=\"reason\"><span class=\"${ready ? 'ready' : 'blocked'}\">` +\n          `${ready ? '可用' : '需要适配'} · ${escapeHtml(engine.name || engine.code)}</span><br>` +\n          `${escapeHtml(engine.reason)}</div>`;\n      }).join('');\n      return `<section class=\"card\"><div class=\"row\"><div class=\"grow\">` +\n        `<div class=\"title\">${escapeHtml(item.name)}</div>` +\n        `<div class=\"meta\">${item.voiceCount} 个音色 · ${escapeHtml(item.id)}</div></div>` +\n        `<button class=\"danger remove\" data-id=\"${escapeHtml(item.id)}\" data-name=\"${escapeHtml(item.name)}\">删除</button>` +\n        `</div>${engines}</section>`;\n    }).join('');\n    document.querySelectorAll('.remove').forEach((button) => {\n      button.addEventListener('click', () => removePackage(button.dataset.id, button.dataset.name));\n    });\n  }\n\n  async function refresh() {\n    const snapshot = await FishReader.tts.snapshot();\n    const availableIds = new Set((snapshot.voices || []).map((voice) => voice.id));\n    const cleanedFavorites = favoriteVoiceIds.filter((id) => availableIds.has(id));\n    if (cleanedFavorites.length !== favoriteVoiceIds.length) {\n      favoriteVoiceIds = cleanedFavorites;\n      await FishReader.storage.set(FAVORITE_VOICE_IDS_KEY, favoriteVoiceIds);\n    }\n    const cleanedDeleted = deletedVoiceIds.filter((id) => availableIds.has(id));\n    if (cleanedDeleted.length !== deletedVoiceIds.length) {\n      deletedVoiceIds = cleanedDeleted;\n      await FishReader.storage.set(DELETED_VOICE_IDS_KEY, deletedVoiceIds);\n    }\n    const cleanedSettings = voiceSettings.filter((item) => availableIds.has(item.voiceId));\n    if (cleanedSettings.length !== voiceSettings.length) {\n      voiceSettings = cleanedSettings;\n      await FishReader.storage.set(VOICE_SETTINGS_KEY, voiceSettings);\n    }\n    render(snapshot);\n  }\n\n  async function toggleFavorite() {\n    const voiceId = voiceNode.value;\n    if (busy || !voiceId) return;\n    try {\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\n      const favorites = new Set(favoriteVoiceIds);\n      const removing = favorites.has(voiceId);\n      if (removing) favorites.delete(voiceId);\n      else favorites.add(voiceId);\n      favoriteVoiceIds = [...favorites];\n      await FishReader.storage.set(FAVORITE_VOICE_IDS_KEY, favoriteVoiceIds);\n      status.textContent = selected ?\n        `${removing ? '已取消收藏' : '已收藏'}音色：${selected.packageName} · ${selected.name}` :\n        (removing ? '已取消收藏音色。' : '已收藏音色。');\n      if (activeVoiceMode === 'favorites') renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\n      else updateFavoriteButton();\n    } catch (error) {\n      status.textContent = `收藏操作失败：${error.message || error}`;\n    }\n  }\n\n  async function toggleDeletedVoice() {\n    const voiceId = voiceNode.value;\n    if (busy || !voiceId) return;\n    try {\n      const selected = availableVoices.find((voice) => voice.id === voiceId);\n      const deleted = new Set(deletedVoiceIds);\n      const restoring = activeVoiceMode === 'deleted' || deleted.has(voiceId);\n      if (restoring) deleted.delete(voiceId);\n      else deleted.add(voiceId);\n      deletedVoiceIds = [...deleted];\n      await FishReader.storage.set(DELETED_VOICE_IDS_KEY, deletedVoiceIds);\n      let switched = false;\n      if (!restoring && voiceId === selectedVoiceId) {\n        const replacement = availableVoices.find((voice) => !deleted.has(voice.id));\n        if (replacement) {\n          await FishReader.tts.selectVoice(replacement.id);\n          selectedVoiceId = replacement.id;\n          switched = true;\n        }\n      }\n      status.textContent = selected ?\n        `${restoring ? '已恢复' : '已删除'}音色：${selected.packageName} · ${selected.name}` +\n          (switched ? '，并已切换到下一可用音色。' : '。') :\n        (restoring ? '已恢复音色。' : '已删除音色。');\n      activePackageId = '';\n      activeCategory = '';\n      renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\n    } catch (error) {\n      status.textContent = `${activeVoiceMode === 'deleted' ? '恢复' : '删除'}音色失败：${error.message || error}`;\n    }\n  }\n\n  function switchVoiceMode(mode) {\n    if (mode !== 'all' && mode !== 'favorites' && mode !== 'deleted') return;\n    activeVoiceMode = mode;\n    activePackageId = '';\n    activeCategory = '';\n    renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\n  }\n\n  function filterVoices() {\n    voiceSearchQuery = voiceFilterNode.value.trim().toLocaleLowerCase();\n    activePackageId = '';\n    activeCategory = '';\n    renderVoiceFilters({ voices: availableVoices, selectedVoiceId });\n  }\n\n  async function importPackage() {\n    if (busy) return;\n    setBusy(true, '正在扫描 TTS_packages 并导入语音包…');\n    try {\n      const result = await FishReader.tts.importPackage();\n      status.textContent = result.message || `已导入 ${result.name}，共 ${result.voiceCount} 个音色。`;\n      await refresh();\n    } catch (error) {\n      status.textContent = `导入失败：${error.message || error}`;\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function removePackage(packageId, name) {\n    if (busy || !confirm(`删除“${name}”？语音包文件会从 TTS_packages 中移除。`)) return;\n    setBusy(true, '正在删除语音包…');\n    try {\n      await FishReader.tts.removePackage(packageId);\n      status.textContent = `已删除 ${name}。`;\n      await refresh();\n    } catch (error) {\n      status.textContent = `删除失败：${error.message || error}`;\n    } finally {\n      setBusy(false);\n    }\n  }\n\n  async function testVoice() {\n    if (!voiceNode.value) return;\n    const text = document.getElementById('testText').value.trim();\n    if (!text) { testStatus.textContent = '请输入测试文字。'; return; }\n    const requestSerial = ++testRequestSerial;\n    const voiceId = voiceNode.value;\n    testStatus.textContent = '正在请求语音…';\n    try {\n      const result = await FishReader.tts.testVoice(voiceId, text,\n        Number(speedNode.value), Number(pitchNode.value));\n      if (requestSerial !== testRequestSerial) return;\n      testStatus.textContent = `合成成功并开始播放：${result.contentType}，${result.byteLength} 字节，${result.sampleRate} Hz。`;\n    } catch (error) {\n      if (requestSerial !== testRequestSerial) return;\n      testStatus.textContent = `合成失败：${error.message || error}`;\n    }\n  }\n\n  importButton.addEventListener('click', importPackage);\n  testButton.addEventListener('click', testVoice);\n  deleteVoiceButton.addEventListener('click', () => { void toggleDeletedVoice(); });\n  favoriteButton.addEventListener('click', () => { void toggleFavorite(); });\n  filterVoiceButton.addEventListener('click', filterVoices);\n  voiceFilterNode.addEventListener('keydown', (event) => {\n    if (event.key === 'Enter') {\n      event.preventDefault();\n      filterVoices();\n    }\n  });\n  voiceModeTabsNode.querySelectorAll('.tab').forEach((button) => {\n    button.addEventListener('click', () => switchVoiceMode(button.dataset.mode || 'all'));\n  });\n  voiceNode.addEventListener('change', () => {\n    if (activeVoiceMode === 'deleted') {\n      updateFavoriteButton();\n      updateDeleteVoiceButton();\n      return;\n    }\n    void selectVoice(voiceNode.value);\n  });\n  voicePickerButton.addEventListener('click', (event) => {\n    event.stopPropagation();\n    if (voicePickerMenu.hidden) openVoicePicker();\n    else closeVoicePicker();\n  });\n  voicePickerMenu.addEventListener('click', (event) => event.stopPropagation());\n  document.addEventListener('click', closeVoicePicker);\n  bindRange(speedNode, speedValueNode);\n  bindRange(pitchNode, pitchValueNode);\n  FishReader.ready.then(async () => {\n    const savedFavorites = await FishReader.storage.get(FAVORITE_VOICE_IDS_KEY);\n    favoriteVoiceIds = Array.isArray(savedFavorites) ? savedFavorites.filter((id) => typeof id === 'string') : [];\n    const savedDeleted = await FishReader.storage.get(DELETED_VOICE_IDS_KEY);\n    deletedVoiceIds = Array.isArray(savedDeleted) ? savedDeleted.filter((id) => typeof id === 'string') : [];\n    voiceSettings = normalizeVoiceSettings(await FishReader.storage.get(VOICE_SETTINGS_KEY));\n    await refresh();\n  }).catch((error) => {\n    status.textContent = `加载失败：${error.message || error}`;\n  });\n</script>\n</body>\n</html>\n"
  }
