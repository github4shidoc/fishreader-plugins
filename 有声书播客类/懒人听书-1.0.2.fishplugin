{
  "schemaVersion": 1,
  "manifest": {
    "schemaVersion": 1,
    "pluginId": "com.fishreader.lanren.audio",
    "name": "懒人听书",
    "version": "1.0.2",
    "sdkVersion": "1.0",
    "sourceFormat": "fishreader-js",
    "pluginKinds": [
      "source"
    ],
    "entryModule": "index.js",
    "entrypoints": [
      "search",
      "detail",
      "catalog",
      "content",
      "exploreMenu",
      "explore"
    ],
    "description": "懒人听书有声书与节目。发现页先榜单、后分类；支持搜索、详情、完整目录及鱼书原生听书播放。自动建立游客会话，可听范围由懒人服务端决定。",
    "permissions": {
      "networkDomains": [
        "shapi.mting.info",
        "*.lrts.me",
        "*.lrts.tencentmusic.com",
        "*.tencentmusic.com"
      ],
      "redirectDomains": [
        "*.lrts.me",
        "*.tencentmusic.com",
        "*.qq.com"
      ],
      "cookieScope": false,
      "pluginStorage": true,
      "pluginDatabase": false,
      "standardCrypto": true,
      "htmlParse": false,
      "webViewAutomation": false,
      "loginBrowser": false
    }
  },
  "source": "'use strict';\n\n// Protocol adapter for the Android 8.7.24 API. All account and media permissions\n// remain server-controlled. No APK code, native library or session is bundled.\nconst API = 'https://shapi.mting.info';\nconst UA = 'Android13/yytingpro/FishReader/Audio/ch_yyting/8724/1080*1920';\nconst HEADERS = { 'User-Agent': UA, ClientVersion: '8.7.24', Referer: 'yytingting.com' };\nconst SALT = 'vYCmm+6CFVykQk5w0wiUDliCQRA=';\nconst PUBLIC_KEY = 'MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCTa5IO+9A0L6eIX+KtvM4o3zCRE0QXX/63Pdcp+ME4Px8LIpfNSHqhSMJW2jUsO6eCRGxbsvOnUqxM7uG4hbQfSqSSmaReaInT5DIlWpSzUtdm+BViIyqKi/1Z2buGWEb/ML836JiRY4WgcVOLWGpde3ZTddWvQ1Hm3bZ/+hGbswIDAQAB';\nconst RSA_MODULUS = '936b920efbd0342fa7885fe2adbcce28df30911344175ffeb73dd729f8c1383f1f0b2297cd487aa148c256da352c3ba782446c5bb2f3a752ac4ceee1b885b41f4aa49299a45e6889d3e432255a94b352d766f81562232a8a8bfd59d9bb865846ff30bf37e898916385a071538b586a5d7b765375d5af4351e6ddb67ffa119bb3';\nconst SESSION_KEY = 'lanren:session:v1';\nconst DEVICE_KEY = 'lanren:device:v1';\nconst CATALOG_PAGE_SIZE = 1000;\nconst CATALOG_CACHE_MS = 5 * 60000;\nconst MAX_CHAPTERS = 20000;\nlet sessionPromise;\nlet refreshPromise;\nlet nativeRsaUnavailable = false;\nlet deviceValue;\nlet sessionValue;\n\nfunction str(value) { return value == null ? '' : String(value).trim(); }\nfunction pageOf(value) { return Math.max(1, Math.floor(Number(value) || 1)); }\nfunction array(value) { return Array.isArray(value) ? value : []; }\nfunction idOf(value) {\n  const s = str(value);\n  if (!/^[1-9]\\d{0,19}$/.test(s)) throw new Error('懒人听书：无效的资源编号');\n  return s;\n}\nfunction httpUrl(value) { const s = str(value); return /^https?:\\/\\//i.test(s) ? s : ''; }\nfunction plain(value) {\n  return str(value).replace(/<br\\s*\\/?\\s*>/gi, '\\n').replace(/<\\/p>/gi, '\\n')\n    .replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();\n}\nfunction b64(bytes) {\n  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/';\n  let out = '';\n  for (let i = 0; i < bytes.length; i += 3) {\n    const a = bytes[i], b = bytes[i + 1] || 0, c = bytes[i + 2] || 0;\n    out += chars[a >> 2] + chars[((a & 3) << 4) | (b >> 4)] +\n      (i + 1 < bytes.length ? chars[((b & 15) << 2) | (c >> 6)] : '=') +\n      (i + 2 < bytes.length ? chars[c & 63] : '=');\n  }\n  return out;\n}\n// Public-key-only RSA compatibility path. Fixed 16-bit limbs work in plugin\n// engines without BigInt and avoid the Harmony key-generator API entirely.\nfunction rsaPublicOperation(block, modulusHex) {\n  const size = modulusHex.length / 4, modulus = [], value = [];\n  if (block.length !== size * 2) throw new Error('Invalid RSA block length');\n  for (let i = 0; i < size; i++) {\n    modulus.push(parseInt(modulusHex.slice(modulusHex.length - (i + 1) * 4, modulusHex.length - i * 4), 16));\n    value.push(block[block.length - 1 - i * 2] + block[block.length - 2 - i * 2] * 256);\n  }\n  function compare(a, b) {\n    for (let i = size - 1; i >= 0; i--) if (a[i] !== b[i]) return a[i] > b[i] ? 1 : -1;\n    return 0;\n  }\n  if (compare(value, modulus) >= 0) throw new Error('RSA block exceeds modulus');\n  function addMod(a, b) {\n    const out = []; let carry = 0;\n    for (let i = 0; i < size; i++) {\n      const n = a[i] + b[i] + carry;\n      out[i] = n & 65535; carry = n >>> 16;\n    }\n    if (carry || compare(out, modulus) >= 0) {\n      let borrow = 0;\n      for (let i = 0; i < size; i++) {\n        const n = out[i] - modulus[i] - borrow;\n        out[i] = n & 65535; borrow = n < 0 ? 1 : 0;\n      }\n    }\n    return out;\n  }\n  function multiplyMod(a, b) {\n    let out = [], factor = a;\n    for (let i = 0; i < size; i++) out[i] = 0;\n    for (let i = 0; i < size; i++) {\n      for (let bit = 0; bit < 16; bit++) {\n        if ((b[i] >>> bit) & 1) out = addMod(out, factor);\n        if (i !== size - 1 || bit !== 15) factor = addMod(factor, factor);\n      }\n    }\n    return out;\n  }\n  // The public exponent in this protocol is 65537 = 2^16 + 1.\n  let result = value;\n  for (let i = 0; i < 16; i++) result = multiplyMod(result, result);\n  result = multiplyMod(result, value);\n  const output = [];\n  for (let i = size - 1; i >= 0; i--) output.push(result[i] >>> 8, result[i] & 255);\n  return output;\n}\nfunction rsaCompatBlock(bytes) {\n  if (bytes.length > 117) throw new Error('RSA metadata block is too large');\n  // The plaintext contains only a synthetic installation identity, not account\n  // credentials or device identifiers. Match the app's PKCS#1 v1.5 wire format.\n  const block = [0, 2];\n  while (block.length < 127 - bytes.length) block.push(1 + Math.floor(Math.random() * 255));\n  block.push(0);\n  for (let i = 0; i < bytes.length; i++) block.push(bytes[i]);\n  return rsaPublicOperation(block, RSA_MODULUS);\n}\nasync function encryptMetadataBlock(bytes) {\n  if (!nativeRsaUnavailable && reader.crypto && typeof reader.crypto.asymmetric === 'function') {\n    try {\n      const r = await reader.crypto.asymmetric({ transformation: 'RSA/ECB/PKCS1Padding',\n        operation: 'encrypt', publicKey: PUBLIC_KEY, usePublicKey: true, data: bytes });\n      if (r && r.data && r.data.length === 128) return r.data;\n    } catch (_) {\n      // Some Harmony hosts create a generator with \"RSA\" instead of \"RSA1024\".\n      // Older hosts may also omit this capability. The public operation below\n      // needs no native asymmetric cryptography or additional host permissions.\n    }\n    nativeRsaUnavailable = true;\n  }\n  return rsaCompatBlock(bytes);\n}\nfunction form(params) {\n  return Object.keys(params).sort().map(k => encodeURIComponent(k) + '=' + encodeURIComponent(str(params[k]))).join('&');\n}\nasync function md5(value) {\n  const result = await reader.crypto.digest({ algorithm: 'MD5', text: value });\n  if (!result || !/^[a-f\\d]{32}$/i.test(result.hex || '')) throw new Error('宿主未返回有效的 MD5 摘要');\n  return result.hex.toLowerCase();\n}\nasync function fetchJson(url, method, body) {\n  const request = { url, method: method || 'GET', headers: Object.assign({}, HEADERS), timeoutMs: 30000, retry: 1 };\n  if (body !== undefined) {\n    request.body = body;\n    request.headers['Content-Type'] = 'application/x-www-form-urlencoded';\n  }\n  const response = await reader.http.fetch(request);\n  if (!response || response.status < 200 || response.status >= 300) {\n    throw new Error('懒人听书请求失败：HTTP ' + (response && response.status || 0));\n  }\n  try { return JSON.parse(response.body); }\n  catch (_) { throw new Error('懒人听书返回了无法识别的数据'); }\n}\nasync function device() {\n  if (deviceValue) return deviceValue;\n  const stored = await reader.storage.get(DEVICE_KEY);\n  if (stored && /^[a-f\\d]{32}$/.test(stored.id || '')) { deviceValue = stored; return stored; }\n  let id = '';\n  for (let i = 0; i < 32; i++) id += Math.floor(Math.random() * 16).toString(16);\n  const value = { id, ostar16: id.slice(0, 16), ostar36: id.slice(0, 8) + '-' + id.slice(8, 12) + '-' + id.slice(12, 16) + '-' + id.slice(16, 20) + '-' + id.slice(20) };\n  await reader.storage.set(DEVICE_KEY, value);\n  deviceValue = value;\n  return value;\n}\nasync function register() {\n  const d = await device();\n  const meta = JSON.stringify({ androidId: d.ostar16, deviceMd5: await md5(d.id),\n    imei: '', imsi: '', mac: '', nowTime: Date.now(), oaid: d.ostar36,\n    ostar16: d.ostar16, ostar36: d.ostar36, serialNo: '', key: '' });\n  // Metadata is ASCII JSON; Android encrypts it in 117-byte RSA blocks.\n  const bytes = [];\n  for (let i = 0; i < meta.length; i++) bytes.push(meta.charCodeAt(i));\n  const encrypted = [];\n  for (let i = 0; i < bytes.length; i += 117) {\n    const block = await encryptMetadataBlock(bytes.slice(i, i + 117));\n    for (let n = 0; n < block.length; n++) encrypted.push(block[n]);\n  }\n  const path = '/yyting/usercenter/AutoRegister.action';\n  const j = await fetchJson(API + path + '?sc=' + await md5(path + SALT), 'POST', form({ meta: b64(encrypted), firstLaunch: '0' }));\n  if (Number(j.status) !== 0 || !str(j.token)) throw new Error('懒人听书游客会话建立失败：' + (str(j.msg) || str(j.status)));\n  const value = { token: j.token, lrid: str(j.lrid), duId: str(j.duId), userMode: str(j.userMode || 0) };\n  await reader.storage.set(SESSION_KEY, value);\n  sessionValue = value;\n  return value;\n}\nasync function session() {\n  if (sessionValue) return sessionValue;\n  const saved = await reader.storage.get(SESSION_KEY);\n  if (saved && str(saved.token)) { sessionValue = saved; return saved; }\n  if (!sessionPromise) sessionPromise = register();\n  try { return await sessionPromise; } finally { sessionPromise = null; }\n}\nasync function refreshSession(failedToken) {\n  if (!refreshPromise) refreshPromise = (async function () {\n    if (sessionValue && sessionValue.token !== failedToken) return;\n    const current = await reader.storage.get(SESSION_KEY);\n    if (current && current.token !== failedToken) { sessionValue = current; return; }\n    sessionValue = null;\n    await reader.storage.set(SESSION_KEY, null);\n    await session();\n  })();\n  try { await refreshPromise; } finally { refreshPromise = null; }\n}\nasync function api(path, input, retried) {\n  const auth = await session(), d = await device();\n  const params = Object.assign({}, input || {}, { token: auth.token, imei: d.ostar16,\n    nwt: '1', q: '108', mode: '0', lrid: auth.lrid, ostar36: d.ostar36,\n    duId: auth.duId, ts: String(Date.now()), userMode: auth.userMode || '0' });\n  // Android signs decoded query values, sorted by parameter name.\n  const raw = Object.keys(params).sort().map(k => k + '=' + str(params[k])).join('&');\n  params.sc = await md5(path + '?' + raw + SALT);\n  const j = await fetchJson(API + path + '?' + form(params));\n  const status = Number(j.status);\n  if ([500, 502, 503, 504].indexOf(status) >= 0 && !retried) return api(path, input, true);\n  if ([481, 482, 484].indexOf(status) >= 0 && !retried) {\n    await refreshSession(auth.token);\n    return api(path, input, true);\n  }\n  if (status !== 0) throw new Error('懒人听书：' + (str(j.msg) || '接口错误 ' + str(j.status)));\n  if (j.data && Number(j.data.errorStatus) > 0) throw new Error('懒人听书：搜索暂不可用，请稍后重试');\n  return j;\n}\nasync function cached(key, ttl, force, loader) {\n  if (!force) {\n    const saved = await reader.storage.get(key);\n    if (saved && saved.at > Date.now() - ttl && saved.value != null) return saved.value;\n  }\n  const value = await loader();\n  await reader.storage.set(key, { at: Date.now(), value });\n  return value;\n}\nfunction bookKey(type, id) { return 'lanren:' + type + ':' + idOf(id); }\nfunction locator(input) {\n  const m = str(input.bookKey).match(/^lanren:([12]):([1-9]\\d*)$/);\n  if (m) return { type: Number(m[1]), id: idOf(m[2]) };\n  const u = str(input.bookUrl).match(/^https:\\/\\/m\\.lrts\\.me\\/(book|album)\\/([1-9]\\d*)/);\n  if (u) return { type: u[1] === 'book' ? 1 : 2, id: idOf(u[2]) };\n  throw new Error('懒人听书：书籍定位信息缺失，请从搜索或发现重新打开');\n}\nfunction summary(item, defaultType) {\n  if (!item || !str(item.name || item.title)) return null;\n  const type = Number(item.baseEntityType || item.entityType || defaultType || 1);\n  if (type !== 1 && type !== 2) return null;\n  const id = str(item.id || item.baseEntityId);\n  if (!/^[1-9]\\d*$/.test(id)) return null;\n  const tags = array(item.tags).map(x => str(x.name)).filter(Boolean);\n  const author = str(item.author), announcer = str(item.announcer || item.nickName);\n  const result = { bookKey: bookKey(type, id), title: plain(item.name || item.title),\n    author: author || announcer, coverUrl: httpUrl(item.bestCover || item.cover),\n    bookUrl: 'https://m.lrts.me/' + (type === 1 ? 'book/' : 'album/') + id,\n    intro: [plain(item.desc || item.description || item.recReason || item.shortRecReason),\n      announcer ? '演播：' + announcer : ''].filter(Boolean).join('\\n'),\n    types: [str(item.typeName || item.type)].concat(tags).filter(Boolean).slice(0, 32),\n    publicationStatus: Number(item.state) === 2 ? '完结' : Number(item.state) === 1 ? '连载' : '',\n    mediaType: 'audiobook' };\n  return result;\n}\nfunction summaries(list, defaultType) { return array(list).map(x => summary(x, defaultType)).filter(Boolean); }\n\nasync function search(input) {\n  const keyword = str(input.keyword);\n  if (!keyword) return [];\n  const page = pageOf(input.page), key = 'lanren:search-cursor:v1:' + await md5(keyword);\n  let state = await reader.storage.get(key);\n  if (page === 1 || !state || state.at < Date.now() - 30 * 60000) state = { at: Date.now(), cursors: { 1: '' } };\n  // This API uses opaque continuation cursors, not pageNum. Recover earlier\n  // cursors when the host asks for a later page after a worker restart.\n  for (let current = 1; current <= page; current++) {\n    if (current < page && Object.prototype.hasOwnProperty.call(state.cursors, current + 1)) continue;\n    const cursor = state.cursors[current];\n    if (cursor === null) return [];\n    if (cursor === undefined) throw new Error('懒人听书搜索分页信息失效，请重新搜索');\n    const j = await api('/yyting/v2/search/searchBookAlbum', { keyWord: keyword,\n      searchId: '', pageId: '', sort: '0', filters: '', referId: cursor });\n    const data = j.data || {}, rows = summaries(data.bookAlbums);\n    const next = str(data.tabInfo && data.tabInfo.referId);\n    state.cursors[current + 1] = rows.length && next && next !== cursor ? next : null;\n    await reader.storage.set(key, state);\n    if (current === page) return rows;\n  }\n  return [];\n}\nasync function detail(input) {\n  const loc = locator(input);\n  const j = await api('/yyting/v2/book/bookInfoPage', { id: loc.id, type: loc.type, reqMask: 31, source: 0 });\n  const info = j.data && j.data.detail;\n  if (!info) throw new Error('懒人听书：该资源暂不可用或已下架');\n  const result = summary(Object.assign({}, info, { id: loc.id, baseEntityType: loc.type }), loc.type);\n  if (!result) throw new Error('懒人听书：详情数据不完整');\n  const count = Number(info.sections || info.audios || info.audioCount);\n  if (Number.isInteger(count) && count >= 0) result.chapterCount = Math.min(MAX_CHAPTERS, count);\n  if (Number.isInteger(count) && count > 0 && count <= MAX_CHAPTERS) {\n    try { await reader.storage.set('lanren:catalog-count:v1:' + result.bookKey, { at: Date.now(), count }); }\n    catch (_) { /* Metadata is an optional request-scheduling hint. */ }\n  }\n  if (Number(info.updateTime) > 0) result.lastUpdated = new Date(Number(info.updateTime)).toISOString();\n  return result;\n}\n\nasync function exploreMenu(input) {\n  const force = !!(input && input.forceRefresh);\n  return cached('lanren:menu:v1', 6 * 3600000, force, async function () {\n    const data = await Promise.all([\n      api('/yyting/ranking/rankingsGroupList.action', { groupId: 0, groupType: 1 }),\n      api('/yyting/page/typePage.action', {})\n    ]);\n    const menu = [], seen = {};\n    array(data[0].data && data[0].data.list).forEach(g => {\n      const group = str(g.rankingsGroupInfoView && g.rankingsGroupInfoView.name);\n      array(g.rankingsList).forEach(r => {\n        // Reading and anchor charts cannot produce audiobook detail locators.\n        if (Number(r.rankType) !== 0 || !/^[1-9]\\d*$/.test(str(r.rankId))) return;\n        const key = 'rank:' + r.rankId + ':' + Math.max(0, Number(r.rangeType) || 0) + ':' + Math.max(0, Number(r.filterType) || 0);\n        if (seen[key]) return;\n        seen[key] = true;\n        menu.push({ key, title: group && group !== '全部' ? group + '·' + str(r.rankName) : str(r.rankName), group: '榜单' });\n      });\n    });\n    const categories = data[1].data || {};\n    array(categories.bookTypeList).forEach(c => {\n      if (/^[1-9]\\d*$/.test(str(c.id)) && str(c.name)) menu.push({ key: 'category:' + c.id, title: str(c.name), group: '分类' });\n    });\n    array(categories.ablumnTypeList).forEach(root => {\n      array(root.subList).forEach(c => {\n        if (/^[1-9]\\d*$/.test(str(c.id)) && str(c.name) && !seen['category:' + c.id]) {\n          seen['category:' + c.id] = true;\n          menu.push({ key: 'category:' + c.id, title: '节目·' + str(c.name), group: '分类' });\n        }\n      });\n    });\n    if (!menu.length) throw new Error('懒人听书：发现菜单暂无数据');\n    if (menu.length > 128) throw new Error('懒人听书发现菜单超过宿主上限，请更新插件');\n    return menu;\n  });\n}\nasync function explore(input) {\n  const key = str(input.category && typeof input.category === 'object' ? input.category.key : input.category);\n  const rank = key.match(/^rank:([1-9]\\d*):(\\d+):(\\d+)$/);\n  if (rank) {\n    const j = await api('/yyting/ranking/resList.action', { rankId: rank[1], rangeType: rank[2], filterType: rank[3], pageNum: pageOf(input.page), pageSize: 20 });\n    return summaries(j.data && j.data.list);\n  }\n  const category = key.match(/^category:([1-9]\\d*)$/);\n  if (category) {\n    const j = await api('/yyting/label/filterResources.action', { entityType: 1, entityId: category[1], pageNum: pageOf(input.page), dsize: 20, showFilters: 0 });\n    return summaries(j.books, 1).concat(summaries(j.albums, 2));\n  }\n  throw new Error('懒人听书：无效的发现分类，请刷新发现菜单');\n}\n\nasync function catalog(input) {\n  const loc = locator(input);\n  const key = bookKey(loc.type, loc.id);\n  // Four bounded, disposable file slots; whole catalogs never go in KV storage.\n  // A hash collision evicts an older entry, but cannot mix different books.\n  let slot = 0;\n  for (let i = 0; i < key.length; i++) slot = (slot * 31 + key.charCodeAt(i)) % 4;\n  const cachePath = 'cache/lanren/catalog-v2-' + slot + '.json';\n  const canCache = reader.file && typeof reader.file.read === 'function' && typeof reader.file.write === 'function';\n  if (canCache && !input.forceRefresh) {\n    try {\n      const cached = JSON.parse(await reader.file.read({ path: cachePath, charset: 'utf-8' }));\n      const rows = cached.rows;\n      if (cached.bookKey === key && cached.at <= Date.now() && cached.at > Date.now() - CATALOG_CACHE_MS &&\n          Array.isArray(rows) && rows.length === cached.count && rows.length <= MAX_CHAPTERS &&\n          rows.every((row, index) => row && row.ordinal === index && str(row.title) &&\n            str(row.chapterKey).indexOf(key + ':') === 0)) return rows;\n    } catch (_) { /* Cache misses or damaged files fall back to a fresh catalog. */ }\n  }\n  return (async function () {\n    let hintedPages = 1;\n    try {\n      const hint = await reader.storage.get('lanren:catalog-count:v1:' + key);\n      if (hint && hint.at <= Date.now() && hint.at > Date.now() - 10 * 60000 &&\n          Number.isInteger(hint.count) && hint.count > 0 && hint.count <= MAX_CHAPTERS) {\n        hintedPages = Math.min(3, Math.ceil(hint.count / CATALOG_PAGE_SIZE));\n      }\n    } catch (_) {}\n    // Resolve host credentials once before starting parallel requests.\n    await session(); await device();\n    async function requestPage(page) {\n      const params = { pageNum: page, pageSize: CATALOG_PAGE_SIZE, sortType: 0 };\n      params[loc.type === 1 ? 'bookId' : 'ablumnId'] = loc.id;\n      if (loc.type === 1) params.isUp = 0;\n      const j = await api(loc.type === 1 ? '/yyting/bookclient/ClientGetBookResource.action' : '/yyting/snsresource/getAblumnAudiosV2.action', params);\n      return { rows: array(j.list || j.data), total: Number(j.sections || j.count || j.total) || 0 };\n    }\n    const initialRequests = [];\n    for (let page = 1; page <= hintedPages; page++) {\n      initialRequests.push(requestPage(page).then(value => ({ value }), error => ({ error })));\n    }\n    // A fresh detail count permits the first three pages to travel together.\n    // Page one remains authoritative if the resource has changed meanwhile.\n    const initial = await Promise.all(initialRequests);\n    async function load(page) {\n      if (page > initial.length) return requestPage(page);\n      const result = initial[page - 1];\n      if (result.error) throw result.error;\n      return result.value;\n    }\n    const first = await load(1);\n    if (first.total > MAX_CHAPTERS) throw new Error('该书超过鱼书单书 20,000 章上限');\n    if (!first.rows.length && first.total > 0) throw new Error('懒人听书目录返回异常，请重试');\n    const rows = first.rows.slice(), size = first.rows.length;\n    if (first.total > size && size > 0) {\n      const pages = Math.ceil(first.total / size);\n      const results = []; let nextPage = 2, failure = null;\n      async function worker() {\n        while (!failure && nextPage <= pages) {\n          const page = nextPage++;\n          try {\n            const result = await load(page);\n            if (!result.rows.length) throw new Error('懒人听书目录分页不完整，请重试');\n            results[page - 2] = result.rows;\n          } catch (error) { failure = error; }\n        }\n      }\n      const workers = [];\n      for (let i = 0; i < Math.min(3, pages - 1); i++) workers.push(worker());\n      await Promise.all(workers);\n      if (failure) throw failure;\n      results.forEach(pageRows => rows.push.apply(rows, pageRows));\n    } else if (!first.total && size >= CATALOG_PAGE_SIZE) {\n      for (let p = 2; rows.length <= MAX_CHAPTERS; p++) {\n        const next = await load(p);\n        rows.push.apply(rows, next.rows);\n        if (next.rows.length < size) break;\n      }\n    }\n    const seen = {}, result = [];\n    rows.forEach((r, i) => {\n      const section = Number(r.section || r.listpos || i + 1);\n      // sectionId is a string and preserves resource IDs above JS's safe integer range.\n      const resId = str(r.sectionId || (Number.isSafeInteger(r.id) ? r.id : ''));\n      if (!resId || !/^[1-9]\\d*$/.test(resId) || !Number.isSafeInteger(section) || section < 1) throw new Error('懒人听书目录定位字段无效');\n      const key = bookKey(loc.type, loc.id) + ':' + section + ':' + resId;\n      if (seen[key]) throw new Error('懒人听书目录分页重复，请刷新重试');\n      seen[key] = true;\n      const row = { chapterKey: key, title: plain(r.name || r.title) || '第' + section + '集', ordinal: result.length,\n        chapterUrl: 'https://m.lrts.me/' + (loc.type === 1 ? 'book/' : 'album/') + loc.id + '?section=' + section,\n        mediaType: 'audiobook' };\n      // chapterKey already contains the complete durable locator.\n      if (Number(r.cantListen) === 1) row.isLocked = true;\n      const updated = Number(r.lastModify || r.updateTime || r.createTime);\n      if (updated > 0 && Number.isFinite(updated)) row.updateTime = new Date(updated).toISOString();\n      result.push(row);\n    });\n    if (result.length > MAX_CHAPTERS || (first.total && result.length !== first.total)) throw new Error('懒人听书目录数量不一致，请刷新重试');\n    if (canCache && result.length) {\n      try {\n        await reader.file.write({ path: cachePath, charset: 'utf-8',\n          content: JSON.stringify({ bookKey: key, at: Date.now(), count: result.length, rows: result }) });\n      } catch (_) { /* A cache write failure must not hide a complete catalog. */ }\n    }\n    return result;\n  })();\n}\nasync function content(input) {\n  const m = str(input.chapterKey).match(/^lanren:([12]):([1-9]\\d*):([1-9]\\d*):([1-9]\\d*)$/);\n  if (!m) throw new Error('懒人听书：章节定位信息缺失，请刷新目录');\n  const loc = locator(input);\n  if (loc.type !== Number(m[1]) || loc.id !== m[2]) throw new Error('懒人听书：章节与书籍不匹配');\n  const j = await api('/yyting/v2/gateway/getListenPath', { entityType: loc.type, entityId: loc.id, id: m[4], section: m[3], opType: 1, removeBgs: 0 });\n  const data = j.data || {}, url = httpUrl(data.path);\n  if (!url) throw new Error('本章节暂未提供可播放音频，可能需要登录、会员或购买权限');\n  return { contentType: 'audio', content: '', mediaUrl: url, mediaHeaders: Object.assign({}, HEADERS),\n    baseUrl: 'https://m.lrts.me/' + (loc.type === 1 ? 'book/' : 'album/') + loc.id };\n}\n\nmodule.exports = { search, detail, catalog, content, exploreMenu, explore };\n"
}
